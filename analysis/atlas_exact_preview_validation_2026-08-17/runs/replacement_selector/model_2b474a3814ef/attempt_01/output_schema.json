{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model_id",
    "decision",
    "figure_index",
    "route_ids_supported",
    "visible_input_evidence",
    "concise_rationale",
    "confidence"
  ],
  "properties": {
    "model_id": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "select_figure",
        "no_suitable_figure"
      ]
    },
    "figure_index": {
      "type": [
        "integer",
        "null"
      ]
    },
    "route_ids_supported": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "visible_input_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "concise_rationale": {
      "type": "string"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    }
  }
}
