    {
      "operation_id": "normalize",
      "label": "Normalization",
      "definition": "Transform numerical values using a declared scaling or statistical normalization rule.",
      "boundaries": "The method and normalization axes distinguish library-size scaling, TPM and LayerNorm; log transforms are separate calls.",
      "parameters": [
        "method",
        "axes",
        "scope"
      ],
      "official_reference": "https://scikit-learn.org/stable/modules/preprocessing.html",
      "inputs": [
        {
          "name": "values",
          "meaning": "Documented input data operands.",
          "variadic": true,
          "optional": false
        }
      ],
      "outputs": [
        {
          "name": "values",
          "meaning": "Produced output data operands.",
          "variadic": true,
          "optional": false
        }
      ]
    },
