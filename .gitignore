# Living-review source payloads and byte-redundant Docling/Graph documents.
# Their paths, sizes, and hashes remain in each update's artifact_manifest.csv.
data/living_catalog_updates/**/*.pdf
data/living_catalog_updates/**/*.html
data/living_catalog_updates/**/*.xml
data/living_catalog_updates/**/*.docling.json
