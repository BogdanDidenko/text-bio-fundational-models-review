./analysis/screening_run_artifacts_after_prompt_update_20260511/prompt_iteration_runs/prompt_iter2_wrapper_relax_highsignal25_deepseekv4_3gpu_11472_20260509T131343Z/guideline_pilot_raw_completed.jsonl:5:{"cluster_id": "benchmark:9", "title": "Generative pretraining from large-scale transcriptomes: Implications for single-cell deciphering and clinical translation", "abstract": "Exponential accumulation of single-cell transcriptomes poses great challenge for efficient assimilation. Here, we present an approach entitled tGPT towards integration of 22.3 million single-cell transcriptomes by modeling gene expression rankings as generative pretraining task. tGPT is conceptually simple in that it autoregressively models the ranking of a gene in the context of its preceding neighbors. We demonstrated the high performance of tGPT on a range of fundamental single-cell analysis tasks and novel applications on bulk tissues. The single-cell clusters and cell lineage trajectories derived from tGPT are highly aligned with known cell labels and states. The feature patterns of tumor bulk tissues learned by tGPT are associated with a wide range of genomic alteration events, prognosis and treatment outcome of immunotherapy. tGPT represents a new analytical paradigm for integrating and deciphering massive amount of transcriptome data and it will facilitate the interpretation and clinical translation of single-cell transcriptomes.", "regression_group": "benchmark_boundary_case", "decision_run_a": NaN, "decision_run_b": NaN, "scope_boundary_run_a": NaN, "scope_boundary_run_b": NaN, "rationale_run_a": NaN, "rationale_run_b": NaN, "_pilot_row_id": 6, "round-A_scope_reviewer_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "no", "text_bio_bridge_present": "no", "primary_exclusion_code": "EC2_no_text_component", "uncertainty_reason": "none", "evidence_for_text_component": "none", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "not_assessed", "boundary_case": "biological_token_only_boundary", "decision_rationale": "tGPT autoregressively models gene expression rankings, which are biological tokens, not natural language text; thus no text component is present."}, "round-A_scope_reviewer_paper_type": "primary_model_paper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "no", "round-A_scope_reviewer_text_bio_bridge_present": "no", "round-A_scope_reviewer_primary_exclusion_code": "EC2_no_text_component", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "none", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "none", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "biological_token_only_boundary", "round-A_scope_reviewer_decision_rationale": "tGPT autoregressively models gene expression rankings, which are biological tokens, not natural language text; thus no text component is present.", "round-A_architecture_reviewer_output": {"paper_type": "primary_model_paper", "generative_model_present": "yes", "foundation_model_evidence": "yes", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "autoregressively models the ranking of a gene in the context of its preceding neighbors; generative pretraining task", "boundary_case": "clear_include", "decision_rationale": "The abstract explicitly describes tGPT as using autoregressive generative pretraining on 22.3 million single-cell transcriptomes, demonstrating broad applicability across single-cell and bulk tissue tasks, satisfying both generative model and foundation model criteria."}, "round-A_architecture_reviewer_paper_type": "primary_model_paper", "round-A_architecture_reviewer_generative_model_present": "yes", "round-A_architecture_reviewer_foundation_model_evidence": "yes", "round-A_architecture_reviewer_primary_exclusion_code": "none", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "autoregressively models the ranking of a gene in the context of its preceding neighbors; generative pretraining task", "round-A_architecture_reviewer_boundary_case": "clear_include", "round-A_architecture_reviewer_decision_rationale": "The abstract explicitly describes tGPT as using autoregressive generative pretraining on 22.3 million single-cell transcriptomes, demonstrating broad applicability across single-cell and bulk tissue tasks, satisfying both generative model and foundation model criteria.", "pilot_roundA_scope_gate": "EXCLUDE", "pilot_roundA_architecture_gate": "PASS", "pilot_needs_adjudication": false}
./analysis/screening_run_artifacts_after_prompt_update_20260511/prompt_iteration_runs/prompt_iter2_wrapper_relax_highsignal25_deepseekv4_3gpu_11472_20260509T131343Z/guideline_pilot_raw_completed.jsonl:6:{"cluster_id": "benchmark:0", "title": "LangCell: Language-Cell Pre-training for Cell Identity Understanding", "abstract": "Cell identity encompasses various semantic aspects of a cell, including cell type, pathway information, disease information, and more, which are essential for biologists to gain insights into its biological characteristics. Understanding cell identity from the transcriptomic data, such as annotating cell types, has become an important task in bioinformatics. As these semantic aspects are determined by human experts, it is impossible for AI models to effectively carry out cell identity understanding tasks without the supervision signals provided by single-cell and label pairs. The single-cell pre-trained language models (PLMs) currently used for this task are trained only on a single modality, transcriptomics data, lack an understanding of cell identity knowledge. As a result, they have to be fine-tuned for downstream tasks and struggle when lacking labeled data with the desired semantic labels. To address this issue, we propose an innovative solution by constructing a unified representation of single-cell data and natural language during the pre-training phase, allowing the model to directly incorporate insights related to cell identity. More specifically, we introduce $\\textbf{LangCell}$, the first $\\textbf{Lang}$uage-$\\textbf{Cell}$ pre-training framework. LangCell utilizes texts enriched with cell identity information to gain a profound comprehension of cross-modal knowledge. Results from experiments conducted on different benchmarks show that LangCell is the only single-cell PLM that can work effectively in zero-shot cell identity understanding scenarios, and also significantly outperforms existing models in few-shot and fine-tuning cell identity understanding scenarios.", "regression_group": "benchmark_boundary_case", "decision_run_a": NaN, "decision_run_b": NaN, "scope_boundary_run_a": NaN, "scope_boundary_run_b": NaN, "rationale_run_a": NaN, "rationale_run_b": NaN, "_pilot_row_id": 7, "round-A_scope_reviewer_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "yes", "text_bio_bridge_present": "yes", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "texts enriched with cell identity information", "evidence_for_text_bio_bridge": "unified representation of single-cell data and natural language during the pre-training phase", "evidence_for_generative_model": "not_assessed", "boundary_case": "clear_include", "decision_rationale": "The abstract presents LangCell, a pre-training framework that integrates single-cell transcriptomics with natural language text to understand cell identity, making it a primary candidate model with a substantive text-bio bridge."}, "round-A_scope_reviewer_paper_type": "primary_model_paper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "yes", "round-A_scope_reviewer_text_bio_bridge_present": "yes", "round-A_scope_reviewer_primary_exclusion_code": "none", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "texts enriched with cell identity information", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "unified representation of single-cell data and natural language during the pre-training phase", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "clear_include", "round-A_scope_reviewer_decision_rationale": "The abstract presents LangCell, a pre-training framework that integrates single-cell transcriptomics with natural language text to understand cell identity, making it a primary candidate model with a substantive text-bio bridge.", "round-A_architecture_reviewer_output": {"paper_type": "primary_model_paper", "generative_model_present": "no", "foundation_model_evidence": "yes", "primary_exclusion_code": "EC3_not_generative", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "none", "boundary_case": "clear_exclude", "decision_rationale": "Abstract describes a pre-training framework for cell identity understanding using transcriptomics and text, but does not mention any generative mechanism (e.g., decoder, autoregressive generation). Therefore generative_model_present is no."}, "round-A_architecture_reviewer_paper_type": "primary_model_paper", "round-A_architecture_reviewer_generative_model_present": "no", "round-A_architecture_reviewer_foundation_model_evidence": "yes", "round-A_architecture_reviewer_primary_exclusion_code": "EC3_not_generative", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "none", "round-A_architecture_reviewer_boundary_case": "clear_exclude", "round-A_architecture_reviewer_decision_rationale": "Abstract describes a pre-training framework for cell identity understanding using transcriptomics and text, but does not mention any generative mechanism (e.g., decoder, autoregressive generation). Therefore generative_model_present is no.", "pilot_roundA_scope_gate": "PASS", "pilot_roundA_architecture_gate": "EXCLUDE", "pilot_needs_adjudication": false}
./analysis/screening_run_artifacts_after_prompt_update_20260511/prompt_iteration_runs/prompt_iter2_wrapper_relax_highsignal25_deepseekv4_3gpu_11472_20260509T131343Z/guideline_pilot_raw_completed.jsonl:7:{"cluster_id": "benchmark:11", "title": "Nicheformer: a foundation model for single-cell and spatial omics", "abstract": "Tissue makeup relies fundamentally on the cellular microenvironment. Spatial single-cell genomics allows probing the underlying cellular interactions in an unbiased, scalable fashion. To learn a unified cell representation that accounts for local dependencies in the cellular microenvironment, we propose Nicheformer, a transformer-based foundation model that combines human and mouse dissociated single-cell and targeted spatial transcriptomics data. Pretrained on over 57 million dissociated and 53 million spatially resolved cells across 73 tissues on cellular reconstruction, the model is fine-tuned on spatial tasks for spatial omics data to decode spatially resolved cellular information. Nicheformer excels in linear-probing and fine-tuning scenarios for a novel set of downstream tasks, in particular spatial composition prediction and spatial label prediction. We further show that existing foundation models trained on dissociated single-cell data alone are not capable of recapitulating the spatial complexity of cells in their microenvironments, indicating that multiscale models are required to understand complex local dependencies at scale. Nicheformer enables the prediction of the spatial context of dissociated cells, allowing the transfer of rich spatial information to scRNA-seq datasets. Overall, Nicheformer sets the stage for the next generation of machine-learning models in spatial single-cell analysis. Extended Abstract Tissue makeup and the corresponding orchestration of vital biological activities, ranging from development and differentiation to immune response and regeneration, rely fundamentally on the cellular microenvironment and the interactions between cells. Spatial single-cell genomics allows probing such interactions in an unbiased and, increasingly, scalable fashion. To learn a unified cell representation that accounts for local dependencies in the cellular microenvironment and the underlying cell interactions, we propose to generalize recent foundation modeling approaches for disassociated single-cell transcriptomics to the spatial omics setting. Our model, Nicheformer, is a transformer-based foundation model that combines human and mouse dissociated single-cell and targeted spatial transcriptomics data to learn a cellular representation useful for a large variety of downstream tasks. Nicheformer is pretrained on over 57 million dissociated and 53 million spatially resolved cells across 73 tissues from both human and mouse. Subsequently, the model is fine-tuned on spatial tasks for spatial omics data to decode spatially resolved cellular information. We demonstrate the usefulness of Nicheformer in both linear-probing as well as fine-tuning scenarios on a novel set of spatially-relevant downstream tasks such as spatial density prediction or niche and region label prediction. In particular, we show that Nicheformer enables the prediction of the spatial context of dissociated cells, allowing the transfer of rich spatial information to scRNA-seq datasets. We define a series of novel spatial prediction problems and observe consistent top performance of Nicheformer, demonstrating the advantage of the improved model capacity of the underlying transformer. Additionally, we benchmarked Nicheformer in these tasks against scGPT1, Geneformer2, scVI3 and PCA and show that the Nicheformer architecture excels in these tasks. Altogether, our large-scale resource of more than 110 million cells in a partial spatial context, together with the set of novel spatial learning tasks and the Nicheformer model itself, will pave the way for the next generation of machine-learning models for spatial single-cell analysis.", "regression_group": "benchmark_boundary_case", "decision_run_a": NaN, "decision_run_b": NaN, "scope_boundary_run_a": NaN, "scope_boundary_run_b": NaN, "rationale_run_a": NaN, "rationale_run_b": NaN, "_pilot_row_id": 8, "round-A_scope_reviewer_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "no", "text_bio_bridge_present": "no", "primary_exclusion_code": "EC2_no_text_component", "uncertainty_reason": "none", "evidence_for_text_component": "none", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "not_assessed", "boundary_case": "clear_exclude", "decision_rationale": "The abstract describes a transformer-based foundation model trained solely on single-cell and spatial transcriptomics data, with no natural-language text component or text-bio bridge; therefore it does not meet the text component criterion."}, "round-A_scope_reviewer_paper_type": "primary_model_paper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "no", "round-A_scope_reviewer_text_bio_bridge_present": "no", "round-A_scope_reviewer_primary_exclusion_code": "EC2_no_text_component", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "none", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "none", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "clear_exclude", "round-A_scope_reviewer_decision_rationale": "The abstract describes a transformer-based foundation model trained solely on single-cell and spatial transcriptomics data, with no natural-language text component or text-bio bridge; therefore it does not meet the text component criterion.", "round-A_architecture_reviewer_output": {"paper_type": "primary_model_paper", "generative_model_present": "no", "foundation_model_evidence": "yes", "primary_exclusion_code": "EC3_not_generative", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "none", "boundary_case": "clear_exclude", "decision_rationale": "The abstract describes a transformer-based foundation model for spatial prediction tasks (composition, label) without any generative mechanism or output generation; thus it is not a generative model."}, "round-A_architecture_reviewer_paper_type": "primary_model_paper", "round-A_architecture_reviewer_generative_model_present": "no", "round-A_architecture_reviewer_foundation_model_evidence": "yes", "round-A_architecture_reviewer_primary_exclusion_code": "EC3_not_generative", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "none", "round-A_architecture_reviewer_boundary_case": "clear_exclude", "round-A_architecture_reviewer_decision_rationale": "The abstract describes a transformer-based foundation model for spatial prediction tasks (composition, label) without any generative mechanism or output generation; thus it is not a generative model.", "pilot_roundA_scope_gate": "EXCLUDE", "pilot_roundA_architecture_gate": "EXCLUDE", "pilot_needs_adjudication": false}
./analysis/screening_run_artifacts_after_prompt_update_20260511/prompt_iteration_runs/prompt_iter2_wrapper_relax_highsignal25_deepseekv4_3gpu_11472_20260509T131343Z/guideline_pilot_raw_completed.jsonl:8:{"cluster_id": "benchmark:7", "title": "Scaling Large Language Models for Next-Generation Single-Cell Analysis.", "abstract": "A bstract Single-cell RNA sequencing has transformed our understanding of cellular diversity, yet current single-cell foundation models (scFMs) remain limited in their scalability, flexibility across diverse tasks, and ability to natively integrate textual information. In this work, we build upon the Cell2Sentence (C2S) framework, which represents scRNA-seq profiles as textual “cell sentences,” to train Large Language Models (LLMs) on a corpus comprising over one billion tokens of transcriptomic data, biological text, and metadata. Scaling the model to 27 billion parameters yields consistent improvements in predictive and generative capabilities and supports advanced downstream tasks that require synthesis of information across multi-cellular contexts. Targeted fine-tuning with modern reinforcement learning techniques produces strong performance in perturbation response prediction, natural language interpretation, and complex biological reasoning. This predictive strength enabled a dual-context virtual screen that nominated the kinase inhibitor silmitasertib (CX-4945) as a candidate for context-selective upregulation of antigen presentation. Experimental assessment in human cell models unseen during training supported this prediction, demonstrating that C2S-Scale can effectively guide the discovery of context-conditioned biology. C2S-Scale unifies transcriptomic and textual data at unprecedented scales, surpassing both specialized single-cell models and general-purpose LLMs to provide a platform for next-generation single-cell analysis and the development of “virtual cells.”", "regression_group": "benchmark_boundary_case", "decision_run_a": NaN, "decision_run_b": NaN, "scope_boundary_run_a": NaN, "scope_boundary_run_b": NaN, "rationale_run_a": NaN, "rationale_run_b": NaN, "_pilot_row_id": 10, "round-A_scope_reviewer_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "yes", "text_bio_bridge_present": "yes", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "biological text and metadata", "evidence_for_text_bio_bridge": "unifies transcriptomic and textual data", "evidence_for_generative_model": "not_assessed", "boundary_case": "clear_include", "decision_rationale": "The paper presents a new LLM (C2S-Scale) that integrates transcriptomic data and biological text, with explicit text-bio alignment for generative and predictive tasks, meeting all inclusion criteria."}, "round-A_scope_reviewer_paper_type": "primary_model_paper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "yes", "round-A_scope_reviewer_text_bio_bridge_present": "yes", "round-A_scope_reviewer_primary_exclusion_code": "none", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "biological text and metadata", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "unifies transcriptomic and textual data", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "clear_include", "round-A_scope_reviewer_decision_rationale": "The paper presents a new LLM (C2S-Scale) that integrates transcriptomic data and biological text, with explicit text-bio alignment for generative and predictive tasks, meeting all inclusion criteria.", "round-A_architecture_reviewer_output": {"paper_type": "primary_model_paper", "generative_model_present": "yes", "foundation_model_evidence": "yes", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "generative capabilities; trained Large Language Models on transcriptomic data and text", "boundary_case": "clear_include", "decision_rationale": "The abstract describes scaling an LLM (autoregressive/generative) on transcriptomic and textual data, explicitly stating generative capabilities and broad pretraining over one billion tokens, meeting criteria for a primary generative text-bio foundation model."}, "round-A_architecture_reviewer_paper_type": "primary_model_paper", "round-A_architecture_reviewer_generative_model_present": "yes", "round-A_architecture_reviewer_foundation_model_evidence": "yes", "round-A_architecture_reviewer_primary_exclusion_code": "none", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "generative capabilities; trained Large Language Models on transcriptomic data and text", "round-A_architecture_reviewer_boundary_case": "clear_include", "round-A_architecture_reviewer_decision_rationale": "The abstract describes scaling an LLM (autoregressive/generative) on transcriptomic and textual data, explicitly stating generative capabilities and broad pretraining over one billion tokens, meeting criteria for a primary generative text-bio foundation model.", "pilot_roundA_scope_gate": "PASS", "pilot_roundA_architecture_gate": "PASS", "pilot_needs_adjudication": false}
./analysis/screening_run_artifacts_after_prompt_update_20260511/prompt_iteration_runs/prompt_iter2_wrapper_relax_highsignal25_deepseekv4_3gpu_11472_20260509T131343Z/guideline_pilot_raw_completed.jsonl:9:{"cluster_id": "benchmark:6", "title": "PathOmCLIP: Connecting tumor histology with spatial gene expression via locally enhanced contrastive learning of Pathology and Single-cell foundation model", "abstract": "Tumor morphological features from histology images are a cornerstone of clinical pathology, diagnostic biomarkers, and basic cancer biology research. Spatial transcriptomics, which provides spatially resolved gene expression profiles overlaid on histology images, offers a unique opportunity to integrate morphological and expression features, thereby deepening our understanding of tumor biology. However, spatial transcriptomics experiments with patient samples in either clinical trials or clinical care are costly and challenging, whereas histology images are generated routinely and available for many legacy prospective cohorts of disease progression and outcomes in well-annotated cohorts. Inferring spatial transcriptomics profiles computationally from these histology images would significantly expand our understanding of tumor biology, but paired data for training multi-modal spatial-histology models remains limited. Here, we tackle this challenge by incorporating performant foundation models pre-trained on massive datasets of pathology images and single-cell RNA-Seq, respectively, which provide useful embeddings to underpin multi-modal models. To this end, we developed PathOmCLIP, a model trained with contrastive loss to create a joint-embedding space between a histopathology foundation model and a single-cell RNA-seq foundation model. We incorporate a set transformer to gather localized neighborhood tumor architecture following contrastive training, which further enhances performance and is necessary to obtain robust results. We validate PathOmCLIP across five tumor types and achieve significant performance improvements in gene expression prediction tasks over other methods. PathOmCLIP can be applied to many archived histology images, unlocking valuable clinical information and facilitating new biomarker discoveries.", "regression_group": "benchmark_boundary_case", "decision_run_a": NaN, "decision_run_b": NaN, "scope_boundary_run_a": NaN, "scope_boundary_run_b": NaN, "rationale_run_a": NaN, "rationale_run_b": NaN, "_pilot_row_id": 9, "round-A_scope_reviewer_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "no", "text_bio_bridge_present": "no", "primary_exclusion_code": "EC2_no_text_component", "uncertainty_reason": "none", "evidence_for_text_component": "none", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "not_assessed", "boundary_case": "clear_exclude", "decision_rationale": "The abstract describes a model connecting histology images and spatial gene expression, with no mention of natural language text, prompts, captions, or text descriptions; thus it lacks a text component."}, "round-A_scope_reviewer_paper_type": "primary_model_paper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "no", "round-A_scope_reviewer_text_bio_bridge_present": "no", "round-A_scope_reviewer_primary_exclusion_code": "EC2_no_text_component", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "none", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "none", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "clear_exclude", "round-A_scope_reviewer_decision_rationale": "The abstract describes a model connecting histology images and spatial gene expression, with no mention of natural language text, prompts, captions, or text descriptions; thus it lacks a text component.", "round-A_architecture_reviewer_output": {"paper_type": "primary_model_paper", "generative_model_present": "no", "foundation_model_evidence": "no", "primary_exclusion_code": "EC3_not_generative", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "none", "boundary_case": "text_component_boundary", "decision_rationale": "The abstract describes a contrastive learning model for aligning histopathology and single-cell RNA-seq embeddings, with no generative mechanism or text component; thus not a generative text-bio foundational model."}, "round-A_architecture_reviewer_paper_type": "primary_model_paper", "round-A_architecture_reviewer_generative_model_present": "no", "round-A_architecture_reviewer_foundation_model_evidence": "no", "round-A_architecture_reviewer_primary_exclusion_code": "EC3_not_generative", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "none", "round-A_architecture_reviewer_boundary_case": "text_component_boundary", "round-A_architecture_reviewer_decision_rationale": "The abstract describes a contrastive learning model for aligning histopathology and single-cell RNA-seq embeddings, with no generative mechanism or text component; thus not a generative text-bio foundational model.", "pilot_roundA_scope_gate": "EXCLUDE", "pilot_roundA_architecture_gate": "EXCLUDE", "pilot_needs_adjudication": false}
./analysis/screening_run_artifacts_after_prompt_update_20260511/prompt_iteration_runs/prompt_iter2_wrapper_relax_highsignal25_deepseekv4_3gpu_11472_20260509T131343Z/guideline_pilot_raw_completed.jsonl:10:{"cluster_id": "benchmark:12", "title": "X-Cell: Scaling Causal Perturbation Prediction Across Diverse Cellular Contexts via Diffusion Language Models", "abstract": "Abstract\n                \n                  Causal models of cellular systems hold the promise to empower broad biological discovery, including the systematic identification of novel targets for drug discovery. Predicting how genetic and pathway perturbations reshape gene expression across diverse cellular contexts is a prerequisite for building generalizable cellular foundation models. However, current methods typically fail to extrapolate beyond their training distributions because they rely predominantly on observational expression atlases rather than interventional perturbation data. We present X-Atlas/Pisces, the largest genome-wide CRISPRi Perturb-seq compendium to date, comprising 25.6 million perturbed single-cell transcriptomes across 16 biologically diverse contexts, including widely used cell lines, induced pluripotent stem cells (iPSCs), resting and CD3/CD28 activated Jurkat T lymphoma cells, and multi-lineage differentiating iPSCs. Leveraging this resource, we develop X-Cell, a diffusion language model that predicts perturbation responses by iteratively refining control-to-perturbed state transitions through cross-attention to multi-modal biological priors derived from natural language, protein language models, interaction networks, genetic dependency maps, and morphological profiles. X-Cell outperforms existing state-of-the-art models by up to five-fold on key metrics such as Pearson\n                  Δ\n                  (correlation between predicted and observed perturbation-induced log-fold changes), and demonstrates zero-shot prediction of T cell inactivating perturbations in stimulated Jurkat cells. We scale X-Cell to 4.9 billion parameters (X-Cell-Ultra), the largest causal perturbation model to date. We demonstrate for the first time that perturbation prediction follows power-law scaling with an exponent matching large language models. X-Cell-Ultra demonstrates zero-shot generalization to novel biological contexts, including unseen iPSC-derived melanocyte progenitors and primary human CD4\n                  +\n                  T cells from multiple donors, and outperforms all baselines after self-supervised test-time adaptation. These results demonstrate that coordinated scaling of causal perturbation data and model capacity yields foundation models capable of generalizable perturbation prediction across cellular contexts, with potential applications for improving computational target identification, validation, and context-specific therapeutic prioritization.", "regression_group": "benchmark_boundary_case", "decision_run_a": NaN, "decision_run_b": NaN, "scope_boundary_run_a": NaN, "scope_boundary_run_b": NaN, "rationale_run_a": NaN, "rationale_run_b": NaN, "_pilot_row_id": 11, "round-A_scope_reviewer_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "yes", "text_bio_bridge_present": "yes", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "multi-modal biological priors derived from natural language", "evidence_for_text_bio_bridge": "cross-attention to multi-modal biological priors derived from natural language", "evidence_for_generative_model": "not_assessed", "boundary_case": "clear_include", "decision_rationale": "The abstract presents a new diffusion language model (X-Cell) that uses cross-attention to multi-modal priors including natural language to predict perturbation responses across cellular contexts, satisfying all criteria."}, "round-A_scope_reviewer_paper_type": "primary_model_paper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "yes", "round-A_scope_reviewer_text_bio_bridge_present": "yes", "round-A_scope_reviewer_primary_exclusion_code": "none", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "multi-modal biological priors derived from natural language", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "cross-attention to multi-modal biological priors derived from natural language", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "clear_include", "round-A_scope_reviewer_decision_rationale": "The abstract presents a new diffusion language model (X-Cell) that uses cross-attention to multi-modal priors including natural language to predict perturbation responses across cellular contexts, satisfying all criteria.", "round-A_architecture_reviewer_output": {"paper_type": "primary_model_paper", "generative_model_present": "yes", "foundation_model_evidence": "yes", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "diffusion language model iteratively refining control-to-perturbed state transitions", "boundary_case": "clear_include", "decision_rationale": "The abstract describes X-Cell, a diffusion language model for perturbation prediction, with evidence of scaling (4.9B parameters) and zero-shot generalization, meeting criteria for a generative foundation model."}, "round-A_architecture_reviewer_paper_type": "primary_model_paper", "round-A_architecture_reviewer_generative_model_present": "yes", "round-A_architecture_reviewer_foundation_model_evidence": "yes", "round-A_architecture_reviewer_primary_exclusion_code": "none", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "diffusion language model iteratively refining control-to-perturbed state transitions", "round-A_architecture_reviewer_boundary_case": "clear_include", "round-A_architecture_reviewer_decision_rationale": "The abstract describes X-Cell, a diffusion language model for perturbation prediction, with evidence of scaling (4.9B parameters) and zero-shot generalization, meeting criteria for a generative foundation model.", "pilot_roundA_scope_gate": "PASS", "pilot_roundA_architecture_gate": "PASS", "pilot_needs_adjudication": false}
./analysis/screening_run_artifacts_after_prompt_update_20260511/prompt_iteration_runs/prompt_iter2_wrapper_relax_highsignal25_deepseekv4_3gpu_11472_20260509T131343Z/guideline_pilot_raw_completed.jsonl:11:{"cluster_id": "benchmark:4", "title": "GenePT: A Simple But Effective Foundation Model for Genes and Cells Built From ChatGPT.", "abstract": "There has been significant recent progress in leveraging large-scale gene expression data to develop foundation models for single-cell biology. Models such as Geneformer and scGPT implicitly learn gene and cellular functions from the gene expression profiles of millions of cells, which requires extensive data curation and resource-intensive training. Here we explore a much simpler alternative by leveraging ChatGPT embeddings of genes based on literature. Our proposal, GenePT, uses NCBI text descriptions of individual genes with GPT-3.5 to generate gene embeddings. From there, GenePT generates single-cell embeddings in two ways: (i) by averaging the gene embeddings, weighted by each gene's expression level; or (ii) by creating a sentence embedding for each cell, using gene names ordered by the expression level. Without the need for dataset curation and additional pretraining, GenePT is efficient and easy to use. On many downstream tasks used to evaluate recent single-cell foundation models - e.g., classifying gene properties and cell types - GenePT achieves comparable, and often better, performance than Geneformer and other models. GenePT demonstrates that large language model embedding of literature is a simple and effective path for biological foundation models.", "regression_group": "benchmark_boundary_case", "decision_run_a": NaN, "decision_run_b": NaN, "scope_boundary_run_a": NaN, "scope_boundary_run_b": NaN, "rationale_run_a": NaN, "rationale_run_b": NaN, "_pilot_row_id": 5, "round-A_scope_reviewer_output": {"paper_type": "application_wrapper", "bio_modality_present": "yes", "text_component_present": "yes", "text_bio_bridge_present": "yes", "primary_exclusion_code": "application_wrapper", "uncertainty_reason": "none", "evidence_for_text_component": "uses NCBI text descriptions of individual genes with GPT-3.5 to generate gene embeddings; creating a sentence embedding for each cell, using gene names", "evidence_for_text_bio_bridge": "leveraging ChatGPT embeddings of genes based on literature; large language model embedding of literature is a simple and effective path for biological foundation models", "evidence_for_generative_model": "not_assessed", "boundary_case": "wrapper_boundary", "decision_rationale": "The paper uses existing GPT-3.5 embeddings from NCBI text descriptions to generate gene and cell embeddings for downstream tasks, fitting the definition of an application wrapper rather than a primary multimodal text-bio model."}, "round-A_scope_reviewer_paper_type": "application_wrapper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "yes", "round-A_scope_reviewer_text_bio_bridge_present": "yes", "round-A_scope_reviewer_primary_exclusion_code": "application_wrapper", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "uses NCBI text descriptions of individual genes with GPT-3.5 to generate gene embeddings; creating a sentence embedding for each cell, using gene names", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "leveraging ChatGPT embeddings of genes based on literature; large language model embedding of literature is a simple and effective path for biological foundation models", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "wrapper_boundary", "round-A_scope_reviewer_decision_rationale": "The paper uses existing GPT-3.5 embeddings from NCBI text descriptions to generate gene and cell embeddings for downstream tasks, fitting the definition of an application wrapper rather than a primary multimodal text-bio model.", "round-A_architecture_reviewer_output": {"paper_type": "application_wrapper", "generative_model_present": "no", "foundation_model_evidence": "yes", "primary_exclusion_code": "application_wrapper", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "none", "boundary_case": "wrapper_boundary", "decision_rationale": "GenePT leverages ChatGPT embeddings to create gene and cell representations; it does not present a new generative model. The paper is an application wrapper using an existing generative model."}, "round-A_architecture_reviewer_paper_type": "application_wrapper", "round-A_architecture_reviewer_generative_model_present": "no", "round-A_architecture_reviewer_foundation_model_evidence": "yes", "round-A_architecture_reviewer_primary_exclusion_code": "application_wrapper", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "none", "round-A_architecture_reviewer_boundary_case": "wrapper_boundary", "round-A_architecture_reviewer_decision_rationale": "GenePT leverages ChatGPT embeddings to create gene and cell representations; it does not present a new generative model. The paper is an application wrapper using an existing generative model.", "pilot_roundA_scope_gate": "EXCLUDE", "pilot_roundA_architecture_gate": "EXCLUDE", "pilot_needs_adjudication": false}
./analysis/screening_run_artifacts_after_prompt_update_20260511/prompt_iteration_runs/prompt_iter2_wrapper_relax_highsignal25_deepseekv4_3gpu_11472_20260509T131343Z/guideline_pilot_raw_completed.jsonl:12:{"cluster_id": "benchmark:8", "title": "scGPT: toward building a foundation model for single-cell multi-omics using generative AI", "abstract": "Generative pretrained models have achieved remarkable success in various domains such as language and computer vision. Specifically, the combination of large-scale diverse datasets and pretrained transformers has emerged as a promising approach for developing foundation models. Drawing parallels between language and cellular biology (in which texts comprise words; similarly, cells are defined by genes), our study probes the applicability of foundation models to advance cellular biology and genetic research. Using burgeoning single-cell sequencing data, we have constructed a foundation model for single-cell biology, scGPT, based on a generative pretrained transformer across a repository of over 33 million cells. Our findings illustrate that scGPT effectively distills critical biological insights concerning genes and cells. Through further adaptation of transfer learning, scGPT can be optimized to achieve superior performance across diverse downstream applications. This includes tasks such as cell type annotation, multi-batch integration, multi-omic integration, perturbation response prediction and gene network inference. Pretrained using over 33 million single-cell RNA-sequencing profiles, scGPT is a foundation model facilitating a broad spectrum of downstream single-cell analysis tasks by transfer learning.", "regression_group": "benchmark_boundary_case", "decision_run_a": NaN, "decision_run_b": NaN, "scope_boundary_run_a": NaN, "scope_boundary_run_b": NaN, "rationale_run_a": NaN, "rationale_run_b": NaN, "_pilot_row_id": 12, "round-A_scope_reviewer_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "no", "text_bio_bridge_present": "no", "primary_exclusion_code": "EC2_no_text_component", "uncertainty_reason": "none", "evidence_for_text_component": "none", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "not_assessed", "boundary_case": "biological_token_only_boundary", "decision_rationale": "scGPT is a generative transformer pretrained on single-cell RNA-seq profiles; it uses gene expression tokens, not natural-language text, so text component is absent."}, "round-A_scope_reviewer_paper_type": "primary_model_paper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "no", "round-A_scope_reviewer_text_bio_bridge_present": "no", "round-A_scope_reviewer_primary_exclusion_code": "EC2_no_text_component", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "none", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "none", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "biological_token_only_boundary", "round-A_scope_reviewer_decision_rationale": "scGPT is a generative transformer pretrained on single-cell RNA-seq profiles; it uses gene expression tokens, not natural-language text, so text component is absent.", "round-A_architecture_reviewer_output": {"paper_type": "primary_model_paper", "generative_model_present": "yes", "foundation_model_evidence": "yes", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "generative pretrained transformer", "boundary_case": "biological_token_only_boundary", "decision_rationale": "scGPT is a generative pretrained transformer for single-cell biology using genes as tokens, with foundation-model evidence from large-scale pretraining and transfer learning. No text component is present."}, "round-A_architecture_reviewer_paper_type": "primary_model_paper", "round-A_architecture_reviewer_generative_model_present": "yes", "round-A_architecture_reviewer_foundation_model_evidence": "yes", "round-A_architecture_reviewer_primary_exclusion_code": "none", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "generative pretrained transformer", "round-A_architecture_reviewer_boundary_case": "biological_token_only_boundary", "round-A_architecture_reviewer_decision_rationale": "scGPT is a generative pretrained transformer for single-cell biology using genes as tokens, with foundation-model evidence from large-scale pretraining and transfer learning. No text component is present.", "pilot_roundA_scope_gate": "EXCLUDE", "pilot_roundA_architecture_gate": "PASS", "pilot_needs_adjudication": false}
./analysis/screening_run_artifacts_after_prompt_update_20260511/prompt_iteration_runs/prompt_iter2_wrapper_relax_highsignal25_deepseekv4_3gpu_11472_20260509T131343Z/guideline_pilot_raw_completed.jsonl:13:{"cluster_id": "benchmark:1", "title": "ChatCell: Facilitating Single-Cell Analysis with Natural Language", "abstract": "As Large Language Models (LLMs) rapidly evolve, their influence in science is becoming increasingly prominent. The emerging capabilities of LLMs in task generalization and free-form dialogue can significantly advance fields like chemistry and biology. However, the field of single-cell biology, which forms the foundational building blocks of living organisms, still faces several challenges. High knowledge barriers and limited scalability in current methods restrict the full exploitation of LLMs in mastering single-cell data, impeding direct accessibility and rapid iteration. To this end, we introduce ChatCell, which signifies a paradigm shift by facilitating single-cell analysis with natural language. Leveraging vocabulary adaptation and unified sequence generation, ChatCell has acquired profound expertise in single-cell biology and the capability to accommodate a diverse range of analysis tasks. Extensive experiments further demonstrate ChatCell's robust performance and potential to deepen single-cell insights, paving the way for more accessible and intuitive exploration in this pivotal field. Our project homepage is available at https://zjunlp.github.io/project/ChatCell.", "regression_group": "benchmark_boundary_case", "decision_run_a": NaN, "decision_run_b": NaN, "scope_boundary_run_a": NaN, "scope_boundary_run_b": NaN, "rationale_run_a": NaN, "rationale_run_b": NaN, "_pilot_row_id": 2, "round-A_scope_reviewer_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "yes", "text_bio_bridge_present": "unclear", "primary_exclusion_code": "none", "uncertainty_reason": "text_bio_bridge_unclear", "evidence_for_text_component": "facilitating single-cell analysis with natural language", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "not_assessed", "boundary_case": "thin_abstract_boundary", "decision_rationale": "The abstract introduces ChatCell as a model that uses natural language for single-cell analysis, but does not specify whether there is a substantive mapping between natural language and biological data; the text-bio bridge is unclear due to thin evidence."}, "round-A_scope_reviewer_paper_type": "primary_model_paper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "yes", "round-A_scope_reviewer_text_bio_bridge_present": "unclear", "round-A_scope_reviewer_primary_exclusion_code": "none", "round-A_scope_reviewer_uncertainty_reason": "text_bio_bridge_unclear", "round-A_scope_reviewer_evidence_for_text_component": "facilitating single-cell analysis with natural language", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "none", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "thin_abstract_boundary", "round-A_scope_reviewer_decision_rationale": "The abstract introduces ChatCell as a model that uses natural language for single-cell analysis, but does not specify whether there is a substantive mapping between natural language and biological data; the text-bio bridge is unclear due to thin evidence.", "round-A_architecture_reviewer_output": {"paper_type": "primary_model_paper", "generative_model_present": "yes", "foundation_model_evidence": "yes", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "unified sequence generation", "boundary_case": "clear_include", "decision_rationale": "Introduces ChatCell, a generative model using unified sequence generation for single-cell analysis, demonstrating foundation-model-like broad applicability and transferable expertise."}, "round-A_architecture_reviewer_paper_type": "primary_model_paper", "round-A_architecture_reviewer_generative_model_present": "yes", "round-A_architecture_reviewer_foundation_model_evidence": "yes", "round-A_architecture_reviewer_primary_exclusion_code": "none", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "unified sequence generation", "round-A_architecture_reviewer_boundary_case": "clear_include", "round-A_architecture_reviewer_decision_rationale": "Introduces ChatCell, a generative model using unified sequence generation for single-cell analysis, demonstrating foundation-model-like broad applicability and transferable expertise.", "pilot_roundA_scope_gate": "UNCERTAIN", "pilot_roundA_architecture_gate": "PASS", "pilot_needs_adjudication": true, "round-B_adjudicator_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "yes", "text_bio_bridge_present": "unclear", "generative_model_present": "yes", "foundation_model_evidence": "yes", "primary_exclusion_code": "none", "uncertainty_reason": "text_bio_bridge_unclear", "evidence_for_text_component": "facilitating single-cell analysis with natural language", "evidence_for_text_bio_bridge": "facilitating single-cell analysis with natural language", "evidence_for_generative_model": "unified sequence generation", "boundary_case": "clear_include", "decision_rationale": "The abstract presents ChatCell as a primary model that uses natural language and unified sequence generation for single-cell analysis, clearly indicating a generative model with text and bio modalities. The text-bio bridge is implied but not explicitly described, so it remains unclear; however, this does not warrant exclusion."}, "round-B_adjudicator_paper_type": "primary_model_paper", "round-B_adjudicator_bio_modality_present": "yes", "round-B_adjudicator_text_component_present": "yes", "round-B_adjudicator_text_bio_bridge_present": "unclear", "round-B_adjudicator_generative_model_present": "yes", "round-B_adjudicator_foundation_model_evidence": "yes", "round-B_adjudicator_primary_exclusion_code": "none", "round-B_adjudicator_uncertainty_reason": "text_bio_bridge_unclear", "round-B_adjudicator_evidence_for_text_component": "facilitating single-cell analysis with natural language", "round-B_adjudicator_evidence_for_text_bio_bridge": "facilitating single-cell analysis with natural language", "round-B_adjudicator_evidence_for_generative_model": "unified sequence generation", "round-B_adjudicator_boundary_case": "clear_include", "round-B_adjudicator_decision_rationale": "The abstract presents ChatCell as a primary model that uses natural language and unified sequence generation for single-cell analysis, clearly indicating a generative model with text and bio modalities. The text-bio bridge is implied but not explicitly described, so it remains unclear; however, this does not warrant exclusion."}
./analysis/screening_run_artifacts_after_prompt_update_20260511/prompt_iteration_runs/prompt_iter2_wrapper_relax_highsignal25_deepseekv4_3gpu_11472_20260509T131343Z/guideline_pilot_raw_completed.jsonl:14:{"cluster_id": "3741", "title": "Abstract 4213: Generative genomics accurately predicts cancer gene expression", "abstract": "AI models capable of predicting experimental outcomes could accelerate biomedical research by circumventing fundamental constraints of laboratory experimentation and clinical trials. We developed GEM-1 (Generate Expression Model-1), a generative genomics framework that models the diversity of real-world gene expression experiments and accurately predicts future experimental results. We trained GEM-1 using 470,691 bulk RNA-seq samples from 24,715 datasets in the NCBI Sequence Read Archive, spanning diverse tissues, diseases, and over 18,000 distinct perturbations. An automated metadata agent harmonized fragmented experimental descriptions using large language models. GEM-1 employs a deep latent variable model that partitions experimental metadata into biological, technical, and perturbational components, using pretrained foundation model embeddings to enable generalization to novel perturbations. Testing on holdout data deposited after training, GEM-1 achieved pseudoreplicate-level accuracy (pearson correlation of gene rank across samples, r_gene, of 0.65-0.75) for previously observed contexts and maintained strong performance for completely novel genetic (r_gene = 0.58-0.63) and chemical perturbations (r_gene = 0.52-0.68). The model correctly predicted 63% and 70% of enriched gene sets for novel genetic and chemical perturbations, respectively. We extended GEM-1 to single-cell data using 41.5 million cells, achieving comparable performance to established models for cell type annotation while enabling interpretable biological feature inference. We demonstrated clinical utility by generating synthetic cohorts that accurately recapitulated key biological phenomena: SYNTH-TEx (5,300 healthy tissue samples matching GTEx patterns), SYNTH-interferon (200 samples correctly modeling lupus interferon dysregulation), and SYNTH-cancer (10,523 samples exhibiting known molecular features of cancer). We show that GEM-1 can simulate novel perturbations on specific patient samples, an ability we term \"reference conditioning\". This approach represents a significant advance toward AI systems that can predict experimental outcomes before physical experiments are conducted, shortcutting fundamental limitations in experimental speed and clinical trial recruitment and potentially revolutionizing drug development and personalized medicine.\n \n \n Gregory Koytiger, Alice M. Walsh, Vaishali Marar, Kayla A. Johnson, Max Highsmith, Alexander R. Abbas, Andrew Stirn, Ariel Brumbaugh, Alex David, Darren Hui, Jeffrey Kahn, Sheng-Yong Niu, Liza J. Ray, Candace Savonen, Stein Setvik, Jeffrey T. Leek, Robert K. Bradley. Generative genomics accurately predicts cancer gene expression [abstract]. In: Proceedings of the American Association for Cancer Research Annual Meeting 2026; Part 1 (Regular Abstracts); 2026 Apr 17-22; San Diego, CA. Philadelphia (PA): AACR; Cancer Res 2026;86(7 Suppl):Abstract nr 4213.", "regression_group": "include_decision_unstable", "decision_run_a": "INCLUDE", "decision_run_b": "EXCLUDE", "scope_boundary_run_a": NaN, "scope_boundary_run_b": NaN, "rationale_run_a": "GEM-1 is a generative genomics model trained on RNA-seq data and uses pretrained LLM embeddings from experimental metadata to condition predictions, establishing a substantive text-bio bridge. | The abstract explicitly describes GEM-1 as a generative genomics framework using a deep latent variable model trained on large-scale transcriptomic data, with evidence of broad pretraining and transferable representations.", "rationale_run_b": "The abstract describes GEM-1, a newly developed generative model for predicting gene expression from experimental metadata, making it a primary model paper. Text component is absent in the model's output, but the text-bio bridge is present via metadata harmonization and pretrained embeddings. Scope reviewer's 'application_wrapper' classification is overridden as the paper presents an original model, not a wrapper.", "_pilot_row_id": 14, "round-A_scope_reviewer_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "yes", "text_bio_bridge_present": "yes", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "automated metadata agent harmonized fragmented experimental descriptions using large language models; model uses pretrained foundation model embeddings", "evidence_for_text_bio_bridge": "predicts gene expression from experimental metadata descriptions; partitions experimental metadata into biological, technical, and perturbational components", "evidence_for_generative_model": "not_assessed", "boundary_case": "clear_include", "decision_rationale": "GEM-1 is a generative model that uses experimental descriptions (text) to predict gene expression, with a clear text-bio bridge via pretrained foundation model embeddings and metadata partitioning."}, "round-A_scope_reviewer_paper_type": "primary_model_paper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "yes", "round-A_scope_reviewer_text_bio_bridge_present": "yes", "round-A_scope_reviewer_primary_exclusion_code": "none", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "automated metadata agent harmonized fragmented experimental descriptions using large language models; model uses pretrained foundation model embeddings", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "predicts gene expression from experimental metadata descriptions; partitions experimental metadata into biological, technical, and perturbational components", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "clear_include", "round-A_scope_reviewer_decision_rationale": "GEM-1 is a generative model that uses experimental descriptions (text) to predict gene expression, with a clear text-bio bridge via pretrained foundation model embeddings and metadata partitioning.", "round-A_architecture_reviewer_output": {"paper_type": "primary_model_paper", "generative_model_present": "yes", "foundation_model_evidence": "yes", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "generative genomics framework with deep latent variable model that generates synthetic cohorts and simulates perturbations", "boundary_case": "clear_include", "decision_rationale": "The abstract describes GEM-1 as a generative genomics framework that models gene expression experiments and generates synthetic cohorts, with broad pretraining on diverse RNA-seq data, indicating a generative foundation model."}, "round-A_architecture_reviewer_paper_type": "primary_model_paper", "round-A_architecture_reviewer_generative_model_present": "yes", "round-A_architecture_reviewer_foundation_model_evidence": "yes", "round-A_architecture_reviewer_primary_exclusion_code": "none", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "generative genomics framework with deep latent variable model that generates synthetic cohorts and simulates perturbations", "round-A_architecture_reviewer_boundary_case": "clear_include", "round-A_architecture_reviewer_decision_rationale": "The abstract describes GEM-1 as a generative genomics framework that models gene expression experiments and generates synthetic cohorts, with broad pretraining on diverse RNA-seq data, indicating a generative foundation model.", "pilot_roundA_scope_gate": "PASS", "pilot_roundA_architecture_gate": "PASS", "pilot_needs_adjudication": false}
./analysis/screening_run_artifacts_after_prompt_update_20260511/prompt_iteration_runs/prompt_iter2_wrapper_relax_highsignal25_deepseekv4_3gpu_11472_20260509T131343Z/guideline_pilot_raw_completed.jsonl:15:{"cluster_id": "1969", "title": "Cell2Text: Multimodal LLM for Generating Single-Cell Descriptions from RNA-Seq Data", "abstract": "Single-cell RNA sequencing has transformed biology by enabling the measurement of gene expression at cellular resolution, providing information for cell types, states, and disease contexts. Recently, single-cell foundation models have emerged as powerful tools for learning transferable representations directly from expression profiles, improving performance on classification and clustering tasks. However, these models are limited to discrete prediction heads, which collapse cellular complexity into predefined labels that fail to capture the richer, contextual explanations biologists need. We introduce Cell2Text, a multimodal generative framework that translates scRNA-seq profiles into structured natural language descriptions. By integrating gene-level embeddings from single-cell foundation models with pretrained large language models, Cell2Text generates coherent summaries that capture cellular identity, tissue origin, disease associations, and pathway activity, generalizing to unseen cells. Empirically, Cell2Text outperforms baselines on classification accuracy, demonstrates strong ontological consistency using PageRank-based similarity metrics, and achieves high semantic fidelity in text generation. These results demonstrate that coupling expression data with natural language offers both stronger predictive performance and inherently interpretable outputs, pointing to a scalable path for label-efficient characterization of unseen cells.", "regression_group": "include_decision_unstable", "decision_run_a": "EXCLUDE", "decision_run_b": "INCLUDE", "scope_boundary_run_a": NaN, "scope_boundary_run_b": NaN, "rationale_run_a": "The abstract presents Cell2Text as a framework that integrates existing single-cell foundation models with pretrained LLMs, not as a new foundation model itself, so it is an application wrapper. Bio modality, text component, text-bio bridge, and generative status are clearly present.", "rationale_run_b": "Cell2Text is a multimodal generative framework that translates scRNA-seq profiles into structured natural language descriptions, integrating gene-level embeddings with a pretrained LLM. This constitutes a primary model paper with a clear text-bio bridge. | The abstract introduces Cell2Text, a generative framework that produces text descriptions from scRNA-seq data, clearly indicating a generative model. However, evidence that Cell2Text itself is a foundation model is unclear as it relies on existing foundation models as components.", "_pilot_row_id": 18, "round-A_scope_reviewer_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "yes", "text_bio_bridge_present": "yes", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "generates coherent summaries that capture cellular identity, tissue origin, disease associations, and pathway activity", "evidence_for_text_bio_bridge": "translates scRNA-seq profiles into structured natural language descriptions", "evidence_for_generative_model": "not_assessed", "boundary_case": "clear_include", "decision_rationale": "The abstract presents a new multimodal generative framework (Cell2Text) that translates single-cell RNA-seq data into natural language descriptions, satisfying all criteria for a primary text-bio model."}, "round-A_scope_reviewer_paper_type": "primary_model_paper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "yes", "round-A_scope_reviewer_text_bio_bridge_present": "yes", "round-A_scope_reviewer_primary_exclusion_code": "none", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "generates coherent summaries that capture cellular identity, tissue origin, disease associations, and pathway activity", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "translates scRNA-seq profiles into structured natural language descriptions", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "clear_include", "round-A_scope_reviewer_decision_rationale": "The abstract presents a new multimodal generative framework (Cell2Text) that translates single-cell RNA-seq data into natural language descriptions, satisfying all criteria for a primary text-bio model.", "round-A_architecture_reviewer_output": {"paper_type": "primary_model_paper", "generative_model_present": "yes", "foundation_model_evidence": "no", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "generates coherent summaries that capture cellular identity, tissue origin, disease associations, and pathway activity", "boundary_case": "clear_include", "decision_rationale": "Cell2Text is a multimodal generative framework that translates scRNA-seq profiles into natural language descriptions, explicitly generating text from gene expression data. The abstract describes a generative model and is a primary model paper."}, "round-A_architecture_reviewer_paper_type": "primary_model_paper", "round-A_architecture_reviewer_generative_model_present": "yes", "round-A_architecture_reviewer_foundation_model_evidence": "no", "round-A_architecture_reviewer_primary_exclusion_code": "none", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "generates coherent summaries that capture cellular identity, tissue origin, disease associations, and pathway activity", "round-A_architecture_reviewer_boundary_case": "clear_include", "round-A_architecture_reviewer_decision_rationale": "Cell2Text is a multimodal generative framework that translates scRNA-seq profiles into natural language descriptions, explicitly generating text from gene expression data. The abstract describes a generative model and is a primary model paper.", "pilot_roundA_scope_gate": "PASS", "pilot_roundA_architecture_gate": "PASS", "pilot_needs_adjudication": false}
./analysis/screening_run_artifacts_after_prompt_update_20260511/prompt_iteration_runs/prompt_iter2_wrapper_relax_highsignal25_deepseekv4_3gpu_11472_20260509T131343Z/guideline_pilot_raw_completed.jsonl:16:{"cluster_id": "3378", "title": "CASSIA: a multi-agent large language model for reference free, interpretable, and automated cell annotation of single-cell RNA-sequencing data", "abstract": "Abstract\n                Cell type annotation is an essential step in single-cell RNA-sequencing analysis, and numerous annotation methods are available. Most require a combination of computational and domain-specific expertise, and they frequently yield inconsistent results that can be challenging to interpret. Large language models have the potential to expand accessibility while reducing manual input and improving accuracy, but existing approaches suffer from hyperconfidence, hallucinations, and lack of reasoning. To address these limitations, we developed CASSIA for automated, accurate, and interpretable cell annotation of single-cell RNA-sequencing data. As demonstrated in analyses of over 970 cell types, CASSIA improves annotation accuracy in benchmark datasets as well as complex and rare cell populations, and also provides users with reasoning and quality assessment to ensure interpretability, guard against hallucinations, and calibrate confidence.", "regression_group": "include_decision_unstable", "decision_run_a": "EXCLUDE", "decision_run_b": "INCLUDE", "scope_boundary_run_a": NaN, "scope_boundary_run_b": NaN, "rationale_run_a": "The abstract describes CASSIA as a multi-agent system leveraging existing LLMs for cell annotation, not a new foundational model, so it is an application wrapper. Per policy, wrapper-style use sets text_bio_bridge_present to no.", "rationale_run_b": "The abstract describes CASSIA as a multi-agent large language model for cell annotation, indicating a primary model paper with generative capabilities, bio modality (scRNA-seq), text component (LLM), and text-bio bridge (annotation). Foundation model evidence is unclear as it does not specify reliance on a pre-trained foundation model.", "_pilot_row_id": 17, "round-A_scope_reviewer_output": {"paper_type": "application_wrapper", "bio_modality_present": "yes", "text_component_present": "yes", "text_bio_bridge_present": "no", "primary_exclusion_code": "application_wrapper", "uncertainty_reason": "none", "evidence_for_text_component": "multi-agent large language model", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "not_assessed", "boundary_case": "wrapper_boundary", "decision_rationale": "CASSIA uses an LLM for cell annotation, a downstream biological classification task, making it an application wrapper rather than a primary generative text-bio model."}, "round-A_scope_reviewer_paper_type": "application_wrapper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "yes", "round-A_scope_reviewer_text_bio_bridge_present": "no", "round-A_scope_reviewer_primary_exclusion_code": "application_wrapper", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "multi-agent large language model", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "none", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "wrapper_boundary", "round-A_scope_reviewer_decision_rationale": "CASSIA uses an LLM for cell annotation, a downstream biological classification task, making it an application wrapper rather than a primary generative text-bio model.", "round-A_architecture_reviewer_output": {"paper_type": "application_wrapper", "generative_model_present": "no", "foundation_model_evidence": "no", "primary_exclusion_code": "application_wrapper", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "none", "boundary_case": "wrapper_boundary", "decision_rationale": "CASSIA is a multi-agent LLM system for cell type annotation, which is a classification task, not generative. The abstract does not describe a generative mechanism or foundation model pretraining; it is an application wrapper using existing LLMs."}, "round-A_architecture_reviewer_paper_type": "application_wrapper", "round-A_architecture_reviewer_generative_model_present": "no", "round-A_architecture_reviewer_foundation_model_evidence": "no", "round-A_architecture_reviewer_primary_exclusion_code": "application_wrapper", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "none", "round-A_architecture_reviewer_boundary_case": "wrapper_boundary", "round-A_architecture_reviewer_decision_rationale": "CASSIA is a multi-agent LLM system for cell type annotation, which is a classification task, not generative. The abstract does not describe a generative mechanism or foundation model pretraining; it is an application wrapper using existing LLMs.", "pilot_roundA_scope_gate": "EXCLUDE", "pilot_roundA_architecture_gate": "EXCLUDE", "pilot_needs_adjudication": false}
