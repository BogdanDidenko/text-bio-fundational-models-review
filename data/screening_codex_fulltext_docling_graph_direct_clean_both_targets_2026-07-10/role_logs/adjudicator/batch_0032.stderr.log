dence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "none", "boundary_case": "clear_exclude", "decision_rationale": "The abstract describes learning literature-enriched embeddings from scRNA-seq data and biomedical text, but does not describe a generative architecture or output; it is a representation learning method."}, "round-A_architecture_reviewer_paper_type": "application_wrapper", "round-A_architecture_reviewer_generative_model_present": "no", "round-A_architecture_reviewer_foundation_model_evidence": "unclear", "round-A_architecture_reviewer_primary_exclusion_code": "EC3_not_generative", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "none", "round-A_architecture_reviewer_boundary_case": "clear_exclude", "round-A_architecture_reviewer_decision_rationale": "The abstract describes learning literature-enriched embeddings from scRNA-seq data and biomedical text, but does not describe a generative architecture or output; it is a representation learning method.", "pilot_roundA_scope_gate": "PASS", "pilot_roundA_architecture_gate": "EXCLUDE", "pilot_needs_adjudication": true, "round-B_adjudicator_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "yes", "text_bio_bridge_present": "yes", "generative_model_present": "no", "foundation_model_evidence": "unclear", "primary_exclusion_code": "EC3_not_generative", "uncertainty_reason": "none", "evidence_for_text_component": "pre-trained language models and biomedical literature", "evidence_for_text_bio_bridge": "jointly train language models on both information sources to learn a common representation", "evidence_for_generative_model": "none", "boundary_case": "clear_exclude", "decision_rationale": "The abstract describes joint training of language models on scRNA-seq and biomedical literature to produce embeddings, but does not mention any generative mechanism such as decoder or autoregressive generation. Therefore the generative criterion is not met, leading to exclusion under EC3."}, "round-B_adjudicator_paper_type": "primary_model_paper", "round-B_adjudicator_bio_modality_present": "yes", "round-B_adjudicator_text_component_present": "yes", "round-B_adjudicator_text_bio_bridge_present": "yes", "round-B_adjudicator_generative_model_present": "no", "round-B_adjudicator_foundation_model_evidence": "unclear", "round-B_adjudicator_primary_exclusion_code": "EC3_not_generative", "round-B_adjudicator_uncertainty_reason": "none", "round-B_adjudicator_evidence_for_text_component": "pre-trained language models and biomedical literature", "round-B_adjudicator_evidence_for_text_bio_bridge": "jointly train language models on both information sources to learn a common representation", "round-B_adjudicator_evidence_for_generative_model": "none", "round-B_adjudicator_boundary_case": "clear_exclude", "round-B_adjudicator_decision_rationale": "The abstract describes joint training of language models on scRNA-seq and biomedical literature to produce embeddings, but does not mention any generative mechanism such as decoder or autoregressive generation. Therefore the generative criterion is not met, leading to exclusion under EC3."}
./analysis/screening_run_artifacts_after_prompt_update_20260511/prompt_iteration_runs/prompt_iter2_wrapper_relax_highsignal25_deepseekv4_3gpu_11472_20260509T131343Z/guideline_pilot_raw_completed.jsonl:20:{"cluster_id": "1349", "title": "GALAX: Graph-Augmented Language Model for Explainable Reinforcement-Guided Subgraph Reasoning in Precision Medicine", "abstract": "In precision medicine, quantitative multi-omic features, topological context, and textual biological knowledge play vital roles in identifying disease-critical signaling pathways and targets. Existing pipelines capture only part of these-numerical omics ignore topological context, text-centric LLMs lack quantitative grounded reasoning, and graph-only models underuse node semantics and the generalization of LLMs-limiting mechanistic interpretability. Although Process Reward Models (PRMs) aim to guide reasoning in LLMs, they remain limited by unreliable intermediate evaluation, and vulnerability to reward hacking with computational cost. These gaps motivate integrating quantitative multi-omic signals, topological structure with node annotations, and literature-scale text via LLMs, using subgraph reasoning as the principle bridge linking numeric evidence, topological knowledge and language context. Therefore, we propose GALAX (Graph Augmented LAnguage model with eXplainability), an innovative framework that integrates pretrained Graph Neural Networks (GNNs) into Large Language Models (LLMs) via reinforcement learning guided by a Graph Process Reward Model (GPRM), which generates disease-relevant subgraphs in a step-wise manner initiated by an LLM and iteratively evaluated by a pretrained GNN and schema-based rule check, enabling process-level supervision without explicit labels. As an application, we also introduced Target-QA, a benchmark combining CRISPR-identified targets, multi-omic profiles, and biomedical graph knowledge across diverse cancer cell lines, which enables GNN pretraining for supervising step-wise graph construction and supports long-context reasoning over text-numeric graphs (TNGs), providing a scalable and biologically grounded framework for explainable, reinforcement-guided subgraph reasoning toward reliable and interpretable target discovery in precision medicine.", "regression_group": "include_decision_unstable", "decision_run_a": "EXCLUDE", "decision_run_b": "INCLUDE", "scope_boundary_run_a": NaN, "scope_boundary_run_b": NaN, "rationale_run_a": "The abstract proposes GALAX, a novel framework integrating GNNs into LLMs for subgraph reasoning, using multi-omic data, topological context, and textual biological knowledge, with explicit text-bio bridge. | The abstract describes a framework for subgraph reasoning using LLMs and GNNs, but the generative output is subgraphs, not text; no evidence of a generative text architecture or foundation-model characteristics for the proposed model.", "rationale_run_b": "The abstract proposes GALAX, a novel framework integrating pretrained GNNs into LLMs, clearly describing a new generative model (LLM) for subgraph reasoning, not a wrapper or review. Despite the architecture reviewer's uncertainty, the evidence supports primary model paper and generative status.", "_pilot_row_id": 21, "round-A_scope_reviewer_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "yes", "text_bio_bridge_present": "yes", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "textual biological knowledge, literature-scale text via LLMs", "evidence_for_text_bio_bridge": "subgraph reasoning as the principle bridge linking numeric evidence, topological knowledge and language context", "evidence_for_generative_model": "not_assessed", "boundary_case": "clear_include", "decision_rationale": "The abstract presents GALAX as a novel framework integrating GNNs into LLMs for subgraph reasoning, explicitly using textual biological knowledge and multi-omic da