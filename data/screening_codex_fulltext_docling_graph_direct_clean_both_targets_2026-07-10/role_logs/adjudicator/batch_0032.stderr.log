evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "none", "round-A_architecture_reviewer_boundary_case": "thin_abstract_boundary", "round-A_architecture_reviewer_decision_rationale": "Abstract describes an LLM framework for multimodal data integration but does not specify generative mechanism, architecture, or pretraining details. Insufficient evidence to determine if it is a primary generative model or an application wrapper.", "pilot_roundA_scope_gate": "UNCERTAIN", "pilot_roundA_architecture_gate": "UNCERTAIN", "pilot_needs_adjudication": true, "round-B_adjudicator_output": {"paper_type": "unclear", "bio_modality_present": "yes", "text_component_present": "unclear", "text_bio_bridge_present": "unclear", "generative_model_present": "unclear", "foundation_model_evidence": "yes", "primary_exclusion_code": "none", "uncertainty_reason": "mixed_signals", "evidence_for_text_component": "large language model (LLM) framework", "evidence_for_text_bio_bridge": "integrate and analyze multimodal data", "evidence_for_generative_model": "none", "boundary_case": "thin_abstract_boundary", "decision_rationale": "The abstract is too thin to determine paper type, text component, text-bio bridge, or generative status. Only bio modality is clear from title. Both reviewers noted mixed signals and uncertainty."}, "round-B_adjudicator_paper_type": "unclear", "round-B_adjudicator_bio_modality_present": "yes", "round-B_adjudicator_text_component_present": "unclear", "round-B_adjudicator_text_bio_bridge_present": "unclear", "round-B_adjudicator_generative_model_present": "unclear", "round-B_adjudicator_foundation_model_evidence": "yes", "round-B_adjudicator_primary_exclusion_code": "none", "round-B_adjudicator_uncertainty_reason": "mixed_signals", "round-B_adjudicator_evidence_for_text_component": "large language model (LLM) framework", "round-B_adjudicator_evidence_for_text_bio_bridge": "integrate and analyze multimodal data", "round-B_adjudicator_evidence_for_generative_model": "none", "round-B_adjudicator_boundary_case": "thin_abstract_boundary", "round-B_adjudicator_decision_rationale": "The abstract is too thin to determine paper type, text component, text-bio bridge, or generative status. Only bio modality is clear from title. Both reviewers noted mixed signals and uncertainty."}
./analysis/screening_run_artifacts_after_prompt_update_20260511/prompt_iteration_runs/prompt_iter2_wrapper_relax_highsignal25_deepseekv4_3gpu_11472_20260509T131343Z/guideline_pilot_raw_completed.jsonl:18:{"cluster_id": "1245", "title": "CoC: Chain-of-Cancer Based on Cross-Modal Autoregressive Traction for Survival Prediction", "abstract": "Survival prediction aims to evaluate the risk level of cancer patients. Existing methods primarily rely on pathology and genomics data, either individually or in combination. From the perspective of cancer pathogenesis, epigenetic changes, such as methylation data, could also be crucial for this task. Furthermore, no previous endeavors have utilized textual descriptions to guide the prediction. To this end, we are the first to explore the use of four modalities, including three clinical modalities and language, for conducting survival prediction. In detail, we are motivated by the Chain-of-Thought (CoT) to propose the Chain-of-Cancer (CoC) framework, focusing on intra-learning and inter-learning. We encode the clinical data as the raw features, which remain domain-specific knowledge for intra-learning. In terms of inter-learning, we use language to prompt the raw features and introduce an Autoregressive Mutual Traction module for synergistic representation. This tailored framework facilitates joint learning among multiple modalities. Our approach is evaluated across five public cancer datasets, and extensive experiments validate the effectiveness of our methods and proposed designs, leading to producing state-of-the-art  results. Codes will be released ( https://github.com/haipengzhou856/CoC ).", "regression_group": "include_decision_unstable", "decision_run_a": "INCLUDE", "decision_run_b": "EXCLUDE", "scope_boundary_run_a": NaN, "scope_boundary_run_b": NaN, "rationale_run_a": "The abstract describes a novel framework (CoC) that integrates clinical biological modalities with language (textual descriptions) for survival prediction, indicating a primary model with a substantive text-bio bridge. | The abstract describes an autoregressive module for cross-modal representation, which is a generative mechanism. No evidence of broad pretraining or transferable representations.", "rationale_run_b": "The abstract describes a survival prediction model that uses language as an input modality, but the task is discriminative (risk level prediction) with no mention of generating text, so it is not a generative model. The paper is a primary model paper, not a wrapper or review.", "_pilot_row_id": 20, "round-A_scope_reviewer_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "yes", "text_bio_bridge_present": "yes", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "utilized textual descriptions to guide the prediction", "evidence_for_text_bio_bridge": "use language to prompt the raw features", "evidence_for_generative_model": "not_assessed", "boundary_case": "clear_exclude", "decision_rationale": "The paper presents a survival prediction model using language as a modality, but does not describe any generative capability; it is a predictive model, not a generative text-bio foundational model."}, "round-A_scope_reviewer_paper_type": "primary_model_paper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "yes", "round-A_scope_reviewer_text_bio_bridge_present": "yes", "round-A_scope_reviewer_primary_exclusion_code": "none", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "utilized textual descriptions to guide the prediction", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "use language to prompt the raw features", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "clear_exclude", "round-A_scope_reviewer_decision_rationale": "The paper presents a survival prediction model using language as a modality, but does not describe any generative capability; it is a predictive model, not a generative text-bio foundational model.", "round-A_architecture_reviewer_output": {"paper_type": "primary_model_paper", "generative_model_present": "no", "foundation_model_evidence": "no", "primary_exclusion_code": "EC3_not_generative", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "none", "boundary_case": "clear_exclude", "decision_rationale": "The abstract focuses on survival prediction (risk level) using clinical and language modalities with an autoregressive module for representation, not for generating text or biological outputs. No foundation model characteristics are mentioned."}, "round-A_architecture_reviewer_paper_type": "primary_model_paper", "round-A_architecture_reviewer_generative_model_present": "no", "round-A_architecture_reviewer_foundation_model_evidence": "no", "round-A_architecture_reviewer_primary_exclusion_code": "EC3_not_generative", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "none", "round-A_architecture_reviewer_boundary_case": "clear_exclude", "round-A_architecture_reviewer_decision_rationale": "The abstract focuses on survival prediction (risk level) using clinical and language modalities with an autoregressive module for representation, not for generating text or biological outputs. No foundation model characteristics are mentioned.", "pilot_roundA_scope_gate": "PASS", "pilot_roundA_architecture_gate": "EXCLUDE", "pilot_needs_adjudication": false}
./analysis/screening_run_artifacts_after_prompt_update_20260511/prompt_iteration_runs/prompt_iter2_wrapper_relax_highsignal25_deepseekv4_3gpu_11472_20260509T131343Z/guideline_pilot_raw_completed.jsonl:19:{"cluster_id": "2378", "title": "Adding layers of information to scRNA-seq data using pre-trained language models", "abstract": "Abstract\n                Pre-trained language models promise to enrich analyses of single-cell data with additional layers of information leveraging large text corpora. Yet, it is still unclear how to achieve optimal alignment with the primary quantitative single-cell data. To address this, we construct text-based training datasets from both scRNA-seq data and biomedical literature targeted to the experimental setting at hand. We then jointly train language models on both information sources to learn a common, literature-enriched representation. Our examples on functionality, disease associations, and temporal trajectories show the potential of knowledge-augmented embeddings as a generalizable and interpretable strategy for enriching single-cell analysis pipelines.", "regression_group": "include_decision_unstable", "decision_run_a": "UNCERTAIN", "decision_run_b": "INCLUDE", "scope_boundary_run_a": NaN, "scope_boundary_run_b": NaN, "rationale_run_a": "Abstract describes jointly training language models on scRNA-seq and biomedical literature, indicating a primary model paper with bio and text components and a bridge. However, it does not explicitly state the model is generative (e.g., masked LMs are not generative), so generative status is unclear.", "rationale_run_b": "The abstract describes constructing datasets and jointly training language models on scRNA-seq and biomedical literature, which constitutes a primary model contribution rather than a wrapper application. Language models are inherently generative, and the training explicitly bridges text and biological data, satisfying all inclusion criteria.", "_pilot_row_id": 15, "round-A_s