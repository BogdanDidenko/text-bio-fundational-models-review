./analysis/screening_run_artifacts_after_prompt_update_20260511/prompt_iteration_runs/prompt_iter2_wrapper_relax_highsignal25_deepseekv4_3gpu_11472_20260509T131343Z/guideline_pilot_raw_completed.jsonl:1:{"cluster_id": "benchmark:10", "title": "CellPLM: Pre-training of Cell Language Model Beyond Single Cells", "abstract": "The current state-of-the-art single-cell pre-trained models are greatly inspired by the success of large language models. They trained transformers by treating genes as tokens and cells as sentences. However, three fundamental differences between single-cell data and natural language data are overlooked: (1) scRNA-seq data are presented as bag-of-genes instead of sequences of RNAs; (2) Cell-cell relations are more intricate and important than inter-sentence relations; and (3) The quantity of single-cell data is considerably inferior to text data, and they are very noisy. In light of these characteristics, we propose a new pre-trained model CellPLM , which takes cells as tokens and tissues as sentences. In addition, we leverage spatially-resolved transcriptomic data in pre-training to facilitate learning cell-cell relationships and introduce a Gaussian mixture prior distribution as an additional inductive bias to overcome data limitation. CellPLM is the first single-cell pre-trained transformer that encodes cell-cell relations and it consistently outperforms existing pre-trained and non-pre-trained models in diverse downstream tasks, with 100x times higher inference speed compared to existing pre-trained models.", "regression_group": "benchmark_boundary_case", "decision_run_a": NaN, "decision_run_b": NaN, "scope_boundary_run_a": NaN, "scope_boundary_run_b": NaN, "rationale_run_a": NaN, "rationale_run_b": NaN, "_pilot_row_id": 0, "round-A_scope_reviewer_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "no", "text_bio_bridge_present": "no", "primary_exclusion_code": "EC2_no_text_component", "uncer