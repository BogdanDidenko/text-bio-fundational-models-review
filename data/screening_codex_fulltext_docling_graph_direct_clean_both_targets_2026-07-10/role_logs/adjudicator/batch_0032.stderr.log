./analysis/screening_run_artifacts_after_prompt_update_20260511/prompt_iteration_runs/prompt_iter2_wrapper_relax_highsignal25_deepseekv4_3gpu_11472_20260509T131343Z/guideline_pilot_raw_completed.csv:1:cluster_id,title,abstract,regression_group,decision_run_a,decision_run_b,scope_boundary_run_a,scope_boundary_run_b,rationale_run_a,rationale_run_b,_pilot_row_id,round-A_scope_reviewer_output,round-A_scope_reviewer_paper_type,round-A_scope_reviewer_bio_modality_present,round-A_scope_reviewer_text_component_present,round-A_scope_reviewer_text_bio_bridge_present,round-A_scope_reviewer_primary_exclusion_code,round-A_scope_reviewer_uncertainty_reason,round-A_scope_reviewer_evidence_for_text_component,round-A_scope_reviewer_evidence_for_text_bio_bridge,round-A_scope_reviewer_evidence_for_generative_model,round-A_scope_reviewer_boundary_case,round-A_scope_reviewer_decision_rationale,round-A_architecture_reviewer_output,round-A_architecture_reviewer_paper_type,round-A_architecture_reviewer_generative_model_present,round-A_architecture_reviewer_foundation_model_evidence,round-A_architecture_reviewer_primary_exclusion_code,round-A_architecture_reviewer_uncertainty_reason,round-A_architecture_reviewer_evidence_for_text_component,round-A_architecture_reviewer_evidence_for_text_bio_bridge,round-A_architecture_reviewer_evidence_for_generative_model,round-A_architecture_reviewer_boundary_case,round-A_architecture_reviewer_decision_rationale,pilot_roundA_scope_gate,pilot_roundA_architecture_gate,pilot_needs_adjudication,round-B_adjudicator_output,round-B_adjudicator_paper_type,round-B_adjudicator_bio_modality_present,round-B_adjudicator_text_component_present,round-B_adjudicator_text_bio_bridge_present,round-B_adjudicator_generative_model_present,round-B_adjudicator_foundation_model_evidence,round-B_adjudicator_primary_exclusion_code,round-B_adjudicator_uncertainty_reason,round-B_adjudicator_evidence_for_text_component,round-B_adjudicator_evidence_for_text_bio_bridge,round-B_adjudicat