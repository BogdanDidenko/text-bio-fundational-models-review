./data/fulltext_screening_context_2026-07-10_docling_graph_direct_all235_clean/fulltext_screening_input.jsonl:27:{"record_id": "full_2026-07-06__rec_003466", "candidate_id": "full_2026-07-06__rec_003466", "source_record_id": "rec_003466", "source_corpus": "include", "title": "ELISA: An Interpretable Hybrid Generative AI Agent for Expression-Grounded Discovery in Single-Cell Genomics", "abstract": "Translating single-cell RNA sequencing (scRNA-seq) data into mechanistic biological hypotheses remains a critical bottleneck, as agentic AI systems lack direct access to transcriptomic representations while expression foundation models remain opaque to natural language. Here we introduce ELISA (Embedding-Linked Interactive Single-cell Agent), an interpretable framework that unifies scGPT expression embeddings with BioBERT-based semantic retrieval and LLM-mediated interpretation for interactive single-cell discovery. An automatic query classifier routes inputs to gene marker scoring, semantic matching, or reciprocal rank fusion pipelines depending on whether the query is a gene signature, natural language concept, or mixture of both. Integrated analytical modules perform pathway activity scoringacross 60+ gene sets, ligand-receptor interaction prediction using 280+ curated pairs, condition-aware comparative analysis, and cell-type proportion estimation all operating directly on embedded data without access to the original count matrix. Benchmarked across six diverse scRNA-seq datasets spanning inflammatory lung disease, pediatric and adult cancers, organoid models, healthy tissue, and neurodevelopment, ELISA significantly outperforms CellWhisperer in cell type retrieval (combined permutation test, p &lt; 0 . 001 ), with particularly large gains on gene-signature queries (Cohen's d = 5 . 98 for MRR). [truncated]", "doi": "", "year": "", "venue": "", "sources": [], "selected_full_text_sections": "[data_source: 2 Materials and Methods > 2.1 Datasets]\nELISA was validated on six publicly available scRNA-seq datasets from CZ CELLxGENE Discover (Table 5), spanning lung (cystic fibrosis)Berg et al. [2025], adrenal tumor (neuroblastoma)Yu et al. [2025], multi-cancer immune checkpoint blockadeGondal et al. [2025], lung organoid Lim et al. [2025], healthy breast tissueBhat-Nakshatri et al. [2024], and first-trimester brainMannens et al. [2025]. Datasets were downloaded in AnnData format and preprocessed into a standardized embedding format. Cell type annotations from the original publications were retained without modification.\n\n[input_representation: 2 Materials and Methods > 2.2 System architecture]\nELISA integrates four modules a hybrid retrieval engine, an analytical suite, a visualization toolkit, and an LLM chat interface operating on a shared serialized PyTorch embedding file per dataset. Each embedding file stores cluster identifiers, BioBERT semantic embeddings (768-d), optional scGPT expression embeddings, per-cluster differential expression statistics, gene ontology (GO) and Reactome enrichment terms, and metadata. This cluster-level representation eliminates the need for access to the original count matrix at query time.", "section_evidence": [{"section_type": "data_source", "heading": "2.1 Datasets", "heading_path": ["2 Materials and Methods", "2.1 Datasets"], "heading_path_text": "2 Materials and Methods > 2.1 Datasets", "heading_level": 3, "line_start": 69, "line_end": 72, "text": "ELISA was validated on six publicly available scRNA-seq datasets from CZ CELLxGENE Discover (Table 5), spanning lung (cystic fibrosis)Berg et al. [2025], adrenal tumor (neuroblastoma)Yu et al. [2025], multi-cancer immune checkpoint blockadeGondal et al. [2025], lung organoid Lim et al. [2025], healthy breast tissueBhat-Nakshatri et al. [2024], and first-trimester brainMannens et al. [2025]. Datasets were downloaded in AnnData format and preprocessed into a standardized embedding format. Cell type annotations from the original publications were retained without modification.", "original_chars": 580, "evidence_quote": "ELISA was validated on six publicly available scRNA-seq datasets from CZ CELLxGENE Discover (Table 5)", "evidence_section_heading": "2.1 Datasets", "contains_evidence_quote": true, "contains_chunk_excerpt": true, "chunk_id": 10, "pages": [4], "doc_item_refs": ["#/texts/35"], "docling_graph_node_id": "DataSourceEvidence_d1568ca541d53803", "docling_graph_provenance": {"document_id": "4c33c0dfaf5366a3827667834163f047", "match": "verbatim", "chunks": [10], "pages": [4], "refs": ["#/texts/35"], "spans": [{"chunk": 10, "start": 60, "end": 128}]}, "grounding_source": "docling_graph_provenance", "match_type": "verbatim", "source_markdown": "data/docling_include_no_vlm_2026-07-09/markdown/full_2026_07_06_rec_003466.md", "derivation_source": "docling_markdown_heading_boundary_from_docling_graph_heading_path", "section_coverage_ratio": 0.003805, "root_container": false, "full_document_like": false, "target_section_types": ["data_source"]}, {"section_type": "input_representation", "heading": "2.2 System architecture", "heading_path": ["2 Materials and Methods", "2.2 System architecture"], "heading_path_text": "2 Materials and Methods > 2.2 System architecture", "heading_level": 3, "line_start": 73, "line_end": 76, "text": "ELISA integrates four modules a hybrid retrieval engine, an analytical suite, a visualization toolkit, and an LLM chat interface operating on a shared serialized PyTorch embedding file per dataset. Each embedding file stores cluster identifiers, BioBERT semantic embeddings (768-d), optional scGPT expression embeddings, per-cluster differential expression statistics, gene ontology (GO) and Reactome enrichment terms, and metadata. This cluster-level representation eliminates the need for access to the original count matrix at query time.", "original_chars": 541, "evidence_quote": "Each embedding file stores cluster identifiers, BioBERT semantic embeddings (768-d), optional scGPT expression embeddings, per-cluster differential expression statistics, gene ontology (GO) and Reactome enrichment terms, and metadata.", "evidence_section_heading": "2.2 System architecture", "contains_evidence_quote": true, "contains_chunk_excerpt": true, "chunk_id": 11, "pages": [4], "doc_item_refs": ["#/texts/37"], "docling_graph_node_id": "InputRepresentationEvidence_48f757c7c11e8aad", "docling_graph_provenance": {"document_id": "4c33c0dfaf5366a3827667834163f047", "match": "verbatim", "chunks": [11], "pages": [4], "refs": ["#/texts/37"], "spans": [{"chunk": 11, "start": 246, "end": 480}]}, "grounding_source": "docling_graph_provenance", "match_type": "verbatim", "source_markdown": "data/docling_include_no_vlm_2026-07-09/markdown/full_2026_07_06_rec_003466.md", "derivation_source": "docling_markdown_heading_boundary_from_docling_graph_heading_path", "section_coverage_ratio": 0.003549, "root_container": false, "full_document_like": false, "target_section_types": ["input_representation"]}], "section_selection_audit": {"method": "Graph provenance alternatives + full-document rejection + section deduplication", "markdown_chars": 152416, "markdown_heading_count": 77, "missing_targets": [], "rejected_sections": []}, "docling_markdown": "data/docling_include_no_vlm_2026-07-09/markdown/full_2026_07_06_rec_003466.md", "docling_status": "docling_ok", "docling_graph_evidence_summary": "data/docling_graph_screening_evidence_full_2026-07-10_gpt54mini_direct_nolimits_16shards/shard_01/full_2026-07-06__rec_003466/screening_evidence_summary.json", "docling_graph_extraction_contract": "direct", "docling_graph_model": "gpt-5.4-mini", "docling_graph_provenance_path": "data/docling_graph_screening_evidence_full_2026-07-10_gpt54mini_direct_nolimits_16shards/shard_01/full_2026-07-06__rec_003466/full_2026_07_06_rec_003466_docling_json_20260710_023158/docling_graph/provenance.json", "docling_graph_provenance_bind_stats": {"nodes_seen": 3, "bound_verbatim": 3, "bound_observed": 0, "bound_document": 0