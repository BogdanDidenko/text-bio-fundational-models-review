./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/deepseek_v4_review_pipeline_all4027_current_rep2_watchdog_20260510T013948Z/job_11532/guideline_pilot_raw_completed.jsonl:442:{"cluster_id": 3659, "title": "ELISA: An Interpretable Hybrid Generative AI Agent for Expression-Grounded Discovery in Single-Cell Genomics", "title_normalized": "elisa an interpretable hybrid generative ai agent for expressiongrounded discovery in singlecell genomics", "doi": NaN, "preprint_doi": NaN, "pmid": NaN, "arxiv_id": "2603.11872", "abstract": "Translating single-cell RNA sequencing (scRNA-seq) data into mechanistic biological hypotheses remains a critical bottleneck, as agentic AI systems lack direct access to transcriptomic representations while expression foundation models remain opaque to natural language. Here we introduce ELISA (Embedding-Linked Interactive Single-cell Agent), an interpretable framework that unifies scGPT expression embeddings with BioBERT-based semantic retrieval and LLM-mediated interpretation for interactive single-cell discovery. An automatic query classifier routes inputs to gene marker scoring, semantic matching, or reciprocal rank fusion pipelines depending on whether the query is a gene signature, natural language concept, or mixture of both. Integrated analytical modules perform pathway activity scoringacross 60+ gene sets, ligand--receptor interaction prediction using 280+ curated pairs, condition-aware comparative analysis, and cell-type proportion estimation all operating directly on embedded data without access to the original count matrix. Benchmarked across six diverse scRNA-seq datasets spanning inflammatory lung disease, pediatric and adult cancers, organoid models, healthy tissue, and neurodevelopment, ELISA significantly outperforms CellWhisperer in cell type retrieval (combined permutation test, $p < 0.001$), with particularly large gains on gene-signature queries (Cohen's $d = 5.98$ for MRR). ELISA replicates published biological findings (mean composite score 0.90) with near-perfect pathway alignment and theme coverage (0.98 each), and generates candidate hypotheses through grounded LLM reasoning, bridging the gap between transcriptomic data exploration and biological discovery. Code available at: https://github.com/omaruno/ELISA-An-AI-Agent-for-Expression-Grounded-Discovery-in-Single-Cell-Genomics.git (If you use ELISA in your research, please cite this work).", "authors": "Omar Coser", "year": 2026.0, "venue": NaN, "date": "2026-03-12", "url": NaN, "sources": "['arxiv', 'google_scholar', 'semantic_scholar']", "n_sources": 3, "all_dois": "[]", "duplicate_count": 3, "abstract_source": NaN, "abstract_enriched_from": NaN, "abstract_old_len": NaN, "update_batch": "2026-03-01_to_2026-04-14", "_pilot_row_id": 404, "round-A_scope_reviewer_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "yes", "text_bio_bridge_present": "yes", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "natural language concept, BioBERT-based semantic retrieval, LLM-mediated interpretation, generates candidate hypotheses through grounded LLM reasoning", "evidence_for_text_bio_bridge": "translating scRNA-seq data into mechanistic biological hypotheses, bridging the gap between transcriptomic data exploration and biological discovery", "evidence_for_generative_model": "not_assessed", "boundary_case": "clear_include", "decision_rationale": "ELISA is a new framework that uses natural language queries and LLM reasoning to interpret single-cell transcriptomic data, satisfying all criteria for a primary text-bio model."}, "round-A_scope_reviewer_paper_type": "primary_model_paper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "yes", "round-A_scope_reviewer_text_bio_bridge_present": "yes", "round-A_scope_reviewer_primary_exclusion_code": "none", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "natural language concept, BioBERT-based semantic retrieval, LLM-mediated interpretation, generates candidate hypotheses through grounded LLM reasoning", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "translating scRNA-seq data into mechanistic biological hypotheses, bridging the gap between transcriptomic data exploration and biological discovery", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "clear_include", "round-A_scope_reviewer_decision_rationale": "ELISA is a new framework that uses natural language queries and LLM reasoning to interpret single-cell transcriptomic data, satisfying all criteria for a primary text-bio model.", "round-A_architecture_reviewer_output": {"paper_type": "application_wrapper", "generative_model_present": "no", "foundation_model_evidence": "no", "primary_exclusion_code": "application_wrapper", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "generates candidate hypotheses through grounded LLM reasoning", "boundary_case": "wrapper_boundary", "decision_rationale": "ELISA is an agentic framework combining scGPT embeddings, BioBERT retrieval, and LLM interpretation; it does not introduce a new generative model, and its generative capability is from an external LLM, making it an application wrapper."}, "round-A_architecture_reviewer_paper_type": "application_wrapper", "round-A_architecture_reviewer_generative_model_present": "no", "round-A_architecture_reviewer_foundation_model_evidence": "no", "round-A_architecture_reviewer_primary_exclusion_code": "application_wrapper", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "generates candidate hypotheses through grounded LLM reasoning", "round-A_architecture_reviewer_boundary_case": "wrapper_boundary", "round-A_architecture_reviewer_decision_rationale": "ELISA is an agentic framework combining scGPT embeddings, BioBERT retrieval, and LLM interpretation; it does not introduce a new generative model, and its generative capability is from an external LLM, making it an application wrapper.", "pilot_roundA_scope_gate": "PASS", "pilot_roundA_architecture_gate": "EXCLUDE", "pilot_needs_adjudication": true, "round-B_adjudicator_output": {"paper_type": "application_wrapper", "bio_modality_present": "yes", "text_component_present": "yes", "text_bio_bridge_present": "yes", "generative_model_present": "no", "foundation_model_evidence": "no", "primary_exclusion_code": "application_wrapper", "uncertainty_reason": "none", "evidence_for_text_component": "natural language concept", "evidence_for_text_bio_bridge": "LLM-mediated interpretation for interactive single-cell discovery", "evidence_for_generative_model": "generates candidate hypotheses through grounded LLM reasoning", "boundary_case": "wrapper_boundary", "decision_rationale": "ELISA is presented as an agentic framework combining existing models (scGPT, BioBERT, LLM) for query-driven analysis, not as a new generative foundation model, making it an application wrapper."}, "round-B_adjudicator_paper_type": "application_wrapper", "round-B_adjudicator_bio_modality_present": "yes", "round-B_adjudicator_text_component_present": "yes", "round-B_adjudicator_text_bio_bridge_present": "yes", "round-B_adjudicator_generative_model_present": "no", "round-B_adjudicator_foundation_model_evidence": "no", "round-B_adjudicator_primary_exclusion_code": "application_wrapper", "round-B_adjudicator_uncertainty_reason": "none", "round-B_adjudicator_evidence_for_text_component": "natural language concept", "round-B_adjudicator_evidence_for_text_bio_bridge": "LLM-mediated interpretation for interactive single-cell discovery", "round-B_adjudicator_evidence_for_generative_model": "generates candidate hypotheses through grounded LLM reasoning", "round-B_adjudicator_boundary_case": "wrapper_boundary", "round-B_adjudicator_decision_rationale": "ELISA is presented as an agentic framework combining existing models (scGPT, BioBERT, LLM) for query-driven analysis, not as a new generative foundation model, making it an application wrapper."}
./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/deepseek_v4_review_pipeline_all4027_current_rep2_watchdog_20260510T013948Z/job_11532/guideline_pilot_raw_completed.csv:983:3659,ELISA: An Interpretable Hybrid Generative AI Agent for Expression-Grounded Discovery in Single-Cell Genomics,elisa an interpretable hybrid generative ai agent for expressiongrounded discovery in singlecell genomics,,,,2603.11872,"Translating single-cell RNA sequencing (scRNA-seq) data into mechanistic biological hypotheses remains a critical bottleneck, as agentic AI systems lack direct access to transcriptomic representations while expression foundation models remain opaque to natural language. Here we introduce ELISA (Embedding-Linked Interactive Single-cell Agent), an interpretable framework that unifies scGPT expression embeddings with BioBERT-based semantic retrieval and LLM-mediated interpretation for interactive single-cell discovery. An automatic query classifier routes inputs to gene marker scoring, semantic matching, or reciprocal rank fusion pipelines depending on whether the query is a gene signature, natural language concept, or mixture of both. Integrated analytical modules perform pathway activity scoringacross 60+ gene sets, ligand--receptor interaction prediction using 280+ curated pairs, condition-aware comparative analysis, and cell-type proportion estimation all operating directly on embedded data without access to the original count matrix. Benchmarked across six diverse scRNA-seq datasets spanning inflammatory lung disease, pediatric and adult cancers, organoid models, healthy tissue, and neurodevelopment, ELISA significantly outperforms CellWhisperer in cell type retrieval (combined permutation test, $p < 0.001$), with particularly large gains on gene-signature queries (Cohen's $d = 5.98$ for MRR). ELISA replicates published biological findings (mean composite score 0.90) with near-perfect pathway alignment and theme coverage (0.98 each), and generates candidate hypotheses through grounded LLM reasoning, bridging the gap between transcriptomic data exploration and biological discovery. Code available at: https://github.com/omaruno/ELISA-An-AI-Agent-for-Expression-Grounded-Discovery-in-Single-Cell-Genomics.git (If you use ELISA in your research, please cite this work).",Omar Coser,2026.0,,2026-03-12,,"['arxiv', 'google_scholar', 'semantic_scholar']",3,[],3,,,,2026-03-01_to_2026-04-14,404,"{""paper_type"": ""primary_model_paper"", ""bio_modality_present"": ""yes"", ""text_component_present"": ""yes"", ""text_bio_bridge_present"": ""yes"", ""primary_exclusion_code"": ""none"", ""uncertainty_reason"": ""none"", ""evidence_for_text_component"": ""natural language concept, BioBERT-based semantic retrieval, LLM-mediated interpretation, generates candidate hypotheses through grounded LLM reasoning"", ""evidence_for_text_bio_bridge"": ""translating scRNA-seq data into mechanistic biological hypotheses, bridging the gap between transcriptomic data exploration and biological discovery"", ""evidence_for_generative_model"": ""not_assessed"", ""boundary_case"": ""clear_include"", ""decision_rationale"": ""ELISA is a new framework that uses natural language queries and LLM reasoning to interpret single-cell transcriptomic data, satisfying all criteria for a primary text-bio model.""}",primary_model_paper,yes,yes,yes,none,none,"natural language concept, BioBERT-based semantic retrieval, LLM-mediated interpretation, generates candidate hypotheses through grounded LLM reasoning","translating scRNA-seq data into mechanistic biological hypotheses, bridging the gap between transcriptomic data exploration and biological discovery",not_assessed,clear_include,"ELISA is a new framework that uses natural language queries and LLM reasoning to interpret single-cell transcriptomic data, satisfying all criteria for a primary text-bio model.","{""paper_type"": ""application_wrapper"", ""generative_model_present"": ""no"", ""foundation_model_evidence"": ""no"", ""primary_exclusion_code"": ""application_wrapper"", ""uncertainty_reason"": ""none"", ""evidence_for_text_component"": ""not_assessed"", ""evidence_for_text_bio_bridge"": ""not_assessed"", ""evidence_for_generative_model"": ""generates candidate hypotheses through grounded LLM reasoning"", ""boundary_case"": ""wrapper_boundary"", ""decision_rationale"": ""ELISA is an agentic framework combining scGPT embeddings, BioBERT retrieval, and LLM interpretation; it does not introduce a new generative model, and its generative capability is from an external LLM, making it an application wrapper.""}",application_wrapper,no,no,application_wrapper,none,not_assessed,not_assessed,generates candidate hypotheses through grounded LLM reasoning,wrapper_boundary,"ELISA is an agentic framework combining scGPT embeddings, BioBERT retrieval, and LLM interpretation; it does not introduce a new generative model, and its generative capability is from an external LLM, making it an application wrapper.",PASS,EXCLUDE,True,"{""paper_type"": ""application_wrapper"", ""bio_modality_present"": ""yes"", ""text_component_present"": ""yes"", ""text_bio_bridge_present"": ""yes"", ""generative_model_present"": ""no"", ""foundation_model_evidence"": ""no"", ""primary_exclusion_code"": ""application_wrapper"", ""uncertainty_reason"": ""none"", ""evidence_for_text_component"": ""natural language concept"", ""evidence_for_text_bio_bridge"": ""LLM-mediated interpretation for interactive single-cell discovery"", ""evidence_for_generative_model"": ""generates candidate hypotheses through grounded LLM reasoning"", ""boundary_case"": ""wrapper_boundary"", ""decision_rationale"": ""ELISA is presented as an agentic framework combining existing models (scGPT, BioBERT, LLM) for query-driven analysis, not as a new generative foundation model, making it an application wrapper.""}",application_wrapper,yes,yes,yes,no,no,application_wrapper,none,natural language concept,LLM-mediated interpretation for interactive single-cell discovery,generates candidate hypotheses through grounded LLM reasoning,wrapper_boundary,"ELISA is presented as an agentic framework combining existing models (scGPT, BioBERT, LLM) for query-driven analysis, not as a new generative foundation model, making it an application wrapper."
