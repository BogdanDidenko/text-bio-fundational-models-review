t":true,"chunk_id":11,"pages":[4],"doc_item_refs":["#/texts/37"],"docling_graph_node_id":"InputRepresentationEvidence_48f757c7c11e8aad","docling_graph_provenance":{"document_id":"4c33c0dfaf5366a3827667834163f047","match":"verbatim","chunks":[11],"pages":[4],"refs":["#/texts/37"],"spans":[{"chunk":11,"start":246,"end":480}]},"grounding_source":"docling_graph_provenance","match_type":"verbatim","source_markdown":"data/docling_include_no_vlm_2026-07-09/markdown/full_2026_07_06_rec_003466.md","derivation_source":"docling_markdown_heading_boundary_from_docling_graph_heading_path"}],"docling_markdown":"data/docling_include_no_vlm_2026-07-09/markdown/full_2026_07_06_rec_003466.md"}]
