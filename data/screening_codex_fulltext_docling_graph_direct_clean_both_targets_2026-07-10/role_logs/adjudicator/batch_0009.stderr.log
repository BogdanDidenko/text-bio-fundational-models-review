./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/gpt_oss_120b_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11561/guideline_pilot_raw_completed.jsonl:566:{"cluster_id": 3659, "title": "ELISA: An Interpretable Hybrid Generative AI Agent for Expression-Grounded Discovery in Single-Cell Genomics", "title_normalized": "elisa an interpretable hybrid generative ai agent for expressiongrounded discovery in singlecell genomics", "doi": NaN, "preprint_doi": NaN, "pmid": NaN, "arxiv_id": "2603.11872", "abstract": "Translating single-cell RNA sequencing (scRNA-seq) data into mechanistic biological hypotheses remains a critical bottleneck, as agentic AI systems lack direct access to transcriptomic representations while expression foundation models remain opaque to natural language. Here we introduce ELISA (Embedding-Linked Interactive Single-cell Agent), an interpretable framework that unifies scGPT expression embeddings with BioBERT-based semantic retrieval and LLM-mediated interpretation for interactive single-cell discovery. An automatic query classifier routes inputs to gene marker scoring, semantic matching, or reciprocal rank fusion pipelines depending on whether the query is a gene signature, natural language concept, or mixture of both. Integrated analytical modules perform pathway activity scoringacross 60+ gene sets, ligand--receptor interaction prediction using 280+ curated pairs, condition-aware comparative analysis, and cell-type proportion estimation all operating directly on embedded data without access to the original count matrix. Benchmarked across six diverse scRNA-seq datasets spanning inflammatory lung disease, pediatric and adult cancers, organoid models, healthy tissue, and neurodevelopment, ELISA significantly outperforms CellWhisperer in cell type retrieval (combined permutation test, $p < 0.001$), with particularly large gains on gene-signature queries (Cohen's $d = 5.98$ for MRR). ELISA replicates published biological findings (mean composite score 0.90) with near-perfect pathway alignment and theme coverage (0.98 each), and generates candidate hypotheses through grounded LLM reasoning, bridging the gap between transcriptomic data exploration and biological discovery. Code available at: https://github.com/omaruno/ELISA-An-AI-Agent-for-Expression-Grounded-Discovery-in-Single-Cell-Genomics.git (If you use ELISA in your research, please cite this work).", "authors": "Omar Coser", "year": 2026.0, "venue": NaN, "date": "2026-03-12", "url": NaN, "sources": "['arxiv', 'google_scholar', 'semantic_scholar']", "n_sources": 3, "all_dois": "[]", "duplicate_count": 3, "abstract_source": NaN, "abstract_enriched_from": NaN, "abstract_old_len": NaN, "update_batch": "2026-03-01_to_2026-04-14", "_pilot_row_id": 567, "round-A_scope_reviewer_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "yes", "text_bio_bridge_present": "yes", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "BioBERT-based semantic retrieval and LLM-mediated interpretation", "evidence_for_text_bio_bridge": "grounded LLM reasoning ... bridging the gap between transcriptomic data exploration and biological discovery", "evidence_for_generative_model": "not_assessed", "boundary_case": "none", "decision_rationale": "The abstract presents ELISA, a new multimodal framework that combines scRNA‑seq embeddings with BioBERT and LLM components, using natural‑language queries and LLM reasoning, indicating a primary model with both biological modality and a substantive text‑bio bridge."}, "round-A_scope_reviewer_paper_type": "primary_model_paper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "yes", "round-A_scope_reviewer_text_bio_bridge_present": "yes", "round-A_scope_reviewer_primary_exclusion_code": "none", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "BioBERT-based semantic retrieval and LLM-mediated interpretation", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "grounded LLM reasoning ... bridging the gap between transcriptomic data exploration and biological discovery", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "none", "round-A_scope_reviewer_decision_rationale": "The abstract presents ELISA, a new multimodal framework that combines scRNA‑seq embeddings with BioBERT and LLM components, using natural‑language queries and LLM reasoning, indicating a primary model with both biological modality and a substantive text‑bio bridge.", "round-A_architecture_reviewer_output": {"paper_type": "primary_model_paper", "generative_model_present": "yes", "foundation_model_evidence": "yes", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "generates candidate hypotheses through grounded LLM reasoning", "boundary_case": "none", "decision_rationale": "The abstract presents ELISA, a new hybrid agent that explicitly generates hypotheses via an LLM, indicating a generative architecture, and it incorporates scGPT and BioBERT, showing use of expression and language foundation models."}, "round-A_architecture_reviewer_paper_type": "primary_model_paper", "round-A_architecture_reviewer_generative_model_present": "yes", "round-A_architecture_reviewer_foundation_model_evidence": "yes", "round-A_architecture_reviewer_primary_exclusion_code": "none", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "generates candidate hypotheses through grounded LLM reasoning", "round-A_architecture_reviewer_boundary_case": "none", "round-A_architecture_reviewer_decision_rationale": "The abstract presents ELISA, a new hybrid agent that explicitly generates hypotheses via an LLM, indicating a generative architecture, and it incorporates scGPT and BioBERT, showing use of expression and language foundation models.", "pilot_roundA_scope_gate": "PASS", "pilot_roundA_architecture_gate": "PASS", "pilot_needs_adjudication": false}
./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/gpt_oss_120b_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11561/guideline_pilot_raw_completed.csv:1149:3659,ELISA: An Interpretable Hybrid Generative AI Agent for Expression-Grounded Discovery in Single-Cell Genomics,elisa an interpretable hybrid generative ai agent for expressiongrounded discovery in singlecell genomics,,,,2603.11872,"Translating single-cell RNA sequencing (scRNA-seq) data into mechanistic biological hypotheses remains a critical bottleneck, as agentic AI systems lack direct access to transcriptomic representations while expression foundation models remain opaque to natural language. Here we introduce ELISA (Embedding-Linked Interactive Single-cell Agent), an interpretable framework that unifies scGPT expression embeddings with BioBERT-based semantic retrieval and LLM-mediated interpretation for interactive single-cell discovery. An automatic query classifier routes inputs to gene marker scoring, semantic matching, or reciprocal rank fusion pipelines depending on whether the query is a gene signature, natural language concept, or mixture of both. Integrated analytical modules perform pathway activity scoringacross 60+ gene sets, ligand--receptor interaction prediction using 280+ curated pairs, condition-aware comparative analysis, and cell-type proportion estimation all operating directly on embedded data without access to the original count matrix. Benchmarked across six diverse scRNA-seq datasets spanning inflammatory lung disease, pediatric and adult cancers, organoid models, healthy tissue, and neurodevelopment, ELISA significantly outperforms CellWhisperer in cell type retrieval (combined permutation test, $p < 0.001$), with particularly large gains on gene-signature queries (Cohen's $d = 5.98$ for MRR). ELISA replicates published biological findings (mean composite score 0.90) with near-perfect pathway alignment and theme coverage (0.98 each), and generates candidate hypotheses through grounded LLM reasoning, bridging the gap between transcriptomic data exploration and biological discovery. Code available at: https://github.com/omaruno/ELISA-An-AI-Agent-for-Expression-Grounded-Discovery-in-Single-Cell-Genomics.git (If you use ELISA in your research, please cite this work).",Omar Coser,2026.0,,2026-03-12,,"['arxiv', 'google_scholar', 'semantic_scholar']",3,[],3,,,,2026-03-01_to_2026-04-14,567,"{""paper_type"": ""primary_model_paper"", ""bio_modality_present"": ""yes"", ""text_component_present"": ""yes"", ""text_bio_bridge_present"": ""yes"", ""primary_exclusion_code"": ""none"", ""uncertainty_reason"": ""none"", ""evidence_for_text_component"": ""BioBERT-based semantic retrieval and LLM-mediated interpretation"", ""evidence_for_text_bio_bridge"": ""grounded LLM reasoning ... bridging the gap between transcriptomic data exploration and biological discovery"", ""evidence_for_generative_model"": ""not_assessed"", ""boundary_case"": ""none"", ""decision_rationale"": ""The abstract presents ELISA, a new multimodal framework that combines scRNA‑seq embeddings with BioBERT and LLM components, using natural‑language queries and LLM reasoning, indicating a primary model with both biological modality and a substantive text‑bio bridge.""}",primary_model_paper,yes,yes,yes,none,none,BioBERT-based semantic retrieval and LLM-mediated interpretation,grounded LLM reasoning ... bridging the gap between transcriptomic data exploration and biological discovery,not_assessed,none,"The abstract presents ELISA, a new multimodal framework that combines scRNA‑seq embeddings with BioBERT and LLM components, using natural‑language queries and LLM reasoning, indicating a primary model with both biological modality and a substantive text‑bio bridge.","{""paper_type"": ""primary_model_paper"", ""generative_model_present"": ""yes"", ""foundation_model_evidence"": ""yes"", ""primary_exclusion_code"": ""none"", ""uncertainty_reason"": ""none"", ""evidence_for_text_component"": ""not_assessed"", ""evidence_for_text_bio_bridge"": ""not_assessed"", ""evidence_for_generative_model"": ""generates candidate hypotheses through grounded LLM reasoning"", ""boundary_case"": ""none"", ""decision_rationale"": ""The abstract presents ELISA, a new hybrid agent that explicitly generates hypotheses via an LLM, indicating a generative architecture, and it incorporates scGPT and BioBERT, showing use of expression and language foundation models.""}",primary_model_paper,yes,yes,none,none,not_assessed,not_assessed,generates candidate hypotheses through grounded LLM reasoning,none,"The abstract presents ELISA, a new hybrid agent that explicitly generates hypotheses via an LLM, indicating a generative architecture, and it incorporates scGPT and BioBERT, showing use of expression and language foundation models.",PASS,PASS,False,,,,,,,,,,,,,,
