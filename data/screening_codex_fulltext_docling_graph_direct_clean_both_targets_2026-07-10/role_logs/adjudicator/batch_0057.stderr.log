[{"record_id":"full_2026-07-06__rec_003578","candidate_id":"full_2026-07-06__rec_003578","source_record_id":"rec_003578","source_corpus":"uncertain","title":"Causal Circuit Tracing Reveals Distinct Computational Architectures in Single-Cell Foundation Models: Inhibitory Dominance, Biological Coherence, and Cross-Model Convergence","abstract":"Motivation: Sparse autoencoders (SAEs) decompose foundation model activations into interpretable features, but causal feature-to-feature interactions across network depth remain unknown for biological foundation models.\n\nResults: We introduce causal circuit tracing-ablating SAE features and measuring downstream responses-and apply it to Geneformer V2-316M and scGPT whole-human across four conditions (96,892 edges, 80,191 forward passes). Both models show ∼ 53% biological coherence and 65-89% inhibitory dominance, invariant to architecture and cell type. scGPT produces stronger effects (mean | d | =1 . 40 vs. 1.05) with more balanced dynamics. Cross-model consensus yields 1,142 conserved domain pairs (10.6 × enrichment, p &lt; 0 . 001 ). Disease-associated domains are 3.59 × more likely to be consensus. Gene-level CRISPRi validation shows 56.4% directional accuracy, confirming co-expression rather than causal encoding.\n\nAvailability and implementation: https://github.com/Biodyn-AI/bio-sae-circuits (Python). Companion SAE atlases: https://github.com/Biodyn-AI/bio-sae .\n\nContact:\n\nkendiukhov@gmail.com\n\nSupplementary information: Supplementary data are available at Bioinformatics online.\n\nKeywords: mechanistic interpretability, sparse autoencoders, single-cell foundation models, causal circuit tracing, Geneformer, scGPT","doi":"10.48550/arXiv.2603.01752","year":"","venue":"","sources":[],"selected_full_text_sections":"[data_source, input_representation: 4 Methods > 4.4 Cell data]\nK562 cells. 200 control cells from the Replogle genome-scale CRISPRi dataset [Replogle et al., 2022], the same cells used for SAE training. Tokenized via Geneformer's rank-value encoding.\n\nTabula Sapiens cells. 200 cells from the Tabula Sapiens atlas [The Tabula Sapiens Consortium, 2022], stratified by tissue: 67 immune (41 cell types), 67 kidney (13 cell types), 66 lung (34 cell types)-totaling 88 cell types. For Geneformer: tokenized via rank-value encoding. For scGPT: tokenized with continuous expression values, genes sorted by expression (descending), padded to 1,200 positions.","first_pass_outputs":{"scope_reviewer":{"record_id":"full_2026-07-06__rec_003578","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"This is a primary methods paper on causal circuit tracing in single-cell foundation models, not a review, benchmark, resource, or wrapper. The provided evidence only shows biological tokenization/feature tracing in Geneformer and scGPT, with no natural-language text component or text-bio bridge.","evidence_snippet":"\"apply it to Geneformer V2-316M and scGPT\"; \"Tokenized via Geneformer's rank-value encoding\"; \"scGPT: tokenized with continuous expression values\""},"architecture_reviewer":{"record_id":"full_2026-07-06__rec_003578","paper_type":"application_wrapper","generative_model_present":"unclear","foundation_model_evidence":"yes","primary_exclusion_code":"application_wrapper","uncertainty_reason":"generative_status_unclear","decision_rationale":"This paper applies causal circuit tracing to existing models rather than presenting a new generative model. The abstract and section evidence refer to Geneformer V2-316M and scGPT as foundation models, but they do not describe a generative mechanism for the candidate contribution.","evidence_snippet":"“apply it to Geneformer V2-316M and scGPT whole-human”; “foundation model activations”"},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"EC2_no_text_component","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","generative_model_present":"unclear","foundation_model_evidence":"yes"}}}]

