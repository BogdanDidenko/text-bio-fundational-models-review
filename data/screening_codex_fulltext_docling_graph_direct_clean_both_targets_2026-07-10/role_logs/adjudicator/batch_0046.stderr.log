[{"record_id":"full_2026-07-06__rec_000711","candidate_id":"full_2026-07-06__rec_000711","source_record_id":"rec_000711","source_corpus":"uncertain","title":"PTM-Mamba: a PTM-aware protein language model with bidirectional gated Mamba blocks","abstract":"","doi":"10.1038/s41592-025-02656-9","year":"","venue":"","sources":[],"selected_full_text_sections":"[data_source: PTM-Mamba: a PTM-aware protein language model with bidirectional gated Mamba blocks > Online content > Methods > Data curation]\nModel training data were curated from UniProt 15 . Specifically, 311,350 experimentally validated PTM records were collected from Swiss-Prot, and the PTM annotations of their proteins were mapped to their respective sequences to construct the new PTM sequences. The final dataset includes a total of 79,707 PTM sequences. Data curation code can be found at https://github.com/programmablebio/ptm-mamba/tree/ main/ptm\\_data\\_preprocessing.\n\nDatasets for the four benchmarking tasks were collected from the following sources. Phosphorylation site data were obtained from the corresponding ProteinBERT benchmark 25 , originally derived from PhospoSitePlus 18 and filtered for sequences between 256 and 512 amino acids in length, yielding a training set of 15,588 sequences, a validation set of 1,707 sequences and a testing set of 3,106 sequences. Non-histone acetylation site prediction was performed equivalently as described in prior literature, using the non-histone acetylation collection dataset 26 . Druggability and disease association datasets were curated from the dbPTM database 17 . PPI data describing the effect of PTMs were curated from PTMint, which encompasses 2,477 nonredundant PTM sites in 1,169 proteins affecting 2,371 protein-protein pairs 20 . In brief, wild-type sequences were mapped to corresponding entries in the PTM-Mamba dataset, and wild-type residues were replaced by the corresponding position-specific PTMs for tokenization by specified models. For all other baseline models trained with standard one-hot embeddings or ESM-2 embeddings, the corresponding wild-type sequence was used as input.\n\n[input_representation: PTM-Mamba: a PTM-aware protein language model with bidirectional gated Mamba blocks > Online content > Methods > Tokenization]\nIn our tokenization scheme, we use the standard set of amino acids tokens as described in ESM-2 (ref. 7). In addition to special tokens, the 20 wild-type amino acids tokens are as follows: D, N, E, K, V, Y, A, Q, M, I, T, L, R, F, G, C, S, P, H, W. We introduce new PTM tokens, corres&lt;N-linked\n\nponding to their unique specific UniProt annotations: (GlcNAc…) asparagine&gt;, &lt;Pyrrolidone carboxylic acid&gt;, &lt;Phosphoserine&gt;, &lt;Phosphothreonine&gt;, &lt;N-acetylalanine&gt;, &lt;N-acetylmethionine&gt;, &lt;N6-acetyllysine&gt;, &lt;Phosphotyrosine&gt;, &lt;S-diacylglycerol cysteine&gt;, &lt;N6-(pyridoxal phosphate)lysine&gt;, &lt;N-acetylserine&gt;, &lt;N6-carboxylysine&gt;, &lt;N6-succinyllysine&gt;,  &lt;S-palmitoyl  cysteine&gt;, &lt;O-(pantetheine 4-phosphoryl)serine&gt;, &lt;Sulfotyrosine&gt;, &lt;O-linked  (GalNAc…)  threonine&gt;,  &lt;Omega-N-methylarginine&gt;, &lt;N-myristoyl glycine&gt;, &lt;4-hydroxyproline&gt;, &lt;Asymmetric  dimethylarginine&gt;,  &lt;N5-methylglutamine&gt;, &lt;4-aspartylphosphate&gt;, &lt;S-geranylgeranyl cysteine&gt;, &lt;4-carboxyglutamate&gt; . The top two most abundant PTM tokens are &lt;N-linked (GlcNAc…) asparagine&gt; and &lt;Phosphoserine&gt; . The full distribution of the PTM tokens is shown in Supplementary Fig. 1, and the full PTM tokens are presented in Supplementary Table 1. The wild-type amino acid tokens are then converted into embed  dings by both ESM-2-650M and PTM-Mamba, while the PTM tokens are only processed by PTM-Mamba.","first_pass_outputs":{"scope_reviewer":{"record_id":"full_2026-07-06__rec_000711","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"This is a primary model paper for PTM/protein sequences, but the provided evidence only describes amino-acid and PTM tokenization. No natural-language text or text-bio bridge is shown.","evidence_snippet":"\"protein language model\"; \"standard set of amino acids tokens\"; \"We introduce new PTM tokens\""},"architecture_reviewer":{"record_id":"full_2026-07-06__rec_000711","paper_type":"primary_model_paper","generative_model_present":"unclear","foundation_model_evidence":"yes","primary_exclusion_code":"none","uncertainty_reason":"generative_status_unclear","decision_rationale":"The record describes a protein language model pretrained on UniProt PTM sequences, which supports foundation-model-like pretraining. It does not explicitly state an autoregressive, decoder, or sequence generation mechanism, so generative status remains unclear.","evidence_snippet":"\"PTM-Mamba: a PTM-aware protein language model\"; \"Model training data were curated from UniProt... The final dataset includes a total of 79,707 PTM sequences.\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"EC2_no_text_component","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","generative_model_present":"unclear","foundation_model_evidence":"yes"}}}]

