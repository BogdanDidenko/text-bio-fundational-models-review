ecord_id":"rec_000080","paper_type":"primary_model_paper","generative_model_present":"no","foundation_model_evidence":"no","primary_exclusion_code":"EC3_not_generative","uncertainty_reason":"none","decision_rationale":"GATHER is a retrieval method for zero-shot cell-type annotation, with evidence selection and LLM calls for reasoning. The abstract does not describe a generative architecture or foundation-model-like pretraining.","evidence_snippet":"\"convergence-centric retriever\" and \"without LLM involvement during retrieval\""}]}
