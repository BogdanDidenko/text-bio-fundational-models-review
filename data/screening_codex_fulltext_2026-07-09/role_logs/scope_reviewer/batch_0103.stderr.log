./data/screening_codex_full_2026-07-06/role_logs/adjudicator/batch_0059.stderr.log:217:./data/screening_codex_full_2026-07-06/role_logs/scope_reviewer/batch_0257.response.txt:1:{"results":[{"record_id":"rec_002049","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","primary_exclusion_code":"none","uncertainty_reason":"none","decision_rationale":"Proposes BIOVERSE as a new multimodal model that aligns biomedical modalities with LLMs and supports instruction tuning for downstream reasoning. The abstract explicitly connects raw biomedical data with LLM knowledge.","evidence_snippet":"\"aligns them with LLMs\"; \"unifying raw biomedical data with knowledge embedded in LLMs\""},{"record_id":"rec_002050","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"This is a new self-supervised ensemble method, but the abstract does not describe a substantive text-language component in the candidate model. Genomics appears only as one evaluation domain.","evidence_snippet":"\"across a wide range of self-supervised architectures in computer vision, natural language processing, and genomics data\""},{"record_id":"rec_002051","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"The abstract states that deep learning techniques on multi-modal cancer imaging are reviewed. This is a review of radiomics, genomics, and clinical data rather than a primary model paper.","evidence_snippet":"\"The application of deep learning techniques on multi-modal cancer imaging is reviewed\""},{"record_id":"rec_002052","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"PGCANet is a new multimodal survival prediction model using whole slide images and genomic data. The abstract does not support any substantive text or language component.","evidence_snippet":"\"constructs hierarchical pathological structure graphs from whole slide images\" and \"cross-attention mechanism\""},{"record_id":"rec_002053","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"The model uses gene expressions, microRNA, clinical data, and histopathology images for prognosis prediction. No text-language model component is described.","evidence_snippet":"\"using gene expressions, microRNA data, clinical data and histopathology whole slide images\""},{"record_id":"rec_002054","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"conST is a contrastive learning framework for spatial transcriptomics that integrates gene expression, spatial information, and morphology. The abstract does not indicate a text component or text-bio bridge.","evidence_snippet":"\"integrating multi-modal SRT data, i.e. gene expression, spatial information, and morphology\""},{"record_id":"rec_002055","paper_type":"application_wrapper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"application_wrapper","uncertainty_reason":"none","decision_rationale":"The abstract uses pre-trained protein language models as embeddings and adds logical constraints for TF prediction. That is an application built around an external language model, not a substantive text-bio foundational model.","evidence_snippet":"\"leverages pre-trained protein language models for high-dimensional sequence embeddings\""},{"record_id":"rec_002056","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"scBIOT is a self-supervised single-cell integration framework using optimal transport and Transformer-based VAEs. The abstract describes biological modalities only, with no substantive text-language component.","evidence_snippet":"\"a self-supervised framework that combines optimal transport alignment with Transformer-based variational autoencoders (VAEs)\""}]}
