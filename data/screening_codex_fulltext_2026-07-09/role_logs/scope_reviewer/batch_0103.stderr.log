./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/nemotron3_super_120b_fp8_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11583/guideline_pilot_raw_completed.jsonl:134:{"cluster_id": 4157, "title": "Phenotypic Bioactivity Prediction as Open-set Biological Assay Querying", "title_normalized": "phenotypic bioactivity prediction as openset biological assay querying", "doi": NaN, "preprint_doi": NaN, "pmid": NaN, "arxiv_id": NaN, "abstract": "The traditional drug discovery pipeline is severely bottlenecked by the need to design and execute bespoke biological assays for every new target and compound—a process that is both time-consuming and prohibitively expensive. While machine learning has accelerated virtual screening, current models remain confined to “closed-set” paradigms, unable to generalize to entirely novel biological assays without target-specific experimental data. Here, we present\n                  OpenPheno\n                  , a groundbreaking multimodal foundation model that fundamentally redefines bioactivity prediction as an open-set, visual-language question-answering (QA) task. By integrating chemical structures (SMILES), universal phenotypic profiles (Cell Painting images), and natural language descriptions of biological assays, OpenPheno unlocks the highly coveted\n                  “profile once, predict many” paradigm\n                  . Instead of conducting countless target-specific wet-lab experiments, researchers only need to capture a single, low-cost Cell Painting image of a novel compound. OpenPheno then evaluates this universal phenotypic “fingerprint” against the text-based description of any unseen assay, predicting bioactivity in a zero-shot manner. On 54 entirely unseen assays, it achieves strong zero-shot performance (mean AUROC 0.75), exceeding supervised baselines trained with full labeled data, and few-shot adaptation further improves predictions. In the most stringent setting where both compounds and assays are novel, OpenPheno maintains robust generalization (mean AUROC 0.66), opening up a new paradigm for a highly scalable, cost-effective, and universal engine for next-generation drug discovery.", "authors": "['Y Sun', 'X Zhang', 'Q Zheng', 'H Li', 'J Zhang', 'L Hong']", "year": 2026.0, "venue": "bioRxiv", "date": NaN, "url": "https://www.biorxiv.org/content/10.64898/2026.02.28.708711.abstract", "sources": "['google_scholar']", "n_sources": 1, "all_dois": "[]", "duplicate_count": 1, "abstract_source": NaN, "abstract_enriched_from": "crossref_title", "abstract_old_len": 178.0, "update_batch": "2026-03-01_to_2026-04-14", "_pilot_row_id": 150, "round-A_scope_reviewer_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "yes", "text_bio_bridge_present": "yes", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "integrating ... natural language descriptions of biological assays", "evidence_for_text_bio_bridge": "evaluates this universal phenotypic fingerprint against the text-based description of any unseen assay", "evidence_for_generative_model": "not_assessed", "boundary_case": "clear_include", "decision_rationale": "The abstract presents OpenPheno as a multimodal foundation model that combines natural language assay descriptions with chemical and phenotypic data for visual-language QA, indicating a primary model with a substantive text-bio bridge."}, "round-A_scope_reviewer_paper_type": "primary_model_paper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "yes", "round-A_scope_reviewer_text_bio_bridge_present": "yes", "round-A_scope_reviewer_primary_exclusion_code": "none", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "integrating ... natural language descriptions of biological assays", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "evaluates this universal phenotypic fingerprint against the text-based description of any unseen assay", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "clear_include", "round-A_scope_reviewer_decision_rationale": "The abstract presents OpenPheno as a multimodal foundation model that combines natural language assay descriptions with chemical and phenotypic data for visual-language QA, indicating a primary model with a substantive text-bio bridge.", "round-A_architecture_reviewer_output": {"paper_type": "primary_model_paper", "generative_model_present": "no", "foundation_model_evidence": "yes", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "none", "boundary_case": "clear_exclude", "decision_rationale": "The abstract describes OpenPheno as a multimodal foundation model that predicts bioactivity via zero-shot visual-language QA, without mentioning any decoder, autoregressive, or sequence-to-sequence generative mechanism. Hence it is not a generative model."}, "round-A_architecture_reviewer_paper_type": "primary_model_paper", "round-A_architecture_reviewer_generative_model_present": "no", "round-A_architecture_reviewer_foundation_model_evidence": "yes", "round-A_architecture_reviewer_primary_exclusion_code": "none", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "none", "round-A_architecture_reviewer_boundary_case": "clear_exclude", "round-A_architecture_reviewer_decision_rationale": "The abstract describes OpenPheno as a multimodal foundation model that predicts bioactivity via zero-shot visual-language QA, without mentioning any decoder, autoregressive, or sequence-to-sequence generative mechanism. Hence it is not a generative model.", "pilot_roundA_scope_gate": "PASS", "pilot_roundA_architecture_gate": "EXCLUDE", "pilot_needs_adjudication": false}
