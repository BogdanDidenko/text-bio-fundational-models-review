./data/docling_uncertain_no_vlm_2026-07-08/documents/full_2026_07_06_rec_003323.docling.json:26846:      "text": "Haotian Liu, Chunyuan Li, Qingyang Wu, and Yong Jae Lee. Visual instruction tuning. Advances in neural information processing systems , 36:34892-34916, 2023.",
./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/nemotron3_super_120b_fp8_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11570/guideline_pilot_raw_completed.jsonl:403:{"cluster_id": 1752, "title": "Improved precision oncology question-answering using agentic LLM", "title_normalized": "improved precision oncology questionanswering using agentic llm", "doi": "10.1101/2024.09.20.24314076", "preprint_doi": NaN, "pmid": NaN, "arxiv_id": NaN, "abstract": "ABSTRACT\n                The clinical adoption of Large Language Models (LLMs) in biomedical research has been limited by concerns regarding the quality, accuracy, and reliability of their outputs, particularly in precision oncology, where clinical decision-making demands high precision. Current models, often based on fine-tuned foundational LLMs, are prone to issues such as hallucinations, incoherent reasoning, and loss of context. In this work, we present GeneSilico Copilot, an advanced agent-based architecture that transforms LLMs from simple response synthesizers to clinical reasoning systems. Our approach is centred around a bespoke ReAct agent that orchestrates a suite of specialized tools for asynchronous information retrieval and synthesis. These tools access curated document vector stores containing clinical treatment guidelines, genomic insights, drug information, clinical trials, and breast cancer-specific literature. To leverage large context windows of current LLMs, we implement a hybrid search strategy that prioritizes key information and dynamically integrates summarized content, reducing context fragmentation. Incorporating additional metadata further allows for precise, transparent and evidence-backed reasoning at each step of the thought process. The system ensures that at every stage, the agent can synthesize meaningful, context-aware observations that contribute to a coherent and comprehensive final response that aligns with clinical standards. Evaluations on real-world breast cancer cases show that GeneSilico Copilot significantly improves response accuracy and personalization. This system represents a critical advancement toward making LLMs clinically deployable in precision oncology and has potential applications in broader medical domains requiring complex, data-driven decision-making.", "authors": "R. Das; K. Maheswari; S. Siddiqui; N. Arora; A. Paul; J. Nanshi; V. Udbalkar; A. Sarvade; H. chaturvedi; T. Shvartsman; S. Masih; R. Thippeswamy; S. Patil; S. S. Nirni; B. Garsson; S. Bandyopadhyay; U. Maulik; M. Farooq; D. Sengupta", "year": 2024.0, "venue": "medRxiv", "date": "2024-09-24", "url": "https://doi.org/10.1101/2024.09.20.24314076", "sources": "['semantic_scholar']", "n_sources": 1, "all_dois": "['10.1101/2024.09.20.24314076']", "duplicate_count": 1, "abstract_source": "crossref", "abstract_enriched_from": NaN, "abstract_old_len": NaN, "update_batch": NaN, "_pilot_row_id": 416, "round-A_scope_reviewer_output": {"paper_type": "application_wrapper", "bio_modality_present": "no", "text_component_present": "yes", "text_bio_bridge_present": "no", "primary_exclusion_code": "application_wrapper", "uncertainty_reason": "none", "evidence_for_text_component": "advanced agent-based architecture that transforms LLMs from simple response synthesizers to clinical reasoning systems", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "not_assessed", "boundary_case": "wrapper_boundary", "decision_rationale": "The work builds an agentic system around an existing LLM for oncology question answering using retrieval tools, indicating an application wrapper rather than a novel text-bio foundational model."}, "round-A_scope_reviewer_paper_type": "application_wrapper", "round-A_scope_reviewer_bio_modality_present": "no", "round-A_scope_reviewer_text_component_present": "yes", "round-A_scope_reviewer_text_bio_bridge_present": "no", "round-A_scope_reviewer_primary_exclusion_code": "application_wrapper", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "advanced agent-based architecture that transforms LLMs from simple response synthesizers to clinical reasoning systems", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "none", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "wrapper_boundary", "round-A_scope_reviewer_decision_rationale": "The work builds an agentic system around an existing LLM for oncology question answering using retrieval tools, indicating an application wrapper rather than a novel text-bio foundational model.", "round-A_architecture_reviewer_output": {"paper_type": "application_wrapper", "generative_model_present": "unclear", "foundation_model_evidence": "unclear", "primary_exclusion_code": "application_wrapper", "uncertainty_reason": "generative_status_unclear", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "none", "boundary_case": "wrapper_boundary", "decision_rationale": "The abstract presents GeneSilico Copilot as an agentic architecture that uses existing LLMs but does not introduce a new generative model; it is an application wrapper around foundational LLMs."}, "round-A_architecture_reviewer_paper_type": "application_wrapper", "round-A_architecture_reviewer_generative_model_present": "unclear", "round-A_architecture_reviewer_foundation_model_evidence": "unclear", "round-A_architecture_reviewer_primary_exclusion_code": "application_wrapper", "round-A_architecture_reviewer_uncertainty_reason": "generative_status_unclear", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "none", "round-A_architecture_reviewer_boundary_case": "wrapper_boundary", "round-A_architecture_reviewer_decision_rationale": "The abstract presents GeneSilico Copilot as an agentic architecture that uses existing LLMs but does not introduce a new generative model; it is an application wrapper around foundational LLMs.", "pilot_roundA_scope_gate": "EXCLUDE", "pilot_roundA_architecture_gate": "EXCLUDE", "pilot_needs_adjudication": false}
./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/nemotron3_super_120b_fp8_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11570/guideline_pilot_raw_completed.jsonl:828:{"cluster_id": 2191, "title": "BioVERSE: Representation Alignment of Biomedical Modalities to LLMs for Multi-Modal Reasoning", "title_normalized": "bioverse representation alignment of biomedical modalities to llms for multimodal reasoning", "doi": "10.48550/arXiv.2510.01428", "preprint_doi": NaN, "pmid": NaN, "arxiv_id": "2510.01428", "abstract": "Recent advances in large language models (LLMs) and biomedical foundation models (BioFMs) have achieved strong results in biological text reasoning, molecular modeling, and single-cell analysis, yet they remain siloed in disjoint embedding spaces, limiting cross-modal reasoning. We present BIOVERSE (Biomedical Vector Embedding Realignment for Semantic Engagement), a two-stage approach that adapts pretrained BioFMs as modality encoders and aligns them with LLMs through lightweight, modality-specific projection layers. The approach first aligns each modality to a shared LLM space through independently trained projections, allowing them to interoperate naturally, and then applies standard instruction tuning with multi-modal data to bring them together for downstream reasoning. By unifying raw biomedical data with knowledge embedded in LLMs, the approach enables zero-shot annotation, cross-modal question answering, and interactive, explainable dialogue. Across tasks spanning cell-type annotation, molecular description, and protein function reasoning, compact BIOVERSE configurations surpass larger LLM baselines while enabling richer, generative outputs than existing BioFMs, establishing a foundation for principled multi-modal biomedical reasoning.", "authors": "Ching-Huei Tsou; Michal Ozery-Flato; Ella Barkan; Diwakar Mahajan; Ben Shapira", "year": 2025.0, "venue": "arXiv.org", "date": "2025-10-01", "url": NaN, "sources": "['arxiv', 'semantic_scholar']", "n_sources": 2, "all_dois": "['10.48550/arXiv.2510.01428']", "duplicate_count": 2, "abstract_source": NaN, "abstract_enriched_from": NaN, "abstract_old_len": NaN, "update_batch": NaN, "_pilot_row_id": 841, "round-A_scope_reviewer_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "yes", "text_bio_bridge_present": "yes", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "aligns them with LLMs through lightweight, modality-specific projection layers", "evidence_for_text_bio_bridge": "enables zero-shot annotation, cross-modal question answering, and interactive, explainable dialogue", "evidence_for_generative_model": "not_assessed", "boundary_case": "clear_include", "decision_rationale": "The abstract describes a new method that aligns biomedical modalities to LLMs via projection layers and instruction tuning, enabling cross-modal QA and dialogue, establishing a substantive text-bio bridge."}, "round-A_scope_reviewer_paper_type": "primary_model_paper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "yes", "round-A_scope_reviewer_text_bio_bridge_present": "yes", "round-A_scope_reviewer_primary_exclusion_code": "none", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "aligns them with LLMs through lightweight, modality-specific projection layers", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "enables zero-shot annotation, cross-modal question answering, and interactive, explainable dialogue", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "clear_include", "round-A_scope_reviewer_decision_rationale": "The abstract describes a new method that aligns biomedical modalities to LLMs via projection layers and instruction tuning, enabling cross-modal QA and dialogue, establishing a substantive text-bio bridge.", "round-A_architecture_reviewer_output": {"paper_type": "primary_model_paper", "generative_model_present": "yes", "foundation_model_evidence": "yes", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "zero-shot annotation, cross-modal question answering, and interactive, explainable dialogue", "evidence_for_text_bio_bridge": "aligns pretrained BioFMs as modality encoders and aligns them with LLMs", "evidence_for_generative_model": "enabling richer, generative outputs than existing BioFMs", "boundary_case": "clear_include", "decision_rationale": "The abstract describes aligning BioFMs with LLMs via projection layers and instruction tuning, enabling generative outputs such as dialogue and question answering, and leverages pretrained LLMs and BioFMs as foundation models."}, "round-A_architecture_reviewer_paper_type": "primary_model_paper", "round-A_architecture_reviewer_generative_model_present": "yes", "round-A_architecture_reviewer_foundation_model_evidence": "yes", "round-A_architecture_reviewer_primary_exclusion_code": "none", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "zero-shot annotation, cross-modal question answering, and interactive, explainable dialogue", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "aligns pretrained BioFMs as modality encoders and aligns them with LLMs", "round-A_architecture_reviewer_evidence_for_generative_model": "enabling richer, generative outputs than existing BioFMs", "round-A_architecture_reviewer_boundary_case": "clear_include", "round-A_architecture_reviewer_decision_rationale": "The abstract describes aligning BioFMs with LLMs via projection layers and instruction tuning, enabling generative outputs such as dialogue and question answering, and leverages pretrained LLMs and BioFMs as foundation models.", "pilot_roundA_scope_gate": "PASS", "pilot_roundA_architecture_gate": "PASS", "pilot_needs_adjudication": false}
./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/nemotron3_super_120b_fp8_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11570/guideline_pilot_raw_completed.jsonl:1814:{"cluster_id": 3199, "title": "CellVerse: Do Large Language Models Really Understand Cell Biology?", "title_normalized": "cellverse do large language models really understand cell biology", "doi": NaN, "preprint_doi": NaN, "pmid": NaN, "arxiv_id": "2505.07865v1", "abstract": "Recent studies have demonstrated the feasibility of modeling single-cell data as natural languages and the potential of leveraging powerful large language models (LLMs) for understanding cell biology. However, a comprehensive evaluation of LLMs' performance on language-driven single-cell analysis tasks still remains unexplored. Motivated by this challenge, we introduce CellVerse, a unified language-centric question-answering benchmark that integrates four types of single-cell multi-omics data and encompasses three hierarchical levels of single-cell analysis tasks: cell type annotation (cell-level), drug response prediction (drug-level), and perturbation analysis (gene-level). Going beyond this, we systematically evaluate the performance across 14 open-source and closed-source LLMs ranging from 160M to 671B on CellVerse. Remarkably, the experimental results reveal: (1) Existing specialist models (C2S-Pythia) fail to make reasonable decisions across all sub-tasks within CellVerse, while generalist models such as Qwen, Llama, GPT, and DeepSeek family models exhibit preliminary understanding capabilities within the realm of cell biology. (2) The performance of current LLMs falls short of expectations and has substantial room for improvement. Notably, in the widely studied drug response prediction task, none of the evaluated LLMs demonstrate significant performance improvement over random guessing. CellVerse offers the first large-scale empirical demonstration that significant challenges still remain in applying LLMs to cell biology. By introducing CellVerse, we lay the foundation for advancing cell biology through natural languages and hope this paradigm could facilitate next-generation single-cell analysis.", "authors": "Fan Zhang; Tianyu Liu; Zhihong Zhu; Hao Wu; Haixin Wang; Donghao Zhou; Yefeng Zheng; Kun Wang; Xian Wu; Pheng-Ann Heng", "year": 2025.0, "venue": NaN, "date": "2025-05-09", "url": NaN, "sources": "['arxiv', 'google_scholar']", "n_sources": 2, "all_dois": "[]", "duplicate_count": 2, "abstract_source": NaN, "abstract_enriched_from": NaN, "abstract_old_len": NaN, "update_batch": NaN, "_pilot_row_id": 1820, "round-A_scope_reviewer_output": {"paper_type": "benchmark_resource", "bio_modality_present": "yes", "text_component_present": "no", "text_bio_bridge_present": "no", "primary_exclusion_code": "benchmark_resource", "uncertainty_reason": "none", "evidence_for_text_component": "none", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "not_assessed", "boundary_case": "clear_exclude", "decision_rationale": "The paper presents CellVerse, a language-centric question-answering benchmark for evaluating existing LLMs on single-cell multi-omics tasks, without introducing a new generative text-bio model."}, "round-A_scope_reviewer_paper_type": "benchmark_resource", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "no", "round-A_scope_reviewer_text_bio_bridge_present": "no", "round-A_scope_reviewer_primary_exclusion_code": "benchmark_resource", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "none", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "none", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "clear_exclude", "round-A_scope_reviewer_decision_rationale": "The paper presents CellVerse, a language-centric question-answering benchmark for evaluating existing LLMs on single-cell multi-omics tasks, without introducing a new generative text-bio model.", "round-A_architecture_reviewer_output": {"paper_type": "benchmark_resource", "generative_model_present": "no", "foundation_model_evidence": "unclear", "primary_exclusion_code": "benchmark_resource", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "none", "boundary_case": "clear_exclude", "decision_rationale": "The paper introduces a benchmark (CellVerse) for evaluating LLMs on single-cell tasks and does not propose a new generative model; thus it lacks a generative architecture and is a benchmark resource."}, "round-A_architecture_reviewer_paper_type": "benchmark_resource", "round-A_architecture_reviewer_generative_model_present": "no", "round-A_architecture_reviewer_foundation_model_evidence": "unclear", "round-A_architecture_reviewer_primary_exclusion_code": "benchmark_resource", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "none", "round-A_architecture_reviewer_boundary_case": "clear_exclude", "round-A_architecture_reviewer_decision_rationale": "The paper introduces a benchmark (CellVerse) for evaluating LLMs on single-cell tasks and does not propose a new generative model; thus it lacks a generative architecture and is a benchmark resource.", "pilot_roundA_scope_gate": "EXCLUDE", "pilot_roundA_architecture_gate": "EXCLUDE", "pilot_needs_adjudication": false}
./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/nemotron3_super_120b_fp8_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11570/guideline_pilot_raw_completed.jsonl:1851:{"cluster_id": 3207, "title": "Biology-Instructions: A Dataset and Benchmark for Multi-Omics Sequence Understanding Capability of Large Language Models", "title_normalized": "biologyinstructions a dataset and benchmark for multiomics sequence understanding capability of large language models", "doi": NaN, "preprint_doi": NaN, "pmid": NaN, "arxiv_id": "2412.19191v2", "abstract": "Large language models (LLMs) have shown remarkable capabilities in general domains, but their application to multi-omics biology remains underexplored. To address this gap, we introduce Biology-Instructions, the first large-scale instruction-tuning dataset for multi-omics biological sequences, including DNA, RNA, proteins, and multi-molecules. This dataset bridges LLMs and complex biological sequence-related tasks, enhancing their versatility and reasoning while maintaining conversational fluency. We also highlight significant limitations of current state-of-the-art LLMs on multi-omics tasks without specialized training. To overcome this, we propose ChatMultiOmics, a strong baseline with a novel three-stage training pipeline, demonstrating superior biological understanding through Biology-Instructions. Both resources are publicly available, paving the way for better integration of LLMs in multi-omics analysis. The Biology-Instructions is publicly available at: https://github.com/hhnqqq/Biology-Instructions.", "authors": "Haonan He; Yuchen Ren; Yining Tang; Ziyang Xu; Junxian Li; Minghao Yang; Di Zhang; Dong Yuan; Tao Chen; Shufei Zhang; Yuqiang Li; Nanqing Dong; Wanli Ouyang; Dongzhan Zhou; Peng Ye", "year": 2024.0, "venue": NaN, "date": "2024-12-26", "url": NaN, "sources": "['arxiv', 'google_scholar']", "n_sources": 2, "all_dois": "[]", "duplicate_count": 2, "abstract_source": NaN, "abstr