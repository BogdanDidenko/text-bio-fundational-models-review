ic data","sources":["google_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_000426","paper_type":"benchmark_resource","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"unclear","primary_exclusion_code":"benchmark_resource","uncertainty_reason":"mixed_signals","decision_rationale":"The title indicates a Cell Ontology resource paper, and the abstract mentions LLMs and prompts in a curation context. It does not clearly present a primary text-bio model.","evidence_snippet":"\"The Cell Ontology... LLM generated, expert reviewed... standardized prompts\""},"architecture_reviewer":{"record_id":"rec_000426","paper_type":"unclear","generative_model_present":"unclear","foundation_model_evidence":"unclear","primary_exclusion_code":"none","uncertainty_reason":"paper_type_unclear","decision_rationale":"The abstract fragment only mentions LLM-generated, expert-reviewed content and does not clearly describe a model paper. There is no clear evidence of a novel generative architecture or foundation-model characteristics.","evidence_snippet":"“LLM generated, expert reviewed” and “standardised prompts”"},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"benchmark_resource","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"benchmark_resource","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"unclear","generative_model_present":"unclear","foundation_model_evidence":"unclear"}}}]
