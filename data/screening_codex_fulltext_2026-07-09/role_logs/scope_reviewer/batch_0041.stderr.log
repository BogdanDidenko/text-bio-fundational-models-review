./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:2:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 2, "text": "In the format provided by the authors and unedited", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nIn the format provided by the authors and unedited", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT"], "pages": [1], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/3", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 1, "bbox": {"l": 39.685, "t": 556.6759278320313, "r": 149.48419999999993, "b": 539.1763659442308, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 50]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:3:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 3, "text": "We systematically investigated and summarized the intended tasks and available official scripts for each scLLM included in our study, as presented in Supplementary Table 1 . It is demonstrated that  all  published  scLLMs  incorporate  cell  type  identification  pipelines  in  both  zero-shot  and finetuning  modes,  allowing  for  a  fair  and  consistent  benchmarking  of  scPEFT  across  scLLM backbones using this common downstream task.\nWhile we acknowledge that each scLLM (with the exception of scBERT, which is solely designed for  cell  type  identification)  was  originally  developed  for  specific  tasks  beyond  cell  type identification, some of these original tasks are often built upon zero-shot embeddings or attention maps derived from pretrained models (e.g., Geneformer's in silico gene perturbation, scGPT's gene  regulatory  network  inference,  and  scFoundation's  gene  module  discovery),  and  do  not include official finetuning protocols, making it challenging to compare adaptation strategies like scPEFT in a standardized manner.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 1: Summary of downstream tasks supported by the involved scLLMs\nWe systematically investigated and summarized the intended tasks and available official scripts for each scLLM included in our study, as presented in Supplementary Table 1 . It is demonstrated that  all  published  scLLMs  incorporate  cell  type  identification  pipelines  in  both  zero-shot  and finetuning  modes,  allowing  for  a  fair  and  consistent  benchmarking  of  scPEFT  across  scLLM backbones using this common downstream task.\nWhile we acknowledge that each scLLM (with the exception of scBERT, which is solely designed for  cell  type  identification)  was  originally  developed  for  specific  tasks  beyond  cell  type identification, some of these original tasks are often built upon zero-shot embeddings or attention maps derived from pretrained models (e.g., Geneformer's in silico gene perturbation, scGPT's gene  regulatory  network  inference,  and  scFoundation's  gene  module  discovery),  and  do  not include official finetuning protocols, making it challenging to compare adaptation strategies like scPEFT in a standardized manner.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 1: Summary of downstream tasks supported by the involved scLLMs"], "pages": [3], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/9", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 3, "bbox": {"l": 72.0, "t": 649.42464, "r": 543.1872000000008, "b": 581.5883053259668, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 445]}]}, {"self_ref": "#/texts/10", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 3, "bbox": {"l": 72.0, "t": 562.0646399999999, "r": 546.1243680000008, "b": 465.1883053259668, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 620]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 1: Summary of downstream tasks supported by the involved scLLMs"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:4:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 4, "text": "In  assessing  the  cell  type  identification  related  tasks,  the  tuned  model's  performance  was evaluated using balanced accuracy as follows under a five-fold cross-validation setting:\n<!-- formula-not-decoded -->\nHere, 𝑐 is  the  number of cell types. 𝑇𝑃 ! represents true positives for 𝑖 %& class and 𝐹𝑁 ! denotes False  Negatives  for 𝑖 %& class.    This  metric  treats  all  cell  types  equally,  regardless  of  their frequency in the dataset, thus avoiding possible bias in imbalanced datasets. Confusion matrices were also utilized to provide a detailed breakdown of true and false prediction percentages for each class. In the context of identifying 𝑐 cell types, the confusion matrix is a 𝑐 × 𝑐 table where rows represent annotated cell types and columns denote model-predicted cell types. Each cell at 𝑖 %& row and 𝑗 %& column reflects the percentage of instances from 𝑖 %& class predicted as 𝑗 %& class. Hence, high values along the diagonal indicate accurate predictions, while off-diagonal values represent misclassifications.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 2: Downstream evaluation tasks and their corresponding metrics\nIn  assessing  the  cell  type  identification  related  tasks,  the  tuned  model's  performance  was evaluated using balanced accuracy as follows under a five-fold cross-validation setting:\n<!-- formula-not-decoded -->\nHere, 𝑐 is  the  number of cell types. 𝑇𝑃 ! represents true positives for 𝑖 %& class and 𝐹𝑁 ! denotes False  Negatives  for 𝑖 %& class.    This  metric  treats  all  cell  types  equally,  regardless  of  their frequency in the dataset, thus avoiding possible bias in imbalanced datasets. Confusion matrices were also utilized to provide a detailed breakdown of true and false prediction percentages for each class. In the context of identifying 𝑐 cell types, the confusion matrix is a 𝑐 × 𝑐 table where rows represent annotated cell types and columns denote model-predicted cell types. Each cell at 𝑖 %& row and 𝑗 %& column reflects the percentage of instances from 𝑖 %& class predicted as 𝑗 %& class. Hence, high values along the diagonal indicate accurate predictions, while off-diagonal values represent misclassifications.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 2: Downstream evaluation tasks and their corresponding metrics"], "pages": [4], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/13", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 4, "bbox": {"l": 72.0, "t": 688.54464, "r": 543.0782880000011, "b": 664.1483053259668, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 191]}]}, {"self_ref": "#/texts/14", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "formula", "prov": [{"page_no": 4, "bbox": {"l": 212.523696, "t": 661.44264, "r": 540.0216, "b": 624.6855304421052, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 52]}]}, {"self_ref": "#/texts/15", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 4, "bbox": {"l": 72.0, "t": 607.20264, "r": 543.3638399999999, "b": 493.0283053259668, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 827]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 2: Downstream evaluation tasks and their corresponding metrics"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:5:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 5, "text": "For the cell group discovery task, the dispersion of annotated cell groups across the generated clusters is evaluated using the Calinski Harabasz Index CHI score 1 . For the TF identification task, following the Geneformer study, we used ROC AUC as the evaluation metric.\nFor  evaluating  batch  correction  performance,  we  considered  two  key  aspects:  biological conservation and batch effect correction, inspired by scIB 2 . Biological conservation is assessed through  metrics  that  evaluate  cell-type  cluster  preservation  in  the  new  embedding  space, specifically NMI, ARI, and cell-type ASW 3 . Batch effect correction is evaluated by examining batch mixing using batch ASW and Graph Connectivity 3 as follows:\n<!-- formula-not-decoded -->\n<!-- formula-not-decoded -->\nWhere Avg BIO donates the average biological conservation score, and Avg BATCH is the average batch effect correction metric.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 2: Downstream evaluation tasks and their corresponding metrics\nFor the cell group discovery task, the dispersion of annotated cell groups across the generated clusters is evaluated using the Calinski Harabasz Index CHI score 1 . For the TF identification task, following the Geneformer study, we used ROC AUC as the evaluation metric.\nFor  evaluating  batch  correction  performance,  we  considered  two  key  aspects:  biological conservation and batch effect correction, inspired by scIB 2 . Biological conservation is assessed through  metrics  that  evaluate  cell-type  cluster  preservation  in  the  new  embedding  space, specifically NMI, ARI, and cell-type ASW 3 . Batch effect correction is evaluated by examining batch mixing using batch ASW and Graph Connectivity 3 as follows:\n<!-- formula-not-decoded -->\n<!-- formula-not-decoded -->\nWhere Avg BIO donates the average biological conservation score, and Avg BATCH is the average batch effect correction metric.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 2: Downstream evaluation tasks and their corresponding metrics"], "pages": [4], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/16", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 4, "bbox": {"l": 72.0, "t": 477.58464, "r": 543.3086399999999, "b": 442.62830532596683, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 271]}]}, {"self_ref": "#/texts/17", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 4, "bbox": {"l": 72.0, "t": 425.02464, "r": 543.2821440000001, "b": 364.62830532596683, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 456]}]}, {"self_ref": "#/texts/18", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "formula", "prov": [{"page_no": 4, "bbox": {"l": 208.548336, "t": 349.60367999999994, "r": 540.0216, "b": 324.19922425263155, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 49]}]}, {"self_ref": "#/texts/19", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "formula", "prov": [{"page_no": 4, "bbox": {"l": 216.660888, "t": 307.36368, "r": 540.00648, "b": 282.43922425263156, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 39]}]}, {"self_ref": "#/texts/20", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 4, "bbox": {"l": 72.0, "t": 265.42463999999995, "r": 543.0767040000007, "b": 242.94830532596688, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 125]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 2: Downstream evaluation tasks and their corresponding metrics"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:6:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 6, "text": "For  the  perturbation  response  task,  performance  was  evaluated  by  comparing  predicted  and actual post perturbation expression values using Pearson correlation PCC 3 and MSE 3 . In addition, PCC and MSE were computed for the top 20 most differentially expressed genes denoted as PCC_DE and MSE_DE to assess the model's sensitivity to major expression changes.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 2: Downstream evaluation tasks and their corresponding metrics\nFor  the  perturbation  response  task,  performance  was  evaluated  by  comparing  predicted  and actual post perturbation expression values using Pearson correlation PCC 3 and MSE 3 . In addition, PCC and MSE were computed for the top 20 most differentially expressed genes denoted as PCC_DE and MSE_DE to assess the model's sensitivity to major expression changes.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 2: Downstream evaluation tasks and their corresponding metrics"], "pages": [4], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/21", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 4, "bbox": {"l": 72.0, "t": 225.34464000000003, "r": 543.3439679999998, "b": 172.14830532596682, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 368]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 2: Downstream evaluation tasks and their corresponding metrics"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:7:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 7, "text": "MS . The MS dataset comprises 21,312 single cells from nine healthy controls and 12 individuals with multiple sclerosis (MS), as annotated in the original study 4 . In alignment with the scGPT data filtering  protocol,  we  excluded  B  cells,  T  cells,  and  oligodendrocyte  B  cells  present  only  in diseased donors. We selected the top 2,000 highly variable genes per cell for analysis. Cells from 13 random donors were assigned to the reference set, and cells from the remaining 8 donors were assigned to the query set, using a 5-fold cross-validation for performance evaluation.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 3: Benchmarking Dataset descriptions\nMS . The MS dataset comprises 21,312 single cells from nine healthy controls and 12 individuals with multiple sclerosis (MS), as annotated in the original study 4 . In alignment with the scGPT data filtering  protocol,  we  excluded  B  cells,  T  cells,  and  oligodendrocyte  B  cells  present  only  in diseased donors. We selected the top 2,000 highly variable genes per cell for analysis. Cells from 13 random donors were assigned to the reference set, and cells from the remaining 8 donors were assigned to the query set, using a 5-fold cross-validation for performance evaluation.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 3: Benchmarking Dataset descriptions"], "pages": [5], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/24", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 5, "bbox": {"l": 72.0, "t": 690.4646399999999, "r": 543.0982800000019, "b": 617.3483053259669, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 587]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 3: Benchmarking Dataset descriptions"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:8:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 8, "text": "NSCLC . The NSCLC dataset includes 77,030 cells from 36 patients with NSCLC, categorized by treatment response. This dataset emphasizes the role of T cells, annotated by their subtype in the  original  study 5 ,  within  the  tumor  immune  microenvironment.  For  analysis,  cells  from  28 patients were randomly assigned to the reference set, and cells from the remaining 8 individuals were assigned to the query set, using 5-fold cross-validation. We selected the top 2,000 highly variable genes per cell to conduct the cell type identification.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 3: Benchmarking Dataset descriptions\nNSCLC . The NSCLC dataset includes 77,030 cells from 36 patients with NSCLC, categorized by treatment response. This dataset emphasizes the role of T cells, annotated by their subtype in the  original  study 5 ,  within  the  tumor  immune  microenvironment.  For  analysis,  cells  from  28 patients were randomly assigned to the reference set, and cells from the remaining 8 individuals were assigned to the query set, using 5-fold cross-validation. We selected the top 2,000 highly variable genes per cell to conduct the cell type identification.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 3: Benchmarking Dataset descriptions"], "pages": [5], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/25", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 5, "bbox": {"l": 72.0, "t": 601.90464, "r": 543.0657120000002, "b": 529.0283053259668, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 549]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 3: Benchmarking Dataset descriptions"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:9:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 9, "text": "COVID-19 .  This dataset consists of 77,168 cells from 16 hospitalized COVID-19 patients with varying symptom severities, including seven asymptomatic, eight moderate, and one severe, as documented in the original study 6 .  We performed a 5-fold cross-validation, randomly selecting cells from 10 patients as the reference set and the remaining six as the query set. The top 2,000 highly  variable  genes,  along  with  all  human  TFs 7 per  cell,  were  selected  for  the  cell  type identification task and gene significance analyses.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 3: Benchmarking Dataset descriptions\nCOVID-19 .  This dataset consists of 77,168 cells from 16 hospitalized COVID-19 patients with varying symptom severities, including seven asymptomatic, eight moderate, and one severe, as documented in the original study 6 .  We performed a 5-fold cross-validation, randomly selecting cells from 10 patients as the reference set and the remaining six as the query set. The top 2,000 highly  variable  genes,  along  with  all  human  TFs 7 per  cell,  were  selected  for  the  cell  type identification task and gene significance analyses.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 3: Benchmarking Dataset descriptions"], "pages": [5], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/26", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 5, "bbox": {"l": 72.0, "t": 513.3446399999999, "r": 543.180576000001, "b": 440.4683053259668, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 539]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 3: Benchmarking Dataset descriptions"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:10:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 10, "text": "Mouse . The primary Mouse dataset encompasses 21,874 single cells from two cortical areas of the adult mouse, including the anterolateral motor area (ALM) and the primary visual cortex (VISp), across 127 samples. Four primary and 21 sub-types of cells were annotated in the original study 8 . We randomly partitioned cells from 100 samples into a reference set and cells from 27 samples into  a  query  set  under  5-fold  cross-validation.  The  top  2,000  highly  variable  genes  from  the orthologous gene set per cell were selected for cross-species validation.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 3: Benchmarking Dataset descriptions\nMouse . The primary Mouse dataset encompasses 21,874 single cells from two cortical areas of the adult mouse, including the anterolateral motor area (ALM) and the primary visual cortex (VISp), across 127 samples. Four primary and 21 sub-types of cells were annotated in the original study 8 . We randomly partitioned cells from 100 samples into a reference set and cells from 27 samples into  a  query  set  under  5-fold  cross-validation.  The  top  2,000  highly  variable  genes  from  the orthologous gene set per cell were selected for cross-species validation.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 3: Benchmarking Dataset descriptions"], "pages": [5], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/27", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 5, "bbox": {"l": 72.0, "t": 424.78463999999997, "r": 545.9052480000001, "b": 351.9083053259668, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 567]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 3: Benchmarking Dataset descriptions"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:11:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 11, "text": "Mouse_10x : The Mouse_10x dataset, independently derived from 10x Genomics, encompasses 29,763 cells from ALM and VISp. This dataset was curated from the original study 9 to align cell type contexts with those in the Mouse dataset, thus facilitating a zero-shot query on the models adapted for the Mouse dataset. For consistency and to ensure queries were performed within the same feature space, the same set of 2,000 genes identified in the Mouse dataset was utilized.\nMouse_smart-seq :  Similarly,  the  Mouse_smart-seq  dataset,  derived  using  Smart-seq  v4 technology, includes 15,571 cells from ALM and VISp, sequenced as part of the same study 9 as the Mouse_10x dataset. This facilitates an inter-assay zero-shot query on the models adapted for the Mouse dataset, using the identical set of 2,000 genes to maintain uniformity in the feature space across datasets.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 3: Benchmarking Dataset descriptions\nMouse_10x : The Mouse_10x dataset, independently derived from 10x Genomics, encompasses 29,763 cells from ALM and VISp. This dataset was curated from the original study 9 to align cell type contexts with those in the Mouse dataset, thus facilitating a zero-shot query on the models adapted for the Mouse dataset. For consistency and to ensure queries were performed within the same feature space, the same set of 2,000 genes identified in the Mouse dataset was utilized.\nMouse_smart-seq :  Similarly,  the  Mouse_smart-seq  dataset,  derived  using  Smart-seq  v4 technology, includes 15,571 cells from ALM and VISp, sequenced as part of the same study 9 as the Mouse_10x dataset. This facilitates an inter-assay zero-shot query on the models adapted for the Mouse dataset, using the identical set of 2,000 genes to maintain uniformity in the feature space across datasets.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 3: Benchmarking Dataset descriptions"], "pages": [5], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/28", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 5, "bbox": {"l": 72.0, "t": 336.22463999999997, "r": 543.0777120000001, "b": 275.82830532596677, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 470]}]}, {"self_ref": "#/texts/29", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 5, "bbox": {"l": 72.0, "t": 260.38464, "r": 543.0941280000003, "b": 199.98830532596685, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 402]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 3: Benchmarking Dataset descriptions"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:12:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 12, "text": "Macaque . The Macaque dataset contains 25,481 single cells from five samples, annotated with 11 major germ and somatic cell types by the original study 10 . We randomly reserved cells from one sample as the query set and utilized the remainder as the reference set under 5-fold crossvalidation. Similarly, we selected the top 2,000 highly variable genes from the orthologous gene set for model adaptation.\nC. Elegans . This dataset includes 47,423 scRNA-seq cells from adult C. elegans , collected at six different timepoints 11 . Given the species-specific cell type gap, we utilized 19 annotated tissue types as cell identities for evaluation. Cells from a single random time point were reserved for query, while the remaining cells were used as reference under 5-fold cross-validation. The top 2,000 highly variable genes from orthologous gene set were selected for analysis.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 3: Benchmarking Dataset descriptions\nMacaque . The Macaque dataset contains 25,481 single cells from five samples, annotated with 11 major germ and somatic cell types by the original study 10 . We randomly reserved cells from one sample as the query set and utilized the remainder as the reference set under 5-fold crossvalidation. Similarly, we selected the top 2,000 highly variable genes from the orthologous gene set for model adaptation.\nC. Elegans . This dataset includes 47,423 scRNA-seq cells from adult C. elegans , collected at six different timepoints 11 . Given the species-specific cell type gap, we utilized 19 annotated tissue types as cell identities for evaluation. Cells from a single random time point were reserved for query, while the remaining cells were used as reference under 5-fold cross-validation. The top 2,000 highly variable genes from orthologous gene set were selected for analysis.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 3: Benchmarking Dataset descriptions"], "pages": [5, 6], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/30", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 5, "bbox": {"l": 72.0, "t": 184.54463999999996, "r": 543.134208000001, "b": 124.14830532596682, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 405]}]}, {"self_ref": "#/texts/31", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 5, "bbox": {"l": 72.0, "t": 108.70464000000004, "r": 543.0941280000009, "b": 73.50830532596683, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 295]}, {"page_no": 6, "bbox": {"l": 72.0, "t": 717.5846399999999, "r": 543.069552, "b": 695.3483053259667, "coord_origin": "BOTTOMLEFT"}, "charspan": [296, 472]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 3: Benchmarking Dataset descriptions"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:13:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 13, "text": "BMMC and CD34 + .  This  dataset  contains  20,234  BMMCs  and  CD34 + enriched  cells  from  4 donors 12 . We used surface protein expression values from CITE-Seq to annotate cell identities based on literature that describes populations as the ground truth. This resulted in 14 groups representing immune developmental lineages, ranging from hematopoietic stem and progenitor cells (HSPCs) to Pre-B and Pro-T cells in the CD34 + enriched population, and 17 populations representing largely fully developed immune cells in the BMMCs. This dataset presents a unique challenge for unsupervised analysis, as many of the cells are distinct yet closely linked through developmental  lineages.  These  adjacent  cell  types  differ  by  the  activity  of  just  one  or  two transcription factors and the expression of as few as one or two surface proteins. The top 2,000 highly variable genes, along with all human transcription factors 7 for each cell, were selected for the cell group discovery and functional analyses.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 3: Benchmarking Dataset descriptions\nBMMC and CD34 + .  This  dataset  contains  20,234  BMMCs  and  CD34 + enriched  cells  from  4 donors 12 . We used surface protein expression values from CITE-Seq to annotate cell identities based on literature that describes populations as the ground truth. This resulted in 14 groups representing immune developmental lineages, ranging from hematopoietic stem and progenitor cells (HSPCs) to Pre-B and Pro-T cells in the CD34 + enriched population, and 17 populations representing largely fully developed immune cells in the BMMCs. This dataset presents a unique challenge for unsupervised analysis, as many of the cells are distinct yet closely linked through developmental  lineages.  These  adjacent  cell  types  differ  by  the  activity  of  just  one  or  two transcription factors and the expression of as few as one or two surface proteins. The top 2,000 highly variable genes, along with all human transcription factors 7 for each cell, were selected for the cell group discovery and functional analyses.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 3: Benchmarking Dataset descriptions"], "pages": [6], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/33", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 6, "bbox": {"l": 72.0, "t": 681.30336, "r": 543.1657439999999, "b": 543.4283053259668, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 1017]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 3: Benchmarking Dataset descriptions"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:14:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 14, "text": "Lung atlas . The integrated lung cancer transcriptome atlas 13 includes over 1.2 million cells from 19  studies  and  309  patients,  refining  patient  stratification  by  immune  phenotype  and  linking histological subtypes. It provides hierarchical annotations of major cell types, including epithelial cells, T cells, B cells, macrophages, dendritic cells, fibroblasts, endothelial cells, and neutrophils. Each major cell type is further subdivided into finer subtypes. This detailed annotation enables comprehensive characterization of the tumor microenvironment and immune landscape in lung cancer.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 3: Benchmarking Dataset descriptions\nLung atlas . The integrated lung cancer transcriptome atlas 13 includes over 1.2 million cells from 19  studies  and  309  patients,  refining  patient  stratification  by  immune  phenotype  and  linking histological subtypes. It provides hierarchical annotations of major cell types, including epithelial cells, T cells, B cells, macrophages, dendritic cells, fibroblasts, endothelial cells, and neutrophils. Each major cell type is further subdivided into finer subtypes. This detailed annotation enables comprehensive characterization of the tumor microenvironment and immune landscape in lung cancer.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 3: Benchmarking Dataset descriptions"], "pages": [6], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/34", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 6, "bbox": {"l": 72.0, "t": 529.6233599999999, "r": 543.2931840000001, "b": 442.3883053259668, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 605]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 3: Benchmarking Dataset descriptions"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:15:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 15, "text": "Bivalent promoters. This genome-wide dataset is derived from ChIP-seq maps of H3K4me3 and H3K27me3 in human embryonic stem cells. Promoters containing both marks were labeled as bivalent  (~4.8 k  genes),  while  those  with  only  H3K4me3  were  labeled  as  H3K4  only  (~11.6 k genes), resulting in a balanced reference among approximately 20 thousand annotated promoters for  chromatin  state  prediction  tasks.  The  labeling  was  performed  in  the  original  study 14 .  For consistency,  we  adopted  the  data  partitions  provided  by  Geneformer's  preprocessing  for  this dataset across all benchmarked models.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 3: Benchmarking Dataset descriptions\nBivalent promoters. This genome-wide dataset is derived from ChIP-seq maps of H3K4me3 and H3K27me3 in human embryonic stem cells. Promoters containing both marks were labeled as bivalent  (~4.8 k  genes),  while  those  with  only  H3K4me3  were  labeled  as  H3K4  only  (~11.6 k genes), resulting in a balanced reference among approximately 20 thousand annotated promoters for  chromatin  state  prediction  tasks.  The  labeling  was  performed  in  the  original  study 14 .  For consistency,  we  adopted  the  data  partitions  provided  by  Geneformer's  preprocessing  for  this dataset across all benchmarked models.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 3: Benchmarking Dataset descriptions"], "pages": [6], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/35", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 6, "bbox": {"l": 72.0, "t": 426.70464, "r": 543.2225279999998, "b": 341.10830532596685, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 625]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 3: Benchmarking Dataset descriptions"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:16:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 16, "text": "Long-range TFs. This dataset originates from the systematic analysis by Chen et al. 15 ,  which integrated thousands of TF ChIP-seq profiles with gene expression and Hi-C data. Each TF was classified as either long-range (49 factors whose regulatory influence typically extends more than 10 kb from a promoter) or short-range (11 factors acting within approximately 1 kb). Geneformer aggregated these annotations across all genes bound by each TF and conducted a 5-fold split, creating a labeled corpus that captures distance-dependent regulatory logic, which we used for benchmarking.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 3: Benchmarking Dataset descriptions\nLong-range TFs. This dataset originates from the systematic analysis by Chen et al. 15 ,  which integrated thousands of TF ChIP-seq profiles with gene expression and Hi-C data. Each TF was classified as either long-range (49 factors whose regulatory influence typically extends more than 10 kb from a promoter) or short-range (11 factors acting within approximately 1 kb). Geneformer aggregated these annotations across all genes bound by each TF and conducted a 5-fold split, creating a labeled corpus that captures distance-dependent regulatory logic, which we used for benchmarking.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 3: Benchmarking Dataset descriptions"], "pages": [6], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/36", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 6, "bbox": {"l": 72.0, "t": 327.06335999999993, "r": 543.1109759999999, "b": 239.82830532596677, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 585]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 3: Benchmarking Dataset descriptions"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:17:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 17, "text": "NOTCH1 (N1) network . This dataset contains measurements of 119 signature genes in patientderived iPSC endothelial cells with heterozygous N1 loss. Of these, 61 central nodes occupy highly connected regulatory hubs, while 58 peripheral nodes are located on the network outskirts. The labels originate from the original network-based drug screen study 16 , in which targeted RNA sequencing quantified how small-molecule treatments altered the expression of these nodes. For benchmarking, we applied Geneformer's central versus peripheral transcription factor split for 5fold cross validation.\nPBMC-10k .  This dataset comprises two batches of single-cell RNA sequencing data obtained from  peripheral  blood  mononuclear  cells  (PBMCs)  of  a  healthy  human  donor,  designed specifically for batch integration evaluation. The first batch contains 7,982 cells, and the second batch includes 4,008 cells, across which nine cell types have been annotated by the original study 17 .", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 3: Benchmarking Dataset descriptions\nNOTCH1 (N1) network . This dataset contains measurements of 119 signature genes in patientderived iPSC endothelial cells with heterozygous N1 loss. Of these, 61 central nodes occupy highly connected regulatory hubs, while 58 peripheral nodes are located on the network outskirts. The labels originate from the original network-based drug screen study 16 , in which targeted RNA sequencing quantified how small-molecule treatments altered the expression of these nodes. For benchmarking, we applied Geneformer's central versus peripheral transcription factor split for 5fold cross validation.\nPBMC-10k .  This dataset comprises two batches of single-cell RNA sequencing data obtained from  peripheral  blood  mononuclear  cells  (PBMCs)  of  a  healthy  human  donor,  designed specifically for batch integration evaluation. The first batch contains 7,982 cells, and the second batch includes 4,008 cells, across which nine cell types have been annotated by the original study 17 .", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 3: Benchmarking Dataset descriptions"], "pages": [6, 7], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/37", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 6, "bbox": {"l": 72.0, "t": 221.22623999999996, "r": 543.0732959999999, "b": 132.30830532596678, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 591]}]}, {"self_ref": "#/texts/38", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 6, "bbox": {"l": 72.0, "t": 116.86464000000001, "r": 543.0923040000001, "b": 81.6683053259668, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 284]}, {"page_no": 7, "bbox": {"l": 72.0, "t": 717.5846399999999, "r": 543.1010880000019, "b": 695.3483053259667, "coord_origin": "BOTTOMLEFT"}, "charspan": [285, 388]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 3: Benchmarking Dataset descriptions"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:18:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 18, "text": "Perirhinal  cortex .  This  dataset  includes  two  batches  derived  from  606  high-quality  samples across  ten  distinct  brain  regions.  The  first  batch  contains  8,465  cells,  and  the  second  batch consists of 9,070 cells. Each batch features 10 cell types that have been annotated according to the original study 18 .\nCOVID-Batch .  The  dataset  is  constructed  from  18  distinct  batches  derived  from  lung  tissue, PBMCs, and bone marrow cells. To ensure a representative cross-section of cell types for robust analysis, it includes only 20,000 selected cells with 39 annotated cell types, as provided by the original study 19 .", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 3: Benchmarking Dataset descriptions\nPerirhinal  cortex .  This  dataset  includes  two  batches  derived  from  606  high-quality  samples across  ten  distinct  brain  regions.  The  first  batch  contains  8,465  cells,  and  the  second  batch consists of 9,070 cells. Each batch features 10 cell types that have been annotated according to the original study 18 .\nCOVID-Batch .  The  dataset  is  constructed  from  18  distinct  batches  derived  from  lung  tissue, PBMCs, and bone marrow cells. To ensure a representative cross-section of cell types for robust analysis, it includes only 20,000 selected cells with 39 annotated cell types, as provided by the original study 19 .", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 3: Benchmarking Dataset descriptions"], "pages": [7], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/40", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 7, "bbox": {"l": 72.0, "t": 679.66464, "r": 543.0627360000007, "b": 631.9883053259668, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 331]}]}, {"self_ref": "#/texts/41", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 7, "bbox": {"l": 72.0, "t": 616.54464, "r": 543.1167360000003, "b": 568.8683053259668, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 317]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 3: Benchmarking Dataset descriptions"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:19:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 19, "text": "Adamson . This dataset encompasses perturbed gene expression data from the K562 leukemia cell line, generated using Perturb-seq as detailed in the original study 20 .  It  includes 86 unique single-gene  perturbations  implemented  through  CRISPR  interference,  with  each  perturbation analyzed in approximately 100 cells. The train set consists of 57 perturbations. The validation set consists of 7 perturbations. The test set consists of 22 perturbations split by GEARS 21 .", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 3: Benchmarking Dataset descriptions\nAdamson . This dataset encompasses perturbed gene expression data from the K562 leukemia cell line, generated using Perturb-seq as detailed in the original study 20 .  It  includes 86 unique single-gene  perturbations  implemented  through  CRISPR  interference,  with  each  perturbation analyzed in approximately 100 cells. The train set consists of 57 perturbations. The validation set consists of 7 perturbations. The test set consists of 22 perturbations split by GEARS 21 .", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 3: Benchmarking Dataset descriptions"], "pages": [7], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/42", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 7, "bbox": {"l": 72.0, "t": 553.18464, "r": 543.0362640000016, "b": 492.7883053259668, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 479]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 3: Benchmarking Dataset descriptions"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:20:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 20, "text": "Norman . This dataset features perturbed gene expression data from the K562 leukemia cell line, obtained using Perturb-seq as described in the original study 22 . It is a challenging dataset as it includes  131  two-gene  perturbations  and  152  one-gene  perturbations,  with  each  perturbation replicated in approximately 300 to 700 cells. The train set consists of 137 perturbations. The validation  set  consists  of  30  perturbations.  The  test  set  consists  of  116  perturbations  split  by GEARS 21 .  In  the  scFoundation's  benchmarking,  we  used  its  5-fold  data  partitions  and  gene relationships defined by its gene vocabulary.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 3: Benchmarking Dataset descriptions\nNorman . This dataset features perturbed gene expression data from the K562 leukemia cell line, obtained using Perturb-seq as described in the original study 22 . It is a challenging dataset as it includes  131  two-gene  perturbations  and  152  one-gene  perturbations,  with  each  perturbation replicated in approximately 300 to 700 cells. The train set consists of 137 perturbations. The validation  set  consists  of  30  perturbations.  The  test  set  consists  of  116  perturbations  split  by GEARS 21 .  In  the  scFoundation's  benchmarking,  we  used  its  5-fold  data  partitions  and  gene relationships defined by its gene vocabulary.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 3: Benchmarking Dataset descriptions"], "pages": [7], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/43", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 7, "bbox": {"l": 72.0, "t": 477.34463999999997, "r": 543.088104000002, "b": 391.74830532596684, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 652]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 3: Benchmarking Dataset descriptions"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:21:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 21, "text": "Replogle_k562 : This dataset records genome-wide perturbations in the K562 leukemia cell line, achieved using clustered regularly interspaced short palindromic repeats (CRISPR) interference as reported in the original study 23 . The dataset is divided into a training set with 278 perturbations and a test set with 103 perturbations using the protocol provided by GEARS 21 .  Perturbations without recorded details of the perturbed gene were excluded from our benchmarking, resulting in  a  final  count  of  68,716 cells across the remaining 412 perturbations. In the scFoundation's benchmarking,  we  used  its  5-fold  data  partitions  and  gene  relationships  defined  by  its  gene vocabulary.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 3: Benchmarking Dataset descriptions\nReplogle_k562 : This dataset records genome-wide perturbations in the K562 leukemia cell line, achieved using clustered regularly interspaced short palindromic repeats (CRISPR) interference as reported in the original study 23 . The dataset is divided into a training set with 278 perturbations and a test set with 103 perturbations using the protocol provided by GEARS 21 .  Perturbations without recorded details of the perturbed gene were excluded from our benchmarking, resulting in  a  final  count  of  68,716 cells across the remaining 412 perturbations. In the scFoundation's benchmarking,  we  used  its  5-fold  data  partitions  and  gene  relationships  defined  by  its  gene vocabulary.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 3: Benchmarking Dataset descriptions"], "pages": [7], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/44", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 7, "bbox": {"l": 72.0, "t": 376.06463999999994, "r": 543.1768799999999, "b": 277.74830532596684, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 700]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 3: Benchmarking Dataset descriptions"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:22:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 22, "text": "Replogle_rpe1 : This dataset records genome-wide perturbations in the RPE1 leukemia cell line, implemented using CRISPR interference as described in the original study 23 . It is divided into a training  set  containing  439  perturbations  and  a  test  set  with  163  perturbations,  organized according to GEARS 21 . Perturbations lacking records of the perturbed gene were excluded from our  benchmarking,  resulting  in  a  refined  dataset  of  76,289  cells  across  the  remaining  651 perturbations.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 3: Benchmarking Dataset descriptions\nReplogle_rpe1 : This dataset records genome-wide perturbations in the RPE1 leukemia cell line, implemented using CRISPR interference as described in the original study 23 . It is divided into a training  set  containing  439  perturbations  and  a  test  set  with  163  perturbations,  organized according to GEARS 21 . Perturbations lacking records of the perturbed gene were excluded from our  benchmarking,  resulting  in  a  refined  dataset  of  76,289  cells  across  the  remaining  651 perturbations.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 3: Benchmarking Dataset descriptions"], "pages": [7], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/45", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 7, "bbox": {"l": 72.0, "t": 262.30463999999995, "r": 543.16032, "b": 189.1883053259669, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 509]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 3: Benchmarking Dataset descriptions"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:23:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 23, "text": "scBERT .  We incorporated scBERT 24 as the backbone for scPEFT in our conditional cell type identification and cross-species benchmarking, utilizing its provided cell type identification script with default hyperparameters. Unlike other scLLMs, scBERT standardizes input cell lengths to its gene vocabulary by padding non-existent genes with zero expression values and concatenating all gene embeddings into its projector module. This design results in a significantly larger number of parameters and increased training time compared to other scLLMs. Hence, we implemented the most lightweight Prefix adapter in scPEFT as the default adapter for its benchmarks in this study.  Detailed  hyperparameter  settings  are  provided  in Supplementary  Table  3 and  the recommended adapters for various downstream tasks are summarized in Supplementary Note 10 .", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 4: Benchmarking setup\nscBERT .  We incorporated scBERT 24 as the backbone for scPEFT in our conditional cell type identification and cross-species benchmarking, utilizing its provided cell type identification script with default hyperparameters. Unlike other scLLMs, scBERT standardizes input cell lengths to its gene vocabulary by padding non-existent genes with zero expression values and concatenating all gene embeddings into its projector module. This design results in a significantly larger number of parameters and increased training time compared to other scLLMs. Hence, we implemented the most lightweight Prefix adapter in scPEFT as the default adapter for its benchmarks in this study.  Detailed  hyperparameter  settings  are  provided  in Supplementary  Table  3 and  the recommended adapters for various downstream tasks are summarized in Supplementary Note 10 .", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 4: Benchmarking setup"], "pages": [8], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/48", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 8, "bbox": {"l": 72.0, "t": 690.18336, "r": 543.2490239999997, "b": 565.0283053259668, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 855]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 4: Benchmarking setup"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:24:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 24, "text": "Geneformer .  We  used  Geneformer 25 as  the  backbone  for  scPEFT  in  transcription  factor identification, conditional cell type identification, and cross-species benchmarking, employing its provided gene classification and cell type identification scripts along with the 12-layer pretrained model.  Detailed  hyperparameter  settings  are  listed  in Supplementary  Table  3 ,  and  the recommended adapters for various downstream tasks are summarized in Supplementary Note 10 .\nscGPT .  We  incorporated  scGPT 3 as  the  backbone  for  scPEFT  in  our  conditional  cell  type identification, cross-species benchmarking (using its provided cell type identification script), and novel  cell  group  discovery  (using  its  unsupervised  pretraining  script).  In  all  experiments,  we applied the recommended pretrained model trained on the whole human cell atlas, except for the near-context model comparison, where lung- and pan-cancer-specific pretrained models were used.  Detailed  hyperparameter  settings  are  provided  in Supplementary  Table  3 and  the recommended adapters for various downstream tasks are summarized in Supplementary Note 10 .", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 4: Benchmarking setup\nGeneformer .  We  used  Geneformer 25 as  the  backbone  for  scPEFT  in  transcription  factor identification, conditional cell type identification, and cross-species benchmarking, employing its provided gene classification and cell type identification scripts along with the 12-layer pretrained model.  Detailed  hyperparameter  settings  are  listed  in Supplementary  Table  3 ,  and  the recommended adapters for various downstream tasks are summarized in Supplementary Note 10 .\nscGPT .  We  incorporated  scGPT 3 as  the  backbone  for  scPEFT  in  our  conditional  cell  type identification, cross-species benchmarking (using its provided cell type identification script), and novel  cell  group  discovery  (using  its  unsupervised  pretraining  script).  In  all  experiments,  we applied the recommended pretrained model trained on the whole human cell atlas, except for the near-context model comparison, where lung- and pan-cancer-specific pretrained models were used.  Detailed  hyperparameter  settings  are  provided  in Supplementary  Table  3 and  the recommended adapters for various downstream tasks are summarized in Supplementary Note 10 .", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 4: Benchmarking setup"], "pages": [8], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/49", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 8, "bbox": {"l": 72.0, "t": 550.98336, "r": 543.0909600000001, "b": 476.4683053259668, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 484]}]}, {"self_ref": "#/texts/50", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 8, "bbox": {"l": 72.0, "t": 462.42336, "r": 543.1630320000013, "b": 362.4683053259668, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 678]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 4: Benchmarking setup"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:25:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 25, "text": "scFoundation . We incorporated scFoundation 26 as the backbone for scPEFT in our conditional cell  type  identification  (using  the  same  settings  as  in  scGPT)  and  perturbation  prediction benchmarking (using its provided perturbation prediction script, which connects it to GEARS). In all experiments, we used the provided 12-layer pretrained model weights. Detailed hyperparameter settings are listed in Supplementary Table 3 , and the recommended adapters for various downstream tasks are summarized in Supplementary Note 10 .\nSingleR. We  leveraged  SingleR's  reference  mapping  protocol  to  benchmark  the  cell  type identification task 27 . The protocol normalizes the input gene expression profiles and then applies Principal Component Analysis (PCA) to reduce the dimensionality of gene expression for both the reference set and the query set. For each query cell, its cell type is assigned based on the most similar  reference  cells,  as  determined  by  their  similarities  in  the  reduced-dimensional  gene expression space.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 4: Benchmarking setup\nscFoundation . We incorporated scFoundation 26 as the backbone for scPEFT in our conditional cell  type  identification  (using  the  same  settings  as  in  scGPT)  and  perturbation  prediction benchmarking (using its provided perturbation prediction script, which connects it to GEARS). In all experiments, we used the provided 12-layer pretrained model weights. Detailed hyperparameter settings are listed in Supplementary Table 3 , and the recommended adapters for various downstream tasks are summarized in Supplementary Note 10 .\nSingleR. We  leveraged  SingleR's  reference  mapping  protocol  to  benchmark  the  cell  type identification task 27 . The protocol normalizes the input gene expression profiles and then applies Principal Component Analysis (PCA) to reduce the dimensionality of gene expression for both the reference set and the query set. For each query cell, its cell type is assigned based on the most similar  reference  cells,  as  determined  by  their  similarities  in  the  reduced-dimensional  gene expression space.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 4: Benchmarking setup"], "pages": [8], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/51", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 8, "bbox": {"l": 72.0, "t": 348.66335999999995, "r": 543.1099200000009, "b": 274.1483053259668, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 536]}]}, {"self_ref": "#/texts/52", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 8, "bbox": {"l": 72.0, "t": 258.4646399999999, "r": 543.25344, "b": 185.58830532596676, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 512]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 4: Benchmarking setup"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:26:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 26, "text": "Seurat . We included Seurat 28 in our benchmarking of cell type identification using its reference mapping protocol. This protocol normalizes expression profiles and represents both reference and query cells through PCA-based low-dimensional reduction. When transferring cell type labels from the reference to the query set, a mutual nearest neighbor strategy is applied. The closest neighbors from the reference set determine the cell type assigned to each query cell. Additionally, we  used  Seurat's  differential  expression  analysis  script  to  identify  genes  contributing  to  the differentiation of cell types in the COVID-19 dataset.\nscVI . scVI 29 is a toolbox comprising deep generative models for various omics analyses. It builds a variational autoencoder (VAE) architecture to model batch effects as latent variables, jointly learning cellular representations that capture biological variability across multiple batches. We benchmarked its batch correction capacity with settings suggested by a benchmarking study scIB 2 .", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 4: Benchmarking setup\nSeurat . We included Seurat 28 in our benchmarking of cell type identification using its reference mapping protocol. This protocol normalizes expression profiles and represents both reference and query cells through PCA-based low-dimensional reduction. When transferring cell type labels from the reference to the query set, a mutual nearest neighbor strategy is applied. The closest neighbors from the reference set determine the cell type assigned to each query cell. Additionally, we  used  Seurat's  differential  expression  analysis  script  to  identify  genes  contributing  to  the differentiation of cell types in the COVID-19 dataset.\nscVI . scVI 29 is a toolbox comprising deep generative models for various omics analyses. It builds a variational autoencoder (VAE) architecture to model batch effects as latent variables, jointly learning cellular representations that capture biological variability across multiple batches. We benchmarked its batch correction capacity with settings suggested by a benchmarking study scIB 2 .", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 4: Benchmarking setup"], "pages": [8, 9], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/53", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 8, "bbox": {"l": 72.0, "t": 171.5433599999999, "r": 543.1554960000016, "b": 84.3083053259669, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 645]}]}, {"self_ref": "#/texts/55", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 9, "bbox": {"l": 72.0, "t": 706.7433599999999, "r": 546.12528, "b": 657.1883053259668, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 393]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 4: Benchmarking setup"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:27:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 27, "text": "Scanorama .  Scanorama 30 addresses batch correction by identifying shared cell types across batches through nearest-neighbor searches, utilizing PCA for dimensionality reduction and an approximate  nearest-neighbors  algorithm  based  on  locality-sensitive  hashing  and  random projection  trees.  Mutually  linked  cells  create  matched  batches,  which  are  then  corrected  and merged into a unified panorama. We also benchmarked its batch correction capability using the settings recommended by scIB 2 .\nGEARS . GEARS 21 is a computational tool designed to predict transcriptional responses to both single and multigene perturbations. By integrating deep learning with a curated knowledge graph, GEARS facilitates the understanding and inference of cellular reactions to genetic modifications for guiding the design of perturbational experiments. We utilized GEARS's data preprocessing script to prepare data partitions for all benchmarks in the gene perturbation task, adhering to the settings recommended by its official guidelines to evaluate its performance.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 4: Benchmarking setup\nScanorama .  Scanorama 30 addresses batch correction by identifying shared cell types across batches through nearest-neighbor searches, utilizing PCA for dimensionality reduction and an approximate  nearest-neighbors  algorithm  based  on  locality-sensitive  hashing  and  random projection  trees.  Mutually  linked  cells  create  matched  batches,  which  are  then  corrected  and merged into a unified panorama. We also benchmarked its batch correction capability using the settings recommended by scIB 2 .\nGEARS . GEARS 21 is a computational tool designed to predict transcriptional responses to both single and multigene perturbations. By integrating deep learning with a curated knowledge graph, GEARS facilitates the understanding and inference of cellular reactions to genetic modifications for guiding the design of perturbational experiments. We utilized GEARS's data preprocessing script to prepare data partitions for all benchmarks in the gene perturbation task, adhering to the settings recommended by its official guidelines to evaluate its performance.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 4: Benchmarking setup"], "pages": [9], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/56", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 9, "bbox": {"l": 72.0, "t": 643.3833599999999, "r": 543.1011360000018, "b": 568.8683053259668, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 512]}]}, {"self_ref": "#/texts/57", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 9, "bbox": {"l": 72.0, "t": 554.82336, "r": 543.1263360000012, "b": 480.3083053259668, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 558]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 4: Benchmarking setup"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:28:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 28, "text": "Linear  perturbation  model. A  recent  stud 31 benchmarked  deep  learning  models,  including scLLMs, against a simple linear model, demonstrating that these deep learning models may not outperform the basic linear model in perturbation prediction. This model defines a linear projection 𝑊∈ℝ 2×+ that  maps 𝑘 -dimensional  gene  expression  representations G to  the 𝑙 -dimensional perturbed  gene  representations P .  The  projection  matrix 𝑊 is  estimated  by  minimizing  the following objective function:\n<!-- formula-not-decoded -->\nWhere 𝑌 %41!5 is  the  training  data  matrix,  with  one  row  per  read-out  gene  expression  and  one column  per  perturbation.  In  the  official  implementation, G consists  of  the top  10  principal components derived from a PCA on 𝑌 %41!5 , and P is the subset of G with the rows corresponding to genes that were perturbed in the training data. b is the row-wise means of the training data:\n<!-- formula-not-decoded -->", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 4: Benchmarking setup\nLinear  perturbation  model. A  recent  stud 31 benchmarked  deep  learning  models,  including scLLMs, against a simple linear model, demonstrating that these deep learning models may not outperform the basic linear model in perturbation prediction. This model defines a linear projection 𝑊∈ℝ 2×+ that  maps 𝑘 -dimensional  gene  expression  representations G to  the 𝑙 -dimensional perturbed  gene  representations P .  The  projection  matrix 𝑊 is  estimated  by  minimizing  the following objective function:\n<!-- formula-not-decoded -->\nWhere 𝑌 %41!5 is  the  training  data  matrix,  with  one  row  per  read-out  gene  expression  and  one column  per  perturbation.  In  the  official  implementation, G consists  of  the top  10  principal components derived from a PCA on 𝑌 %41!5 , and P is the subset of G with the rows corresponding to genes that were perturbed in the training data. b is the row-wise means of the training data:\n<!-- formula-not-decoded -->", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 4: Benchmarking setup"], "pages": [9], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/58", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 9, "bbox": {"l": 72.0, "t": 466.26336, "r": 543.1065600000009, "b": 381.6683053259668, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 512]}]}, {"self_ref": "#/texts/59", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "formula", "prov": [{"page_no": 9, "bbox": {"l": 229.895256, "t": 377.68368, "r": 540.0216, "b": 355.63922425263155, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 37]}]}, {"self_ref": "#/texts/60", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 9, "bbox": {"l": 72.0, "t": 352.78463999999997, "r": 543.1440479999997, "b": 299.10830532596685, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 400]}]}, {"self_ref": "#/texts/61", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "formula", "prov": [{"page_no": 9, "bbox": {"l": 266.70768, "t": 294.88367999999997, "r": 540.0216, "b": 269.0055304421053, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 26]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 4: Benchmarking setup"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:29:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 29, "text": "Once the matrix 𝑊 is learned from training data, it is subsequently applied to test gene expression data to predict the corresponding perturbation responses 𝑌 R via:\n<!-- formula-not-decoded -->\nHere, 𝑃 R is the matrix formed by the rows of G corresponding to genes perturbed in the test data.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 4: Benchmarking setup\nOnce the matrix 𝑊 is learned from training data, it is subsequently applied to test gene expression data to predict the corresponding perturbation responses 𝑌 R via:\n<!-- formula-not-decoded -->\nHere, 𝑃 R is the matrix formed by the rows of G corresponding to genes perturbed in the test data.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 4: Benchmarking setup"], "pages": [9], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/62", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 9, "bbox": {"l": 72.0, "t": 251.02463999999998, "r": 543.1361520000014, "b": 225.6683053259669, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 165]}]}, {"self_ref": "#/texts/63", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "formula", "prov": [{"page_no": 9, "bbox": {"l": 269.28312, "t": 221.68367999999998, "r": 540.0216, "b": 210.43922425263156, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 19]}]}, {"self_ref": "#/texts/64", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 9, "bbox": {"l": 72.0, "t": 206.56367999999998, "r": 541.3392, "b": 195.1883053259669, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 98]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 4: Benchmarking setup"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:30:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 30, "text": "To further assess scPEFT's sensitivity to hyperparameters, we expanded the analysis originally presented  in  Fig.  3e  to  include  a  broader  range  of  tasks  and  datasets,  using  scGPT  as  the backbone model.\nFirst, beyond the M.S. dataset, we evaluated two additional datasets for the cell type identification task. As in Fig. 3e, we varied the number of hidden layers in each adapter. Across all settings and datasets, we observed consistent performance (see Supplementary Figs . 9ab ), with average accuracy variance remaining below  5%,  confirming the robustness of scPEFT  to  this hyperparameter.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 5: Additional hyperparameter sensitivity analysis of scPEFT\nTo further assess scPEFT's sensitivity to hyperparameters, we expanded the analysis originally presented  in  Fig.  3e  to  include  a  broader  range  of  tasks  and  datasets,  using  scGPT  as  the backbone model.\nFirst, beyond the M.S. dataset, we evaluated two additional datasets for the cell type identification task. As in Fig. 3e, we varied the number of hidden layers in each adapter. Across all settings and datasets, we observed consistent performance (see Supplementary Figs . 9ab ), with average accuracy variance remaining below  5%,  confirming the robustness of scPEFT  to  this hyperparameter.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 5: Additional hyperparameter sensitivity analysis of scPEFT"], "pages": [10], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/67", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 10, "bbox": {"l": 72.0, "t": 688.54464, "r": 543.3240960000002, "b": 649.7483053259668, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 216]}]}, {"self_ref": "#/texts/68", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 10, "bbox": {"l": 72.0, "t": 630.2246399999999, "r": 543.2600640000002, "b": 562.3883053259668, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 394]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 5: Additional hyperparameter sensitivity analysis of scPEFT"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:31:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 31, "text": "Next, we conducted similar hyperparameter sensitivity analyses for two other adaptation tasks supported by scGPT, including perturbation response prediction and batch effect correction. For perturbation response prediction ( Supplementary Figs. 9c-9f ), we focused on the mean squared error at the top 20 differentially expressed genes (MSE_DE), a sensitive and task-relevant metric. Across all tested hyperparameter configurations and datasets, only the LoRA adapter showed notable sensitivity, with an MSE_DE variance of 0.08 on the Adamson dataset. All other adapters exhibited minimal variation (MSE_DE variance < 0.03). Although a few configurations slightly underperformed fully finetuned scGPT, scPEFT still offered significant efficiency advantages due to the substantially reduced number of learnable parameters.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 5: Additional hyperparameter sensitivity analysis of scPEFT\nNext, we conducted similar hyperparameter sensitivity analyses for two other adaptation tasks supported by scGPT, including perturbation response prediction and batch effect correction. For perturbation response prediction ( Supplementary Figs. 9c-9f ), we focused on the mean squared error at the top 20 differentially expressed genes (MSE_DE), a sensitive and task-relevant metric. Across all tested hyperparameter configurations and datasets, only the LoRA adapter showed notable sensitivity, with an MSE_DE variance of 0.08 on the Adamson dataset. All other adapters exhibited minimal variation (MSE_DE variance < 0.03). Although a few configurations slightly underperformed fully finetuned scGPT, scPEFT still offered significant efficiency advantages due to the substantially reduced number of learnable parameters.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 5: Additional hyperparameter sensitivity analysis of scPEFT"], "pages": [10], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/69", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 10, "bbox": {"l": 72.0, "t": 543.10464, "r": 543.3307200000003, "b": 416.94830532596677, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 821]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 5: Additional hyperparameter sensitivity analysis of scPEFT"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:32:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 32, "text": "In  the  batch  effect  correction  task,  we  observed  similarly  low  hyperparameter  sensitivity ( Supplementary Figs. 9g-9i ). We followed scGPT to use Overall1 score as a comprehensive metric  for  this  task.  It  weighted  sum  of  biological  conservation  (AvgBio)  and  batch  mixing (AvgBatch)  with  a  ratio  of  6:4,  where  AvgBio  aggregates  three  cell  type  clustering  metrics: normalized mutual information (NMI), adjusted Rand index (ARI), and average silhouette width (ASW) based on cell type labels and AvgBatch reflects batch integration quality, combining ASW on batch labels and graph connectivity. The Overall scores varied by only around 0.04 across three datasets in our attempts.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 5: Additional hyperparameter sensitivity analysis of scPEFT\nIn  the  batch  effect  correction  task,  we  observed  similarly  low  hyperparameter  sensitivity ( Supplementary Figs. 9g-9i ). We followed scGPT to use Overall1 score as a comprehensive metric  for  this  task.  It  weighted  sum  of  biological  conservation  (AvgBio)  and  batch  mixing (AvgBatch)  with  a  ratio  of  6:4,  where  AvgBio  aggregates  three  cell  type  clustering  metrics: normalized mutual information (NMI), adjusted Rand index (ARI), and average silhouette width (ASW) based on cell type labels and AvgBatch reflects batch integration quality, combining ASW on batch labels and graph connectivity. The Overall scores varied by only around 0.04 across three datasets in our attempts.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 5: Additional hyperparameter sensitivity analysis of scPEFT"], "pages": [10], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/70", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 10, "bbox": {"l": 72.0, "t": 397.66463999999996, "r": 543.06912, "b": 285.90830532596686, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 712]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 5: Additional hyperparameter sensitivity analysis of scPEFT"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:33:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 33, "text": "These consistent results across tasks and datasets support our claim that scPEFT is insensitive to adapter hyperparameter configurations when using scGPT. Based on these observations, we selected  a  default  configuration  that  offers  a  substantial  trade-off  between  performance  and computational efficiency for each adapter in scPEFT (highlighted in Fig. 3e in the main text and the Supplementary Fig. 9 ). This default setting was then applied across all other experiments involving different scLLM backbones in this study, without further hyperparameter tuning.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 5: Additional hyperparameter sensitivity analysis of scPEFT\nThese consistent results across tasks and datasets support our claim that scPEFT is insensitive to adapter hyperparameter configurations when using scGPT. Based on these observations, we selected  a  default  configuration  that  offers  a  substantial  trade-off  between  performance  and computational efficiency for each adapter in scPEFT (highlighted in Fig. 3e in the main text and the Supplementary Fig. 9 ). This default setting was then applied across all other experiments involving different scLLM backbones in this study, without further hyperparameter tuning.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 5: Additional hyperparameter sensitivity analysis of scPEFT"], "pages": [10], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/71", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 10, "bbox": {"l": 72.0, "t": 266.62464, "r": 543.26448, "b": 184.14830532596682, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 572]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 5: Additional hyperparameter sensitivity analysis of scPEFT"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:34:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 34, "text": "To evaluate the time efficiency of scLLM utility, we conducted runtime benchmarks comparing all adapter strategies in scPEFT against traditional finetuning across four different scLLM backbones and  diverse  downstream  tasks,  as  summarized  in Supplementary  Table 4 .  Notably,  all benchmarks were computed based on query cell time consumption, regardless of whether the tasks were at the gene level. For the cell type identification task, scBERT inputs the entire gene panel rather than just the expressed genes, resulting in  an additional excitation time. For TF identification, even though transcription factors (TFs) are a small proportion of genes, Geneformer still needs to input whole transcriptomics for gene contextual learning and mask out non-TFs in its inference operation, leading to a longer time than its cell type identification consumption. For the perturbation response prediction task using scPEFT with the scFoundation backbone, the reported runtimes include additional  computation  time  attributable  to  GEARS  alongside scFoundation.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 6: Runtime analysis of scPEFT\nTo evaluate the time efficiency of scLLM utility, we conducted runtime benchmarks comparing all adapter strategies in scPEFT against traditional finetuning across four different scLLM backbones and  diverse  downstream  tasks,  as  summarized  in Supplementary  Table 4 .  Notably,  all benchmarks were computed based on query cell time consumption, regardless of whether the tasks were at the gene level. For the cell type identification task, scBERT inputs the entire gene panel rather than just the expressed genes, resulting in  an additional excitation time. For TF identification, even though transcription factors (TFs) are a small proportion of genes, Geneformer still needs to input whole transcriptomics for gene contextual learning and mask out non-TFs in its inference operation, leading to a longer time than its cell type identification consumption. For the perturbation response prediction task using scPEFT with the scFoundation backbone, the reported runtimes include additional  computation  time  attributable  to  GEARS  alongside scFoundation.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 6: Runtime analysis of scPEFT"], "pages": [11], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/74", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 11, "bbox": {"l": 72.0, "t": 688.54464, "r": 543.16752, "b": 518.7083053259669, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 1064]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 6: Runtime analysis of scPEFT"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:35:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 35, "text": "Our  observations  indicate  that  while  scPEFT  substantially  reduces  the  number  of  trainable parameters,  this  reduction  does  not  always  translate  directly  into  faster  inference  times. Compared to zero-shot inference or finetuned scLLM models, scPEFT with adapters incurs a slight increase in execution time per sample (whether a gene or a cell, depending on the task). This overhead is due to the additional computations introduced by the plug-in adapters during the inference  stage  alongside  the  original  scLLM.  For  most  gene-  and  cell-level  tasks,  this  extra computation ranges from approximately 0.1 to 0.3 milliseconds, depending on the backbone and task, which is negligible and practically imperceptible to end users. Meanwhile, scPEFT maintains significant advantages in terms of reduced graphics processing unit (GPU) memory usage, lower requirements for annotated data, and faster convergence during model adaptation, as illustrated in Fig. 3 of the main text.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 6: Runtime analysis of scPEFT\nOur  observations  indicate  that  while  scPEFT  substantially  reduces  the  number  of  trainable parameters,  this  reduction  does  not  always  translate  directly  into  faster  inference  times. Compared to zero-shot inference or finetuned scLLM models, scPEFT with adapters incurs a slight increase in execution time per sample (whether a gene or a cell, depending on the task). This overhead is due to the additional computations introduced by the plug-in adapters during the inference  stage  alongside  the  original  scLLM.  For  most  gene-  and  cell-level  tasks,  this  extra computation ranges from approximately 0.1 to 0.3 milliseconds, depending on the backbone and task, which is negligible and practically imperceptible to end users. Meanwhile, scPEFT maintains significant advantages in terms of reduced graphics processing unit (GPU) memory usage, lower requirements for annotated data, and faster convergence during model adaptation, as illustrated in Fig. 3 of the main text.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 6: Runtime analysis of scPEFT"], "pages": [11], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/75", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 11, "bbox": {"l": 72.0, "t": 499.42463999999995, "r": 543.1651200000006, "b": 344.22830532596686, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 1001]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 6: Runtime analysis of scPEFT"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:36:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 36, "text": "To  provide  further  evidence  of  the  enhanced  disease  gene  enrichment  achieved  by  scPEFT relative to both native and finetuned scLLMs via attention-based analysis, we additionally report the fold-change (FC) values for the top 30 attention-ranked genes identified by scPEFT in the NSCLC and COVID-19 datasets, thereby complementing our prior evaluations of disease gene detection.\nFor the NSCLC dataset, we focused on CD4 ⁺ T cell subtypes and evaluated the attention scores of  signature  genes  originally  used  to  define  these  subtypes.  In  addition,  we  report  the  gene expression  fold  changes  for  the  top  30  attention-ranked  genes  per  CD4 ⁺ T  cell  subtype, comparing their expression in the target cell group versus all other groups ( Supplementary Figs. 10-18 ). These FC analyses highlight the specificity of the identified genes to their corresponding subtypes.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 7: Cell-group-specific analysis of top 30 genes identified by scPEFT attention\nTo  provide  further  evidence  of  the  enhanced  disease  gene  enrichment  achieved  by  scPEFT relative to both native and finetuned scLLMs via attention-based analysis, we additionally report the fold-change (FC) values for the top 30 attention-ranked genes identified by scPEFT in the NSCLC and COVID-19 datasets, thereby complementing our prior evaluations of disease gene detection.\nFor the NSCLC dataset, we focused on CD4 ⁺ T cell subtypes and evaluated the attention scores of  signature  genes  originally  used  to  define  these  subtypes.  In  addition,  we  report  the  gene expression  fold  changes  for  the  top  30  attention-ranked  genes  per  CD4 ⁺ T  cell  subtype, comparing their expression in the target cell group versus all other groups ( Supplementary Figs. 10-18 ). These FC analyses highlight the specificity of the identified genes to their corresponding subtypes.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 7: Cell-group-specific analysis of top 30 genes identified by scPEFT attention"], "pages": [12], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/78", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 12, "bbox": {"l": 72.0, "t": 673.90464, "r": 543.3152640000001, "b": 606.0683053259668, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 390]}]}, {"self_ref": "#/texts/79", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 12, "bbox": {"l": 72.0, "t": 586.54464, "r": 546.12528, "b": 503.5883053259668, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 508]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 7: Cell-group-specific analysis of top 30 genes identified by scPEFT attention"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:37:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 37, "text": "Overall, genes ranked by attention in native scGPT, finetuned scGPT, and scPEFT all showed varying levels of specificity to the target CD4 ⁺ T cell subtypes. Notably, scPEFT demonstrated an enhanced ability to identify TFs (e.g., CREM in Supplementary Fig. 10 , FOS in Supplementary Fig. 13 , FOXP3 in Supplementary Fig. 17 ) that are potentially relevant but often expressed at low  levels.  These  genes  are  typically  overlooked  by  traditional  differential  expression  (DEG) methods, but scPEFT's contextualized attention mechanism  enables  their prioritization, suggesting an advantage of deep attention-based modeling. Most notable were the regulatory T cells  ( Supplementary Fig. 17 ),  where  scPEFT  was  the  only  method  to  prioritize", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 7: Cell-group-specific analysis of top 30 genes identified by scPEFT attention\nOverall, genes ranked by attention in native scGPT, finetuned scGPT, and scPEFT all showed varying levels of specificity to the target CD4 ⁺ T cell subtypes. Notably, scPEFT demonstrated an enhanced ability to identify TFs (e.g., CREM in Supplementary Fig. 10 , FOS in Supplementary Fig. 13 , FOXP3 in Supplementary Fig. 17 ) that are potentially relevant but often expressed at low  levels.  These  genes  are  typically  overlooked  by  traditional  differential  expression  (DEG) methods, but scPEFT's contextualized attention mechanism  enables  their prioritization, suggesting an advantage of deep attention-based modeling. Most notable were the regulatory T cells  ( Supplementary Fig. 17 ),  where  scPEFT  was  the  only  method  to  prioritize", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 7: Cell-group-specific analysis of top 30 genes identified by scPEFT attention"], "pages": [12], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/80", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 12, "bbox": {"l": 72.0, "t": 484.30463999999995, "r": 543.1713119999998, "b": 328.86830532596684, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 1048]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 7: Cell-group-specific analysis of top 30 genes identified by scPEFT attention"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:38:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 38, "text": "well-known transcription factors ( FOXP3 ) and immunomodulatory molecules ( CTLA4 , TIGIT , IL2RA ). It also highlighted several genes with intriguing potential for new insights into T reg biology that have not yet been reported. Some of these genes were also among the lower-expressed genes.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 7: Cell-group-specific analysis of top 30 genes identified by scPEFT attention\nwell-known transcription factors ( FOXP3 ) and immunomodulatory molecules ( CTLA4 , TIGIT , IL2RA ). It also highlighted several genes with intriguing potential for new insights into T reg biology that have not yet been reported. Some of these genes were also among the lower-expressed genes.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 7: Cell-group-specific analysis of top 30 genes identified by scPEFT attention"], "pages": [12], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/80", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 12, "bbox": {"l": 72.0, "t": 484.30463999999995, "r": 543.1713119999998, "b": 328.86830532596684, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 1048]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 7: Cell-group-specific analysis of top 30 genes identified by scPEFT attention"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:39:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 39, "text": "In  the  FC  comparisons  for  CD4 + T  cell  subtypes ISG ( Supplementary  Fig.  14 ), Th1 -like ( Supplementary Fig. 16 ),  and Proliferation ( Supplementary Fig. 18 ),  attention-ranked genes from finetuned scGPT failed to consistently exhibit strong subtype specificity, whereas both native scGPT and scPEFT maintained clearer specificity. Moreover, scPEFT often prioritized genes with lower expression frequency but higher cell-group specificity (e.g., in T em , CD69 , Th1-like , T reg , and Proliferation  of  CD4 + T  cell  subtypes),  which  were  likely  missed  by  both  DEG  analysis  and attention analysis using native or finetuned scLLMs.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 7: Cell-group-specific analysis of top 30 genes identified by scPEFT attention\nIn  the  FC  comparisons  for  CD4 + T  cell  subtypes ISG ( Supplementary  Fig.  14 ), Th1 -like ( Supplementary Fig. 16 ),  and Proliferation ( Supplementary Fig. 18 ),  attention-ranked genes from finetuned scGPT failed to consistently exhibit strong subtype specificity, whereas both native scGPT and scPEFT maintained clearer specificity. Moreover, scPEFT often prioritized genes with lower expression frequency but higher cell-group specificity (e.g., in T em , CD69 , Th1-like , T reg , and Proliferation  of  CD4 + T  cell  subtypes),  which  were  likely  missed  by  both  DEG  analysis  and attention analysis using native or finetuned scLLMs.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 7: Cell-group-specific analysis of top 30 genes identified by scPEFT attention"], "pages": [12], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/81", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 12, "bbox": {"l": 72.0, "t": 310.98335999999995, "r": 543.2175599999997, "b": 212.46830532596687, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 654]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 7: Cell-group-specific analysis of top 30 genes identified by scPEFT attention"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:40:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 40, "text": "A similar trend was observed in the COVID-19 dataset ( Supplementary Figs. 19-20 ), where the top 30 attention-ranked genes from scPEFT demonstrated strong specificity to relevant cell states. Among all evaluated models, scPEFT consistently enriched COVID-associated genes at higher ranks  (as  shown  in Fig.  4 in  the  main  text  and  highlighted  in Supplementary Figs.  19-20 ), improving  the  identification  of  cell-state-specific  genes  without  introducing  spurious  or  nonspecific hits. In summary, scPEFT not only improves disease gene enrichment but also better maintains gene expression specificity, especially for low expression yet biologically meaningful genes, thereby supporting its robustness for disease gene discovery.\nAltogether, these results show that scPEFT can identify key regulators and cell state-defining genes. This approach overcomes statistical limitations in detecting regulators with low expression but strong cell state-driving potential.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 7: Cell-group-specific analysis of top 30 genes identified by scPEFT attention\nA similar trend was observed in the COVID-19 dataset ( Supplementary Figs. 19-20 ), where the top 30 attention-ranked genes from scPEFT demonstrated strong specificity to relevant cell states. Among all evaluated models, scPEFT consistently enriched COVID-associated genes at higher ranks  (as  shown  in Fig.  4 in  the  main  text  and  highlighted  in Supplementary Figs.  19-20 ), improving  the  identification  of  cell-state-specific  genes  without  introducing  spurious  or  nonspecific hits. In summary, scPEFT not only improves disease gene enrichment but also better maintains gene expression specificity, especially for low expression yet biologically meaningful genes, thereby supporting its robustness for disease gene discovery.\nAltogether, these results show that scPEFT can identify key regulators and cell state-defining genes. This approach overcomes statistical limitations in detecting regulators with low expression but strong cell state-driving potential.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 7: Cell-group-specific analysis of top 30 genes identified by scPEFT attention"], "pages": [12, 13], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/82", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 12, "bbox": {"l": 72.0, "t": 192.94463999999994, "r": 545.9548800000003, "b": 81.42830532596679, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 745]}]}, {"self_ref": "#/texts/84", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 13, "bbox": {"l": 72.0, "t": 702.9446399999999, "r": 543.0642720000001, "b": 664.1483053259668, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 234]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 7: Cell-group-specific analysis of top 30 genes identified by scPEFT attention"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:41:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 41, "text": "To further validate the generalizability of our unsupervised adaptation protocol, we conducted an additional experiment on a comprehensive lung cancer atlas 13 that includes over 1.2 million cells from 19 studies and 309 patients. This atlas provides hierarchical cell ontology annotations and rich metadata describing diverse cellular populations at varying levels of granularity. To ensure an out-of-context scenario for the scGPT backbone in the unsupervised protocol, we excluded cells from healthy controls.\nIn  this  experiment, only the gene expression profiles were used as input to the unsupervised adaptation protocol. The resulting cell embeddings generated by native scGPT, finetuned scGPT, and scPEFT were visualized using UMAP, with cell colors reflecting the hierarchical annotations. This  allowed  us  to  assess  how  well  each  model  captured  cellular  structure  and  revealed subpopulations within the disease atlas.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 8: Unsupervised adaptation of scPEFT to the lung cancer atlas\nTo further validate the generalizability of our unsupervised adaptation protocol, we conducted an additional experiment on a comprehensive lung cancer atlas 13 that includes over 1.2 million cells from 19 studies and 309 patients. This atlas provides hierarchical cell ontology annotations and rich metadata describing diverse cellular populations at varying levels of granularity. To ensure an out-of-context scenario for the scGPT backbone in the unsupervised protocol, we excluded cells from healthy controls.\nIn  this  experiment, only the gene expression profiles were used as input to the unsupervised adaptation protocol. The resulting cell embeddings generated by native scGPT, finetuned scGPT, and scPEFT were visualized using UMAP, with cell colors reflecting the hierarchical annotations. This  allowed  us  to  assess  how  well  each  model  captured  cellular  structure  and  revealed subpopulations within the disease atlas.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 8: Unsupervised adaptation of scPEFT to the lung cancer atlas"], "pages": [14], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/87", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 14, "bbox": {"l": 72.0, "t": 688.54464, "r": 543.3108479999997, "b": 606.0683053259668, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 512]}]}, {"self_ref": "#/texts/88", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 14, "bbox": {"l": 72.0, "t": 586.78464, "r": 543.3373440000001, "b": 518.7083053259669, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 427]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 8: Unsupervised adaptation of scPEFT to the lung cancer atlas"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:42:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 42, "text": "From the Uniform Manifold Approximation and Projection UMAP visualizations ( Supplementary Fig. 21a ), we observed clear clustering of major cell types, even in the zero-shot embeddings from native scGPT, highlighting the strong biological prior captured during pretraining. Following adaptation, both finetuned scGPT and scPEFT further refined the separation of major cell types and  introduced  additional  subclusters.  Higher  Calinski-Harabasz  index  (CHI)  scores  for  the adapted  models  confirmed  improved  cluster  separability  and  cohesiveness.  These  emergent subclusters suggest that context-specific biological signals were captured during unsupervised adaptation.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 8: Unsupervised adaptation of scPEFT to the lung cancer atlas\nFrom the Uniform Manifold Approximation and Projection UMAP visualizations ( Supplementary Fig. 21a ), we observed clear clustering of major cell types, even in the zero-shot embeddings from native scGPT, highlighting the strong biological prior captured during pretraining. Following adaptation, both finetuned scGPT and scPEFT further refined the separation of major cell types and  introduced  additional  subclusters.  Higher  Calinski-Harabasz  index  (CHI)  scores  for  the adapted  models  confirmed  improved  cluster  separability  and  cohesiveness.  These  emergent subclusters suggest that context-specific biological signals were captured during unsupervised adaptation.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 8: Unsupervised adaptation of scPEFT to the lung cancer atlas"], "pages": [14], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/89", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 14, "bbox": {"l": 72.0, "t": 499.42463999999995, "r": 543.0941280000006, "b": 387.9083053259668, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 684]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 8: Unsupervised adaptation of scPEFT to the lung cancer atlas"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:43:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 43, "text": "To further investigate these subpopulations, we applied finer annotations to color the major cell types ( Supplementary Fig. 21b ). Within the epithelial compartment, which includes tumor cells, scPEFT  and  finetuned  scGPT  revealed  clear  boundaries  between  alveolar,  transitional,  and cancer cells, separations not apparent in native scGPT embeddings, indicating that the adapted models generated more context-aware representations. Moreover, the cancer cell population split into numerous distinct subclusters, each corresponding to its patient of origin and associated with varying Union for International Cancer Control (UICC) stages ( Supplementary Fig. 21c ). This pattern  is  expected  because  the  profile  of  genomic  alterations  in  each  tumor  will  be  unique, making a spread of augmentations to the baseline gene expression state.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 8: Unsupervised adaptation of scPEFT to the lung cancer atlas\nTo further investigate these subpopulations, we applied finer annotations to color the major cell types ( Supplementary Fig. 21b ). Within the epithelial compartment, which includes tumor cells, scPEFT  and  finetuned  scGPT  revealed  clear  boundaries  between  alveolar,  transitional,  and cancer cells, separations not apparent in native scGPT embeddings, indicating that the adapted models generated more context-aware representations. Moreover, the cancer cell population split into numerous distinct subclusters, each corresponding to its patient of origin and associated with varying Union for International Cancer Control (UICC) stages ( Supplementary Fig. 21c ). This pattern  is  expected  because  the  profile  of  genomic  alterations  in  each  tumor  will  be  unique, making a spread of augmentations to the baseline gene expression state.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 8: Unsupervised adaptation of scPEFT to the lung cancer atlas"], "pages": [14], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/90", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 14, "bbox": {"l": 72.0, "t": 368.38464, "r": 543.3660480000003, "b": 242.22830532596686, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 857]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 8: Unsupervised adaptation of scPEFT to the lung cancer atlas"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:44:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 44, "text": "This trend was consistently observed across other major cell types with finer cell type annotations in  the  atlas  ( Supplementary  Figs.  22-23 ).  Across  these  cases,  scPEFT  generally  achieved higher CHI scores than finetuned scGPT, particularly for dominant cell groups, including CD4 + T cells,  alveolar  macrophages,  and  lymphatic  endothelial  cells.  These  results  suggest  that compared to the finetuning strategy, scPEFT better preserves the overall structure of cell types while  offering  discerning  sensitivity  to  biologically  meaningful  subpopulations  in  large-scale disease contexts.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 8: Unsupervised adaptation of scPEFT to the lung cancer atlas\nThis trend was consistently observed across other major cell types with finer cell type annotations in  the  atlas  ( Supplementary  Figs.  22-23 ).  Across  these  cases,  scPEFT  generally  achieved higher CHI scores than finetuned scGPT, particularly for dominant cell groups, including CD4 + T cells,  alveolar  macrophages,  and  lymphatic  endothelial  cells.  These  results  suggest  that compared to the finetuning strategy, scPEFT better preserves the overall structure of cell types while  offering  discerning  sensitivity  to  biologically  meaningful  subpopulations  in  large-scale disease contexts.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 8: Unsupervised adaptation of scPEFT to the lung cancer atlas"], "pages": [14], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/91", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 14, "bbox": {"l": 72.0, "t": 222.94463999999994, "r": 543.2468159999999, "b": 126.06830532596678, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 615]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 8: Unsupervised adaptation of scPEFT to the lung cancer atlas"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:45:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 45, "text": "A recent study 31 suggests that scLLMs and deep learning models may not surpass a simple linear model. We included the proposed linear model in our benchmarks in perturbation prediction by directly applying the split train and test data provided in the benchmark with scFoundation and scGPT to the source code from this study. We then evaluated the linear model using the same metrics mean squared error (MSE), Pearson correlation coefficient (PCC), and their counterparts, MSE_DE and PCC_DE, which are restricted to the top 20 differentially expressed genes.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 9: Comparison with a linear-model baseline in perturbation prediction\nA recent study 31 suggests that scLLMs and deep learning models may not surpass a simple linear model. We included the proposed linear model in our benchmarks in perturbation prediction by directly applying the split train and test data provided in the benchmark with scFoundation and scGPT to the source code from this study. We then evaluated the linear model using the same metrics mean squared error (MSE), Pearson correlation coefficient (PCC), and their counterparts, MSE_DE and PCC_DE, which are restricted to the top 20 differentially expressed genes.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 9: Comparison with a linear-model baseline in perturbation prediction"], "pages": [15], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/94", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 15, "bbox": {"l": 72.0, "t": 674.34336, "r": 543.0742560000003, "b": 590.2283053259669, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 559]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 9: Comparison with a linear-model baseline in perturbation prediction"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:46:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 46, "text": "From  the  benchmarking  results  from  scFoundation  backbone  ( Supplementary Table 5 ),  the linear model achieved the best or near-best PCC and MSE values across the two datasets. This finding  is  consistent  with  prior  work 31 ,  which  demonstrated  that  general  purpose  scLLM representations  of  cellular  states  struggle  to  accurately  predict  perturbation  effects  across  all genes even after adaptation. However, when the evaluation is restricted to the top differentially expressed  genes,  which  carry  stronger  biological  signals  and  are  more  likely  to  serve  as biomarkers driving phenotypic changes 32,33 , the linear model consistently underperformed relative to scPEFT. Specifically, scPEFT outperformed the linear model by 0.02 to 0.09 in MSE_DE and 0.02 to 0.15 in PCC_DE, while the linear model performed comparably to zero-shot scFoundation on  the  datasets.  These  results  suggest  that  scPEFT  is  able  to  capture  the  strong  non-linear perturbation  patterns  from  adapted  data,  which  the  linear", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 9: Comparison with a linear-model baseline in perturbation prediction\nFrom  the  benchmarking  results  from  scFoundation  backbone  ( Supplementary Table 5 ),  the linear model achieved the best or near-best PCC and MSE values across the two datasets. This finding  is  consistent  with  prior  work 31 ,  which  demonstrated  that  general  purpose  scLLM representations  of  cellular  states  struggle  to  accurately  predict  perturbation  effects  across  all genes even after adaptation. However, when the evaluation is restricted to the top differentially expressed  genes,  which  carry  stronger  biological  signals  and  are  more  likely  to  serve  as biomarkers driving phenotypic changes 32,33 , the linear model consistently underperformed relative to scPEFT. Specifically, scPEFT outperformed the linear model by 0.02 to 0.09 in MSE_DE and 0.02 to 0.15 in PCC_DE, while the linear model performed comparably to zero-shot scFoundation on  the  datasets.  These  results  suggest  that  scPEFT  is  able  to  capture  the  strong  non-linear perturbation  patterns  from  adapted  data,  which  the  linear", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 9: Comparison with a linear-model baseline in perturbation prediction"], "pages": [15], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/95", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 15, "bbox": {"l": 72.0, "t": 570.7046399999999, "r": 543.1566719999998, "b": 357.4283053259668, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 1409]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 9: Comparison with a linear-model baseline in perturbation prediction"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:47:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 47, "text": "model  cannot  capture  and  which general-purpose zero-shot scFoundation cannot provide. A similar trend was observed in the benchmark using the scGPT  backbone ( Supplementary Table  6 ). The linear model demonstrated  higher  performance  in  terms  of  PCC  and  MSE  across  four  datasets,  but  it consistently lagged behind in MSE_DE and PCC_DE.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 9: Comparison with a linear-model baseline in perturbation prediction\nmodel  cannot  capture  and  which general-purpose zero-shot scFoundation cannot provide. A similar trend was observed in the benchmark using the scGPT  backbone ( Supplementary Table  6 ). The linear model demonstrated  higher  performance  in  terms  of  PCC  and  MSE  across  four  datasets,  but  it consistently lagged behind in MSE_DE and PCC_DE.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 9: Comparison with a linear-model baseline in perturbation prediction"], "pages": [15], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/95", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 15, "bbox": {"l": 72.0, "t": 570.7046399999999, "r": 543.1566719999998, "b": 357.4283053259668, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 1409]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 9: Comparison with a linear-model baseline in perturbation prediction"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:48:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 48, "text": "Nevertheless, the improvement achieved by these deep learning-based models relative to the linear model is modest when considering their higher computational cost. A potential explanation suggested is that pretraining on single-cell atlas data provides only limited benefit for perturbation prediction. This challenges the assumption of scPEFT that a generalizable embedding space for any target task is already established during the pretraining stage of scLLMs. Notably, a proof-ofconcept study using the linear model 31 indicates that pretraining on perturbation data can improve predictive performance. In our future work, we plan to extend scPEFT the specific scLLM STATE 34 , pretrained on perturbation data, to further enhance its adaptability for this open challenge.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 9: Comparison with a linear-model baseline in perturbation prediction\nNevertheless, the improvement achieved by these deep learning-based models relative to the linear model is modest when considering their higher computational cost. A potential explanation suggested is that pretraining on single-cell atlas data provides only limited benefit for perturbation prediction. This challenges the assumption of scPEFT that a generalizable embedding space for any target task is already established during the pretraining stage of scLLMs. Notably, a proof-ofconcept study using the linear model 31 indicates that pretraining on perturbation data can improve predictive performance. In our future work, we plan to extend scPEFT the specific scLLM STATE 34 , pretrained on perturbation data, to further enhance its adaptability for this open challenge.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 9: Comparison with a linear-model baseline in perturbation prediction"], "pages": [15], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/96", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 15, "bbox": {"l": 72.0, "t": 338.1446399999999, "r": 546.124992, "b": 226.38830532596683, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 775]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 9: Comparison with a linear-model baseline in perturbation prediction"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:49:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 49, "text": "Providing a best practice summary of scPEFT configurations across different scLLM backbones and downstream tasks is essential to enhance its practical utility and reduce trial-and-error costs for users. Accordingly, we compiled the best-performing individual adapter configurations for all scLLMs, and tasks studied here, as summarized in Supplementary Table 7 .\nFrom  these  results,  we  observed  that  different  scLLMs  and  downstream  applications  have preferred adapter types to unlock their full potential. For scLLMs that include a built-in cell token (e.g., scGPT) and are used for cell-level tasks such as cell type identification and batch effect correction, the Encoder adapter is often the most effective initial choice. This is likely because the Encoder adapter operates on the output of the Transformer module, directly adapting the learned cell token embeddings to the specific cell-level task.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 10: Best practices for applying scPEFT across scLLM backbones and downstream tasks\nProviding a best practice summary of scPEFT configurations across different scLLM backbones and downstream tasks is essential to enhance its practical utility and reduce trial-and-error costs for users. Accordingly, we compiled the best-performing individual adapter configurations for all scLLMs, and tasks studied here, as summarized in Supplementary Table 7 .\nFrom  these  results,  we  observed  that  different  scLLMs  and  downstream  applications  have preferred adapter types to unlock their full potential. For scLLMs that include a built-in cell token (e.g., scGPT) and are used for cell-level tasks such as cell type identification and batch effect correction, the Encoder adapter is often the most effective initial choice. This is likely because the Encoder adapter operates on the output of the Transformer module, directly adapting the learned cell token embeddings to the specific cell-level task.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 10: Best practices for applying scPEFT across scLLM backbones and downstream tasks"], "pages": [16], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/99", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 16, "bbox": {"l": 72.0, "t": 673.90464, "r": 543.3152639999997, "b": 620.4683053259668, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 362]}]}, {"self_ref": "#/texts/100", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 16, "bbox": {"l": 72.0, "t": 601.18464, "r": 543.2755200000001, "b": 518.7083053259669, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 551]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 10: Best practices for applying scPEFT across scLLM backbones and downstream tasks"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:50:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 50, "text": "In  contrast,  for  scLLMs  without  a  dedicated  cell  token  (e.g.,  scBERT,  Geneformer,  and scFoundation), the Token adapter or LoRA adapter tends to perform better at cell-level tasks. These  models  typically  use  a  pooling  strategy  to  aggregate  all  gene  embeddings  into  a  cell embedding. The Token and LoRA adapters operate at the Tokenizer module or within the token embedding  calculation in the Transformer's attention mechanism,  allowing task-specific adaptation at the individual gene token level and facilitating better harmonization of gene tokens during pooling.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 10: Best practices for applying scPEFT across scLLM backbones and downstream tasks\nIn  contrast,  for  scLLMs  without  a  dedicated  cell  token  (e.g.,  scBERT,  Geneformer,  and scFoundation), the Token adapter or LoRA adapter tends to perform better at cell-level tasks. These  models  typically  use  a  pooling  strategy  to  aggregate  all  gene  embeddings  into  a  cell embedding. The Token and LoRA adapters operate at the Tokenizer module or within the token embedding  calculation in the Transformer's attention mechanism,  allowing task-specific adaptation at the individual gene token level and facilitating better harmonization of gene tokens during pooling.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 10: Best practices for applying scPEFT across scLLM backbones and downstream tasks"], "pages": [16], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/101", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 16, "bbox": {"l": 72.0, "t": 499.42463999999995, "r": 543.0861600000011, "b": 402.3083053259668, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 591]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 10: Best practices for applying scPEFT across scLLM backbones and downstream tasks"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:51:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 51, "text": "Similarly, for gene-level tasks such as transcription factor identification or perturbation response prediction, the Token adapter and Prefix adapter provide stronger adaptation. These adapters introduce tunable parameters either at the tokenizer or as injected tensors, enabling better taskspecific tuning of individual gene tokens and improving their integration during contextual learning. We hope these  observations  and  recommendations  serve  as  a  practical  reference  for  users working with current and future scLLMs and guide adapter design choices accordingly.\nIt  is  important  to  note  that  the  recommendations  in Supplementary  Table  7 are  based  on scenarios with official scripts provided by the respective scLLM releases. We plan to continuously extend  scPEFT  support  to  untested  and  emerging  single-cell  analysis  scenarios  and  provide updated best practice guidance in future work.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 10: Best practices for applying scPEFT across scLLM backbones and downstream tasks\nSimilarly, for gene-level tasks such as transcription factor identification or perturbation response prediction, the Token adapter and Prefix adapter provide stronger adaptation. These adapters introduce tunable parameters either at the tokenizer or as injected tensors, enabling better taskspecific tuning of individual gene tokens and improving their integration during contextual learning. We hope these  observations  and  recommendations  serve  as  a  practical  reference  for  users working with current and future scLLMs and guide adapter design choices accordingly.\nIt  is  important  to  note  that  the  recommendations  in Supplementary  Table  7 are  based  on scenarios with official scripts provided by the respective scLLM releases. We plan to continuously extend  scPEFT  support  to  untested  and  emerging  single-cell  analysis  scenarios  and  provide updated best practice guidance in future work.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 10: Best practices for applying scPEFT across scLLM backbones and downstream tasks"], "pages": [16], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/102", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 16, "bbox": {"l": 72.0, "t": 383.02464, "r": 543.1960320000011, "b": 300.54830532596685, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 575]}]}, {"self_ref": "#/texts/103", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 16, "bbox": {"l": 72.0, "t": 281.26463999999993, "r": 543.0944640000009, "b": 227.82830532596677, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 345]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 10: Best practices for applying scPEFT across scLLM backbones and downstream tasks"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:52:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 52, "text": "To  investigate  the  potential  synergistic  or  redundant  effects  of  adapter  combinations,  we conducted a comprehensive benchmark using scGPT as the backbone and cell type identification as  the  representative  task.  Specifically,  we  evaluated  all  possible  combinations  of  the  four proposed adapters (Token, Prefix, LoRA, and Encoder) on the NSCLC dataset using 5-fold crossvalidation, with balanced accuracy as the evaluation metric.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 11: Adapter combinations and configuration in scPEFT\nTo  investigate  the  potential  synergistic  or  redundant  effects  of  adapter  combinations,  we conducted a comprehensive benchmark using scGPT as the backbone and cell type identification as  the  representative  task.  Specifically,  we  evaluated  all  possible  combinations  of  the  four proposed adapters (Token, Prefix, LoRA, and Encoder) on the NSCLC dataset using 5-fold crossvalidation, with balanced accuracy as the evaluation metric.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 11: Adapter combinations and configuration in scPEFT"], "pages": [17], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/106", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 17, "bbox": {"l": 72.0, "t": 673.90464, "r": 543.2357760000001, "b": 606.0683053259668, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 451]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 11: Adapter combinations and configuration in scPEFT"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:53:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 53, "text": "Our  results  on  dual-adapter  combinations  ( Supplementary  Figs.  24a-24f )  revealed  that combining two adapters often led to performance improvements over the individually weakerperforming adapters, suggesting a synergistic effect (p-value < 0.01). However, in comparison to the individually stronger-performing adapters, the dual combinations showed only marginal gains or slight declines, with differences generally not statistically significant (p-value > 0.05). Similar patterns were observed for triple- and quadruple-adapter combinations ( Supplementary Figs. 24g-24k ), where increased adapter stacking did not consistently yield improved performance. For instance, the four-adapter combination ( Supplementary Fig. 24k ) did not outperform the best dual or triple combinations (e.g., see Supplementary Figs. 24xy ),  suggesting that excessive adapter  stacking  may  introduce  parameter  redundancy.  Additionally,  adapter  combinations resulted  in  an  increased  number  of  learnable  parameters  and  greater  GPU  memory", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 11: Adapter combinations and configuration in scPEFT\nOur  results  on  dual-adapter  combinations  ( Supplementary  Figs.  24a-24f )  revealed  that combining two adapters often led to performance improvements over the individually weakerperforming adapters, suggesting a synergistic effect (p-value < 0.01). However, in comparison to the individually stronger-performing adapters, the dual combinations showed only marginal gains or slight declines, with differences generally not statistically significant (p-value > 0.05). Similar patterns were observed for triple- and quadruple-adapter combinations ( Supplementary Figs. 24g-24k ), where increased adapter stacking did not consistently yield improved performance. For instance, the four-adapter combination ( Supplementary Fig. 24k ) did not outperform the best dual or triple combinations (e.g., see Supplementary Figs. 24xy ),  suggesting that excessive adapter  stacking  may  introduce  parameter  redundancy.  Additionally,  adapter  combinations resulted  in  an  increased  number  of  learnable  parameters  and  greater  GPU  memory", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 11: Adapter combinations and configuration in scPEFT"], "pages": [17], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/107", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 17, "bbox": {"l": 72.0, "t": 586.78464, "r": 543.1216800000004, "b": 416.94830532596677, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 1147]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 11: Adapter combinations and configuration in scPEFT"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:54:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 54, "text": "usage ( Supplementary Fig. 24l ), which may limit their practicality in resource-constrained settings.\nBased on these findings, we recommend using adapter combinations primarily when the optimal adapter type for a given backbone or downstream task is uncertain. In such cases, combining adapters across different modules can be helpful. For instance, integration of Token adapters at the tokenizer and Encoder adapters at the Transformer tended to yield greater improvements (see Supplementary  Figs.  24  a,  j,  and  k ).  We  acknowledge  that  these  effects  may  vary depending on the choice of backbone model and downstream task.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 11: Adapter combinations and configuration in scPEFT\nusage ( Supplementary Fig. 24l ), which may limit their practicality in resource-constrained settings.\nBased on these findings, we recommend using adapter combinations primarily when the optimal adapter type for a given backbone or downstream task is uncertain. In such cases, combining adapters across different modules can be helpful. For instance, integration of Token adapters at the tokenizer and Encoder adapters at the Transformer tended to yield greater improvements (see Supplementary  Figs.  24  a,  j,  and  k ).  We  acknowledge  that  these  effects  may  vary depending on the choice of backbone model and downstream task.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 11: Adapter combinations and configuration in scPEFT"], "pages": [17], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/107", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 17, "bbox": {"l": 72.0, "t": 586.78464, "r": 543.1216800000004, "b": 416.94830532596677, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 1147]}]}, {"self_ref": "#/texts/108", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 17, "bbox": {"l": 72.0, "t": 397.66463999999996, "r": 543.3373440000001, "b": 315.18830532596684, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 533]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 11: Adapter combinations and configuration in scPEFT"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:55:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 55, "text": "The recent research on PEFT techniques concentrates on improvement upon LoRA. For instance, AdLoRA 35 dynamically  allocates  LoRA's  low-rank  matrices  across  layers  based  on  their  taskspecific  importance,  rather  than  applying  them  uniformly.  PISSA 36 only  updates  the  principal singular  values  and  singular  vectors  of  weight  matrices  in  LoRA.  DoRA 37 decomposes LoRA weight updates into direction and magnitude, only finetuning the direction while preserving the pre-trained magnitude. Among LoRA variants, we selected two representative and competitive LoRA variants, Orthogonal Fine-Tuning (OFT) 38 and Householder Reflection Adaptation (HRA) 39 , to conduct a comparison with scPEFT. These two methods employ different matrix formulations to replace the low-rank decomposition used in LoRA, aiming to reduce parameter counts and enhance representational capacity.", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 12: Comparisons with state-of-the-art PEFT techniques\nThe recent research on PEFT techniques concentrates on improvement upon LoRA. For instance, AdLoRA 35 dynamically  allocates  LoRA's  low-rank  matrices  across  layers  based  on  their  taskspecific  importance,  rather  than  applying  them  uniformly.  PISSA 36 only  updates  the  principal singular  values  and  singular  vectors  of  weight  matrices  in  LoRA.  DoRA 37 decomposes LoRA weight updates into direction and magnitude, only finetuning the direction while preserving the pre-trained magnitude. Among LoRA variants, we selected two representative and competitive LoRA variants, Orthogonal Fine-Tuning (OFT) 38 and Householder Reflection Adaptation (HRA) 39 , to conduct a comparison with scPEFT. These two methods employ different matrix formulations to replace the low-rank decomposition used in LoRA, aiming to reduce parameter counts and enhance representational capacity.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 12: Comparisons with state-of-the-art PEFT techniques"], "pages": [18], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/111", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 18, "bbox": {"l": 72.0, "t": 688.54464, "r": 543.068832, "b": 547.7483053259668, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 894]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 12: Comparisons with state-of-the-art PEFT techniques"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
./data/docling_include_no_vlm_2026-07-09/chunks/full_2026_07_06_rec_001358.jsonl:56:{"candidate_id": "full_2026-07-06__rec_001358", "chunk_index": 56, "text": "OFT constrains the learnable weight updates within an orthogonal matrix 𝑅 applied to the frozen W 8 , 𝑊 2 ,  and 𝑊 9 of  the  self-attention  mechanism.  Taking  the  Query  matrix 𝑄 as  an  example, Equation 17 in the main text can be modified as:\n<!-- formula-not-decoded -->\nWhere ℎ (!) denotes  the  embeddings  of  cell 𝑖 . 𝑅 with  dimension 𝑑 ∗ 𝑑 ( 𝑑 is  the  gene  or  cell embedding dimension) is a block-diagonal orthogonal matrix structured as:\n<!-- formula-not-decoded -->", "contextualized_text": "Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT\nSupplementary Notes\nSupplementary Note 12: Comparisons with state-of-the-art PEFT techniques\nOFT constrains the learnable weight updates within an orthogonal matrix 𝑅 applied to the frozen W 8 , 𝑊 2 ,  and 𝑊 9 of  the  self-attention  mechanism.  Taking  the  Query  matrix 𝑄 as  an  example, Equation 17 in the main text can be modified as:\n<!-- formula-not-decoded -->\nWhere ℎ (!) denotes  the  embeddings  of  cell 𝑖 . 𝑅 with  dimension 𝑑 ∗ 𝑑 ( 𝑑 is  the  gene  or  cell embedding dimension) is a block-diagonal orthogonal matrix structured as:\n<!-- formula-not-decoded -->", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 12: Comparisons with state-of-the-art PEFT techniques"], "pages": [18], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/112", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 18, "bbox": {"l": 72.0, "t": 528.2246399999999, "r": 543.0695040000005, "b": 487.50830532596683, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 248]}]}, {"self_ref": "#/texts/113", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "formula", "prov": [{"page_no": 18, "bbox": {"l": 262.512, "t": 483.36263999999994, "r": 540.0216, "b": 470.12553044210523, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 29]}]}, {"self_ref": "#/texts/114", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 18, "bbox": {"l": 72.0, "t": 466.08263999999997, "r": 543.0743040000008, "b": 439.9883053259668, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 176]}]}, {"self_ref": "#/texts/115", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "formula", "prov": [{"page_no": 18, "bbox": {"l": 115.77295199999999, "t": 435.76367999999997, "r": 540.0216, "b": 373.8792242526315, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 124]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Notes", "Supplementary Note 12: Comparisons with state-of-the-art PEFT techniques"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
