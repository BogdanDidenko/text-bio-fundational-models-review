./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/deepseek_v4_review_pipeline_all4027_current_rep2_watchdog_20260510T013948Z/job_11505/guideline_pilot_raw_completed.jsonl:316:{"cluster_id": 1787, "title": "Overcoming barriers to the wide adoption of single-cell large language models in biomedical research", "title_normalized": "overcoming barriers to the wide adoption of singlecell large language models in biomedical research", "doi": "10.1038/s41587-025-02846-y", "preprint_doi": NaN, "pmid": 41131148.0, "arxiv_id": NaN, "abstract": "Transformer-based large language models are gaining traction in biomedical research, particularly in single-cell omics. Despite their promise, the application of single-cell large language models (scLLMs) remains limited in practice. In this Comment, we examine the current landscape of scLLMs and the benchmark studies that assess their applications in various analytical tasks. We highlight existing technical gaps and practical barriers, and discuss future directions toward a more accessible and effective ecosystem to promote the applications of scLLMs in the biomedical community.", "authors": "Fang Xie; Bingkang Zhao; Songxiang Xu; Zehua Wang; James J. Moon; Lana X. Garmire", "year": 2025.0, "venue": "Nature Biotechnology", "date": "2025-10-23", "url": NaN, "sources": "['google_scholar', 'semantic_scholar', 'springernature']", "n_sources": 3, "all_dois": "['10.1038/s41587-025-02846-y']", "duplicate_count": 3, "abstract_source": NaN, "abstract_enriched_from": NaN, "abstract_old_len": NaN, "update_batch": NaN, "_pilot_row_id": 328, "round-A_scope_reviewer_output": {"paper_type": "review_editorial", "bio_modality_present": "unclear", "text_component_present": "unclear", "text_bio_bridge_present": "unclear", "primary_exclusion_code": "review_editorial", "uncertainty_reason": "none", "evidence_for_text_component": "none", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "not_assessed", "boundar