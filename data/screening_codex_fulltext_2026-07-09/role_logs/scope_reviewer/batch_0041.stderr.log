 description = The average of the squared difference between predicted and observed expression.", "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Tables", "Supplementary Table 2: Evaluation metrics used in this study."], "pages": [24], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/tables/1", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "table", "prov": [{"page_no": 24, "bbox": {"l": 70.19544219970703, "t": 680.4779510498047, "r": 540.4527587890625, "b": 73.7984619140625, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 0]}]}], "headings": ["Harnessing the power of single-cell large language models with parameter-efficient fine-tuning using scPEFT", "Supplementary Tables", "Supplementary Table 2: Evaluation metrics used in this study."], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 3578786038470275027, "filename": "full_text_02_landing_pdf_link.pdf", "uri": null}}}
