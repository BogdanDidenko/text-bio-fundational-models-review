./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/deepseek_v4_review_pipeline_all4027_current_rep2_watchdog_20260510T013948Z/job_11505/guideline_pilot_raw_completed.jsonl:369:{"cluster_id": 1775, "title": "Evaluating the Effectiveness of Parameter-Efficient Fine-Tuning in Genomic Classification Tasks", "title_normalized": "evaluating the effectiveness of parameterefficient finetuning in genomic classification tasks", "doi": "10.1101/2025.08.21.671544", "preprint_doi": NaN, "pmid": NaN, "arxiv_id": NaN, "abstract": "ABSTRACT\n                Foundation models are increasingly being leveraged for biological tasks. To address the high memory requirements of fine-tuning large pre-trained language models, parameter efficient fine-tuning (PEFT) methods are also being increasingly utilized. Previous studies have shown minimal, if any, loss in performance when using PEFT on binary classification tasks. However, the impact of using PEFT on tasks with large classification spaces has not been systemically evaluated. In this work, we apply PEFT to the problem of taxonomic classification using pre-trained genomic language models as the classification backbone. We explore various training strategies—including PEFT, full fine-tuning, and partial fine-tuning—for classifying sequences at the superkingdom, phylum, and genus levels. We find that PEFT-trained models significantly underperform compared to those trained via full fine-tuning or partial fine-tuning. Additionally, we demonstrate increased performance of pretrained models over those randomly initialized.", "authors": "Daniel Berman; Daniel Jimenez; Stanley Ta; Brian Merritt; Jeremy D Ratcliff; Vijay Narayan", "year": 2025.0, "venue": "bioRxiv", "date": "2025-08-26", "url": NaN, "sources": "['semantic_scholar']", "n_sources": 1, "all_dois": "['10.1101/2025.08.21.671544']", "duplicate_count": 1, "abstract_source": "crossref", "abstract_enriched_from": NaN, "abstract_old_len": NaN, "update_batch": NaN, "_pilot_row_id": 316, "round-A_scope_reviewer_output": {"paper_type": "application_wrapper", "bio_modality_present": "yes", "text_component_present": "no", "text_bio_bridge_present": "no", "primary_exclusion_code": "application_wrapper", "uncertainty_reason": "none", "evidence_for_text_component": "none", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "not_assessed", "boundary_case": "wrapper_boundary", "decision_rationale": "The paper evaluates fine-tuning methods on pre-trained genomic language models for taxonomic classification; it does not present a new generative text-bio model and uses existing models as a backbone for a downstream classification task, making it an application wrapper."}, "round-A_scope_reviewer_paper_type": "application_wrapper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "no", "round-A_scope_reviewer_text_bio_bridge_present": "no", "round-A_scope_reviewer_primary_exclusion_code": "application_wrapper", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "none", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "none", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "wrapper_boundary", "round-A_scope_reviewer_decision_rationale": "The paper evaluates fine-tuning methods on pre-trained genomic language models for taxonomic classification; it does not present a new generative text-bio model and uses existing models as a backbone for a downstream classification task, making it an application wrapper.", "round-A_architecture_reviewer_output": {"paper_type": "benchmark_resource", "generative_model_present": "no", "foundation_model_evidence": "unclear", "primary_exclusion_code": "EC3_not_generative", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "none", "boundary_case": "clear_exclude", "decision_rationale": "Abstract focuses on evaluating parameter-efficient fine-tuning for taxonomic classification using pre-trained genomic language models; no generative architecture or mechanism is described, only classification tasks."}, "round-A_architecture_reviewer_paper_type": "benchmark_resource", "round-A_architecture_reviewer_generative_model_present": "no", "round-A_architecture_reviewer_foundation_model_evidence": "unclear", "round-A_architecture_reviewer_primary_exclusion_code": "EC3_not_generative", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "none", "round-A_architecture_reviewer_boundary_case": "clear_exclude", "round-A_architecture_reviewer_decision_rationale": "Abstract focuses on evaluating parameter-efficient fine-tuning for taxonomic classification using pre-trained genomic language models; no generative architecture or mechanism is described, only classification tasks.", "pilot_roundA_scope_gate": "EXCLUDE", "pilot_roundA_architecture_gate": "EXCLUDE", "pilot_needs_adjudication": true, "round-B_adjudicator_output": {"paper_type": "application_wrapper", "bio_modality_present": "yes", "text_component_present": "no", "text_bio_bridge_present": "no", "generative_model_present": "no", "foundation_model_evidence": "yes", "primary_exclusion_code": "application_wrapper", "uncertainty_reason": "none", "evidence_for_text_component": "none", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "taxonomic classification", "boundary_case": "clear_exclude", "decision_rationale": "The abstract describes applying pre-trained genomic language models as a classification backbone for taxonomic classification, with no natural-language text or generative component. The paper is an application wrapper evaluating PEFT methods, not a new generative model."}, "round-B_adjudicator_paper_type": "application_wrapper", "round-B_adjudicator_bio_modality_present": "yes", "round-B_adjudicator_text_component_present": "no", "round-B_adjudicator_text_bio_bridge_present": "no", "round-B_adjudicator_generative_model_present": "no", "round-B_adjudicator_foundation_model_evidence": "yes", "round-B_adjudicator_primary_exclusion_code": "application_wrapper", "round-B_adjudicator_uncertainty_reason": "none", "round-B_adjudicator_evidence_for_text_component": "none", "round-B_adjudicator_evidence_for_text_bio_bridge": "none", "round-B_adjudicator_evidence_for_generative_model": "taxonomic classification", "round-B_adjudicator_boundary_case": "clear_exclude", "round-B_adjudicator_decision_rationale": "The abstract describes applying pre-trained genomic language models as a classification backbone for taxonomic classification, with no natural-language text or generative component. The paper is an application wrapper evaluating PEFT methods, not a new generative model."}
