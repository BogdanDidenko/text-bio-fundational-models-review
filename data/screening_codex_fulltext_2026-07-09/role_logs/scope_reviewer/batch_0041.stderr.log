""address\"":{\""name\"":\""MOE Key Laboratory of Bioinformatics and Bioinformatics Division of BNRIST, Department of Automation, Tsinghua University, Beijing, China\"",\""@type\"":\""PostalAddress\""},\""@type\"":\""Organization\""}],\""@type\"":\""Person\""},{\""name\"":\""Xiaomin Dong\"",\""affiliation\"":[{\""name\"":\""Tsinghua University\"",\""address\"":{\""name\"":\""MOE Key Laboratory of Bioinformatics and Bioinformatics Division of BNRIST, Department of Automation, Tsinghua University, Beijing, China\"",\""@type\"":\""PostalAddress\""},\""@type\"":\""Organization\""}],\""@type\"":\""Person\""},{\""name\"":\""Chen Li\"",\""affiliation\"":[{\""name\"":\""Tsinghua University\"",\""address\"":{\""name\"":\""MOE Key Laboratory of Bioinformatics and Bioinformatics Division of BNRIST, Department of Automation, Tsinghua University, Beijing, China\"",\""@type\"":\""PostalAddress\""},\""@type\"":\""Organization\""}],\""@type\"":\""Person\""},{\""name\"":\""Minsheng Hao\"",\""affiliation\"":[{\""name\"":\""Tsinghua University\"",\""address\"":{\""name\"":\""MOE Key Laboratory of Bioinformatics and Bioinformatics Division of BNRIST, Department of Automation, Tsinghua University, Beijing, China\"",\""@type\"":\""PostalAddress\""},\""@type\"":\""Organization\""}],\""@type\"":\""Person\""},{\""name\"":\""Sijie Chen\"",\""affiliation\"":[{\""name\"":\""Tsinghua University\"",\""address\"":{\""name\"":\""MOE Key Laboratory of Bioinformatics and Bioinformatics Division of BNRIST, Department of Automation, Tsinghua University, Beijing, China\"",\""@type\"":\""PostalAddress\""},\""@type\"":\""Organization\""}],\""@type\"":\""Person\""},{\""name\"":\""Jinyi Hu\"",\""affiliation\"":[{\""name\"":\""Tsinghua University\"",\""address\"":{\""name\"":\""Department of Computer Science and Technology, Tsinghua University, Beijing, China\"",\""@type\"":\""PostalAddress\""},\""@type\"":\""Organization\""}],\""@type\"":\""Person\""},{\""name\"":\""Maosong Sun\"",\""affiliation\"":[{\""name\"":\""Tsinghua University\"",\""address\"":{\""name\"":\""Department of Computer Science and Technology, Tsinghua University, Beijing, China\"",\""@type\"":\""PostalAddress\""},\""@type\"":\""Organization\""}],\""@type\"":\""Person\""},{\""name\"":\""Lei Wei\"",\""affiliation\"":[{\""name\"":\""Tsinghua University\"",\""address\"":{\""name\"":\""MOE Key Laboratory of Bioinformatics and Bioinformatics Division of BNRIST, Department of Automation, Tsinghua University, Beijing, China\"",\""@type\"":\""PostalAddress\""},\""@type\"":\""Organization\""}],\""email\"":\""weilei92@tsinghua.edu.cn\"",\""@type\"":\""Person\""},{\""name\"":\""Xuegong Zhang\"",\""affiliation\"":[{\""name\"":\""Tsinghua University\"",\""address\"":{\""name\"":\""MOE Key Laboratory of Bioinformatics and Bioinformatics Division of BNRIST, Department of Automation, Tsinghua University, Beijing, China\"",\""@type\"":\""PostalAddress\""},\""@type\"":\""Organization\""},{\""name\"":\""Tsinghua University\"",\""address\"":{\""name\"":\""Center for Synthetic and Systems Biology, School of Life Sciences and School of Medicine, Tsinghua University, Beijing, China\"",\""@type\"":\""PostalAddress\""},\""@type\"":\""Organization\""}],\""email\"":\""zhangxg@tsinghua.edu.cn\"",\""@type\"":\""Person\""}],\""keywords\"":\""Foundation Models, Single-cell Data, Pretraining\"",\""description\"":\""Gene expression could be perceived as a form of “cell language”, with underlying regulatory mechanisms akin to biological grammar. Decoding this language is critical in understanding cellular functions and behaviors. In this study, we proposed a new pre-training paradigm by integrating rich metadata and pre-training tasks, and developed scMulan, a multitask generative pre-trained language model for single-cell analyses. scMulan can accomplish multiple tasks in zero-shot manner such as cell-type annotation, batch integration, and conditional cell generation, guided by different task prompts. scMulan is also ready to be e