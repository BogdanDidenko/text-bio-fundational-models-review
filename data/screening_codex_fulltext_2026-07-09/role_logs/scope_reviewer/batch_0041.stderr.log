./data/docling_uncertain_biorxiv_chrome_no_vlm_2026-07-08/chunks/rec_002228_2025_08_23_671699v2_full.jsonl:87:{"candidate_id": "rec_002228_2025_08_23_671699v2_full", "chunk_index": 87, "text": "11. Xie F, Zhao B, Xu S, Wang Z, Moon JJ, and Garmire LX. Overcoming barriers to the wide adoption of single-cell large language models in biomedical research. Nature Biotechnology 2025:1758-62. DOI: 10.1038/s41587-025-02846-y .\n12. Levine D, Rizvi SA, et al. Cell2Sentence: Teaching Large Language Models the Language of Biology. bioRxiv 2023:DOI: 10.1101/2023.09.11.557287 .\n13. Gong Q, Sharma M, et al. Multi-omic profiling reveals age-related immune dynamics in healthy adults. Nature 2025:696-706. DOI: 10.1038/s41586-025-09686-5 .\n14. Miller JA, Guillozet-Bongaarts A, et al. Neuropathological and transcriptomic characteristics of the aged 649 brain. eLife 2017:e31126. DOI: 10.7554/eLife.31126 . 650", "contextualized_text": "5 Methods\nReferences\n11. Xie F, Zhao B, Xu S, Wang Z, Moon JJ, and Garmire LX. Overcoming barriers to the wide adoption of single-cell large language models in biomedical research. Nature Biotechnology 2025:1758-62. DOI: 10.1038/s41587-025-02846-y .\n12. Levine D, Rizvi SA, et al. Cell2Sentence: Teaching Large Language Models the Language of Biology. bioRxiv 2023:DOI: 10.1101/2023.09.11.557287 .\n13. Gong Q, Sharma M, et al. Multi-omic profiling reveals age-related immune dynamics in healthy adults. Nature 2025:696-706. DOI: 10.1038/s41586-025-09686-5 .\n14. Miller JA, Guillozet-Bongaarts A, et al. Neuropathological and transcriptomic characteristics of the aged 649 brain. eLife 2017:e31126. DOI: 10.7554/eLife.31126 . 650", "headings": ["5 Methods", "References"], "pages": [26], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/1216", "parent": {"cref": "#/groups/3"}, "children": [], "content_layer": "body", "meta": null, "label": "list_item", "prov": [{"page_no": 26, "bbox": {"l": 86.79899999999995, "t": 291.35883064843756, "r": 508.47856399999995, "b": 247.84056264843764, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 228]}]}, {"self_ref": "#/texts/1217", "parent": {"cref": "#/groups/3"}, "children": [], "content_layer": "body", "meta": null, "label": "list_item", "prov": [{"page_no": 26, "bbox": {"l": 86.79899999999998, "t": 235.3288306484376, "r": 508.47405164198096, "b": 209.54256264843764, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 147]}]}, {"self_ref": "#/texts/1218", "parent": {"cref": "#/groups/3"}, "children": [], "content_layer": "body", "meta": null, "label": "list_item", "prov": [{"page_no": 26, "bbox": {"l": 86.79899999999995, "t": 197.03183064843768, "r": 508.4741061571806, "b": 171.24456264843764, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 159]}]}, {"self_ref": "#/texts/1219", "parent": {"cref": "#/groups/3"}, "children": [], "content_layer": "body", "meta": null, "label": "list_item", "prov": [{"page_no": 26, "bbox": {"l": 40.0919999999999, "t": 158.73383064843767, "r": 508.4740544529206, "b": 132.94656264843763, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 170]}]}], "headings": ["5 Methods", "References"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 13413431590947499925, "filename": "rec_002228_2025.08.23.671699v2.full.pdf", "uri": null}}}
