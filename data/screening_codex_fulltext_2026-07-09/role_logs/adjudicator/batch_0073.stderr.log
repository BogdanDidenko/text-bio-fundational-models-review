ict","paper_type":"unclear","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","generative_model_present":"yes","foundation_model_evidence":"unclear"}}},{"record_id":"rec_003259","title":"Large language models for biological sequence analysis in infectious disease research","abstract":"models, genomic language models, and multimodal models,  the emergence of computational,  LLM-based approaches for  foundation model and benchmark for multi species genomes","doi":"","year":"2025","venue":"Biosafety and Health","sources":["google_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_003259","paper_type":"unclear","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","primary_exclusion_code":"none","uncertainty_reason":"paper_type_unclear","decision_rationale":"The title and abstract tie LLMs to biological sequence analysis, but the abstract fragment is too incomplete to confirm whether this is a primary study, review, or resource paper. The biological and language components are still evident.","evidence_snippet":"\"Large language models for biological sequence analysis in infectious disease research\""},"architecture_reviewer":{"record_id":"rec_003259","paper_type":"unclear","generative_model_present":"unclear","foundation_model_evidence":"unclear","primary_exclusion_code":"none","uncertainty_reason":"paper_type_unclear","decision_rationale":"The fragment mentions LLM-based approaches and a benchmark, but it does not clearly state whether this is a primary model paper or a review. There is not enough detail to confirm generative architecture or foundation-model characteristics.","evidence_snippet":"\"LLM-based approaches for foundation model and benchmark for multi species genomes\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"none","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"unclear","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","generative_model_present":"unclear","foundation_model_evidence":"unclear"}}},{"record_id":"rec_003261","title":"The large language models on biomedical data analysis: a survey","abstract":"of LLMs in genomics, proteomics, transcriptomics, single-cell  BERT-based LLM that uses a  multi-modal self-supervised pre foundation model and benchmark for multi-species genome.","doi":"","year":"2025","venue":"IEEE Journal of …","sources":["google_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_003261","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"The title explicitly says 'a survey' and the abstract says it 'comprehensively reviews' LLM applications in biomedical data analysis. This is a review rather than a primary model paper.","evidence_snippet":"\"The large language models on biomedical data analysis: a survey\"; \"This comprehensive review\""},"architecture_reviewer":{"record_id":"rec_003261","paper_type":"review_editorial","generative_model_present":"unclear","foundation_model_evidence":"unclear","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"The abstract explicitly identifies the work as a survey of biomedical data analysis with LLMs. No new generative model is described.","evidence_snippet":"\"The large language models on biomedical data analysis: a survey\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"review_editorial","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","generative_model_present":"unclear","foundation_model_evidence":"unclear"}}}]
