./data/screening_codex_full_2026-07-06/role_logs/adjudicator/batch_0098.prompt.txt:52:[{"record_id":"rec_002002","title":"Beyond Correlation: Towards Causal Large Language Model Agents in Biomedicine","abstract":"Large Language Models (LLMs) show promise in biomedicine but lack true causal understanding, relying instead on correlations. This paper envisions causal LLM agents that integrate multimodal data (text, images, genomics, etc.) and perform intervention-based reasoning to infer cause-and-effect. Addressing this requires overcoming key challenges: designing safe, controllable agentic frameworks; developing rigorous benchmarks for causal evaluation; integrating heterogeneous data sources; and synergistically combining LLMs with structured knowledge (KGs) and formal causal inference tools. Such agents could unlock transformative opportunities, including accelerating drug discovery through automated hypothesis generation and simulation, enabling personalized medicine through patient-specific causal models. This research agenda aims to foster interdisciplinary efforts, bridging causal concepts and foundation models to develop reliable AI partners for biomedical progress.","doi":"10.48550/arXiv.2505.16982","year":"2025","venue":"arXiv.org","sources":["semantic_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_002002","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"The abstract frames the work as an agenda/perspective on causal LLM agents rather than a new model. It discusses integrating text with other biomedical data for reasoning.","evidence_snippet":"\"This paper envisions causal LLM agents\""},"architecture_reviewer":{"record_id":"rec_002002","paper_type":"review_editorial","generative_model_present":"unclear","foundation_model_evidence":"unclear","primary_exclusion_code":"review_editorial","uncertainty_reason":"generative_status_unclear","decision_rationale":"This is a research agenda about causal LLM agents rather than a primary model paper. It discusses future agentic frameworks, not an implemented generative model.","evidence_snippet":"\"This research agenda aims to foster interdisciplinary efforts\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"review_editorial","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","generative_model_present":"unclear","foundation_model_evidence":"unclear"}}},{"record_id":"rec_002005","title":"Genomic Touchstone: Benchmarking Genomic Language Models in the Context of the Central Dogma","abstract":"ABSTRACT\n                \n                  The emergence of genomic language models (gLMs) has revolutionized the analysis of genomic sequences, enabling robust capture of biologically meaningful patterns from DNA sequences for an improved understanding of human genome-wide regulatory programs, variant pathogenicity and therapeutic discovery. Given that DNA serves as the foundational blueprint within the central dogma, the ultimate evaluation of a gLM is its ability to generalize across this entire biological cascade. However, existing evaluations lack this holistic and consistent framework, leaving researchers uncertain about which model best translates sequence understanding into downstream biological prediction. Here we present\n                  Genomic Touchstone\n                  , a comprehensive benchmark designed to evaluate gLMs across 36 diverse tasks and 88 datasets structured along the central dogma’s modalities of DNA, RNA, and protein, encompassing 5.34 billion base pairs of genomic sequences. We evaluate 34 representative models encompassing transformers and convolutional neural networks, as well as emerging efficient architectures such as Hyena and Mamba. Our analysis yield four key insights. First, gLMs achieve comparable or superior performance on RNA and protein tasks compared to models pretrained on these molecules. Second, transformer-based models continue to lead in overall performance, yet efficient sequence models show promising task-specific capabilities and deserve further exploration. Third, the scaling behavior of gLMs remains incompletely understood. While longer input sequences and more diverse pretraining data consistently improve performance, increases in model size do not always translate into better results. Fourth, pretraining strategies, including the choice of training objectives and the composition of pretraining corpora, exert substantial influence on downstream generalization across different genomic contexts. Genomic Touchstone establishes a unified evaluation framework tailored to human genomics. By spanning multiple molecular modalities and biological tasks, it offers a valuable foundation for guiding future gLM design and understanding model generalizability in complex biological contexts.","doi":"10.1101/2025.06.25.661622","year":"2025","venue":"bioRxiv","sources":["semantic_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_002005","paper_type":"benchmark_resource","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","primary_exclusion_code":"benchmark_resource","uncertainty_reason":"none","decision_rationale":"The abstract presents Genomic Touchstone as a benchmark with 36 tasks and 88 datasets. It evaluates genomic language models across biological modalities rather than proposing a new model.","evidence_snippet":"\"we present Genomic Touchstone, a comprehensive benchmark\""},"architecture_reviewer":{"record_id":"rec_002005","paper_type":"benchmark_resource","generative_model_present":"unclear","foundation_model_evidence":"unclear","primary_exclusion_code":"benchmark_resource","uncertainty_reason":"generative_status_unclear","decision_rationale":"Genomic Touchstone is a benchmark for evaluating gLMs across tasks and datasets, not a model paper. It reports on pretraining and generalization behavior of other models.","evidence_snippet":"\"a comprehensive benchmark designed to evaluate gLMs across 36 diverse tasks and 88 datasets\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"benchmark_resource","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"benchmark_resource","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","generative_model_present":"unclear","foundation_model_evidence":"unclear"}}},{"record_id":"rec_002008","title":"Artificial Intelligence Strategies in Biological Sciences: Transforming Research, Analysis, and Discovery","abstract":"Abstract: \"Artificial Intelligence (AI) has emerged as a transformative instrument in biological sciences, facilitating the analysis of complex biological datasets, predicting molecular interactions, and automating laboratory and field operations.\". This paper explores key AI strategies—machine learning, deep learning, computer vision, and natural language processing (NLP)—and their applications across genomics, proteomics, taxonomy, ecology, and medical diagnostics. Recent advancements in artificial intelligence include the utilization of models such as convolutional neural networks (CNNs) and support vector machines (SVMs). The integration of AI with biological databases accelerates drug discovery, species classification, and environmental assessment. The study highlights future directions and ethical considerations in implementing AI responsibly for sustainable biological research.","doi":"10.51583/ijltemas.2025.1410000094","year":"2025","venue":"International Journal of Latest Technology in Engineering Management &amp; Applied Science","sources":["semantic_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_002008","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"unclear","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"This is a broad overview of AI strategies in biological sciences, not a primary model paper. It mentions NLP among surveyed methods, but only as a review topic.","evidence_snippet":"\"This paper explores key AI strategies... and natural language processing (NLP)\""},"architecture_reviewer":{"record_id":"rec_002008","paper_type":"review_editorial","generative_model_present":"unclear","foundation_model_evidence":"unclear","primary_exclusion_code":"review_editorial","uncertainty_reason":"generative_status_unclear","decision_rationale":"This is a broad AI survey across biological sciences. It summarizes methods and applications rather than introducing a new generative model.","evidence_snippet":"\"This paper explores key AI strategies... and their applications across genomics, proteomics, taxonomy, ecology, and medical diagnostics\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"review_editorial","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"unclear","generative_model_present":"unclear","foundation_model_evidence":"unclear"}}},{"record_id":"rec_002010","title":"Genomic prediction of plant traits by popular machine learning methods","abstract":"A rapid growth of the available body of genomic data has made it possible to obtain extensive results in genomic prediction and identification of associations of SNPs with phenotypic traits. In many cases, to identify new relationships between phenotypes and genotypes, it is preferable to use machine learning, deep learning and artificial intelligence, especially explainable artificial intelligence, capable of recognizing complex patterns. 80 sources were manually selected; while there were no restrictions on the release date, the main attention was paid to the originality of the proposed approach for use in genomic prediction. The article considers models for genomic prediction, convolutional neural networks, explainable artificial intelligence and large language models. Attention is paid to Data Augmentation, Transfer Learning, Dimensionality Reduction methods and hybrid methods. Research in the field of model-specific and model-independent methods for interpretation of model solutions is represented by three main categories: sensing, perturbation, and surrogate model. The considered examples reflect the main modern trends in this area of research. The growing role of large language models, including those based on transformers, for genetic code processing, as well as the development of data augmentation methods, are noted. Among hybrid approaches, the prospect of combining machine learning models and models of plant development based on biophysical and biochemical processes is emphasized. Since the methods of machine learning and artificial intelligence are the focus of attention of both specialists in various applied fields and fundamental scientists, and also cause public resonance, the number of works devoted to these topics is growing explosively.","doi":"10.18699/vjgb-25-49","year":"2025","venue":"Vavilovskii zhurnal genetiki i selektsii","sources":["semantic_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_002010","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"unclear","text_bio_bridge_present":"unclear","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"This is a narrative review of genomic prediction methods, not a primary model paper. It summarizes prior work and mentions large language models among other methods.","evidence_snippet":"\"80 sources were manually selected\"; \"The article considers models for genomic prediction\""},"architecture_reviewer":{"record_id":"rec_002010","paper_type":"review_editorial","generative_model_present":"no","foundation_model_evidence":"no","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"This is a narrative review of genomic prediction methods rather than an original model paper. It mentions large language models in general, but does not describe a candidate generative model or foundation-model evidence.","evidence_snippet":"\"80 sources were manually selected\" and \"The article considers models for genomic prediction... and large language models\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"review_editorial","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"unclear","text_bio_bridge_present":"unclear","generative_model_present":"no","foundation_model_evidence":"no"}}},{"record_id":"rec_002014","title":"The Role of AI in Early Detection of Alzheimer's and Parkinson's Diseases: A Literature Survey","abstract":"Early detection of neurodegenerative diseases like Alzheimer’s and Parkinson’s is crucial for improving patient care and enabling timely interventions. Artificial intelligence (AI) offers innovative approaches to analyzing complex medical datasets, revolutionizing the detection of these diseases at early stages. This review discusses key AI methodologies, including machine learning (ML), deep learning (DL), natural language processing (NLP), and reinforcement learning (RL), and their applications in early diagnosis. ML models excel in predicting disease risk and classifying imaging and biometric data, while DL techniques, such as convolutional and recurrent neural networks, are effective in processing unstructured data like images and speech. NLP facilitates extracting critical insights from clinical notes and patient narratives, and RL enhances decision-making in diagnostic workflows. Integrating multimodal data—such as genomics, neuroimaging, wearable device metrics, and electronic health records—further strengthens diagnostic precision. Despite its promise, the widespread implementation of AI faces challenges, including the need for standardized data, ethical considerations, and clinical validation. Overcoming these obstacles is essential for AI to transform early detection and management of neurodegenerative diseases. This review emphasizes the significance of interdisciplinary efforts and sustained research to unlock AI’s full potential in medical applications.","doi":"10.9734/ajrcos/2025/v18i2570","year":"2025","venue":"Asian Journal of Research in Computer Science","sources":["semantic_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_002014","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"unclear","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"This is explicitly a literature survey of AI for early detection of Alzheimer's and Parkinson's diseases. It reviews methods rather than proposing a candidate model.","evidence_snippet":"\"A Literature Survey\"; \"This review discusses key AI methodologies\""},"architecture_reviewer":{"record_id":"rec_002014","paper_type":"review_editorial","generative_model_present":"no","foundation_model_evidence":"no","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"This is a literature survey on AI methods for early detection, not an original model report. It summarizes existing approaches and does not present a generative foundation model.","evidence_snippet":"\"This review discusses key AI methodologies... and their applications in early diagnosis\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"review_editorial","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"unclear","generative_model_present":"no","foundation_model_evidence":"no"}}},{"record_id":"rec_002018","title":"CAPTAIN: A multimodal foundation model pretrained on co-assayed single-cell RNA and protein","abstract":"Proteins act as the terminal effectors of cellular function, encoding the phenotypic consequences of genomic and transcriptomic programs. Although transcriptomic profiles serve as accessible proxies, they remain incomplete surrogates for the proteomic landscape that ultimately defines cellular phenotypes. Current single-cell foundation models, however, are trained exclusively on transcriptomes, resulting in biased and partial characterizations of cellular states. To address this limitation, we introduce CAPTAIN, a multimodal foundational model pretrained on over four million single cells with concurrently measured transcriptomes and a curated repertoire of 382 surface proteins across diverse human and mouse tissues. Our results show that CAPTAIN learns unified multimodal representations by modeling cross-modality dependencies and capturing the diversity of cellular states across complex biological contexts. CAPTAIN generalizes robustly across both fine-tuning and zero-shot settings, excelling in core downstream tasks such as protein imputation and expansion, cell type annotation, and batch harmonization. Beyond improved accuracy in multi-omics integration, CAPTAIN uncovers previously inaccessible mechanisms of protein-driven intercellular dynamics, including immune interaction patterns linked to COVID-19 severity. CAPTAIN establishes a new paradigm for multimodal single-cell modeling, laying the foundation for comprehensive cellular understanding and virtual cell construction.","doi":"10.1101/2025.07.07.663366","year":"2025","venue":"bioRxiv","sources":["biorxiv_medrxiv","google_scholar","semantic_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_002018","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"CAPTAIN is pretrained on single-cell transcriptomes and surface proteins, so the biological modality is clear. The abstract does not describe any text or language component.","evidence_snippet":"“pretrained on over four million single cells with concurrently measured transcriptomes and ... 382 surface proteins”"},"architecture_reviewer":{"record_id":"rec_002018","paper_type":"primary_model_paper","generative_model_present":"unclear","foundation_model_evidence":"yes","primary_exclusion_code":"none","uncertainty_reason":"generative_status_unclear","decision_rationale":"The abstract clearly presents a pretrained multimodal foundation model with broad downstream use and zero-shot transfer. It does not explicitly describe a generative mechanism such as decoder-based or autoregressive modeling.","evidence_snippet":"“a multimodal foundational model pretrained on over four million single cells” and “generalizes robustly across both fine-tuning and zero-shot settings”"},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"EC2_no_text_component","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","generative_model_present":"unclear","foundation_model_evidence":"yes"}}}]
./data/screening_codex_full_2026-07-06/role_logs/adjudicator/batch_0017.stdout.log:1:{"results":[{"record_id":"rec_000350","paper_type":"application_wrapper","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"no","generative_model_present":"no","foundation_model_evidence":"no","primary_exclusion_code":"application_wrapper","uncertainty_reason":"none","decision_rationale":"stImpute is a downstream spatial transcriptomics imputation method that uses ESM-2 embeddings to build a gene network. The language model is auxiliary input, not the core candidate model.","evidence_snippet":"“gene network constructed from the protein language model ESM-2” and “imputed through a graph neural network”"},{"record_id":"rec_000352","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"unclear","generative_model_present":"no","foundation_model_evidence":"no","primary_exclusion_code":"review_editorial","uncertainty_reason":"text_bio_bridge_unclear","decision_rationale":"The abstract explicitly describes a review of AI in head and neck cancer, not a primary model paper. It mentions NLP and imaging/genomics integration, but not a specific text-bio model.","evidence_snippet":"“This review highlights the advancements in AI technologies” and “including deep learning and natural language processing”"},{"record_id":"rec_000353","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","generative_model_present":"yes","foundation_model_evidence":"unclear","primary_exclusion_code":"review_editorial","uncertainty_reason":"foundation_model_evidence_unclear","decision_rationale":"This is a perspective/review on multimodal large language models in health care, not a primary model paper. It clearly discusses LLMs and multimodal clinical data, but does not present a specific foundation model.","evidence_snippet":"“This paper aims to present a detailed, practical, and solution-oriented perspective on the use of multimodal LLMs”"},{"record_id":"rec_000354","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"unclear","generative_model_present":"no","foundation_model_evidence":"no","primary_exclusion_code":"review_editorial","uncertainty_reason":"text_bio_bridge_unclear","decision_rationale":"The abstract states that this is a comprehensive summary of PLA prediction methods, so it is a review rather than a candidate model paper. Protein language models are mentioned as part of the survey, not as a new text-bio model.","evidence_snippet":"“a comprehensive summary of 166 in silico PLA prediction methods” and “application of protein language models and transfer learning”"},{"record_id":"rec_000355","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","generative_model_present":"yes","foundation_model_evidence":"unclear","primary_exclusion_code":"review_editorial","uncertainty_reason":"foundation_model_evidence_unclear","decision_rationale":"This is a Perspective summarizing prospects and applications of generative AI for bone research, not a primary model report. It discusses multimodal cellular data and generative AI broadly, but gives no specific foundation model.","evidence_snippet":"“In this Perspective, we summarize the progress and prospects of generative AI applied to these datasets”"},{"record_id":"rec_000364","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"unclear","generative_model_present":"yes","foundation_model_evidence":"unclear","primary_exclusion_code":"review_editorial","uncertainty_reason":"foundation_model_evidence_unclear","decision_rationale":"The abstract says this is a Series paper exploring opportunities and limitations of AI models in cardiovascular medicine, so it is review-style rather than a primary model paper. It mentions LLMs and multimodal clinical data, but not a specific candidate model.","evidence_snippet":"“This Series paper explores opportunities and limitations of AI models” and “large language models”"}]}
