/Users/bogdan.didenko/lpnu/review/data/docling_uncertain_no_vlm_2026-07-08/chunks/full_2026_07_06_rec_003118.jsonl:20:{"candidate_id": "full_2026-07-06__rec_003118", "chunk_index": 20, "text": "Gene text embedding. Gene corpus can complement expression data and provide valuable opportunities to directly reveal cellular characteristics. Given a known gene, the corresponding item in the corpus summarizes the associated diseases, biological processes, and other genes in natural language (see Appendix A.2 for details). To encode the textual contents, a special item token is added at the end of each summary item, followed by being mapped into item-level embeddings using an autoregressive text model f T , such as LLaMA (Touvron et al., 2023). Formulaically, the textual contents C ∈ R G × L , where L denotes the maximum length of text tokens, are encoded as\n<!-- formula-not-decoded -->", "contextualized_text": "3 METHODOLOGY\n3.1 SINGLE-CELL MODEL PRE-TRAINING\nGene text embedding. Gene corpus can complement expression data and provide valuable opportunities to directly reveal cellular characteristics. Given a known gene, the corresponding item in the corpus summarizes the associated diseases, biological processes, and other genes in natural language (see Appendix A.2 for details). To encode the textual contents, a special item token is added at the end of each summary item, followed by being mapped into item-level embeddings using an autoregressive text model f T , such as LLaMA (Touvron et al., 2023). Formulaically, the textual contents C ∈ R G × L , where L denotes the maximum length of text tokens, are encoded as\n<!-- formula-not-decoded -->", "headings": ["3 METHODOLOGY", "3.1 SINGLE-CELL MODEL PRE-TRAINING"], "pages": [4], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/257", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 4, "bbox": {"l": 107.99999999999999, "t": 363.383194, "r": 504.0033873999996, "b": 288.6887743929203, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 668]}]}, {"self_ref": "#/texts/258", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "formula", "prov": [{"page_no": 4, "bbox": {"l": 258.897, "t": 283.3731054, "r": 504.00039159999994, "b": 271.67152673256487, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 31]}]}], "headings": ["3 METHODOLOGY", "3.1 SINGLE-CELL MODEL PRE-TRAINING"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 7109630141359406345, "filename": "full_text_user_manual_zeromics.pdf", "uri": null}}}
/Users/bogdan.didenko/lpnu/review/data/docling_uncertain_no_vlm_2026-07-08/chunks/full_2026_07_06_rec_003118.jsonl:21:{"candidate_id": "full_2026-07-06__rec_003118", "chunk_index": 21, "text": "Multi-modal mask learning for semantic alignment. Cell expression and gene text embeddings reveal distinct levels of biomedical information within SC data. Using multi-modal learning to align their semantic spaces inspires the model to extract more comprehensive representations. For computational efficiency, ZerOmics utilizes the broadcasting to directly add Z T to Z E , which is then encoded to the contextual SC embeddings that contain the gene functional semantics, as follows:\n<!-- formula-not-decoded -->\nwhere ⊕ denotes the addition via the broadcasting and f SC represents the encoder-only SC Model. Effective generation of mask token embeddings should ensure they exhibit significant gene expression and textual information, enabling a single-layer network to accurately predict their original expression bins and corresponding gene summary items. Consequently, these mask token embeddings are transformed into probability distributions p E ∈ [0 , 1] N bins , and p T ∈ [0 , 1] G for gene expression bins and gene summary items using two independent predictors. Given the ground truth labels y E and y T for the bin and gene items, the loss function in mask learning is defined as", "contextualized_text": "3 METHODOLOGY\n3.1 SINGLE-CELL MODEL PRE-TRAINING\nMulti-modal mask learning for semantic alignment. Cell expression and gene text embeddings reveal distinct levels of biomedical information within SC data. Using multi-modal learning to align their semantic spaces inspires the model to extract more comprehensive representations. For computational efficiency, ZerOmics utilizes the broadcasting to directly add Z T to Z E , which is then encoded to the contextual SC embeddings that contain the gene functional semantics, as follows:\n<!-- formula-not-decoded -->\nwhere ⊕ denotes the addition via the broadcasting and f SC represents the encoder-only SC Model. Effective generation of mask token embeddings should ensure they exhibit significant gene expression and textual information, enabling a single-layer network to accurately predict their original expression bins and corresponding gene summary items. Consequently, these mask token embeddings are transformed into probability distributions p E ∈ [0 , 1] N bins , and p T ∈ [0 , 1] G for gene expression bins and gene summary items using two independent predictors. Given the ground truth labels y E and y T for the bin and gene items, the loss function in mask learning is defined as", "headings": ["3 METHODOLOGY", "3.1 SINGLE-CELL MODEL PRE-TRAINING"], "pages": [4], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/259", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 4, "bbox": {"l": 107.99999999999994, "t": 260.286194, "r": 504.00475499999976, "b": 207.50977439292035, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 483]}]}, {"self_ref": "#/texts/260", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "formula", "prov": [{"page_no": 4, "bbox": {"l": 230.685, "t": 202.1941054, "r": 504.00039160000006, "b": 190.4915267325648, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 45]}]}, {"self_ref": "#/texts/261", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 4, "bbox": {"l": 108.00000000000006, "t": 185.01445579999995, "r": 504.00338739999967, "b": 109.63052673256482, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 678]}]}], "headings": ["3 METHODOLOGY", "3.1 SINGLE-CELL MODEL PRE-TRAINING"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 7109630141359406345, "filename": "full_text_user_manual_zeromics.pdf", "uri": 