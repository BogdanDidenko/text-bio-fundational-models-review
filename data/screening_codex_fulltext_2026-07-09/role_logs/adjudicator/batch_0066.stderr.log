./data/screening_codex_full_2026-07-06/role_logs/adjudicator/batch_0155.prompt.txt:52:[{"record_id":"rec_003134","title":"Biomedical foundation model: A survey","abstract":"Following this work, a series of DNA language model has been  foundation models for  single-cell profiles, enabling the  our understanding of gene expression dynamics across diverse","doi":"","year":"2025","venue":"arXiv preprint arXiv …","sources":["google_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_003134","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"unclear","text_bio_bridge_present":"unclear","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"The title identifies this as a survey, so it is a review rather than a primary model paper. The abstract summarizes prior biomedical foundation-model work instead of presenting a new model.","evidence_snippet":"“Biomedical foundation model: A survey”"},"architecture_reviewer":{"record_id":"rec_003134","paper_type":"review_editorial","generative_model_present":"no","foundation_model_evidence":"no","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"The title explicitly identifies the paper as a survey. It is a review rather than a primary model contribution.","evidence_snippet":"\"Biomedical foundation model: A survey\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"review_editorial","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"unclear","text_bio_bridge_present":"unclear","generative_model_present":"no","foundation_model_evidence":"no"}}},{"record_id":"rec_003135","title":"Empirical Evaluation of Single-Cell Foundation Models for Predicting Cancer Outcomes","abstract":"Abstract\n                \n                Foundation models pretrained on large-scale single-cell RNA sequencing data present a promising opportunity to advance translational cancer research. However, their utility in clinically relevant, patient-level applications of single-cell analysis remains underexplored. Here, we systematically evaluated nine emerging single-cell foundation models (scFMs) and three alternative baseline approaches across six cancer-specific tasks, ranging from subtype classification to treatment response prediction. We assessed model performance under zero- shot, continual training, and fine-tuning conditions, conducting 1,170 supervised and 130 unsupervised experiments. Our findings revealed that while current scFMs excel in certain analysis tasks, such as tumor microenvironment cell annotation, they had limited advantages in predicting clinical and biological outcomes of cancer patients compared to simpler baseline models. These insights highlight the critical role of evaluation on biologically and clinically relevant tasks in the responsible and impactful application of scFMs in precision oncology. They also emphasize the necessity of further methodological innovation and expanded cancer single-cell cohorts for the future development of scFMs.","doi":"","year":"2025","venue":"bioRxiv","sources":["google_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_003135","paper_type":"benchmark_resource","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"benchmark_resource","uncertainty_reason":"none","decision_rationale":"This paper systematically evaluates nine single-cell foundation models across multiple cancer tasks. It is an empirical comparison/benchmark study, not a new text-bio foundation model.","evidence_snippet":"“We systematically evaluated nine emerging single-cell foundation models” and “across six cancer-specific tasks”"},"architecture_reviewer":{"record_id":"rec_003135","paper_type":"application_wrapper","generative_model_present":"no","foundation_model_evidence":"no","primary_exclusion_code":"application_wrapper","uncertainty_reason":"none","decision_rationale":"This paper evaluates existing single-cell foundation models on cancer outcome tasks rather than proposing a new generative model. The abstract centers on benchmarking and downstream prediction.","evidence_snippet":"\"systematically evaluated nine emerging single-cell foundation models\"; \"across six cancer-specific tasks\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"benchmark_resource","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"benchmark_resource","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","generative_model_present":"no","foundation_model_evidence":"no"}}},{"record_id":"rec_003137","title":"Primer on machine learning applications in brain immunology","abstract":"Single-cell and spatial technologies have transformed our understanding of brain immunology, providing unprecedented insights into immune cell heterogeneity and spatial organisation within the central nervous system. These methods have uncovered complex cellular interactions, rare cell populations, and the dynamic immune landscape in neurological disorders. This review highlights recent advances in single-cell “omics” data analysis and discusses their applicability for brain immunology. Traditional statistical techniques, adapted for single-cell omics, have been crucial in categorizing cell types and identifying gene signatures, overcoming challenges posed by increasingly complex datasets. We explore how machine learning, particularly deep learning methods like autoencoders and graph neural networks, is addressing these challenges by enhancing dimensionality reduction, data integration, and feature extraction. Newly developed foundation models present exciting opportunities for uncovering gene expression programs and predicting genetic perturbations. Focusing on brain development, we demonstrate how single-cell analyses have resolved immune cell heterogeneity, identified temporal maturation trajectories, and uncovered potential therapeutic links to various pathologies, including brain malignancies and neurodegeneration. The integration of single-cell and spatial omics has elucidated the intricate cellular interplay within the developing brain. This mini-review is intended for wet lab biologists at all career stages, offering a concise overview of the evolving landscape of single-cell omics in the age of widely available artificial intelligence.","doi":"","year":"2025","venue":"Frontiers in Bioinformatics","sources":["google_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_003137","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"unclear","text_bio_bridge_present":"unclear","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"The title and abstract describe a mini-review on machine learning applications in brain immunology, not a primary model paper. It discusses single-cell and spatial omics, but the candidate is clearly a review.","evidence_snippet":"\"This mini-review\"; \"reviews recent advances in single-cell omics data analysis\""},"architecture_reviewer":{"record_id":"rec_003137","paper_type":"review_editorial","generative_model_present":"no","foundation_model_evidence":"no","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"This is a mini-review/primer, not a primary model paper. It discusses autoencoders, graph neural networks, and foundation models, but does not present a candidate generative model.","evidence_snippet":"\"This mini-review...\"; \"Newly developed foundation models present exciting opportunities\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"review_editorial","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"unclear","text_bio_bridge_present":"unclear","generative_model_present":"no","foundation_model_evidence":"no"}}},{"record_id":"rec_003139","title":"Spatial Cell-Guided Pretraining for Scalable Spatial Transcriptomics Foundation Model","abstract":"Single-cell spatial transcriptomics enables highresolution  been exposed to both single-cell  and spatial transcriptomics  exclusively on reconstructing the gene expression of the center","doi":"","year":"NA","venue":"ICML 2025 Generative AI …","sources":["google_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_003139","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"The title indicates a spatial transcriptomics foundation model, so this is a primary model paper. The provided abstract fragment only mentions spatial transcriptomics and gene-expression reconstruction, with no substantive text/language component.","evidence_snippet":"\"Spatial Cell-Guided Pretraining for Scalable Spatial Transcriptomics Foundation Model\"; \"reconstructing the gene expression\""},"architecture_reviewer":{"record_id":"rec_003139","paper_type":"primary_model_paper","generative_model_present":"unclear","foundation_model_evidence":"yes","primary_exclusion_code":"none","uncertainty_reason":"generative_status_unclear","decision_rationale":"The title indicates a spatial transcriptomics foundation model with pretraining, but the abstract fragment only mentions reconstruction and does not specify a clearly generative mechanism. Foundation-model status is supported by the title.","evidence_snippet":"\"Spatial Cell-Guided Pretraining for Scalable Spatial Transcriptomics Foundation Model\"; \"reconstructing the gene expression\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"EC2_no_text_component","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","generative_model_present":"unclear","foundation_model_evidence":"yes"}}},{"record_id":"rec_003140","title":"Generalized biological foundation model with unified nucleic acid and protein language","abstract":"Abstract\n                  The language of biology, encoded in DNA, RNA and proteins, forms the foundation of life but remains challenging to decode owing to its complexity. Traditional computational methods often struggle to integrate information across these molecules, limiting a comprehensive understanding of biological systems. Advances in natural language processing with pre-trained models offer possibilities for interpreting biological language. Here we introduce LucaOne, a pre-trained foundation model trained on nucleic acid and protein sequences from 169,861 species. Through large-scale data integration and semi-supervised learning, LucaOne shows an understanding of key biological principles, such as DNA–protein translation. Using few-shot learning, it effectively comprehends the central dogma of molecular biology and performs competitively on tasks involving DNA, RNA or protein inputs. Our results highlight the potential of unified foundation models to address complex biological questions, providing an adaptable framework for bioinformatics research and enhancing the interpretation of life’s complexity.","doi":"","year":"2025","venue":"Nature Machine …","sources":["google_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_003140","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"The abstract describes LucaOne as a foundation model trained on nucleic acid and protein sequences. It is biological sequence modeling only; no text/language modality or text-bio bridge is described.","evidence_snippet":"\"trained on nucleic acid and protein sequences\"; \"few-shot learning\""},"architecture_reviewer":{"record_id":"rec_003140","paper_type":"primary_model_paper","generative_model_present":"unclear","foundation_model_evidence":"yes","primary_exclusion_code":"none","uncertainty_reason":"generative_status_unclear","decision_rationale":"This describes a pre-trained foundation model trained on nucleic acid and protein sequences from many species. The abstract does not explicitly state a generative architecture such as decoder or autoregressive modeling.","evidence_snippet":"\"pre-trained foundation model\"; \"trained on nucleic acid and protein sequences from 169,861 species\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"EC2_no_text_component","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","generative_model_present":"unclear","foundation_model_evidence":"yes"}}},{"record_id":"rec_003141","title":"Bidirectional mamba for single-cell data: Efficient context learning with biological fidelity","abstract":"requirement for single-cell analysis tasks where gene expression pat pre-trained language  model for single-cell analysis. In  schyena: Foundation model for full-length single-cell rna-seq","doi":"","year":"2025","venue":"arXiv preprint arXiv:2504.16956","sources":["google_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_003141","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"unclear","text_bio_bridge_present":"unclear","primary_exclusion_code":"none","uncertainty_reason":"text_component_unclear","decision_rationale":"The record appears to be a primary single-cell model, but the provided abstract is truncated. It mentions a \"pre-trained language model\" without clearly showing whether a substantive text component or text-bio bridge is actually present.","evidence_snippet":"\"pre-trained language model for single-cell analysis\"; abstract fragment is truncated"},"architecture_reviewer":{"record_id":"rec_003141","paper_type":"primary_model_paper","generative_model_present":"unclear","foundation_model_evidence":"yes","primary_exclusion_code":"none","uncertainty_reason":"mixed_signals","decision_rationale":"The record looks like a model paper and contains fragments referring to a pre-trained language model and a foundation model, but the abstract is corrupted and does not clearly state the generative mechanism. The foundation-model signal is present, but the wording is mixed.","evidence_snippet":"\"pre-trained language model for single-cell analysis\"; \"Foundation model for full-length single-cell rna-seq\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"none","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"unclear","text_bio_bridge_present":"unclear","generative_model_present":"unclear","foundation_model_evidence":"yes"}}}]
