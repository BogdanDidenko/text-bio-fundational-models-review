./data/screening_codex_full_2026-07-06/role_logs/adjudicator/batch_0076.prompt.txt:52:[{"record_id":"rec_001515","title":"Advancements in Gene Structure Prediction:\nInnovation and Prospects of Deep Learning Models Apply in Multi-species","abstract":"In recent years, advancements in gene structure prediction have been significantly driven by the integration of deep learning technologies into bioinformatics. Transitioning from traditional thermodynamics and comparative genomics methods to modern deep learning-based models such as CDSBERT, DNABERT, RNA-FM, and PlantRNA-FM prediction accuracy and generalization have seen remarkable improvements. These models, leveraging genome sequence data along with secondary and tertiary structure information, have facilitated diverse applications in studying gene functions across animals, plants, and humans. They also hold substantial potential for multi-application in early disease diagnosis, personalized treatment, and genomic evolution research. This review combines traditional gene structure prediction methods with advancements in deep learning, showcasing applications in functional region annotation, protein-RNA interactions, and cross-species genome analysis. It highlights their contributions to animal, plant, and human disease research while exploring future opportunities in cancer mutation prediction, RNA vaccine design, and CRISPR gene editing optimization. The review also emphasizes future directions, such as model refinement, multimodal integration, and global collaboration. By offering a concise overview and forward-looking insights, this article aims to provide a foundational resource and practical guidance for advancing nucleic acid structure prediction research.","doi":"10.71423/aimed.20250102","year":"2025","venue":"AI Med","sources":["semantic_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_001515","paper_type":"review_editorial","bio_modality_present":"unclear","text_component_present":"unclear","text_bio_bridge_present":"unclear","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"This is a review of gene-structure prediction methods and applications, not a primary model paper. It summarizes existing models such as CDSBERT and DNABERT.","evidence_snippet":"“This review combines traditional gene structure prediction methods with advancements in deep learning”"},"architecture_reviewer":{"record_id":"rec_001515","paper_type":"review_editorial","generative_model_present":"no","foundation_model_evidence":"no","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"This is a review that surveys existing deep learning methods for gene structure prediction rather than introducing a new model. The abstract summarizes applications and future directions, not a primary generative foundation model.","evidence_snippet":"\"This review combines traditional gene structure prediction methods with advancements in deep learning\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"review_editorial","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"review_editorial","bio_modality_present":"unclear","text_component_present":"unclear","text_bio_bridge_present":"unclear","generative_model_present":"no","foundation_model_evidence":"no"}}},{"record_id":"rec_001518","title":"Intra- and inter-tumoural heterogeneity in von Hippel–Lindau disease-related renal cancer: a multimodal data study protocol","abstract":"von Hippel–Lindau (VHL) disease is a rare hereditary cancer syndrome caused by germline pathogenic variants in the VHL gene. The current standard of care primarily involves surgical resection, which is arbitrarily recommended for renal tumours ≥ 3 cm to reduce the risk of metastasis. However, this approach often leads to repeated surgeries and increased patient morbidity. The key unmet clinical need for VHL patients is the ability to predict the most appropriate therapeutic strategy and the optimal timing for surgical intervention on an individualised basis. Here, we describe a methodology designed to create an integrated map of intra- and inter-tumour heterogeneity in VHL-associated clear cell renal cell carcinoma by combining radiomics, histology, RNA sequencing, whole genome sequencing, and patient-derived organoid cultures from multi-regional tumour biopsies. We hypothesise that decoding this heterogeneity through an integrated analysis of imaging, histopathology, and molecular profiling will enhance diagnostic accuracy and enable more informed and personalised therapeutic decisions for VHL patients. Due to the current lack of biological or molecular markers assisting clinical decision-making, VHL patients undergo multiple surgical interventions with an incremental risk of complications and morbidity. We expect that our multimodal data study protocol will give tools to guide clinical management. Multiregional needle biopsies enable comprehensive analysis even in small ccRCC. Imaging characteristics suggest the presence of intra- and inter-lesion heterogeneity. Tumours are clonally independent and harbour distinct chromosome 3p loss events. Tumours display both intra- and inter-tumour transcriptomics heterogeneity. Patient-derived organoids grow more easily from areas of low tumour density. Multiregional needle biopsies enable comprehensive analysis even in small ccRCC. Imaging characteristics suggest the presence of intra- and inter-lesion heterogeneity. Tumours are clonally independent and harbour distinct chromosome 3p loss events. Tumours display both intra- and inter-tumour transcriptomics heterogeneity. Patient-derived organoids grow more easily from areas of low tumour density.","doi":"10.1186/s41747-025-00648-0","year":"2025","venue":"European Radiology Experimental","sources":["semantic_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_001518","paper_type":"unclear","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"paper_type_unclear","decision_rationale":"The abstract describes a multimodal study protocol using radiomics, histology, RNA sequencing, and WGS, not a candidate generative model. No text/language component is presented.","evidence_snippet":"“we describe a methodology designed to create an integrated map... by combining radiomics, histology, RNA sequencing, whole genome sequencing”"},"architecture_reviewer":{"record_id":"rec_001518","paper_type":"unclear","generative_model_present":"no","foundation_model_evidence":"no","primary_exclusion_code":"EC3_not_generative","uncertainty_reason":"paper_type_unclear","decision_rationale":"This is a multimodal study protocol about tumor heterogeneity and clinical decision support, not a model paper. The abstract does not describe a generative architecture or any foundation-model characteristics.","evidence_snippet":"\"multimodal data study protocol\"; combining radiomics, histology, RNA sequencing, whole genome sequencing, and organoid cultures"},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"EC2_no_text_component","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"unclear","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","generative_model_present":"no","foundation_model_evidence":"no"}}},{"record_id":"rec_001524","title":"Integrative spatial analysis of cell morphologies and transcriptional states with MUSE","abstract":"Bao F(#)(1), Deng Y(#)(2)(3), Wan S(4), Shen SQ(1)(5), Wang B(2), Dai Q(6)(7)(8), Altschuler SJ(9), Wu LF(10).","doi":"10.1038/s41587-022-01251-z","year":"2022","venue":"Nature Biotechnology","sources":["semantic_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_001524","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","t