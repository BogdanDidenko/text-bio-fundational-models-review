/Users/bogdan.didenko/lpnu/review/data/determinism_codex_2026-07-01/run_1/role_logs/adjudicator/batch_0002.prompt.txt:52:[{"record_id":"rec_000013","title":"Biomedical data and AI","abstract":"Subsequently, a larger generative model based on the GPT (Generative Pre-trained   gene expression relationships and achieve state-of-the-art performance in various single-cell","doi":"","year":"2025","venue":"Sci China Life …","sources":["google_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_000013","paper_type":"unclear","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"unclear","primary_exclusion_code":"none","uncertainty_reason":"paper_type_unclear","decision_rationale":"The title is generic and the abstract fragment is truncated, but it mentions a GPT-based generative model and gene expression relationships. The record is too incomplete to classify the model scope confidently.","evidence_snippet":"“a larger generative model based on the GPT” and “gene expression relationships”"},"architecture_reviewer":{"record_id":"rec_000013","paper_type":"primary_model_paper","generative_model_present":"yes","foundation_model_evidence":"unclear","primary_exclusion_code":"none","uncertainty_reason":"foundation_model_evidence_unclear","decision_rationale":"The fragment explicitly refers to a \"larger generative model\" based on GPT, so generative modeling is indicated. The available text does not clearly establish broad pretraining or other foundation-model characteristics.","evidence_snippet":"\"larger generative model based on the GPT\" and \"state-of-the-art performance in various single-cell\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"none","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"unclear","generative_model_present":"yes","foundation_model_evidence":"unclear"}}},{"record_id":"rec_000016","title":"Chromatin unwinding state for in situ identification and lineage tracing of circulating tumor cells","abstract":"To the Editor, Circulating tumor cells (CTCs) are key metastatic precursors, yet their extreme  rarity and molecular heterogeneity—including downregulation of epithelial markers (eg,","doi":"","year":"NA","venue":"iMeta","sources":["google_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_000016","paper_type":"unclear","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"paper_type_unclear","decision_rationale":"The title and abstract fragment indicate a biological study on circulating tumor cells, but no text/language component is evident. The truncated abstract makes the exact paper type uncertain.","evidence_snippet":"“Circulating tumor cells (CTCs) are key metastatic precursors”"},"architecture_reviewer":{"record_id":"rec_000016","paper_type":"unclear","generative_model_present":"no","foundation_model_evidence":"no","primary_exclusion_code":"EC4_no_foundation_model_evidence","uncertainty_reason":"paper_type_unclear","decision_rationale":"The provided abstract fragment does not describe an AI model or generative architecture. It appears to be a biological methods/editorial item, so there is no foundation-model evidence in the record.","evidence_snippet":"Only a truncated biology-focused fragment is provided: \"Chromatin unwinding state for in situ identification and lineage tracing of circulating tumor cells\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"EC2_no_text_component","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"unclear","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","generative_model_present":"no","foundation_model_evidence":"no"}}},{"record_id":"rec_000017","title":"Evaluating the Effectiveness of Parameter-Efficient Fine-Tuning in Genomic Classification Tasks","abstract":"ABSTRACT\n                Foundation models are increasingly being leveraged for biological tasks. To address the high memory requirements of fine-tuning large pre-trained language models, parameter efficient fine-tuning (PEFT) methods are also being increasingly utilized. Previous studies have shown minimal, if any, loss in performance when using PEFT on binary classification tasks. However, the impact of using PEFT on tasks with large classification spaces has not been systemically evaluated. In this work, we apply PEFT to the problem of taxonomic classification using pre-trained genomic language models as the classification backbone. We explore various training strategies—including PEFT, full fine-tuning, and partial fine-tuning—for classifying sequences at the superkingdom, phylum, and genus levels. We find that PEFT-trained models significantly underperform compared to those trained via full fine-tuning or partial fine-tuning. Additionally, we demonstrate increased performance of pretrained models over those randomly initialized.","doi":"10.1101/2025.08.21.671544","year":"2025","venue":"bioRxiv","sources":["semantic_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_000017","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","primary_exclusion_code":"none","uncertainty_reason":"none","decision_rationale":"Primary study on PEFT for taxonomic classification using pre-trained genomic language models. The abstract centers on biological sequences modeled with a language-model backbone.","evidence_snippet":"\"pre-trained genomic language models as the classification backbone\"; \"taxonomic classification using ... PEFT\""},"architecture_reviewer":{"record_id":"rec_000017","paper_type":"primary_model_paper","generative_model_present":"no","foundation_model_evidence":"yes","primary_exclusion_code":"none","uncertainty_reason":"none","decision_rationale":"The abstract describes PEFT applied to pre-trained genomic language models for taxonomic classification, not a generative architecture. It does show foundation-model-like pretraining and transfer to downstream genomic tasks.","evidence_snippet":"\"pre-trained genomic language models as the classification backbone\"; \"performance of pretrained models over those randomly initialized\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"none","adjudication_reason":"fallback_unresolved","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","generative_model_present":"no","foundation_model_evidence":"yes"}}},{"record_id":"rec_000018","title":"IMG-33. Unveiling glioblastoma heterogeneity with deep learning derived MRI subtyping: insights from the global ReSPOND consortium","abstract":"This study aims to identify distinct imaging subtypes of glioblastoma using multi-modal MRIs from the ReSPOND consortium, providing insights into tumor heterogeneity to inform personalized treatment approaches.\n \n \n \n We analyzed 3,145 subjects with multi-modal MRIs (T1, T2, T1Gd, FLAIR) from 16 geographically distinct institutions across North America, Europe, and Asia. Radiomic features were extracted using Masked Auto-Encoder (MAE), a deep learning architecture trained through self-supervised learning on 23,608 MRIs across 11-dimensional MRI-derived imaging measures (conventional, diffusion, and perfusion protocols). For clustering analysis, we used features extracted from the four structural modalities available in all subjects. Following feature extraction, we applied ComBat harmonization to remove institutional batch effects, performed dimensionality reduction using cross-validated PCA, and employed K-medoids clustering with consensus analysis (100 random data partitions with a 90/10 split for clustering/validation) to identify stable subtypes, with optimal cluster number determined using adjusted rand index. Additionally, we extracted morphological, intensity, and textural features to characterize the identified subtypes in an interpretable manner.\n \n \n \n Our analysis revealed three reproducible glioblastoma subtypes. Statistical analysis demonstrated significant differences between subtypes in tumor morphology and spatial location features. Subtype 1 showed centrally located, spherical tumors; Subtype 2 exhibited peripheral, irregular morphologies; Subtype 3 had mixed features (p < 0.001). Key features included right hemisphere ratio, centroid Z position, sphericity, and shape convexity ratio (p < 0.001). Survival analysis indicated median overall survival of 12.3, 14.5, and 16.8 months for Subtypes 1, 2, and 3, respectively (p = 0.042, borderline). Preliminary genomic analysis showed frequent TP53 and RB1 co-mutations, with distinct molecular patterns per subtype.\n \n \n \n This study demonstrates that multi-modal MRIs can successfully identify glioblastoma subtypes characterized by deep learning derived radiomic features. Future work will focus on validation with comprehensive molecular and tissue-based profiles, survival outcomes, and treatment responses to support personalized medicine.","doi":"10.1093/neuonc/noaf201.1112","year":"2025","venue":"Neuro-Oncology","sources":["semantic_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_000018","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"This is a primary imaging study on glioblastoma subtype discovery from multi-modal MRIs. No text or language component is described in the model or method.","evidence_snippet":"\"multi-modal MRIs\"; \"identify distinct imaging subtypes of glioblastoma\""},"architecture_reviewer":{"record_id":"rec_000018","paper_type":"application_wrapper","generative_model_present":"yes","foundation_model_evidence":"yes","primary_exclusion_code":"application_wrapper","uncertainty_reason":"none","decision_rationale":"This is an application of a masked autoencoder to extract MRI features for clustering and subtyping, rather than a new model paper. The self-supervised pretraining on 23,608 MRIs supports foundation-model-like broad pretraining.","evidence_snippet":"\"Radiomic features were extracted using Masked Auto-Encoder (MAE)\"; \"trained through self-supervised learning on 23,608 MRIs\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"EC2_no_text_component","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","generative_model_present":"yes","foundation_model_evidence":"yes"}}},{"record_id":"rec_000019","title":"Automated machine learning with interpretation: A systematic review of methodologies and applications in healthcare","abstract":"Machine learning (ML) has achieved substantial success in performing healthcare tasks in which the configuration of every part of the ML pipeline relies heavily on technical knowledge. To help professionals with borderline expertise to better use ML techniques, Automated ML (AutoML) has emerged as a prospective solution. However, most models generated by AutoML are black boxes that are challenging to comprehend and deploy in healthcare settings. We conducted a systematic review to examine AutoML with interpretation systems for healthcare. We searched four databases (MEDLINE, EMBASE, Web of Science, and Scopus) complemented with seven prestigious ML conferences (AAAI, ACL, ICLR, ICML, IJCAI, KDD, and NeurIPS) that reported AutoML with interpretation for healthcare before September 1, 2023. We included 118 articles related to AutoML with interpretation in healthcare. First, we illustrated AutoML techniques used in the included publications, including automated data preparation, automated feature engineering, and automated model development, accompanied by a real‐world case study to demonstrate the advantages of AutoML over classic ML. Then, we summarized interpretation methods: feature interaction and importance, data dimensionality reduction, intrinsically interpretable models, and knowledge distillation and rule extraction. Finally, we detailed how AutoML with interpretation has been used for six major data types: image, free text, tabular data, signal, genomic sequences, and multi‐modality. To some extent, AutoML with interpretation provides effortless development and improves users' trust in ML in healthcare settings. In future studies, researchers should explore automated data preparation, seamless integration of automation and interpretation, compatibility with multi‐modality, and utilization of foundation models.","doi":"10.1002/med4.75","year":"2024","venue":"Medicine Advances","sources":["semantic_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_000019","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"unclear","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"The abstract explicitly states this is a systematic review of AutoML with interpretation in healthcare. It summarizes prior applications rather than presenting a new candidate model.","evidence_snippet":"\"We conducted a systematic review\"; includes \"free text\" and \"genomic sequences\" as reviewed data types"},"architecture_reviewer":{"record_id":"rec_000019","paper_type":"review_editorial","generative_model_present":"no","foundation_model_evidence":"no","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"The abstract explicitly states this is a systematic review of AutoML with interpretation systems, not an original generative model. It discusses existing methods and applications rather than presenting a foundation model.","evidence_snippet":"\"We conducted a systematic review\"; \"included 118 articles\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"review_editorial","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"unclear","generative_model_present":"no","foundation_model_evidence":"no"}}}]
