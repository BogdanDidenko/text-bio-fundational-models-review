/Users/bogdan.didenko/lpnu/review/data/screening_codex_2026-07-06/role_logs/adjudicator/batch_0002.prompt.txt:52:[{"record_id":"rec_000013","title":"Generative Artificial Intelligence and Large Language Models in Clinical Oncology.","abstract":"ABSTRACT Cancer remains a major global health challenge, and the increasing availability of multimodal biomedical data has created unprecedented opportunities for precision oncology. Recent advances in generative artificial intelligence (AI), particularly large language models (LLMs), have enabled new approaches for integrating heterogeneous data sources, including electronic health records, medical imaging, pathology, genomics, and clinical text. However, current studies remain fragmented across specific tasks, cancer types, and model architectures, and a comprehensive synthesis of how generative AI can support the entire oncology continuum is still lacking. This review provides an overview of generative AI in clinical oncology, covering LLMs, generative adversarial networks, diffusion models, and multimodal foundation models. We summarize their methodological foundations and discuss applications in cancer diagnosis, prognosis prediction, treatment planning, patient management, and clinical trial optimization. Particular attention is given to multimodal data integration, synthetic data generation, clinical reasoning, and decision support, together with current challenges related to interpretability, reliability, data privacy, regulatory governance, and real‐world implementation. By consolidating recent technological advances and clinical evidence, this review highlights future priorities toward safe, trustworthy, and clinically deployable intelligent oncology systems. Emerging agent‐based architectures and human–AI collaborative workflows may further expand the clinical utility of generative AI in oncology.","doi":"10.1002/mco2.70833","year":"2026","venue":"MedComm","sources":["pubmed","scopus","semantic_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_000013","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"The abstract states it is a review of generative AI and LLMs in clinical oncology. It summarizes multimodal biomedical data integration and clinical text applications rather than proposing a new model.","evidence_snippet":"\"This review provides an overview of generative AI in clinical oncology\" and \"including electronic health records ... genomics, and clinical text\""},"architecture_reviewer":{"record_id":"rec_000013","paper_type":"review_editorial","generative_model_present":"unclear","foundation_model_evidence":"unclear","primary_exclusion_code":"review_editorial","uncertainty_reason":"foundation_model_evidence_unclear","decision_rationale":"The abstract is a review of generative AI and LLMs in oncology, not a primary model description. It surveys generative AI methods, but does not establish a specific model's architecture or training scale.","evidence_snippet":"\"This review provides an overview of generative AI in clinical oncology\" and \"multimodal foundation models\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"review_editorial","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","generative_model_present":"unclear","foundation_model_evidence":"unclear"}}},{"record_id":"rec_000014","title":"A Genomics-Guided Multimodal Contrastive Learning Framework for Clinically Significant Prostate Cancer Risk Stratification with Missing Clinical Data.","abstract":"Heterogeneous data integration remains a major challenge in intelligent information systems, particularly under missing-modality and cross-domain conditions. Existing multimodal fusion approaches often rely on complete datasets and weak alignment mechanisms, limiting their robustness and practical applicability. This study aims to develop and evaluate a genomics-guided multimodal representation learning framework that enables robust heterogeneous data fusion, reliable cross-modal correspondence, and accurate prediction under incomplete-data conditions. We propose a multimodal learning architecture that models genomics as the primary biological anchor and learns conditional projections to imaging modalities, including multiparametric MRI and whole-slide histopathology (WSI). The framework formulates multimodal fusion as a genomics-guided contrastive learning problem, incorporates domain-specific optimization constraints, and learns a latent shared-state representation to support inference without requiring fully paired datasets. Evaluation was conducted using public datasets, including TCGA-PRAD and TCIA, across low-risk versus higher-risk/clinically significant prostate cancer (csPCa) discrimination, Gleason-based risk stratification, and clinically significant outcome prediction tasks under realistic multimodal and missing-modality scenarios. In the adequately powered Genomics+WSI cohort ( The proposed framework provides a scalable and generalizable solution for heterogeneous multimodal data fusion, supporting reliable prediction, robustness to missing modalities, and applicability to complex information systems beyond the studied domain.","doi":"10.3390/cancers18121952","year":"2026","venue":"Cancers","sources":["pubmed"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_000014","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"Primary multimodal learning framework using genomics, MRI, and histopathology for prostate cancer risk stratification. The abstract does not describe a substantive text/language component.","evidence_snippet":"\"models genomics as the primary biological anchor\" and \"imaging modalities, including multiparametric MRI and whole-slide histopathology\""},"architecture_reviewer":{"record_id":"rec_000014","paper_type":"primary_model_paper","generative_model_present":"no","foundation_model_evidence":"unclear","primary_exclusion_code":"EC3_not_generative","uncertainty_reason":"foundation_model_evidence_unclear","decision_rationale":"This is a multimodal contrastive representation-learning framework for risk stratification, not a generative model. It claims generalizability, but the abstract does not show broad pretraining or foundation-model-like transfer evidence.","evidence_snippet":"\"genomics-guided multimodal contrastive learning\" and \"shared-state representation\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"EC2_no_text_component","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","generative_model_present":"no","foundation_model_evidence":"unclear"}}},{"record_id":"rec_000015","title":"Emerging Pathways to Non-Invasive Diagnosis in Endometriosis: Integrating Machine Learning, Deep Learning and Multi-Omics Biomarkers.","abstract":"Endometriosis is a chronic, debilitating condition affecting approximately 10-15% of reproductive-aged women and it is often associated with significant diagnostic delays due to its heterogeneity and unreliable non-invasive tests. Artificial intelligence (AI) offers innovative methods for improving endometriosis diagnosis, prognosis and research via advanced pattern recognition and data analysis capabilities. The integration of AI in diagnostic workflow has the potential to improve efficiency, accuracy, and patient outcomes. This review summarises current developments of AI-including machine learning, deep learning, and natural language processing-in the diagnostic workflow of endometriosis. It analyses different fields of diagnostics ranging from AI-assisted imaging in detection of pouch of Douglas to multi-omics biomarkers assisting the clinical decision process. AI can enhance accuracy, reducing diagnostic delays and supporting personalised treatment planning. However, there are multiple limitations, such as small datasets, overfitting, and lack of external validation and variability. Further research and evaluation are required before it can be implemented into healthcare systems. AI holds promise as a non-invasive, scalable adjunct to current diagnostics, potentially reducing the economic and personal burden endometriosis carries.","doi":"10.3390/diagnostics16121823","year":"2026","venue":"Diagnostics (Basel, Switzerland)","sources":["pubmed"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_000015","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"no","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"This is a review of machine learning, deep learning, and NLP for endometriosis diagnosis. It is not a primary model paper.","evidence_snippet":"\"This review summarises current developments of AI-including machine learning, deep learning, and natural language processing\""},"architecture_reviewer":{"record_id":"rec_000015","paper_type":"review_editorial","generative_model_present":"unclear","foundation_model_evidence":"unclear","primary_exclusion_code":"review_editorial","uncertainty_reason":"foundation_model_evidence_unclear","decision_rationale":"Narrative review of AI methods for endometriosis diagnosis, not a primary model paper. The abstract discusses ML, deep learning, and NLP at a high level without a specific generative or foundation model.","evidence_snippet":"\"This review summarises current developments\" and \"AI-including machine learning, deep learning, and natural language processing\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"review_editorial","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"no","generative_model_present":"unclear","foundation_model_evidence":"unclear"}}},{"record_id":"rec_000017","title":"Cellular architecture and neighborhood-informed virtual spatial tumor profiling from histopathology.","abstract":"The tumor microenvironment (TME) critically shapes disease progression and therapeutic resistance. However, a comprehensive understanding of its spatial architecture remains elusive, and clinical translation is challenging. Here, we present cellular architecture and neighborhood-informed virtual AI-driven spatial profiling (CANVAS), an artificial intelligence platform that infers tumor ecological habitats from hematoxylin and eosin (H&E) histopathology. Built on an atlas of over 18 million cells profiled by 41-plex spatial proteomics across 457 patients with non-small cell lung cancer, CANVAS establishes 10 reproducible cellular neighborhoods (CNs) capturing conserved spatial organization of the TME. Through multimodal alignment and foundation-model-based morphological encoding, CANVAS predicts CN-anchored habitat structures from H&E slides and enables clinical evaluation in over 5,000 patients spanning 9 cancer types. Across patient cohorts, CANVAS supports prognostic modeling, spatial ecotype stratification, and immunotherapy outcome prediction. These results establish CANVAS as a clinically scalable platform for spatial profiling, bridging single-cell analysis to population-level insight and enabling precision oncology.","doi":"10.1016/j.cell.2026.05.031","year":"2026","venue":"Cell","sources":["pubmed"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_000017","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"Primary AI model on H&E histopathology for spatial tumor profiling. The abstract describes foundation-model-based morphological encoding, but no substantive text/language component.","evidence_snippet":"\"foundation-model-based morphological encoding\"; \"predicts CN-anchored habitat structures from H&E slides\""},"architecture_reviewer":{"record_id":"rec_000017","paper_type":"application_wrapper","generative_model_present":"no","foundation_model_evidence":"no","primary_exclusion_code":"application_wrapper","uncertainty_reason":"none","decision_rationale":"The abstract describes a platform that infers spatial tumor habitats from H&E slides, not a generative model. It mentions foundation-model-based encoding, but the candidate itself is presented as a predictive profiling system.","evidence_snippet":"\"foundation-model-based morphological encoding\"; \"predicts CN-anchored habitat structures from H&E slides\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"EC2_no_text_component","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","generative_model_present":"no","foundation_model_evidence":"no"}}},{"record_id":"rec_000019","title":"Charting the computational landscape of single-cell genetic perturbation.","abstract":"Single-cell genetic perturbation screens are increasingly used to study gene function at single-cell resolution. However, their analysis remains difficult because available computational methods differ in assumptions, input requirements, and output definitions, which can complicate cross-study comparison and consistent tool selection. We summarize current methods by organizing single-cell genetic perturbation analysis into a five-step computational workflow: basic data preprocessing, data refinement and correction, perturbation-specific quality control and filtering, effect quantification and network inference, and functional annotation and visualization. Within this structure, we group current algorithms by modeling principle, including regression and testing methods, latent-state and assignment-error models, matrix or manifold-based methods, and latent-variable or generative models. We compare their assumptions, limitations, and use cases to inform method selection. We also summarize strategies for multimodal perturbation analysis, in which transcriptomic, proteomic, epigenomic, spatial, and kinetic readouts affect multiple steps of the workflow. Finally, we review perturbation prediction models, from graph-based approaches to large-scale foundation models, with attention to their input requirements and practical limitations. By linking workflow steps with model assumptions and input requirements, this review provides a basis for method reporting and interpretation in single-cell perturbation studies.","doi":"10.1016/j.jare.2026.06.012","year":"2026","venue":"Journal of advanced research","sources":["pubmed"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_000019","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"unclear","text_bio_bridge_present":"unclear","primary_exclusion_code":"review_editorial","uncertainty_reason":"mixed_signals","decision_rationale":"This is a review of single-cell genetic perturbation analysis methods, not a candidate model paper. It mentions foundation models only as part of a survey of the field.","evidence_snippet":"\"We summarize current methods\"; \"This review provides a basis for method reporting and interpretation\""},"architecture_reviewer":{"record_id":"rec_000019","paper_type":"review_editorial","generative_model_present":"no","foundation_model_evidence":"no","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"The abstract explicitly says it summarizes and reviews current methods and workflows. It does not present a new model.","evidence_snippet":"\"We summarize current methods\"; \"This review provides a basis for method reporting\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"review_editorial","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"unclear","text_bio_bridge_present":"unclear","generative_model_present":"no","foundation_model_evidence":"no"}}},{"record_id":"rec_000025","title":"The Impact of Machine Learning and AI on Bioinformatics","abstract":"The rapid growth of biological data has fundamentally transformed bioinformatics, challenging the effectiveness of traditional methods. This paper examines the evolving role of AI and ML in addressing the limitations of conventional methods such as HMMs and sequence alignment tools. Unlike rule-based approaches, ML techniques enable scalable, data-driven analysis capable of capturing complicated and nonlinear relationships within genomic and multi-omics data. Key applications, including genomic sequence classification, disease prediction, and multi-omics integration, demonstrates the significant advantage of machine-driven methods in improving predictive accuracy and expanding analytical scope. However, challenges such as model interpretability and computational demands remain critical concerns, prompting the development of AI frameworks that are explainable. This paper argues that rather than replacing traditional methods, AI and ML should serve as complementary tools that enhance the overall analytical framework. Future directions highlight the potential of generative models and decision-based machine systems to further advance biological discovery and precision medicine.","doi":"10.54097/7kn89v49","year":"2026","venue":"Highlights in Science Engineering and Technology","sources":["semantic_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_000025","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"This is a review of AI/ML in bioinformatics, not a primary model paper. It mentions generative models only as future directions.","evidence_snippet":"\"This paper examines the evolving role of AI and ML\"; \"Future directions highlight the potential of generative models\""},"architecture_reviewer":{"record_id":"rec_000025","paper_type":"review_editorial","generative_model_present":"unclear","foundation_model_evidence":"unclear","primary_exclusion_code":"review_editorial","uncertainty_reason":"mixed_signals","decision_rationale":"This is a review of AI/ML in bioinformatics, not a primary model paper. It mentions future generative models, but no generative architecture or foundation-model evidence is described.","evidence_snippet":"\"This paper examines the evolving role of AI and ML\" and \"Future directions highlight the potential of generative models\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"review_editorial","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","generative_model_present":"unclear","foundation_model_evidence":"unclear"}}}]
