/Users/bogdan.didenko/lpnu/review/data/determinism_codex_2026-07-01/run_1/role_logs/adjudicator/batch_0001.prompt.txt:52:[{"record_id":"rec_000001","title":"Prompt-based bioinformatic pipeline generation for a multi-step metaviral workflow","abstract":"Abstract\n                  \n                    Motivation\n                    The rapid evolution of bioinformatics tools and multi-step analytic procedure presents a challenge for building effective pipelines, particularly for researchers without extensive programming expertise. This study demonstrates that large language models (LLMs) hold strong potential for generating end-to-end bioinformatic pipelines through carefully crafted prompts, using a multi-step metaviral workflow as a representative example. Multiple LLMs were tested for their effectiveness, including OpenAI ChatGPT series, Anthropic Claude series, Google Gemini, Meta Llama, and DeepSeek.\n                  \n                  \n                    Results\n                    Our results show that ChatGPT-4, ChatGPT-5, Claude 4.5, and Gemini 2.5 consistently outperform other LLMs in generating complete bioinformatic pipelines, with statistically significant success rates. These models also handle tool substitutions effectively. Simple prompt engineering and the inclusion of official documentation further enhance performance, especially for newer bioinformatic tools. While capabilities vary, all LLMs tested show potential for both pipeline generation and updates with our designed prompts and strategies.\n                  \n                  \n                    Availability and implementation\n                    All prompts are available in the paper. The examples are available in GitHub https://github.com/mpckkk/pBio.","doi":"","year":"2026","venue":"Bioinformatics …","sources":["google_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_000001","paper_type":"application_wrapper","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","primary_exclusion_code":"application_wrapper","uncertainty_reason":"none","decision_rationale":"Uses existing LLMs with prompts to generate bioinformatic pipelines; this is a wrapper/use-case paper, not a new foundation model. The biological context is a metaviral workflow, and the text component is the prompting/interface to external LLMs.","evidence_snippet":"\"large language models (LLMs) hold strong potential for generating end-to-end bioinformatic pipelines through carefully crafted prompts\""},"architecture_reviewer":{"record_id":"rec_000001","paper_type":"application_wrapper","generative_model_present":"yes","foundation_model_evidence":"unclear","primary_exclusion_code":"application_wrapper","uncertainty_reason":"foundation_model_evidence_unclear","decision_rationale":"The abstract is about using existing LLMs to generate bioinformatic pipelines, not proposing a new generative model. It does not clearly show foundation-model characteristics beyond model names.","evidence_snippet":"“large language models (LLMs) hold strong potential for generating end-to-end bioinformatic pipelines” and “Multiple LLMs were tested”"},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"application_wrapper","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"application_wrapper","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","generative_model_present":"yes","foundation_model_evidence":"unclear"}}},{"record_id":"rec_000004","title":"DestinyNet: A deep-learning framework for cell-fate analysis from lineage-tracing single-cell RNA sequencing data","abstract":"-scSeq datasets to pretrain a foundation model. Such a model, ideally incorporating biological   We used the scRNA-seq GEX information and cell-type annotation curated by CoSpar as","doi":"","year":"2026","venue":"Patterns","sources":["google_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_000004","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"text_component_unclear","decision_rationale":"The title and excerpt indicate a single-cell RNA-seq deep-learning framework, but no text/language component is described. The available abstract text is truncated, so the exact model scope is limited, but it is still a bio-only framework.","evidence_snippet":"\"deep-learning framework for cell-fate analysis from lineage-tracing single-cell RNA sequencing data\""},"architecture_reviewer":{"record_id":"rec_000004","paper_type":"unclear","generative_model_present":"no","foundation_model_evidence":"unclear","primary_exclusion_code":"EC3_not_generative","uncertainty_reason":"paper_type_unclear","decision_rationale":"The abstract fragment describes a deep-learning framework for cell-fate analysis but does not state any generative mechanism. Foundation-model evidence is only hinted at by the truncated phrase about pretraining.","evidence_snippet":"“a deep-learning framework for cell-fate analysis” and “pretrain a foundation model”"},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"EC2_no_text_component","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","generative_model_present":"no","foundation_model_evidence":"unclear"}}},{"record_id":"rec_000006","title":"STAG-LLM: Predicting TCR-pHLA binding with protein language models and computationally generated 3D structures.","abstract":"Background: Strong binding between T cell receptors (TCRs) and peptide–HLA (pHLA) complexes is important for triggering the adaptive immune response. Binding specificity prediction, identifying which TCRs will bind strongly to which pHLAs, can serve as a first step in designing personalized immunotherapy treatments. Existing machine learning (ML) methods to predict binding specificity rely primarily on the amino acid sequences of TCRs and pHLAs to make predictions. However, incorporating the 3D structure and geometry of the TCR-pHLA complex as an additional data modality alongside protein sequence offers a promising approach to improving ML methods for predicting TCR-pHLA binding specificity. Modern computational modeling tools present unprecedented opportunities to incorporate structure data into ML pipelines. We utilize such computational tools to incorporate 3D data into this work. Results: We present STAG-LLM, a multimodal ML model for predicting TCR-pHLA binding specificity that leverages sequence data and computationally generated 3D protein structures. We show that by combining a protein language model with a geometric deep learning architecture, our method outperforms existing methods even when trained on 3x smaller datasets. To further validate our model, we conduct in vitro alanine scanning experiments for four peptides and demonstrate a correlation with the attention weights learned by our model and in vitro results. We also seek to address three key challenges that arise from using computationally generated 3D structures in ML pipelines: increased inference costs arising from the need to generate 3D structures, limited training data, and robustness to noise in the generated structures. Conclusions: STAG-LLM shows tremendous potential for structure-based TCR-pHLA binding prediction methods, offering a foundation for further advancements in using modeled 3D structures to solve problems in immunology and proteomics. We anticipate that the usefulness of STAG-LLM and similar tools will increase in coming years as both protein structure prediction models and large language models continue to advance.","doi":"10.1016/j.csbj.2025.09.004","year":"2025","venue":"Computational and structural biotechnology journal","sources":["pubmed","scopus","semantic_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_000006","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","primary_exclusion_code":"none","uncertainty_reason":"none","decision_rationale":"The abstract explicitly describes a protein language model combined with geometric deep learning and 3D protein structures. This is a primary multimodal model paper with a substantive language component and a clear sequence-structure bridge.","evidence_snippet":"\"leverages sequence data and computationally generated 3D protein structures\" and \"combine a protein language model with a geometric deep learning architecture\""},"architecture_reviewer":{"record_id":"rec_000006","paper_type":"application_wrapper","generative_model_present":"no","foundation_model_evidence":"unclear","primary_exclusion_code":"application_wrapper","uncertainty_reason":"foundation_model_evidence_unclear","decision_rationale":"This is a predictive binding model that combines a protein language model with generated 3D structures. The abstract does not clearly establish foundation-model-like training or broad applicability for the candidate model itself.","evidence_snippet":"“a multimodal ML model for predicting TCR-pHLA binding specificity” and “combining a protein language model with a geometric deep learning architecture”"},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"application_wrapper","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","generative_model_present":"no","foundation_model_evidence":"unclear"}}},{"record_id":"rec_000010","title":"A multi-modal transformer for cell type-agnostic regulatory predictions.","abstract":"Sequence-based deep learning models have emerged as powerful tools for deciphering the cis-regulatory grammar of the human genome but cannot generalize to unobserved cellular contexts. Here, we present EpiBERT, a multi-modal transformer that learns generalizable representations of genomic sequence and cell type-specific chromatin accessibility through a masked accessibility-based pre-training objective. Following pre-training, EpiBERT can be fine-tuned for gene expression prediction, achieving accuracy comparable to the sequence-only Enformer model, while also being able to generalize to unobserved cell states. The learned representations are interpretable and useful for predicting chromatin accessibility quantitative trait loci (caQTLs), regulatory motifs, and enhancer-gene links. Our work represents a step toward improving the generalization of sequence-based deep neural networks in regulatory genomics.","doi":"10.1016/j.xgen.2025.100762","year":"2025","venue":"Cell genomics","sources":["pubmed","scopus"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_000010","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"Primary model for genomic sequence and chromatin accessibility. It is a multimodal biological model, but the abstract does not support a substantive text/language component.","evidence_snippet":"“multi-modal transformer that learns generalizable representations of genomic sequence and cell type-specific chromatin accessibility”"},"architecture_reviewer":{"record_id":"rec_000010","paper_type":"primary_model_paper","generative_model_present":"unclear","foundation_model_evidence":"yes","primary_exclusion_code":"none","uncertainty_reason":"generative_status_unclear","decision_rationale":"The abstract describes a multi-modal transformer with masked pre-training and transferable representations, which supports foundation-model-like evidence. It does not clearly state a genuinely generative mechanism such as autoregressive or decoder-based generation.","evidence_snippet":"\"multi-modal transformer\" with \"masked accessibility-based pre-training objective\" and \"generalizable representations\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"EC2_no_text_component","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","generative_model_present":"unclear","foundation_model_evidence":"yes"}}},{"record_id":"rec_000011","title":"Large language models in genomics—a perspective on personalized medicine","abstract":"Integrating artificial intelligence (AI), particularly large language models (LLMs), into the healthcare industry is revolutionizing the field of medicine. LLMs possess the capability to analyze the scientific literature and genomic data by comprehending and producing human-like text. This enhances the accuracy, precision, and efficiency of extensive genomic analyses through contextualization. LLMs have made significant advancements in their ability to understand complex genetic terminology and accurately predict medical outcomes. These capabilities allow for a more thorough understanding of genetic influences on health issues and the creation of more effective therapies. This review emphasizes LLMs’ significant impact on healthcare, evaluates their triumphs and limitations in genomic data processing, and makes recommendations for addressing these limitations in order to enhance the healthcare system. It explores the latest advancements in LLMs for genomic analysis, focusing on enhancing disease diagnosis and treatment accuracy by taking into account an individual’s genetic composition. It also anticipates a future in which AI-driven genomic analysis is commonplace in clinical practice, suggesting potential research areas. To effectively leverage LLMs’ potential in personalized medicine, it is vital to actively support innovation across multiple sectors, ensuring that AI developments directly contribute to healthcare solutions tailored to individual patients.","doi":"","year":"2025","venue":"Bioengineering","sources":["google_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_000011","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"This is a perspective/review on LLMs in genomics and personalized medicine, not a primary model paper. It discusses LLMs applied to genomic data and literature.","evidence_snippet":"“a perspective on personalized medicine” and “This review emphasizes LLMs’ significant impact on healthcare”"},"architecture_reviewer":{"record_id":"rec_000011","paper_type":"review_editorial","generative_model_present":"unclear","foundation_model_evidence":"unclear","primary_exclusion_code":"review_editorial","uncertainty_reason":"mixed_signals","decision_rationale":"This is a perspective article about LLMs in genomics, not a primary model report. It mentions LLM capabilities in general, but no specific candidate model or pretraining evidence is presented.","evidence_snippet":"\"a perspective on personalized medicine\" and discussion of \"large language models (LLMs)\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"review_editorial","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","generative_model_present":"unclear","foundation_model_evidence":"unclear"}}},{"record_id":"rec_000012","title":"Novel research and future prospects of artificial intelligence in cancer diagnosis and treatment","abstract":"Research into the potential benefits of artificial intelligence for comprehending the intricate biology of cancer has grown as a result of the widespread use of deep learning and machine learning in the healthcare sector and the availability of highly specialized cancer datasets. Here, we review new artificial intelligence approaches and how they are being used in oncology. We describe how artificial intelligence might be used in the detection, prognosis, and administration of cancer treatments and introduce the use of the latest large language models such as ChatGPT in oncology clinics. We highlight artificial intelligence applications for omics data types, and we offer perspectives on how the various data types might be combined to create decision-support tools. We also evaluate the present constraints and challenges to applying artificial intelligence in precision oncology. Finally, we discuss how current challenges may be surmounted to make artificial intelligence useful in clinical settings in the future.","doi":"10.1186/s13045-023-01514-5","year":"2023","venue":"Journal of Hematology and Oncology","sources":["scopus"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_000012","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"The abstract explicitly says this paper reviews new AI approaches in oncology and discusses large language models such as ChatGPT. That makes it a review/editorial rather than a candidate model paper.","evidence_snippet":"“We review new artificial intelligence approaches” and “the latest large language models such as ChatGPT in oncology clinics”"},"architecture_reviewer":{"record_id":"rec_000012","paper_type":"review_editorial","generative_model_present":"unclear","foundation_model_evidence":"unclear","primary_exclusion_code":"review_editorial","uncertainty_reason":"mixed_signals","decision_rationale":"The abstract is a broad review of AI in oncology and mentions ChatGPT as an example, but it is not a primary model paper. No specific generative architecture or foundation-model evidence is described.","evidence_snippet":"\"We review new artificial intelligence approaches\" and \"the latest large language models such as ChatGPT\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"review_editorial","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","generative_model_present":"unclear","foundation_model_evidence":"unclear"}}}]
