./data/screening_codex_full_2026-07-06/role_logs/adjudicator/batch_0023.prompt.txt:52:[{"record_id":"rec_000488","title":"Integrative Multiscale Biochemical Mapping of the Brain via Deep-Learning-Enhanced High-Throughput Mass Spectrometry.","abstract":"Elucidating the spatial-biochemical organization of the brain across different scales produces invaluable insight into the molecular intricacy of the brain. While mass spectrometry imaging (MSI) provides spatial localization of compounds, comprehensive chemical profiling at a brain-wide scale in three dimensions by MSI with single-cell resolution has not been achieved. We demonstrate complementary brain-wide and single-cell biochemical mapping via MEISTER, an integrative experimental and computational mass spectrometry framework. MEISTER integrates a deep-learning-based reconstruction that accelerates high-mass-resolving MS by 15-fold, multimodal registration creating 3D molecular distributions, and a data integration method fitting cell-specific mass spectra to 3D data sets. We imaged detailed lipid profiles in tissues with data sets containing millions of pixels, and in large single-cell populations acquired from the rat brain. We identified region-specific lipid contents, and cell-specific localizations of lipids depending on both cell subpopulations and anatomical origins of the cells. Our workflow establishes a blueprint for future developments of multiscale technologies for biochemical characterization of the brain.","doi":"10.1101/2023.05.31.543144","year":"2023","venue":"bioRxiv : the preprint server for biology","sources":["biorxiv_medrxiv","pubmed","semantic_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_000488","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"This is a deep-learning biochemical mapping workflow for brain mass spectrometry and imaging. No text or language component is mentioned in the abstract.","evidence_snippet":"“Integrative Multiscale Biochemical Mapping of the Brain” and “deep-learning-based reconstruction” with mass spectrometry"},"architecture_reviewer":{"record_id":"rec_000488","paper_type":"application_wrapper","generative_model_present":"no","foundation_model_evidence":"no","primary_exclusion_code":"application_wrapper","uncertainty_reason":"none","decision_rationale":"The abstract describes an experimental and computational workflow for biochemical mapping with deep-learning-based reconstruction. It does not present a generative model or foundation-model evidence.","evidence_snippet":"\"an integrative experimental and computational mass spectrometry framework\" and \"deep-learning-based reconstruction\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"EC2_no_text_component","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","generative_model_present":"no","foundation_model_evidence":"no"}}},{"record_id":"rec_000489","title":"Cell type matching across species using protein embeddings and transfer learning.","abstract":"Knowing the relation between cell types is crucial for translating experimental results from mice to humans. Establishing cell type matches, however, is hindered by the biological differences between the species. A substantial amount of evolutionary information between genes that could be used to align the species is discarded by most of the current methods since they only use one-to-one orthologous genes. Some methods try to retain the information by explicitly including the relation between genes, however, not without caveats. In this work, we present a model to transfer and align cell types in cross-species analysis (TACTiCS). First, TACTiCS uses a natural language processing model to match genes using their protein sequences. Next, TACTiCS employs a neural network to classify cell types within a species. Afterward, TACTiCS uses transfer learning to propagate cell type labels between species. We applied TACTiCS on scRNA-seq data of the primary motor cortex of human, mouse, and marmoset. Our model can accurately match and align cell types on these datasets. Moreover, our model outperforms Seurat and the state-of-the-art method SAMap. Finally, we show that our gene matching method results in better cell type matches than BLAST in our model. The implementation is available on GitHub (https://github.com/kbiharie/TACTiCS). The preprocessed datasets and trained models can be downloaded from Zenodo (https://doi.org/10.5281/zenodo.7582460).","doi":"10.1093/bioinformatics/btad248","year":"2023","venue":"Bioinformatics (Oxford, England)","sources":["biorxiv_medrxiv","pubmed","scopus","semantic_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_000489","paper_type":"application_wrapper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"The record is a cross-species cell-type matching method built on protein embeddings and transfer learning, not a substantive text-bio model. The NLP model is used on protein sequences as a helper step, not as a text-generative component.","evidence_snippet":"\"uses a natural language processing model to match genes using their protein sequences\""},"architecture_reviewer":{"record_id":"rec_000489","paper_type":"primary_model_paper","generative_model_present":"no","foundation_model_evidence":"no","primary_exclusion_code":"EC3_not_generative","uncertainty_reason":"none","decision_rationale":"TACTiCS is a transfer-learning classifier for cross-species cell-type matching. The abstract does not describe a genuinely generative architecture or foundation-model-like pretraining.","evidence_snippet":"“uses a natural language processing model to match genes… employs a neural network to classify cell types… uses transfer learning”"},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"EC2_no_text_component","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"application_wrapper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","generative_model_present":"no","foundation_model_evidence":"no"}}},{"record_id":"rec_000499","title":"Systematic comparison of multi-omics survival models reveals a widespread lack of noise resistance.","abstract":"As observed in several previous studies, integrating more molecular modalities in multi-omics cancer survival models may not always improve model accuracy. In this study, we compared eight deep learning and four statistical integration techniques for survival prediction on 17 multi-omics datasets, examining model performance in terms of overall accuracy and noise resistance. We found that one deep learning method, mean late fusion, and two statistical methods,","doi":"10.1016/j.crmeth.2023.100461","year":"2023","venue":"Cell reports methods","sources":["pubmed","scopus"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_000499","paper_type":"benchmark_resource","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"benchmark_resource","uncertainty_reason":"none","decision_rationale":"This is a systematic comparison of existing multi-omics survival models across datasets, not a new candidate model paper. It focuses on benchmarking model performance and noise resistance.","evidence_snippet":"\"We compared eight deep learning and four statistical integration techniques\""},"architecture_reviewer":{"record_id":"rec_000499","paper_type":"unclear","generative_model_present":"no","foundation_model_evidence":"no","primary_exclusion_code":"EC3_not_generative","uncertainty_reason":"paper_type_unclear","decision_rationale":"The abstract describes a comparative study of survival models on multi-omics datasets, not a generative text-bio model. It provides no evidence of foundation-model-style pretraining or transfer.","evidence_snippet":"\"Systematic comparison of multi-omics survival models\"; \"compared eight deep learning and four statistical integration techniques\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"benchmark_resource","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"benchmark_resource","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","generative_model_present":"no","foundation_model_evidence":"no"}}},{"record_id":"rec_000507","title":"Editorial: AI and data science in drug development and public health: Highlights from the MCBIOS 2022 conference.","abstract":"COPYRIGHT © 2023 Homayouni, Manda, Tan and Qin. This is an open-access article distributed under the terms of the Creative Commons Attribution License (CC BY). The use, distribution or reproduction in other forums is permitted, provided the original author(s) and the copyright owner(s) are credited and that the original publication in this journal is cited, in accordance with accepted academic practice. No use, distribution or reproduction is permitted which does not comply with these terms. Editorial: AI and data science in drug development and public health: Highlights from the MCBIOS 2022 conference","doi":"10.3389/fdata.2023.1156811","year":"2023","venue":"Frontiers in big data","sources":["pubmed","scopus"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_000507","paper_type":"review_editorial","bio_modality_present":"unclear","text_component_present":"unclear","text_bio_bridge_present":"unclear","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"The record is explicitly an editorial and does not present a candidate model. No substantive model details are provided in the abstract.","evidence_snippet":"\"Editorial: AI and data science in drug development and public health\""},"architecture_reviewer":{"record_id":"rec_000507","paper_type":"review_editorial","generative_model_present":"no","foundation_model_evidence":"no","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"The record is an editorial announcing conference highlights rather than an original model paper. No generative architecture or foundation-model evidence is described.","evidence_snippet":"\"Editorial: AI and data science in drug development and public health\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"review_editorial","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"review_editorial","bio_modality_present":"unclear","text_component_present":"unclear","text_bio_bridge_present":"unclear","generative_model_present":"no","foundation_model_evidence":"no"}}},{"record_id":"rec_000516","title":"Identifying and Analyzing Topic Clusters in a Nutri-, Food-, and Diet-Proteomic Corpus Using Machine Reading.","abstract":"Nutrition affects the early stages of disease development, but the mechanisms remain poorly understood. High-throughput proteomic methods are being used to generate data and information on the effects of nutrients, foods, and diets on health and disease processes. In this report, a novel machine reading pipeline was used to identify all articles and abstracts on proteomics, diet, food, and nutrition in humans. The resulting proteomic corpus was further analyzed to produce seven clusters of \"thematic\" content defined as documents that have similar word content. Examples of publications from several of these clusters were then described in a similar way to a typical descriptive review.","doi":"10.3390/nu15020270","year":"2023","venue":"Nutrients","sources":["pubmed","scopus"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_000516","paper_type":"application_wrapper","bio_modality_present":"no","text_component_present":"yes","text_bio_bridge_present":"no","primary_exclusion_code":"application_wrapper","uncertainty_reason":"none","decision_rationale":"This is a machine-reading pipeline that analyzes articles and abstracts about proteomics, diet, food, and nutrition. The abstract does not describe a biological data modality or a substantive text-bio foundation model bridge.","evidence_snippet":"\"a novel machine reading pipeline\"; \"identify all articles and abstracts on proteomics, diet, food, and nutrition\""},"architecture_reviewer":{"record_id":"rec_000516","paper_type":"unclear","generative_model_present":"no","foundation_model_evidence":"no","primary_exclusion_code":"EC3_not_generative","uncertainty_reason":"paper_type_unclear","decision_rationale":"The abstract describes a machine-reading pipeline for clustering documents, not a generative text-bio model. It is about corpus analysis and thematic clustering rather than model generation or broad pretraining.","evidence_snippet":"\"a novel machine reading pipeline was used to identify all articles and abstracts\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"application_wrapper","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"application_wrapper","bio_modality_present":"no","text_component_present":"yes","text_bio_bridge_present":"no","generative_model_present":"no","foundation_model_evidence":"no"}}},{"record_id":"rec_000518","title":"A multi-view latent variable model reveals cellular heterogeneity in complex tissues for paired multimodal single-cell data.","abstract":"Abstract Motivation Single-cell multimodal assays allow us to simultaneously measure two different molecular features of the same cell, enabling new insights into cellular heterogeneity, cell development and diseases. However, most existing methods suffer from inaccurate dimensionality reduction for the joint-modality data, hindering their discovery of novel or rare cell subpopulations. Results Here, we present VIMCCA, a computational framework based on variational-assisted multi-view canonical correlation analysis to integrate paired multimodal single-cell data. Our statistical model uses a common latent variable to interpret the common source of variances in two different data modalities. Our approach jointly learns an inference model and two modality-specific non-linear models by leveraging variational inference and deep learning. We perform VIMCCA and compare it with 10 existing state-of-the-art algorithms on four paired multi-modal datasets sequenced by different protocols. Results demonstrate that VIMCCA facilitates integrating various types of joint-modality data, thus leading to more reliable and accurate downstream analysis. VIMCCA improves our ability to identify novel or rare cell subtypes compared to existing widely used methods. Besides, it can also facilitate inferring cell lineage based on joint-modality profiles. Availability and implementation The VIMCCA algorithm has been implemented in our toolkit package scbean (≥0.5.0), and its code has been archived at https://github.com/jhu99/scbean under MIT license. Supplementary information Supplementary data are available at Bioinformatics online.","doi":"10.1093/bioinformatics/btad005","year":"2023","venue":"Bioinformatics (Oxford, England)","sources":["pubmed","scopus","semantic_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_000518","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"Introduces VIMCCA for paired multimodal single-cell data integration. The modalities are biological assay data, but there is no text/language component described.","evidence_snippet":"\"integrate paired multimodal single-cell data\"; \"jointly learns an inference model and two modality-specific non-linear models\""},"architecture_reviewer":{"record_id":"rec_000518","paper_type":"primary_model_paper","generative_model_present":"unclear","foundation_model_evidence":"no","primary_exclusion_code":"EC4_no_foundation_model_evidence","uncertainty_reason":"generative_status_unclear","decision_rationale":"The abstract describes a variational latent-variable framework, which suggests a generative-style model, but it does not clearly state a decoder or other explicit generative mechanism. It is a specialized multimodal integration method, not evidence of a foundation model.","evidence_snippet":"\"based on variational-assisted multi-view canonical correlation analysis\" and \"jointly learns an inference model and two modality-specific non-linear models\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"EC2_no_text_component","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","generative_model_present":"unclear","foundation_model_evidence":"no"}}}]
