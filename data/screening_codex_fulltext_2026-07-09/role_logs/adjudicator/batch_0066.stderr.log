512679999999, "b": 153.13548829999957, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 3]}]}, {"self_ref": "#/texts/892", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 16, "bbox": {"l": 73.131, "t": 148.66441219999956, "r": 86.42512679999999, "b": 141.18048829999952, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 3]}]}, {"self_ref": "#/texts/893", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 16, "bbox": {"l": 73.131, "t": 136.70841219999954, "r": 86.42512679999999, "b": 129.2244882999995, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 3]}]}, {"self_ref": "#/texts/894", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 16, "bbox": {"l": 73.131, "t": 124.7534121999995, "r": 86.42512679999999, "b": 117.26948829999947, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 3]}]}, {"self_ref": "#/texts/895", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 16, "bbox": {"l": 73.131, "t": 112.79841219999958, "r": 86.42512679999999, "b": 105.31448829999954, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 3]}]}, {"self_ref": "#/texts/896", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 16, "bbox": {"l": 73.131, "t": 100.84341219999953, "r": 86.42512679999999, "b": 93.3594882999995, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 3]}]}, {"self_ref": "#/texts/897", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 16, "bbox": {"l": 73.131, "t": 88.8884121999995, "r": 86.42512679999999, "b": 81.40448829999957, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 3]}]}, {"self_ref": "#/texts/898", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 16, "bbox": {"l": 73.131, "t": 76.93341219999957, "r": 86.42512679999999, "b": 69.44948829999953, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 3]}]}, {"self_ref": "#/texts/899", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 16, "bbox": {"l": 108.0, "t": 706.6616526, "r": 504.00338739999984, "b": 643.3147743929206, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 527]}]}], "headings": ["A DATASETS INFORMATION", "A.3 DATA PREPROCESSING"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 7109630141359406345, "filename": "full_text_user_manual_zeromics.pdf", "uri": null}}}
/Users/bogdan.didenko/lpnu/review/data/docling_uncertain_no_vlm_2026-07-08/chunks/full_2026_07_06_rec_003118.jsonl:95:{"candidate_id": "full_2026-07-06__rec_003118", "chunk_index": 95, "text": "Dataset splitting. Wecategorize the SC datasets in our study based on their usages: (1) large-scale datasets used for Zeromics' pre-training and instruction tuning stage (2) training and fine-tuning datasets split from evaluation datasets used for baseline methods training and fine-tuning (unavailable for ZerOmics in zero-shot setting, partially available for ZerOmics in few-shot settings) (3) 9 held-out evaluation datasets, which are collected from diverse studies and labs only used for testing model performance. The detailed train-test split strategy between type 2 and type 3 datasets is similar to Langcell (Zhao et al., 2024), which can be also seen in each task description of Appendix B.1. Therefore, type 2 and type 3 datasets are split from the same evaluation datasets, sharing the same sampling conditions and sequencing processes, which approximately satisfy the same distribution assumption. In contrast, type 1 datasets originate from independent studies with different research objectives and sampling conditions, resulting in no correspondence with the held-out datasets.", "contextualized_text": "A DATASETS INFORMATION\nA.3 DATA PREPROCESSING\nDataset splitting. Wecategorize the SC datasets in our study based on their usages: (1) large-scale datasets used for Zeromics' pre-training and instruction tuning stage (2) training and fine-tuning datasets split from evaluation datasets used for baseline methods training and fine-tuning (unavailable for ZerOmics in zero-shot setting, partially available for ZerOmics in few-shot settings) (3) 9 held-out evaluation datasets, which are collected from diverse studies and labs only used for testing model performance. The detailed train-test split strategy between type 2 and type 3 datasets is similar to Langcell (Zhao et al., 2024), which can be also seen in each task description of Appendix B.1. Therefore, type 2 and type 3 datasets are split from the same evaluation datasets, sharing the same sampling conditions and sequencing processes, which approximately satisfy the same distribution assumption. In contrast, type 1 datasets originate from independent studies with different research objectives and sampling conditions, resulting in no correspondence with the held-out datasets.", "headings": ["A DATASETS INFORMATION", "A.3 DATA PREPROCESSING"], "pages": [16], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/900", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 16, "bbox": {"l": 108.0, "t": 626.9201940000003, "r": 504.0046835999991, "b": 497.43177439292106, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 1184]}]}], "headings": ["A DATASETS INFORMATION", "A.3 DATA PREPROCESSING"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 7109630141359406345, "filename": "full_text_user_manual_zeromics.pdf", "uri": null}}}
/Users/bogdan.didenko/lpnu/review/data/docling_uncertain_no_vlm_2026-07-08/chunks/full_2026_07_06_rec_003118.jsonl:96:{"candidate_id": "full_2026-07-06__rec_003118", "chunk_index": 96, "text": "Consequently, type 3 dataset is designated as the unseen held-out datasets for evaluation.", "contextualized_text": "A DATASETS INFORMATION\nA.3 DATA PREPROCESSING\nConsequently, type 3 dataset is designated as the unseen held-out datasets for evaluation.", "headings": ["A DATASETS INFORMATION", "A.3 DATA PREPROCESSING"], "pages": [16], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/900", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 16, "bbox": {"l": 108.0, "t": 626.9201940000003, "r": 504.0046835999991, "b": 497.43177439292106, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 1184]}]}], "headings": ["A DATASETS INFORMATION", "A.3 DATA PREPROCESSING"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 7109630141359406345, "filename": "full_text_user_manual_zeromics.pdf", "uri": null}}}
/Users/bogdan.didenko/lpnu/review/data/docling_uncertain_no_vlm_2026-07-08/chunks/full_2026_07_06_rec_003118.jsonl:97:{"candidate_id": "full_2026-07-06__rec_003118", "chunk_index": 97, "text": "Cell type annotation (CTA). CTA is the most classic multi-classification task in single-cell analysis. The conventional analysis process is to use the given SC dataset and cell type label file to train a classifier and use it to identify cell types in the same type of test set. For ZerOmics in the zeroshot setting, only the dataset needs to be provided, and it randomly assigns an instruction template to generate a text response for the cell type. Since supervised and fine-tuning methods need to be re-learned on downstream datasets, we further divide the evaluation datasets into training and test sets according to the common 2:1. We compare the classification results of all methods on the test set with the widely used metrics, accuracy and macro F1-score.", "contextualized_text": "B EVALUATION PROTOCOLS\nB.1 EVALUATION TASKS AND METRICS\nCell type annotation (CTA). CTA is the most classic multi-classification task in single-cell analysis. The conventional analysis process is to use the given SC dataset and cell type label file to train a classifier and use it to identify cell types in the same type of test set. For ZerOmics in the zeroshot setting, only the dataset needs to be provided, and it randomly assigns an instruction template to generate a text response for the cell type. Since supervised and fine-tuning methods need to be re-learned on downstream datasets, we further divide the evaluation datasets into training and test sets according to the common 2:1. We compare the classification results of all methods on the test set with the widely used metrics, accuracy and macro F1-score.", "headings": ["B EVALUATION PROTOCOLS", "B.1 EVALUATION TASKS AND METRICS"], "pages": [16], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/903", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 16, "bbox": {"l": 108.0, "t": 429.9491940000007, "r": 504.0033873999998, "b": 344.29577439292103, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 764]}]}], "headings": ["B EVALUATION PROTOCOLS", "B.1 EVALUATION TASKS AND METRICS"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 7109630141359406345, "filename": "full_text_user_manual_zeromics.pdf", "uri": null}}}
/Users/bogdan.didenko/lpnu/review/data/docling_uncertain_no_vlm_2026-07-08/chunks/full_2026_07_06_rec_003118.jsonl:98:{"candidate_id": "full_2026-07-06__rec_003118", "chunk_index": 98, "text": "Rare cell identification (RCI). RCI is a special two-class classification task with imbalanced classes. The conventional analysis process is to use the given SC dataset and cell type label file to train a model. However, in the test set, the models compare the cells from the new dataset with the existing samples, and those samples that are difficult to be classified into existing types are regarded as rare cells. For ZerOmics in zero-shot setting, similar to the CTA process, the LLM directly generates binary classification text results. The evaluation datasets are split according to 2:1, and all methods generate results on the test set for comparison. F1-score and the Cohen Kappa score ( κ ) are employed for evaluation, where κ is a metric that compares the prediction result with random guessing and is often used to detect imbalanced class samples.", "contextualized_text": "B EVALUATION PROTOCOLS\nB.1 EVALUATION TASKS AND METRICS\nRare cell identification (RCI). RCI is a special two-class classification task with imbalanced classes. The conventional analysis process is to use the given SC dataset and cell type label file to train a model. However, in the test set, the models compare the cells from the new dataset with the existing samples, and those samples that are difficult to be classified into existing types are regarded as rare cells. For ZerOmics in zero-shot setting, similar to the CTA process, the LLM directly generates binary classification text results. The evaluation datasets are split according to 2:1, and all methods generate results on the test set for comparison. F1-score and the Cohen Kappa score ( κ ) are employed for evaluation, where κ is a metric that compares the prediction result with random guessing and is often used to detect imbalanced class samples.", "headings": ["B EVALUATION PROTOCOLS", "B.1 EVALUATION TASKS AND METRICS"], "pages": [16], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/904", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 16, "bbox": {"l": 108.0, "t": 327.9011940000007, "r": 504.0046801999994, "b": 231.289774392921, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 860]}]}], "headings": ["B EVALUATION PROTOCOLS", "B.1 EVALUATION TASKS AND METRICS"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 7109630141359406345, "filename": "full_text_user_manual_zeromics.pdf", "uri": null}}}
/Users/bogdan.didenko/lpnu/review/data/docling_uncertain_no_vlm_2026-07-08/chunks/full_2026_07_06_rec_003118.jsonl:99:{"candidate_id": "full_2026-07-06__rec_003118", "chunk_index": 99, "text": "Tumor cell discovery (TCD). TCD is also a two-class classification task. Unlike CTA and RCI, the conventional analysis process usually does not provide label files about tumor type of each cell, and the model needs to identify cancer cells in an unsupervised or weakly supervised manner. For ZerOmics in zero-shot setting, the LLM not only needs to respond to whether it is a tumor cell, but also needs to respond to what subtype of tumor it is. This strategy is mainly to enable ZerOmics to better understand and infer information related to cancer. The evaluation datasets are split according to 2:1, and all methods generate results on the test set for comparison. In addition, to ensure the consistency of the evaluation, the tumor subtypes predicted by ZerOmics are not considered, that is, the predicted results are uniformly treated as binary classification. Lastly, accuracy and F1-score are served as the evaluation metrics.", "contextualized_text": "B EVALUATION PROTOCOLS\nB.1 EVALUATION TASKS AND METRICS\nTumor cell discovery (TCD). TCD is also a two-class classification task. Unlike CTA and RCI, the conventional analysis process usually does not provide label files about tumor type of each cell, and the model needs to identify cancer cells in an unsupervised or weakly supervised manner. For ZerOmics in zero-shot setting, the LLM not only needs to respond to whether it is a tumor cell, but also needs to respond to what subtype of tumor it is. This strategy is mainly to enable ZerOmics to better understand and infer information related to cancer. The evaluation datasets are split according to 2:1, and all methods generate results on the test set for comparison. In addition, to ensure the consistency of the evaluation, the tumor subtypes predicted by ZerOmics are not considered, that is, the predicted results are uniformly treated as binary classification. Lastly, accuracy and F1-score are served as the evaluation metrics.", "headings": ["B EVALUATION PROTOCOLS", "B.1 EVALUATION TASKS AND METRICS"], "pages": [16], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/905", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 16, "bbox": {"l": 108.0, "t": 214.89519400000063, "r": 504.0033873999996, "b": 107.32477439292097, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 933]}]}], "headings": ["B EVALUATION PROTOCOLS", "B.1 EVALUATION TASKS AND METRICS"], "captions": null, "origin": {"mimetype": "application/pdf", "binary_hash": 7109630141359406345, "filename": "full_text_user_manual_zeromics.pdf", "uri": null}}}
