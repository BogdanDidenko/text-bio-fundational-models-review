/Users/bogdan.didenko/lpnu/review/data/determinism_codex_2026-07-01/run_3/role_logs/adjudicator/batch_0001.prompt.txt:52:[{"record_id":"rec_000001","title":"Prompt-based bioinformatic pipeline generation for a multi-step metaviral workflow","abstract":"Abstract\n                  \n                    Motivation\n                    The rapid evolution of bioinformatics tools and multi-step analytic procedure presents a challenge for building effective pipelines, particularly for researchers without extensive programming expertise. This study demonstrates that large language models (LLMs) hold strong potential for generating end-to-end bioinformatic pipelines through carefully crafted prompts, using a multi-step metaviral workflow as a representative example. Multiple LLMs were tested for their effectiveness, including OpenAI ChatGPT series, Anthropic Claude series, Google Gemini, Meta Llama, and DeepSeek.\n                  \n                  \n                    Results\n                    Our results show that ChatGPT-4, ChatGPT-5, Claude 4.5, and Gemini 2.5 consistently outperform other LLMs in generating complete bioinformatic pipelines, with statistically significant success rates. These models also handle tool substitutions effectively. Simple prompt engineering and the inclusion of official documentation further enhance performance, especially for newer bioinformatic tools. While capabilities vary, all LLMs tested show potential for both pipeline generation and updates with our designed prompts and strategies.\n                  \n                  \n                    Availability and implementation\n                    All prompts are available in the paper. The examples are available in GitHub https://github.com/mpckkk/pBio.","doi":"","year":"2026","venue":"Bioinformatics …","sources":["google_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_000001","paper_type":"application_wrapper","bio_modality_present":"no","text_component_present":"yes","text_bio_bridge_present":"no","primary_exclusion_code":"application_wrapper","uncertainty_reason":"none","decision_rationale":"The paper evaluates prompting existing LLMs to generate bioinformatic pipelines rather than introducing a new text-bio model. The biological content is the pipeline task itself, not a central biological modality.","evidence_snippet":"“large language models (LLMs) ... generating end-to-end bioinformatic pipelines through carefully crafted prompts”"},"architecture_reviewer":{"record_id":"rec_000001","paper_type":"application_wrapper","generative_model_present":"yes","foundation_model_evidence":"unclear","primary_exclusion_code":"application_wrapper","uncertainty_reason":"foundation_model_evidence_unclear","decision_rationale":"This is an application of existing LLMs to generate bioinformatic pipelines, not a new model paper. The abstract does not establish foundation-model characteristics for a candidate model.","evidence_snippet":"\"LLMs hold strong potential for generating end-to-end bioinformatic pipelines\" and \"Multiple LLMs were tested\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"application_wrapper","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"application_wrapper","bio_modality_present":"no","text_component_present":"yes","text_bio_bridge_present":"no","generative_model_present":"yes","foundation_model_evidence":"unclear"}}},{"record_id":"rec_000004","title":"DestinyNet: A deep-learning framework for cell-fate analysis from lineage-tracing single-cell RNA sequencing data","abstract":"-scSeq datasets to pretrain a foundation model. Such a model, ideally incorporating biological   We used the scRNA-seq GEX information and cell-type annotation curated by CoSpar as","doi":"","year":"2026","venue":"Patterns","sources":["google_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_000004","paper_type":"unclear","bio_modality_present":"yes","text_component_present":"unclear","text_bio_bridge_present":"unclear","primary_exclusion_code":"none","uncertainty_reason":"paper_type_unclear","decision_rationale":"The snippet suggests a foundation model pretrained on scRNA-seq data, but the abstract is truncated and does not reveal whether there is any text component or bridge. The paper type cannot be verified from the fragment alone.","evidence_snippet":"“scSeq datasets to pretrain a foundation model”"},"architecture_reviewer":{"record_id":"rec_000004","paper_type":"unclear","generative_model_present":"unclear","foundation_model_evidence":"unclear","primary_exclusion_code":"none","uncertainty_reason":"paper_type_unclear","decision_rationale":"The provided abstract text is fragmentary and does not clearly describe the model or its architecture. There is insufficient evidence to assess generative or foundation-model status.","evidence_snippet":"\"pretrain a foundation model\" and \"We used the scRNA-seq GEX information\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"none","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"unclear","bio_modality_present":"yes","text_component_present":"unclear","text_bio_bridge_present":"unclear","generative_model_present":"unclear","foundation_model_evidence":"unclear"}}},{"record_id":"rec_000006","title":"STAG-LLM: Predicting TCR-pHLA binding with protein language models and computationally generated 3D structures.","abstract":"Background: Strong binding between T cell receptors (TCRs) and peptide–HLA (pHLA) complexes is important for triggering the adaptive immune response. Binding specificity prediction, identifying which TCRs will bind strongly to which pHLAs, can serve as a first step in designing personalized immunotherapy treatments. Existing machine learning (ML) methods to predict binding specificity rely primarily on the amino acid sequences of TCRs and pHLAs to make predictions. However, incorporating the 3D structure and geometry of the TCR-pHLA complex as an additional data modality alongside protein sequence offers a promising approach to improving ML methods for predicting TCR-pHLA binding specificity. Modern computational modeling tools present unprecedented opportunities to incorporate structure data into ML pipelines. We utilize such computational tools to incorporate 3D data into this work. Results: We present STAG-LLM, a multimodal ML model for predicting TCR-pHLA binding specificity that leverages sequence data and computationally generated 3D protein structures. We show that by combining a protein language model with a geometric deep learning architecture, our method outperforms existing methods even when trained on 3x smaller datasets. To further validate our model, we conduct in vitro alanine scanning experiments for four peptides and demonstrate a correlation with the attention weights learned by our model and in vitro results. We also seek to address three key challenges that arise from using computationally generated 3D structures in ML pipelines: increased inference costs arising from the need to generate 3D structures, limited training data, and robustness to noise in the generated structures. Conclusions: STAG-LLM shows tremendous potential for structure-based TCR-pHLA binding prediction methods, offering a foundation for further advancements in using modeled 3D structures to solve problems in immunology and proteomics. We anticipate that the usefulness of STAG-LLM and similar tools will increase in coming years as both protein structure prediction models and large language models continue to advance.","doi":"10.1016/j.csbj.2025.09.004","year":"2025","venue":"Computational and structural biotechnology journal","sources":["pubmed","scopus","semantic_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_000006","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"The model predicts TCR-pHLA binding from protein sequences and generated 3D structures. That is biological sequence/structure modeling, not a substantive text-bio model.","evidence_snippet":"“a protein language model with a geometric deep learning architecture”"},"architecture_reviewer":{"record_id":"rec_000006","paper_type":"application_wrapper","generative_model_present":"no","foundation_model_evidence":"no","primary_exclusion_code":"application_wrapper","uncertainty_reason":"none","decision_rationale":"This is a downstream binding-prediction system built from a protein language model plus geometric deep learning. The abstract does not describe a genuinely generative model or foundation-model evidence for the candidate system.","evidence_snippet":"\"predicting TCR-pHLA binding specificity\" and \"combining a protein language model with a geometric deep learning architecture\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"EC2_no_text_component","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","generative_model_present":"no","foundation_model_evidence":"no"}}},{"record_id":"rec_000007","title":"Translating cancer genomics into precision medicine with artificial intelligence: applications, challenges and future perspectives.","abstract":"{'h1': 'Abstract', 'p': 'In the field of cancer genomics, the broad availability of genetic information offered by next-generation sequencing technologies and rapid growth in biomedical publication has led to the advent of the big-data era. Integration of artificial intelligence (AI) approaches such as machine learning, deep learning, and natural language processing (NLP) to tackle the challenges of scalability and high dimensionality of data and to transform big data into clinically actionable knowledge is expanding and becoming the foundation of precision medicine. In this paper, we review the current status and future directions of AI application in cancer genomics within the context of workflows to integrate genomic analysis for precision cancer care. The existing solutions of AI and their limitations in cancer genetic testing and diagnostics such as variant calling and interpretation are critically analyzed. Publicly available tools or algorithms for key NLP technologies in the literature mining for evidence-based clinical recommendations are reviewed and compared. In addition, the present paper highlights the challenges to AI adoption in digital healthcare with regard to data requirements, algorithmic transparency, reproducibility, and real-world assessment, and discusses the importance of preparing patients and physicians for modern digitized healthcare. We believe that AI will remain the main driver to healthcare transformation toward precision medicine, yet the unprecedented challenges posed should be addressed to ensure safety and beneficial impact to healthcare.'}","doi":"10.1007/s00439-019-01970-5","year":"2019","venue":"Human genetics","sources":["pubmed","scopus","semantic_scholar","springernature"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_000007","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"unclear","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"The abstract explicitly states that the paper reviews current status and future directions, and it discusses existing AI/NLP solutions rather than presenting a new model. It is therefore a review article.","evidence_snippet":"“In this paper, we review the current status and future directions ... Publicly available tools or algorithms for key NLP technologies ... are reviewed and compared”"},"architecture_reviewer":{"record_id":"rec_000007","paper_type":"review_editorial","generative_model_present":"no","foundation_model_evidence":"no","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"The abstract explicitly says this paper reviews the status and future directions of AI applications. It is not presenting a candidate generative model.","evidence_snippet":"\"In this paper, we review the current status and future directions\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"review_editorial","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"unclear","generative_model_present":"no","foundation_model_evidence":"no"}}},{"record_id":"rec_000008","title":"Integrative Multiscale Biochemical Mapping of the Brain via Deep-Learning-Enhanced High-Throughput Mass Spectrometry.","abstract":"Elucidating the spatial-biochemical organization of the brain across different scales produces invaluable insight into the molecular intricacy of the brain. While mass spectrometry imaging (MSI) provides spatial localization of compounds, comprehensive chemical profiling at a brain-wide scale in three dimensions by MSI with single-cell resolution has not been achieved. We demonstrate complementary brain-wide and single-cell biochemical mapping via MEISTER, an integrative experimental and computational mass spectrometry framework. MEISTER integrates a deep-learning-based reconstruction that accelerates high-mass-resolving MS by 15-fold, multimodal registration creating 3D molecular distributions, and a data integration method fitting cell-specific mass spectra to 3D data sets. We imaged detailed lipid profiles in tissues with data sets containing millions of pixels, and in large single-cell populations acquired from the rat brain. We identified region-specific lipid contents, and cell-specific localizations of lipids depending on both cell subpopulations and anatomical origins of the cells. Our workflow establishes a blueprint for future developments of multiscale technologies for biochemical characterization of the brain.","doi":"10.1101/2023.05.31.543144","year":"2023","venue":"bioRxiv : the preprint server for biology","sources":["biorxiv_medrxiv","pubmed","semantic_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_000008","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"This is a deep-learning mass spectrometry framework for biochemical brain mapping. No text or language component is described.","evidence_snippet":"“an integrative experimental and computational mass spectrometry framework”"},"architecture_reviewer":{"record_id":"rec_000008","paper_type":"application_wrapper","generative_model_present":"no","foundation_model_evidence":"no","primary_exclusion_code":"EC3_not_generative","uncertainty_reason":"none","decision_rationale":"The abstract describes a deep-learning reconstruction and data-integration workflow for mass spectrometry, not a generative model. No foundation-model-like pretraining or transferability is presented.","evidence_snippet":"\"deep-learning-based reconstruction\" and \"integrative experimental and computational mass spectrometry framework\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"EC2_no_text_component","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","generative_model_present":"no","foundation_model_evidence":"no"}}},{"record_id":"rec_000013","title":"Biomedical data and AI","abstract":"Subsequently, a larger generative model based on the GPT (Generative Pre-trained   gene expression relationships and achieve state-of-the-art performance in various single-cell","doi":"","year":"2025","venue":"Sci China Life …","sources":["google_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_000013","paper_type":"unclear","bio_modality_present":"yes","text_component_present":"unclear","text_bio_bridge_present":"unclear","primary_exclusion_code":"none","uncertainty_reason":"mixed_signals","decision_rationale":"The record is too fragmentary to determine the paper type confidently. It mentions a GPT-based generative model and single-cell gene-expression relationships, but the exact model scope and bridge are unclear.","evidence_snippet":"\"a larger generative model based on the GPT\" and \"gene expression relationships... in various single-cell\""},"architecture_reviewer":{"record_id":"rec_000013","paper_type":"primary_model_paper","generative_model_present":"yes","foundation_model_evidence":"unclear","primary_exclusion_code":"none","uncertainty_reason":"paper_type_unclear","decision_rationale":"The fragment suggests a GPT-based generative model, but the abstract is truncated and incomplete. There is not enough evidence here to judge foundation-model characteristics confidently.","evidence_snippet":"\"a larger generative model based on the GPT\" and \"achieve state-of-the-art performance in various single-cell\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"none","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"unclear","text_bio_bridge_present":"unclear","generative_model_present":"yes","foundation_model_evidence":"unclear"}}}]
