ody"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 18, "bbox": {"l": 73.131, "t": 638.8264121999998, "r": 86.42512679999999, "b": 631.3424882999998, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 3]}]}, {"self_ref": "#/texts/981", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 18, "bbox": {"l": 73.131, "t": 626.8714121999998, "r": 86.42512679999999, "b": 619.3874882999997, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 3]}]}, {"self_ref": "#/texts/982", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 18, "bbox": {"l": 73.131, "t": 614.9154121999998, "r": 86.42512679999999, "b": 607.4314882999997, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 3]}]}, {"self_ref": "#/texts/983", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 18, "bbox": {"l": 73.131, "t": 602.9604121999997, "r": 86.42512679999999, "b": 595.4764882999997, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 3]}]}, {"self_ref": "#/texts/984", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 18, "bbox": {"l": 73.131, "t": 591.0054121999997, "r": 86.42512679999999, "b": 583.5214882999996, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 3]}]}, {"self_ref": "#/texts/985", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 18, "bbox": {"l": 73.131, "t": 579.0504121999996, "r": 86.42512679999999, "b": 571.5664882999996, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 3]}]}, {"self_ref": "#/texts/986", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 18, "bbox": {"l": 73.131, "t": 567.0954121999996, "r": 86.42512679999999, "b": 559