/Users/bogdan.didenko/lpnu/review/data/docling_uncertain_no_vlm_2026-07-08/chunks/full_2026_07_06_rec_003118.jsonl:12:{"candidate_id": "full_2026-07-06__rec_003118", "chunk_index": 12, "text": "123\n124\n125\n126\n127\n128\n129\n130\n131\n132\n133\n134\n135\n136\n137\n138\n139\n140\n141\n142\n143\n144\n145\n146\n147\n148\n149\n150\n151\n152\n153\n154\n155\n156\n157\n158\n159\n160\n161\nintegrate biological information and natural language text into a unified space from the perspective of multimodal instruction tuning, so that LLM can directly answer various SC analysis tasks.", "contextualized_text": "2 RELATED WORK\n2.1 MULTI-MODAL INSTRUCTION TUNING FOR LLMS\n123\n124\n125\n126\n127\n128\n129\n130\n131\n132\n133\n134\n135\n136\n137\n138\n139\n140\n141\n142\n143\n144\n145\n146\n147\n148\n149\n150\n151\n152\n153\n154\n155\n156\n157\n158\n159\n160\n161\nintegrate biological information and natural language text into a unified space from the perspective of multimodal instruction tuning, so that LLM can directly answer various SC analysis tasks.", "headings": ["2 RELATED WORK", "2.1 MULTI-MODAL INSTRUCTION TUNING FOR LLMS"], "pages": [3], "meta": {"schema_name": "docling_core.transforms.chunker.DocMeta", "version": "1.0.0", "doc_items": [{"self_ref": "#/texts/146", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 3, "bbox": {"l": 73.131, "t": 531.2294121999995, "r": 86.42512679999999, "b": 523.7454882999995, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 3]}]}, {"self_ref": "#/texts/147", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"page_no": 3, "bbox": {"l": 73.131, "t": 519.2744121999995, "r": 86.42512679999999, "b": 511.7904882999994, "coord_origin": "BOTTOMLEFT"}, "charspan": [0, 3]}]}, {"self_ref": "#/texts/148", "parent": {"cref": "#/body"}, "children": [], "content_layer": "body", "meta": null, "label": "text", "prov": [{"