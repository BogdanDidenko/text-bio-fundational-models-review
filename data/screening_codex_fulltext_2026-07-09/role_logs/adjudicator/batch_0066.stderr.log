./data/screening_codex_full_2026-07-06/role_logs/adjudicator/batch_0121.stderr.log:67:[{"record_id":"rec_002423","title":"Structural and functional radiomics for lung cancer","abstract":"{'h1': 'Abstract', 'p': ['Introduction', 'Lung cancer ranks second in new cancer cases and first in cancer-related deaths worldwide. Precision medicine is working on altering\\xa0treatment approaches and improving outcomes in this patient population. Radiological images are a powerful non-invasive tool in the screening and\\xa0diagnosis of early-stage lung cancer, treatment strategy support, prognosis assessment, and follow-up for advanced-stage lung cancer. Recently, radiological\\xa0features have evolved from solely semantic to include (handcrafted and deep) radiomic features. Radiomics entails the extraction and analysis of\\xa0quantitative features from medical images using mathematical and machine learning methods to explore possible ties with biology and clinical outcomes.', 'Methods', 'Here, we outline the latest applications of both structural and functional radiomics in detection, diagnosis, and prediction of pathology, gene\\xa0mutation, treatment strategy, follow-up, treatment response evaluation, and prognosis in the field of lung cancer.', 'Conclusion', 'The major drawbacks of radiomics are the lack of large datasets with high-quality data, standardization of methodology, the black-box nature\\xa0of deep learning, and reproducibility. The prerequisite for the clinical implementation of radiomics is that these limitations are addressed. Future directions\\xa0include a safer and more efficient model-training mode, merge multi-modality images, and combined multi-discipline or multi-omics to form “Medomics.”']}","doi":"10.1007/s00259-021-05242-1","year":"2021","venue":"European Journal of Nuclear Medicine and Molecular Imaging","sources":["semantic_scholar","springernature"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_002423","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"The abstract is a review of radiomics applications in lung cancer rather than a primary model report. It discusses imaging features and future directions, not a new text-bio model.","evidence_snippet":"\"We outline the latest applications\"; \"Future directions include... merge multi-modality images\""},"architecture_reviewer":{"record_id":"rec_002423","paper_type":"review_editorial","generative_model_present":"unclear","foundation_model_evidence":"unclear","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"This is a review of radiomics applications in lung cancer, not an original model paper. The abstract does not provide evidence for a specific generative foundation model.","evidence_snippet":"\"Here, we outline the latest applications\"; \"major drawbacks of radiomics\"; \"Future directions\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"review_editorial","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","generative_model_present":"unclear","foundation_model_evidence":"unclear"}}},{"record_id":"rec_002424","title":"Influ-BERT: A Domain-Adaptive Genomic Language Model for Advancing Influenza A Virus Research","abstract":"Abstract\n                Influenza A Virus (IAV) poses a persistent threat to global public health due to its broad host adaptability, frequent anti-genic variation, and potential for cross-species transmission. Accurate identification of IAV subtypes is essential for effective epidemic surveillance and precise disease control. Here, we present Influ-BERT, a domain-adaptive pretrained model based on the Transformer architecture. Optimized from DNABERT-2, Influ-BERT was developed using a dedicated corpus of approximately 900,000 influenza genome sequences. We constructed a custom Byte Pair Encoding (BPE) tokenizer, and employed a two-stage training strategy involving domain-adaptive pretraining followed by task-specific fine-tuning. This approach significantly enhanced identification performance for IAV subtypes. Experimental results demonstrate that Influ-BERT outperforms both traditional machine learning approaches and general genomic language models, such as DNABERT-2 and MegaDNA, in the task of IAV subtype identification. The model achieved F1-scores consistently above 97% and exhibited stable performance gains for subtypes that are underrepresented in sequencing data, including H5N8, H5N1, H7N9, and H9N2. Beyond subtype identification, Influ-BERT was successfully applied to additional tasks including respiratory virus identification, IAV pathogenicity prediction, and identification of IAV genomic fragments and functional genes, demonstrating robust performance throughout. Further interpretability analysis using sliding window perturbation confirmed that the model focuses on biologically significant genomic regions, providing insight into its improved predictive capability.\n                \n                  Contact\n                  \n                    songshh@big.ac.cn\n                    (Song S),\n                    atrv@lncc.br\n                    (Ana Tereza Ribeiro Vasconcelos)","doi":"10.1101/2025.07.31.667841","year":"2025","venue":"bioRxiv","sources":["semantic_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_002424","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","primary_exclusion_code":"none","uncertainty_reason":"none","decision_rationale":"This is a primary genomic language model paper with Transformer pretraining, custom BPE tokenization, and task fine-tuning. The abstract supports a substantive language-model bridge to influenza genomic sequences.","evidence_snippet":"\"a domain-adaptive pretrained model based on the Transformer architecture\"; \"custom Byte Pair Encoding (BPE) tokenizer\"; \"dedicated corpus of approximately 900,000 influenza genome sequences\""},"architecture_reviewer":{"record_id":"rec_002424","paper_type":"primary_model_paper","generative_model_present":"no","foundation_model_evidence":"yes","primary_exclusion_code":"EC3_not_generative","uncertainty_reason":"generative_status_unclear","decision_rationale":"The abstract describes a domain-adaptive pretrained Transformer with broad downstream use, which supports foundation-model evidence. It does not explicitly state a generative decoder or autoregressive mechanism.","evidence_snippet":"\"domain-adaptive pretrained model\"; \"approximately 900,000 influenza genome sequences\"; \"applied to additional tasks\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"EC3_not_generative","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","generative_model_present":"no","foundation_model_evidence":"yes"}}},{"record_id":"rec_002425","title":"Continually Evolved Multimodal Foundation Models for Cancer Prognosis","abstract":"Cancer prognosis is a critical task that involves predicting patient outcomes and survival rates. To enhance prediction accuracy, previous studies have integrated diverse data modalities, such as clinical notes, medical images, and genomic data, leveraging their complementary information. However, existing approaches face two major limitations. First, they struggle to incorporate newly arrived data with varying distributions into training, such as patient records from different hospitals, thus rendering sub-optimal generalizability and limited utility in real-world applications. Second, most multimodal integration methods rely on simplistic concatenation or task-specific pipelines, which fail to capture the complex interdependencies across modalities. To address these, we propose a continually evolving multi-modal foundation model. Extensive experiments on the TCGA dataset demonstrate the effectiveness of our approach, highlighting its potential to advance cancer prognosis by enabling robust and adaptive multimodal integration.","doi":"10.48550/arXiv.2501.18170","year":"2025","venue":"arXiv.org","sources":["google_scholar","semantic_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_002425","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","primary_exclusion_code":"none","uncertainty_reason":"none","decision_rationale":"Abstract describes a continually evolving multimodal foundation model using clinical notes, medical images, and genomic data for cancer prognosis. The text and biological modalities are integrated in the model itself.","evidence_snippet":"\"clinical notes, medical images, and genomic data\"; \"continually evolving multi-modal foundation model\""},"architecture_reviewer":{"record_id":"rec_002425","paper_type":"primary_model_paper","generative_model_present":"no","foundation_model_evidence":"unclear","primary_exclusion_code":"EC3_not_generative","uncertainty_reason":"foundation_model_evidence_unclear","decision_rationale":"The abstract describes a prognostic multimodal foundation model for prediction, not a clearly generative architecture. It signals broad multimodal utility, but does not show broad pretraining or transferable foundation-model behavior.","evidence_snippet":"“we propose a continually evolving multi-modal foundation model” for “cancer prognosis” and “adaptive multimodal integration”"},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"EC3_not_generative","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","generative_model_present":"no","foundation_model_evidence":"unclear"}}},{"record_id":"rec_002427","title":"Nucleotide GPT: Sequence-Based Deep Learning Prediction of Nuclear Subcompartment-Associated Genome Architecture","abstract":"The spatial organization of the genome within the nucleus is partially determined by its interactions with distinct nuclear subcompartments, such as the nuclear lamina and nuclear speckles, which play key roles in gene regulation during development. However, whether these genome-nuclear subcompartment interactions are encoded in the underlying DNA sequence remains poorly understood. The mechanisms for gene regulation are primarily encoded in noncoding DNA sequences, but deciphering how these sequence features control gene expression remains a significant challenge in genomics. Here, we present Nucleotide GPT, a transformer-based model that predicts genomic associations with spatially distinct, physical nuclear subcompartments from DNA sequence alone. Pre-trained on a diverse set of multi-species genomes, we demonstrate Nucleotide GPT’s genomic understanding through evaluation on diverse prediction tasks, including histone modifications, promoter detection, and transcription factor binding sites. When finetuned to predict genome interactions with two separate nuclear subcompartments – the lamina of the inner nuclear membrane and nuclear speckles that lie more interior – Nucleotide GPT achieves an average accuracy of 73.6% for lamina-associated domains (LADs) and 79.4% accuracy for speckle-associated domains (SPADs), averaged across three cortical development cell types. Analysis of the model’s learned representations through Uniform Manifold Approximation and Projection (UMAP) reveals that Nucleotide GPT develops internal embeddings that effectively distinguish LADs from inter-LADs, with predicted probabilities closely corresponding to experimentally determined LAD classifications. When examining these representations in the context of cell type-invariant constitutive LADs (cLADs) compared to cell type-specific LADs, the model assigns lower confidence scores to cell type-specific LADs compared to cLADs that are conserved across neuronal differentiation, suggesting sequence features may play a stronger role in maintaining cLAD associations. Examination of the model’s attention patterns at correctly classified regions suggests that specific sequence elements govern model decision making about nuclear subcompartment associations. Our results demonstrate the utility of transformer architectures for studying three-dimensional (3D) genome organization and substantiate a role for DNA sequence in determining nuclear subcompartment associations.","doi":"10.1101/2024.11.27.625761","year":"2024","venue":"bioRxiv","sources":["biorxiv_medrxiv","semantic_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_002427","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"This is a transformer model on DNA sequence alone for genomic prediction tasks. The abstract does not describe any text or language modality.","evidence_snippet":"\"predicts genomic associations... from DNA sequence alone\"; \"pre-trained on a diverse set of multi-species genomes\""},"architecture_reviewer":{"record_id":"rec_002427","paper_type":"primary_model_paper","generative_model_present":"unclear","foundation_model_evidence":"yes","primary_exclusion_code":"none","uncertainty_reason":"mixed_signals","decision_rationale":"The title suggests GPT, but the abstract mainly describes a transformer that predicts genomic associations from sequence. It does provide foundation-model-like evidence through diverse pretraining and evaluation across multiple tasks.","evidence_snippet":"“Pre-trained on a diverse set of multi-species genomes” and evaluated on “diverse prediction tasks”"},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"EC2_no_text_component","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","generative_model_present":"unclear","foundation_model_evidence":"yes"}}},{"record_id":"rec_002429","title":"Coherent Cross-modal Generation of Synthetic Biomedical Data to Advance Multimodal Precision Medicine","abstract":"ABSTRACT Integration of multimodal, multi-omics data is critical for advancing precision medicine, yet its application is frequently limited by incomplete datasets where one or more modalities are missing. To address this challenge, we developed a generative framework capable of synthesizing any missing modality from an arbitrary subset of available modalities. We introduce Coherent Denoising, a novel ensemble-based generative diffusion method that aggregates predictions from multiple specialized, single-condition models and enforces consensus during the sampling process. We compare this approach against a multicondition, generative model that uses a flexible masking strategy to handle arbitrary subsets of inputs. The results show that our architectures successfully generate high-fidelity data that preserve the complex biological signals required for downstream tasks. We demonstrate that the generated synthetic data can be used to maintain the performance of predictive models on incomplete patient profiles and can leverage counterfactual analysis to guide the prioritization of diagnostic tests. We validated the framework’s efficacy on a large-scale multimodal, multi-omics cohort from The Cancer Genome Atlas (TCGA) of over 10,000 samples spanning across 20 tumor types, using data modalities such as copy-number alterations (CNA), transcriptomics (RNA-Seq), proteomics (RPPA), and histopathology (WSI). This work establishes a robust and flexible generative framework to address sparsity in multimodal datasets, providing a key step toward improving precision oncology.","doi":"10.1101/2025.08.22.671728","year":"2025","venue":"bioRxiv","sources":["biorxiv_medrxiv","semantic_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_002429","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"This is a generative framework for synthesizing missing biomedical omics and histopathology modalities. No text or language component is described.","evidence_snippet":"\"synthesizing any missing modality\"; \"generative diffusion method\"; \"multimodal, multi-omics cohort\""},"architecture_reviewer":{"record_id":"rec_002429","paper_type":"primary_model_paper","generative_model_present":"yes","foundation_model_evidence":"unclear","primary_exclusion_code":"none","uncertainty_reason":"foundation_model_evidence_unclear","decision_rationale":"The abstract explicitly states a generative diffusion method that synthesizes missing modalities. It does not clearly establish foundation-model characteristics such as broad pretraining or transferable representations.","evidence_snippet":"“a novel ensemble-based generative diffusion method” that can “synthesiz[e] any missing modality”"},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"EC2_no_text_component","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","generative_model_present":"yes","foundation_model_evidence":"unclear"}}},{"record_id":"rec_002434","title":"Multimodal decoding of human liver regeneration","abstract":"{'h1': 'Abstract', 'p': ['The liver has a unique ability to regenerate^ 1 , 2 ; however, in the setting of acute liver failure (ALF), this regenerative capacity is often overwhelmed, leaving emergency liver transplantation as the only curative option^ 3 – 5 . Here, to advance understanding of human liver regeneration, we use paired single-nucleus RNA sequencing combined with spatial profiling of healthy and ALF explant human livers to generate a single-cell, pan-lineage atlas of human liver regeneration. We uncover a novel ANXA2^+ migratory hepatocyte subpopulation, which emerges during human liver regeneration, and a corollary subpopulation in a mouse model of acetaminophen (APAP)-induced liver regeneration. Interrogation of necrotic wound closure and hepatocyte proliferation across multiple timepoints following APAP-induced liver injury in mice demonstrates that wound closure precedes hepatocyte proliferation. Four-dimensional intravital imaging of APAP-induced mouse liver injury identifies motile hepatocytes at the edge of the necrotic area, enabling collective migration of the hepatocyte sheet to effect wound closure. Depletion of hepatocyte ANXA2 reduces hepatocyte growth factor-induced human and mouse hepatocyte migration in vitro, and abrogates necrotic wound closure following APAP-induced mouse liver injury. Together, our work dissects unanticipated aspects of liver regeneration, demonstrating an uncoupling of wound closure and hepatocyte proliferation and uncovering a novel migratory hepatocyte subpopulation that mediates wound closure following liver injury. Therapies designed to promote rapid reconstitution of normal hepatic microarchitecture and reparation of the gut–liver barrier may advance new areas of therapeutic discovery in regenerative medicine.', 'Harnessing single-nucleus RNA sequencing and spatial profiling, this work dissects unanticipated aspects of human liver regeneration to uncover a novel migratory hepatocyte subpopulation mediating wound closure following acute liver injury.']}","doi":"10.1038/s41586-024-07376-2","year":"2023","venue":"bioRxiv","sources":["semantic_scholar","springernature"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_002434","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"This is primary biological research on liver regeneration using single-nucleus RNA sequencing and spatial profiling. No substantive text/language component is described.","evidence_snippet":"\"paired single-nucleus RNA sequencing combined with spatial profiling\" to study human liver regeneration"},"architecture_reviewer":{"record_id":"rec_002434","paper_type":"unclear","generative_model_present":"no","foundation_model_evidence":"no","primary_exclusion_code":"EC3_not_generative","uncertainty_reason":"paper_type_unclear","decision_rationale":"This is a biological atlas study of liver regeneration, not a generative text-bio model paper. No generative architecture or foundation-model characteristics are described.","evidence_snippet":"\"single-cell, pan-lineage atlas of human liver regeneration\"; no model architecture described"},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"EC2_no_text_component","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","generative_model_present":"no","foundation_model_evidence":"no"}}}]
