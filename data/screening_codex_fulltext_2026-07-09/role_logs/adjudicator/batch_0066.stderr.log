esent":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","primary_exclusion_code":"none","uncertainty_reason":"none","decision_rationale":"This is presented as a new LLM-based framework for zero-shot single-cell multi-omics analysis, not a review, benchmark, or wrapper. The selected sections show both biological single-cell data and a textual gene corpus/instructions used to align SC data with the LLM.","evidence_snippet":"“aligns SC expression data with the well-organized gene corpus”; “By simply inputting data and posing queries in natural language”"},"architecture_reviewer":{"record_id":"full_2026-07-06__rec_003118","paper_type":"application_wrapper","generative_model_present":"yes","foundation_model_evidence":"yes","primary_exclusion_code":"application_wrapper","uncertainty_reason":"none","decision_rationale":"The abstract describes an LLM-based framework that is tuned to perform single-cell tasks and answer natural-language queries, so a generative model is present. It is still an application wrapper around an existing LLM rather than a new primary foundation model.","evidence_snippet":"\"guides LLMs to perform various SC tasks\"; \"By simply inputting data and posing queries in natural language\"; \"tune the LLM\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"application_wrapper","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","generative_model_present":"yes","foundation_model_evidence":"yes"}}}]
