/Users/bogdan.didenko/lpnu/review/data/determinism_codex_2026-07-01/run_2/role_logs/adjudicator/batch_0001.prompt.txt:52:[{"record_id":"rec_000004","title":"DestinyNet: A deep-learning framework for cell-fate analysis from lineage-tracing single-cell RNA sequencing data","abstract":"-scSeq datasets to pretrain a foundation model. Such a model, ideally incorporating biological   We used the scRNA-seq GEX information and cell-type annotation curated by CoSpar as","doi":"","year":"2026","venue":"Patterns","sources":["google_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_000004","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"The title and fragment indicate a deep-learning framework for single-cell/lineage-tracing RNA-seq analysis. No text or language component is evident from the provided record.","evidence_snippet":"deep-learning framework for cell-fate analysis from lineage-tracing single-cell RNA sequencing data"},"architecture_reviewer":{"record_id":"rec_000004","paper_type":"unclear","generative_model_present":"unclear","foundation_model_evidence":"unclear","primary_exclusion_code":"none","uncertainty_reason":"paper_type_unclear","decision_rationale":"The record is truncated and only shows a fragment mentioning pretraining a foundation model. That is not enough to determine whether the model is generative or to assess foundation-model characteristics confidently.","evidence_snippet":"\"pretrain a foundation model\"; abstract fragment is incomplete"},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"EC2_no_text_component","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","generative_model_present":"unclear","foundation_model_evidence":"unclear"}}},{"record_id":"rec_000011","title":"Large language models in genomics—a perspective on personalized medicine","abstract":"Integrating artificial intelligence (AI), particularly large language models (LLMs), into the healthcare industry is revolutionizing the field of medicine. LLMs possess the capability to analyze the scientific literature and genomic data by comprehending and producing human-like text. This enhances the accuracy, precision, and efficiency of extensive genomic analyses through contextualization. LLMs have made significant advancements in their ability to understand complex genetic terminology and accurately predict medical outcomes. These capabilities allow for a more thorough understanding of genetic influences on health issues and the creation of more effective therapies. This review emphasizes LLMs’ significant impact on healthcare, evaluates their triumphs and limitations in genomic data processing, and makes recommendations for addressing these limitations in order to enhance the healthcare system. It explores the latest advancements in LLMs for genomic analysis, focusing on enhancing disease diagnosis and treatment accuracy by taking into account an individual’s genetic composition. It also anticipates a future in which AI-driven genomic analysis is commonplace in clinical practice, suggesting potential research areas. To effectively leverage LLMs’ potential in personalized medicine, it is vital to actively support innovation across multiple sectors, ensuring that AI developments directly contribute to healthcare solutions tailored to individual patients.","doi":"","year":"2025","venue":"Bioengineering","sources":["google_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_000011","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"unclear","primary_exclusion_code":"review_editorial","uncertainty_reason":"text_bio_bridge_unclear","decision_rationale":"This is explicitly a perspective/review on large language models in genomics and personalized medicine. It discusses LLMs and genomic data, but not a primary candidate model.","evidence_snippet":"\"a perspective on personalized medicine\" and \"LLMs ... analyze ... genomic data\""},"architecture_reviewer":{"record_id":"rec_000011","paper_type":"review_editorial","generative_model_present":"unclear","foundation_model_evidence":"unclear","primary_exclusion_code":"review_editorial","uncertainty_reason":"generative_status_unclear","decision_rationale":"This is a perspective on LLMs in genomics, not a paper presenting a candidate model. The abstract does not give model-level evidence to screen.","evidence_snippet":"\"Large language models in genomics-a perspective on personalized medicine\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"review_editorial","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"unclear","generative_model_present":"unclear","foundation_model_evidence":"unclear"}}},{"record_id":"rec_000012","title":"Novel research and future prospects of artificial intelligence in cancer diagnosis and treatment","abstract":"Research into the potential benefits of artificial intelligence for comprehending the intricate biology of cancer has grown as a result of the widespread use of deep learning and machine learning in the healthcare sector and the availability of highly specialized cancer datasets. Here, we review new artificial intelligence approaches and how they are being used in oncology. We describe how artificial intelligence might be used in the detection, prognosis, and administration of cancer treatments and introduce the use of the latest large language models such as ChatGPT in oncology clinics. We highlight artificial intelligence applications for omics data types, and we offer perspectives on how the various data types might be combined to create decision-support tools. We also evaluate the present constraints and challenges to applying artificial intelligence in precision oncology. Finally, we discuss how current challenges may be surmounted to make artificial intelligence useful in clinical settings in the future.","doi":"10.1186/s13045-023-01514-5","year":"2023","venue":"Journal of Hematology and Oncology","sources":["scopus"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_000012","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"unclear","primary_exclusion_code":"review_editorial","uncertainty_reason":"text_bio_bridge_unclear","decision_rationale":"The abstract is a review of AI in cancer diagnosis and treatment and mentions ChatGPT in oncology clinics. It is not presenting a primary model.","evidence_snippet":"\"We review new artificial intelligence approaches\" and \"the latest large language models such as ChatGPT\""},"architecture_reviewer":{"record_id":"rec_000012","paper_type":"review_editorial","generative_model_present":"unclear","foundation_model_evidence":"unclear","primary_exclusion_code":"review_editorial","uncertainty_reason":"generative_status_unclear","decision_rationale":"The abstract reviews AI applications in oncology and mentions ChatGPT, but it does not describe a new generative text-bio model. It is editorial/review content rather than a primary model paper.","evidence_snippet":"\"We review new artificial intelligence approaches\" and \"latest large language models such as ChatGPT\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"review_editorial","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"unclear","generative_model_present":"unclear","foundation_model_evidence":"unclear"}}},{"record_id":"rec_000013","title":"Biomedical data and AI","abstract":"Subsequently, a larger generative model based on the GPT (Generative Pre-trained   gene expression relationships and achieve state-of-the-art performance in various single-cell","doi":"","year":"2025","venue":"Sci China Life …","sources":["google_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_000013","paper_type":"unclear","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"unclear","primary_exclusion_code":"none","uncertainty_reason":"paper_type_unclear","decision_rationale":"The abstract is truncated, but it mentions a generative model based on GPT and single-cell gene-expression relationships. The paper type and the text-bio bridge cannot be established confidently from the provided text.","evidence_snippet":"\"a larger generative model based on the GPT ... gene expression relationships\""},"architecture_reviewer":{"record_id":"rec_000013","paper_type":"primary_model_paper","generative_model_present":"yes","foundation_model_evidence":"yes","primary_exclusion_code":"none","uncertainty_reason":"none","decision_rationale":"The abstract explicitly describes a larger generative GPT-based model and says it achieves state-of-the-art performance across single-cell tasks.","evidence_snippet":"\"larger generative model based on the GPT\" and \"state-of-the-art performance in various single-cell\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"none","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"unclear","generative_model_present":"yes","foundation_model_evidence":"yes"}}},{"record_id":"rec_000014","title":"CART-GPT: A T Cell-Informed AI Linguistic Framework for Interpreting Neurotoxicity and Therapeutic Outcomes in CAR-T Therapy.","abstract":"Chimeric antigen receptor (CAR) T cell therapy holds transformative potential for hematologic malignancies, yet predicting patient-specific treatment efficacy and neurotoxicity remains a major clinical challenge due to the complex and heterogeneous nature of the infused CAR-T cell populations. Here, we introduce CART-GPT, a transformer-based model fine-tuned on a curated atlas of 1.12 million CAR-T single-cell RNA-seq profiles annotated with clinical outcomes. CART-GPT is the first AI model developed for CAR-T therapy that predicts both treatment response and the risk of immune effector cell-associated neurotoxicity syndrome (ICANS), achieving state-of-the-art performance (AUC ~0.8) and marking a significant advance in the field. The model provides interpretable insights, revealing that neither therapeutic efficacy nor neurotoxicity is driven by individual cell types alone, but by the combined influence of discrete, distinct subsets across diverse T cell states and transcriptional programs. A novel cell aggregation strategy links single-cell predictions to patient-level metrics, enhancing both accuracy and biological relevance. As a contribution to this ever-evolving field, we also release a comprehensive, annotated single-cell CAR-T atlas as a community resource to facilitate future research in immunotherapy. These advances demonstrate the potential of foundation models in single-cell biology to inform precision CAR-T treatment planning and facilitate the rational design of next-generation cell therapies.","doi":"10.1101/2025.08.08.669387","year":"2025","venue":"bioRxiv : the preprint server for biology","sources":["biorxiv_medrxiv","pubmed","semantic_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_000014","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"CART-GPT is a transformer-based model fine-tuned on CAR-T single-cell RNA-seq profiles and clinical outcomes. The abstract does not clearly show a substantive text/language component.","evidence_snippet":"\"transformer-based model fine-tuned on a curated atlas of 1.12 million CAR-T single-cell RNA-seq profiles\""},"architecture_reviewer":{"record_id":"rec_000014","paper_type":"primary_model_paper","generative_model_present":"no","foundation_model_evidence":"unclear","primary_exclusion_code":"EC3_not_generative","uncertainty_reason":"mixed_signals","decision_rationale":"CART-GPT is described as a transformer fine-tuned for CAR-T outcome prediction, which is predictive rather than clearly generative. The foundation-model framing is suggested, but not clearly established for this specific model.","evidence_snippet":"\"transformer-based model fine-tuned on a curated atlas of 1.12 million CAR-T single-cell RNA-seq profiles\" and \"predicts both treatment response and the risk of ... neurotoxicity\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"EC2_no_text_component","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","generative_model_present":"no","foundation_model_evidence":"unclear"}}},{"record_id":"rec_000017","title":"Evaluating the Effectiveness of Parameter-Efficient Fine-Tuning in Genomic Classification Tasks","abstract":"ABSTRACT\n                Foundation models are increasingly being leveraged for biological tasks. To address the high memory requirements of fine-tuning large pre-trained language models, parameter efficient fine-tuning (PEFT) methods are also being increasingly utilized. Previous studies have shown minimal, if any, loss in performance when using PEFT on binary classification tasks. However, the impact of using PEFT on tasks with large classification spaces has not been systemically evaluated. In this work, we apply PEFT to the problem of taxonomic classification using pre-trained genomic language models as the classification backbone. We explore various training strategies—including PEFT, full fine-tuning, and partial fine-tuning—for classifying sequences at the superkingdom, phylum, and genus levels. We find that PEFT-trained models significantly underperform compared to those trained via full fine-tuning or partial fine-tuning. Additionally, we demonstrate increased performance of pretrained models over those randomly initialized.","doi":"10.1101/2025.08.21.671544","year":"2025","venue":"bioRxiv","sources":["semantic_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_000017","paper_type":"application_wrapper","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_substantive_text_bio_bridge","uncertainty_reason":"none","decision_rationale":"Uses pre-trained genomic language models as a backbone and evaluates PEFT vs fine-tuning for taxonomic classification. This is a downstream adaptation study rather than a new text-bio foundation model.","evidence_snippet":"\"pre-trained genomic language models as the classification backbone\"; \"we apply PEFT to the problem of taxonomic classification\""},"architecture_reviewer":{"record_id":"rec_000017","paper_type":"primary_model_paper","generative_model_present":"unclear","foundation_model_evidence":"yes","primary_exclusion_code":"none","uncertainty_reason":"generative_status_unclear","decision_rationale":"The abstract centers on pre-trained genomic language models used for taxonomic classification and PEFT comparisons. It does not explicitly describe a decoder, autoregressive, or other clearly generative architecture.","evidence_snippet":"\"pre-trained genomic language models as the classification backbone\"; \"pretrained models over those randomly initialized\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"EC2_no_substantive_text_bio_bridge","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"application_wrapper","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"no","generative_model_present":"unclear","foundation_model_evidence":"yes"}}}]
