[{"record_id":"full_2026-07-06__rec_001487","candidate_id":"full_2026-07-06__rec_001487","source_record_id":"rec_001487","source_corpus":"include","title":"Universal Single-Cell Transcriptomic Aging Clock powered by LLMs reveals targets to slow cellular aging","abstract":"","doi":"10.1093/geroni/igaf122.4305","year":"","venue":"","sources":[],"full_text_context":"[document_opening: Docling opening text]\nAbstract citation ID: igaf122.4305\n## UNIVERSAL SINGLE-CELL TRANSCRIPTOMIC AGING CLOCK POWERED BY LLMS REVEALS TARGETS TO SLOW CELLULAR AGING\nRaghav Sehgal, Yale University, New Haven, Connecticut, United States\nLarge language models such as GPT have shown impressive performance in capturing structure and meaning from natural language. We adapt this capability to biology by representing single-cell transcriptomes as ordered sequences of gene names, analogous to sentences in text. Each cell's expression profile is converted into a 'cell sentence,' enabling pretrained language models to be fine-tuned directly on single-cell data for age prediction. Trained on millions of cells spanning diverse tissues and life stages, the model learns a universal latent representation of aging. It captures both cell-type-specific trajectories and conserved molecular signatures, generalizing across tissues and species. Unlike other foundational models that must be trained from scratch on omics data, our framework leverages already well-validated LLMs, taking advantage of their robust priors while avoiding the cost and instability of building new architectures. The resulting clock achieves state-of-the-art accuracy in predicting biological age at single-cell resolution. Embeddings proteostasis decline, and metabolic shifts, aligning with known hallmarks of aging. Importantly, the model can also identify genes whose modulation decreases predicted transcriptional age, nominating candidate targets for therapeutic intervention. [truncated]","section_evidence":[{"section_type":"document_opening","heading":"Docling opening text","heading_level":0,"line_start":1,"line_end":0,"text":"Abstract citation ID: igaf122.4305\n## UNIVERSAL SINGLE-CELL TRANSCRIPTOMIC AGING CLOCK POWERED BY LLMS REVEALS TARGETS TO SLOW CELLULAR AGING\nRaghav Sehgal, Yale University, New Haven, Connecticut, United States\nLarge language models such as GPT have shown impressive performance in capturing structure and meaning from natural language. We adapt this capability to biology by representing single-cell transcriptomes as ordered sequences of gene names, analogous to sentences in text. Each cell's expression profile is converted into a 'cell sentence,' enabling pretrained language models to be fine-tuned directly on single-cell data for age prediction. Trained on millions of cells spanning diverse tissues and life stages, the model learns a universal latent representation of aging. It captures both cell-type-specific trajectories and conserved molecular signatures, generalizing across tissues and species. Unlike other foundational models that must be trained from scratch on omics data, our framework leverages already well-validated LLMs, taking advantage of their robust priors while avoiding the cost and instability of building new architectures. The resulting clock achieves state-of-the-art accuracy in predicting biological age at single-cell resolution. Embeddings proteostasis decline, and metabolic shifts, aligning with known hallmarks of aging. Importantly, the model can also identify genes whose modulation decreases predicted transcriptional age, nominating candidate targets for therapeutic intervention. [truncated]","original_chars":1540}],"docling_markdown":"data/docling_include_no_vlm_2026-07-09/markdown/full_2026_07_06_rec_001487.md","first_pass_outputs":{"scope_reviewer":{"record_id":"full_2026-07-06__rec_001487","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"This is a primary model paper on single-cell transcriptomes, but the text claim is only a sentence-like analogy over gene names. The provided text does not show a substantive natural-language component or a text-bio bridge.","evidence_snippet":"\"representing single-cell transcriptomes as ordered sequences of gene names, analogous to sentences in text\"; \"converted into a 'cell sentence'\"; \"fine-tuned directly on single-cell data for age prediction\""},"architecture_reviewer":{"record_id":"full_2026-07-06__rec_001487","paper_type":"application_wrapper","generative_model_present":"no","foundation_model_evidence":"yes","primary_exclusion_code":"application_wrapper","uncertainty_reason":"none","decision_rationale":"The record describes fine-tuning pretrained language models on single-cell data for age prediction, which is an application of an existing model rather than a clearly generative new architecture. It does support foundation-model-like transfer and broad representation learning across tissues and species.","evidence_snippet":"\"enabling pretrained language models to be fine-tuned directly on single-cell data for age prediction\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"EC2_no_text_component","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","generative_model_present":"no","foundation_model_evidence":"yes"}}}]

