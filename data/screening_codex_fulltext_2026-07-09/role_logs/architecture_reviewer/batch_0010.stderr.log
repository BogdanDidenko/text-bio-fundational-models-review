./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/nemotron3_super_120b_fp8_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11581/guideline_pilot_raw_completed.jsonl:143:{"cluster_id": 3613, "title": "GenoBERT: A Language Model for Accurate Genotype Imputation", "title_normalized": "genobert a language model for accurate genotype imputation", "doi": NaN, "preprint_doi": NaN, "pmid": NaN, "arxiv_id": "2604.00058", "abstract": "Genotype imputation enables dense variant coverage for genome-wide association and risk-prediction studies, yet conventional reference-panel methods remain limited by ancestry bias and reduced rare-variant accuracy. We present Genotype Bidirectional Encoder Representations from Transformers (GenoBERT), a transformer-based, reference-free framework that tokenizes phased genotypes and uses a self-attention mechanism to capture both short- and long-range linkage disequilibrium (LD) dependencies. Benchmarking on two independent datasets including the Louisiana Osteoporosis Study (LOS) and the 1000 Genomes Project (1KGP) across ancestry groups and multiple genotype missingness levels (5-50%) shows that GenoBERT achieves the highest overall accuracy compared to four baseline methods (Beagle5.4, SCDA, BiU-Net, and STICI). At practical sparsity levels (up to 25% missing), GenoBERT attains high overall imputation accuracy ($r^2 approx 0.98$) across datasets, and maintains robust performance ($r^2>0.90$) even at 50% missingness. Experimental results across different ancestries confirm consistent gains across datasets, with resilience to small sample sizes and weak LD. A 128-SNP (single-nucleotide polymorphism) context window (approximately 100 Kb) is validated through LD-decay analyses as sufficient to capture local correlation structures. By eliminating reference-panel dependence while preserving high accuracy, GenoBERT provides a scalable and robust solution for genotype imputation and a foundation for downstream genomic modeling.", "authors": "Lei Huang; Chuan Qiu; Kuanjui Su; Anqi Liu; Yun Gong; Weiqiang Lin; Lindong Jiang; Chen Zhao; Meng Song; Jeffrey D. Deng; Qing Tian; Zhe Luo; Ping Gong; Hui Shen; Chaoyang Zhang; Hong-Wen Deng", "year": 2026.0, "venue": NaN, "date": "2026-03-31", "url": NaN, "sources": "['google_scholar', 'semantic_scholar']", "n_sources": 2, "all_dois": "[]", "duplicate_count": 2, "abstract_source": NaN, "abstract_enriched_from": NaN, "abstract_old_len": NaN, "update_batch": "2026-03-01_to_2026-04-14", "_pilot_row_id": 151, "round-A_scope_reviewer_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "no", "text_bio_bridge_present": "no", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "none", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "not_assessed", "boundary_case": "biological_token_only_boundary", "decision_rationale": "The abstract describes GenoBERT as a transformer that tokenizes phased genotypes and uses self-attention to capture LD dependencies, with no mention of natural-language text as input or output."}, "round-A_scope_reviewer_paper_type": "primary_model_paper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "no", "round-A_scope_reviewer_text_bio_bridge_present": "no", "round-A_scope_reviewer_primary_exclusion_code": "none", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "none", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "none", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "biological_token_only_boundary", "round-A_scope_reviewer_decision_rationale": "The abstract describes GenoBERT as a transformer that tokenizes phased genotypes and uses self-attention to capture LD dependencies, with no mention of natural-language text as input or output.", "round-A_architecture_reviewer_output": {"paper_type": "primary_model_paper", "generative_model_present": "no", "foundation_model_evidence": "unclear", "primary_exclusion_code": "EC3_not_generative", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "none", "boundary_case": "clear_exclude", "decision_rationale": "The abstract describes GenoBERT as a transformer-based encoder using self-attention for genotype imputation, with no mention of decoder, autoregressive, or generative mechanisms."}, "round-A_architecture_reviewer_paper_type": "primary_model_paper", "round-A_architecture_reviewer_generative_model_present": "no", "round-A_architecture_reviewer_foundation_model_evidence": "unclear", "round-A_architecture_reviewer_primary_exclusion_code": "EC3_not_generative", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "none", "round-A_architecture_reviewer_boundary_case": "clear_exclude", "round-A_architecture_reviewer_decision_rationale": "The abstract describes GenoBERT as a transformer-based encoder using self-attention for genotype imputation, with no mention of decoder, autoregressive, or generative mechanisms.", "pilot_roundA_scope_gate": "EXCLUDE", "pilot_roundA_architecture_gate": "EXCLUDE", "pilot_needs_adjudication": false}
./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/nemotron3_super_120b_fp8_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11581/guideline_pilot_raw_completed.jsonl:148:{"cluster_id": 3623, "title": "Decoding antibiotic modes of action from multimodal cellular responses", "title_normalized": "decoding antibiotic modes of action from multimodal cellular responses", "doi": "10.64898/2026.03.31.715570", "preprint_doi": NaN, "pmid": NaN, "arxiv_id": NaN, "abstract": "Abstract\n                \n                  Antibiotic resistance continues to rise, yet most new drug candidates act through long-established targets. Faster mode of action (MoA) assessment would enable more effective prioritization of screening hits and help identify compounds with novel mechanisms. In this study, we aimed to develop a scalable framework for MoA inference from antibiotic-induced cellular response profiles in\n                  Escherichia coli\n                  . We generated a multimodal dataset spanning more than 50 antibiotics, including proteome profiles, chemical structure descriptors, inhibitory concentrations and growth dynamics, and used it to build MAPPER (Mode of Action Prediction via Proteomics-Enhanced Representation), a framework comprising a fixed multimodal predictor and an uncertainty module. MAPPER accurately classified antibiotics across nine mechanistic classes, flagged compounds with likely novel mechanisms and retained predictive power in proteomics-only transfer experiments across mass spectrometry platforms and external data. Together, these results establish MAPPER as an innovative tool for MoA prediction and novelty detection, enabling prioritization of antibacterial candidates with distinct mechanisms.", "authors": "Joshua Hesse; Dominik Schum; L. Leidel; Leonard R. Gareis; Jennifer Herrmann; Rolf Müller; Stephan A. Sieber", "year": 2026.0, "venue": "bioRxiv", "date": "2026-04-02", "url": NaN, "sources": "['semantic_scholar']", "n_sources": 1, "all_dois": "['10.64898/2026.03.31.715570']", "duplicate_count": 1, "abstract_source": "crossref", "abstract_enriched_from": NaN, "abstract_old_len": NaN, "update_batch": "2026-03-01_to_2026-04-14", "_pilot_row_id": 161, "round-A_scope_reviewer_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "no", "text_bio_bridge_present": "no", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "none", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "not_assessed", "boundary_case": "text_component_boundary", "decision_rationale": "The abstract describes MAPPER, a multimodal predictor using proteomic, chemical, and growth data to classify antibiotic mechanisms, with no natural language text component or text‑bio generative bridge."}, "round-A_scope_reviewer_paper_type": "primary_model_paper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "no", "round-A_scope_reviewer_text_bio_bridge_present": "no", "round-A_scope_reviewer_primary_exclusion_code": "none", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "none", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "none", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "text_component_boundary", "round-A_scope_reviewer_decision_rationale": "The abstract describes MAPPER, a multimodal predictor using proteomic, chemical, and growth data to classify antibiotic mechanisms, with no natural language text component or text‑bio generative bridge.", "round-A_architecture_reviewer_output": {"paper_type": "primary_model_paper", "generative_model_present": "no", "foundation_model_evidence": "unclear", "primary_exclusion_code": "EC3_not_generative", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "none", "boundary_case": "clear_exclude", "decision_rationale": "The abstract describes a classification/prediction framework (MAPPER) with no mention of generative mechanisms such as decoder, autoregressive, or diffusion; thus it is not a generative model."}, "round-A_architecture_reviewer_paper_type": "primary_model_paper", "round-A_architecture_reviewer_generative_model_present": "no", "round-A_architecture_reviewer_foundation_model_evidence": "unclear", "round-A_architecture_reviewer_primary_exclusion_code": "EC3_not_generative", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "none", "round-A_architecture_reviewer_boundary_case": "clear_exclude", "round-A_architecture_reviewer_decision_rationale": "The abstract describes a classification/prediction framework (MAPPER) with no mention of generative mechanisms such as decoder, autoregressive, or diffusion; thus it is not a generative model.", "pilot_roundA_scope_gate": "EXCLUDE", "pilot_roundA_architecture_gate": "EXCLUDE", "pilot_needs_adjudication": false}
./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/nemotron3_super_120b_fp8_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11581/guideline_pilot_raw_completed.jsonl:181:{"cluster_id": 3616, "title": "Deep learning models for diagnosing mood disorders using integrated MRI and genetic data", "title_normalized": "deep learning models for diagnosing mood disorders using integrated mri and genetic data", "doi": "10.7717/peerj-cs.3562", "preprint_doi": NaN, "pmid": NaN, "arxiv_id": NaN, "abstract": "Brain disorders are conditions that affect brain structure, function, or chemistry, causing various symptoms and impairments. Brain disorders are categorized into neurodegenerative disorders, including Alzheimer’s disease and Parkinson’s disease, which involve progressive neuronal degeneration; mental health disorders, including depression, anxiety, bipolar disorder (BD), and schizophrenia; and traumatic brain injuries resulting from external force, causing temporary or permanent brain damage. Mood disorders, including major depressive disorder (MDD) and BD, are frequently underdiagnosed, thereby contributing to a significant clinical burden. To address this challenge, we introduce a novel computational framework that uses multimodal data integration by combining patient-specific magnetic resonance imaging (MRI) with whole-exome sequencing data.\n \n \n \n \n Our dataset consisted of brain imaging and genetic data from 321 East Asian individuals, comprising 147 diagnosed with MDD, 78 with BD, and 96 healthy controls, along with corresponding single-nucleotide polymorphism (SNP) data containing 212 features per subject. Further, we used a child MRI dataset for external validation. We initially prepared and preprocessed our data for the adult dataset. SNP data were then loaded from a Excel file; features were normalized, and MRI images stored in Neuroimaging Informatics Technology Initiative (NIFTI) format were preprocessed by resizing and augmenting them. Various deep learning models (\n e.g\n ., InceptionV3, ResNet) were employed to extract features from MRI data. SNP characteristics were extracted from the preprocessed genetic data. The number of samples was aligned between the SNP and MRI feature sets; these features were concatenated to form a combined feature set, and the combined features were normalized.\n \n \n \n \n \n The combined features were input into machine learning classifiers (\n e.g\n ., support vector machine (SVM), K Nearest Neighbors) for final classification, yielding the best accuracy of 74.2% on a linear SVM classifier for detecting mood disorders. Further, two more results were considered, with the second being the classification of the child MRI dataset into abnormal and normal categories, which achieved an exceptional accuracy of 99.8% on the cubic SVM classifier.\n \n \n \n \n Our approach supports the diagnostic evaluation of patients with psychiatric disorders by incorporating additional neuroimaging modalities and genomic information into routine clinical workflows.", "authors": "Ahsan Aziz; Saelin Oh; Yuyoung Ji; Yunyoung Nam; Byung-Joo Ham; Yongwon Cho", "year": 2026.0, "venue": "PeerJ Computer Science", "date": "2026-03-02", "url": NaN, "sources": "['semantic_scholar']", "n_sources": 1, "all_dois": "['10.7717/peerj-cs.3562']", "duplicate_count": 1, "abstract_source": NaN, "abstract_enriched_from": NaN, "abstract_old_len": NaN, "update_batch": "2026-03-01_to_2026-04-14", "_pilot_row_id": 154, "round-A_scope_reviewer_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "unclear", "text_bio_bridge_present": "unclear", "primary_exclusion_code": "none", "uncertainty_reason": "text_component_unclear", "evidence_for_text_component": "none", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "not_assessed", "boundary_case": "thin_abstract_boundary", "decision_rationale": "The abstract focuses on MRI and genetic data integration for mood disorder classification without any mention of natural language text or generative text-bio components."}, "round-A_scope_reviewer_paper_type": "primary_model_paper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "unclear", "round-A_scope_reviewer_text_bio_bridge_present": "unclear", "round-A_scope_reviewer_primary_exclusion_code": "none", "round-A_scope_reviewer_uncertainty_reason": "text_component_unclear", "round-A_scope_reviewer_evidence_for_text_component": "none", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "none", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "thin_abstract_boundary", "round-A_scope_reviewer_decision_rationale": "The abstract focuses on MRI and genetic data integration for mood disorder classification without any mention of natural language text or generative text-bio components.", "round-A_architecture_reviewer_output": {"paper_type": "primary_model_paper", "generative_model_present": "no", "foundation_model_evidence": "unclear", "primary_exclusion_code": "EC3_not_generative", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "none", "boundary_case": "clear_exclude", "decision_rationale": "The abstract reports only classification models (CNN feature extractors with SVM/KNN) for mood disorder diagnosis, without any decoder, autoregressive, sequence-to-sequence, diffusion, or other generative mechanism."}, "round-A_architecture_reviewer_paper_type": "primary_model_paper", "round-A_architecture_reviewer_generative_model_present": "no", "round-A_architecture_reviewer_foundation_model_evidence": "unclear", "round-A_architecture_reviewer_primary_exclusion_code": "EC3_not_generative", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "none", "round-A_architecture_reviewer_boundary_case": "clear_exclude", "round-A_architecture_reviewer_decision_rationale": "The abstract reports only classification models (CNN feature extractors with SVM/KNN) for mood disorder diagnosis, without any decoder, autoregressive, sequence-to-sequence, diffusion, or other generative mechanism.", "pilot_roundA_scope_gate": "UNCERTAIN", "pilot_roundA_architecture_gate": "EXCLUDE", "pilot_needs_adjudication": true, "round-B_adjudicator_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "no", "text_bio_bridge_present": "no", "generative_model_present": "no", "foundation_model_evidence": "unclear", "primary_exclusion_code": "EC2_no_text_component", "uncertainty_reason": "none", "evidence_for_text_component": "The combined features were input into machine learning classifiers (e.g., support vector machine (SVM), K Nearest Neighbors) for final classification", "evidence_for_text_bio_bridge_present": "The combined features were input into machine learning classifiers (e.g., support vector machine (SVM), K Nearest Neighbors) for final classification", "evidence_for_generative_model": "The combined features were input into machine learning classifiers (e.g., support vector machine (SVM), K Nearest Neighbors) for final classification", "boundary_case": "text_component_boundary", "decision_rationale": "The abstract involves only MRI and genetic data processing and classification, with no natural language text, text-bio bridge, or generative mechanism, thus failing the text component requirement for a generative text-bio foundational model.", "evidence_for_text_bio_bridge": null}, "round-B_adjudicator_paper_type": "primary_model_paper", "round-B_adjudicator_bio_modality_present": "yes", "round-B_adjudicator_text_component_present": "no", "round-B_adjudicator_text_bio_bridge_present": "no", "round-B_adjudicator_generative_model_present": "no", "round-B_adjudicator_foundation_model_evidence": "unclear", "round-B_adjudicator_primary_exclusion_code": "EC2_no_text_component", "round-B_adjudicator_uncertainty_reason": "none", "round-B_adjudicator_evidence_for_text_component": "The combined features were input into machine learning classifiers (e.g., support vector machine (SVM), K Nearest Neighbors) for final classification", "round-B_adjudicator_evidence_for_text_bio_bridge": null, "round-B_adjudicator_evidence_for_generative_model": "The combined features were input into machine learning classifiers (e.g., support vector machine (SVM), K Nearest Neighbors) for final classification", "round-B_adjudicator_boundary_case": "text_component_boundary", "round-B_adjudicator_decision_rationale": "The abstract involves only MRI and genetic data processing and classification, with no natural language text, text-bio bridge, or generative mechanism, thus failing the text component requirement for a generative text-bio foundational model."}
./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/nemotron3_super_120b_fp8_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11581/guideline_pilot_raw_completed.jsonl:182:{"cluster_id": 3619, "title": "BOTANIC-0: a series of foundation models for plant genomic data", "title_normalized": "botanic0 a series of foundation models for plant genomic data", "doi": "10.64898/2026.02.23.706817", "preprint_doi": NaN, "pmid": NaN, "arxiv_id": NaN, "abstract": "Genomic language models (gLMs) have emerged as a powerful paradigm for learning regulatory biology directly from DNA sequence. Here, we introduce\n                  Botanic0\n                  ¶\n                  , a family of plant genomic foundation models spanning 100M to 1B parameters and pretrained on 43 phylogenetically diverse plant genomes. The\n                  \n                    Botanic0-S\n                    ,\n                    Botanic0-M\n                  \n                  , and\n                  \n                    Botanic0-L\n                  \n                  models form the first generation of a long-term research initiative, dedicated to advancing crop improvement research, genotype–to-phenotype modeling, and sequence-based genome editing. The architecture, pre-training pipeline and pre-training dataset of\n                  Botanic0\n                  follow the seminal work of [1]. Across a broad suite of genomic and genetic prediction tasks, including regulatory element annotation, gene expression inference, and variant effect prediction,\n                  Botanic0\n                  models achieve performance competitive with state-of-the-art foundation models, both in zero-shot settings and after fine-tuning. Scaling analyses reveal consistent improvements in predictive power with increased model capacity, highlighting the benefits of large-model pretraining for plant genomics. This work establishes our ability to train foundation models at scale, and lays the foundation for the next generations of models to come. To support reproducible research and community benchmarking, we release all\n                  Botanic0\n                  models at\n                  https://huggingface.co/living-models/models\n                  .", "authors": "J. Ogier du Terrail; Tanguy Marchand; V. Cabeli; Zhor Khadir; C. Véran; Léonard Strouk", "year": 2026.0, "venue": "bioRxiv", "date": "2026-03-04", "url": NaN, "sources": "['google_scholar', 'semantic_scholar']", "n_sources": 2, "all_dois": "['10.64898/2026.02.23.706817']", "duplicate_count": 2, "abstract_source": NaN, "abstract_enriched_from": "crossref", "abstract_old_len": 181.0, "update_batch": "2026-03-01_to_2026-04-14", "_pilot_row_id": 157, "round-A_scope_reviewer_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "no", "text_bio_bridge_present": "no", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "none", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "not_assessed", "boundary_case": "biological_token_only_boundary", "decision_rationale": "The abstract describes Botanic0 as a genomic language model pretrained on plant DNA sequences, with no mention of natural language text or text-bio bridging."}, "round-A_scope_reviewer_paper_type": "primary_model_paper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "no", "round-A_scope_reviewer_text_bio_bridge_present": "no", "round-A_scope_reviewer_primary_exclusion_code": "none", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "none", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "none", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "biological_token_only_boundary", "round-A_scope_reviewer_decision_rationale": "The