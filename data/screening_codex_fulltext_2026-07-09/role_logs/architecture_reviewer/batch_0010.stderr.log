e_gate": "UNCERTAIN", "pilot_needs_adjudication": true, "round-B_adjudicator_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "no", "text_bio_bridge_present": "no", "generative_model_present": "yes", "foundation_model_evidence": "no", "primary_exclusion_code": "EC2_no_text_component", "uncertainty_reason": "none", "evidence_for_text_component": "none", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "deep generative framework", "boundary_case": "text_component_boundary", "decision_rationale": "The abstract presents DeepTracing as a deep generative framework for single-cell RNA-seq data but provides no evidence of natural-language text or text-bio bridging, indicating a missing text component."}, "round-B_adjudicator_paper_type": "primary_model_paper", "round-B_adjudicator_bio_modality_present": "yes", "round-B_adjudicator_text_component_present": "no", "round-B_adjudicator_text_bio_bridge_present": "no", "round-B_adjudicator_generative_model_present": "yes", "round-B_adjudicator_foundation_model_evidence": "no", "round-B_adjudicator_primary_exclusion_code": "EC2_no_text_component", "round-B_adjudicator_uncertainty_reason": "none", "round-B_adjudicator_evidence_for_text_component": "none", "round-B_adjudicator_evidence_for_text_bio_bridge": "none", "round-B_adjudicator_evidence_for_generative_model": "deep generative framework", "round-B_adjudicator_boundary_case": "text_component_boundary", "round-B_adjudicator_decision_rationale": "The abstract presents DeepTracing as a deep generative framework for single-cell RNA-seq data but provides no evidence of natural-language text or text-bio bridging, indicating a missing text component."}
./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/nemotron3_super_120b_fp8_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11581/guideline_pilot_raw_completed.jsonl:250:{"cluster_id": 3725, "title": "BSAN: Behavioral State Attention Network for Modeling Mosquito Host-Seeking Behavior", "title_normalized": "bsan behavioral state attention network for modeling mosquito hostseeking behavior", "doi": "10.1609/aaai.v40i46.41280", "preprint_doi": NaN, "pmid": NaN, "arxiv_id": NaN, "abstract": "Understanding the complex host-seeking behavior of disease vectors such as mosquito is critical for predicting disease transmission and vector control. This behavior arises from a dynamic interplay between multi-modal sensory cues and internal behavioral states, a process challenging traditional ODE frameworks due to its inherent stochasticity and discrete, state-based nature. We introduce the Behavioral State Attention Network (BSAN), a deep learning architecture designed to model the underlying sensorimotor computations of this behavior. BSAN utilizes a recurrent neural network (RNN) with an LSTM core to process temporal sequences, incorporating a variational encoder to capture the randomness of flight paths and a Mixture Density Network (MDN) to predict multi-modal velocity distributions. The architecture explicitly models distinct behavioral states, such as $CO_2$ plume tracking and thermal approach, through a Mixture-of-Experts (MoE) framework, and learns to interpretably integrate olfactory, thermal, and visual inputs using a cross-modal attention mechanism. The network generates realistic flight trajectories that exhibit emergent host-seeking behaviors. By providing both trajectory predictions and interpretable behavioral primitives, BSAN serves as a framework for downstream applications in landscape genomics and vector control, enabling the prediction of mosquito population connectivity through environment-specific movement kernels.", "authors": "Haotian Sun; J. Li; John M. Marshall", "year": 2026.0, "venue": "AAAI Conference on Artificial Intelligence", "date": "2026-03-14", "url": NaN, "sources": "['semantic_scholar']", "n_sources": 1, "all_dois": "['10.1609/aaai.v40i46.41280']", "duplicate_count": 1, "abstract_source": NaN, "abstract_enriched_from": NaN, "abstract_old_len": NaN, "update_batch": "2026-03-01_to_2026-04-14", "_pilot_row_id": 260, "round-A_scope_reviewer_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "no", "text_bio_bridge_present": "no", "primary_exclusion_code": "EC2_no_text_component", "uncertainty_reason": "none", "evidence_for_text_component": "none", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "not_assessed", "boundary_case": "text_component_boundary", "decision_rationale": "The abstract presents a deep learning architecture for modeling mosquito host-seeking behavior using sensory inputs and recurrent networks, with no mention of natural language text or text-bio integration."}, "round-A_scope_reviewer_paper_type": "primary_model_paper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "no", "round-A_scope_reviewer_text_bio_bridge_present": "no", "round-A_scope_reviewer_primary_exclusion_code": "EC2_no_text_component", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "none", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "none", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "text_component_boundary", "round-A_scope_reviewer_decision_rationale": "The abstract presents a deep learning architecture for modeling mosquito host-seeking behavior using sensory inputs and recurrent networks, with no mention of natural language text or text-bio integration.", "round-A_architecture_reviewer_output": {"paper_type": "primary_model_paper", "generative_model_present": "yes", "foundation_model_evidence": "no", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "generates realistic flight trajectories", "boundary_case": "clear_exclude", "decision_rationale": "The abstract describes BSAN as a variational encoder‑MDN RNN that generates realistic flight trajectories, indicating a generative architecture. No evidence of broad pretraining or transferable representations is provided, so foundation‑model evidence is lacking."}, "round-A_architecture_reviewer_paper_type": "primary_model_paper", "round-A_architecture_reviewer_generative_model_present": "yes", "round-A_architecture_reviewer_foundation_model_evidence": "no", "round-A_architecture_reviewer_primary_exclusion_code": "none", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "generates realistic flight trajectories", "round-A_architecture_reviewer_boundary_case": "clear_exclude", "round-A_architecture_reviewer_decision_rationale": "The abstract describes BSAN as a variational encoder‑MDN RNN that generates realistic flight trajectories, indicating a generative architecture. No evidence of broad pretraining or transferable representations is provided, so foundation‑model evidence is lacking.", "pilot_roundA_scope_gate": "EXCLUDE", "pilot_roundA_architecture_gate": "PASS", "pilot_needs_adjudication": false}
./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/nemotron3_super_120b_fp8_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11581/guideline_pilot_raw_completed.jsonl:256:{"cluster_id": 3729, "title": "Minimal biophysical rules are sufficient for the emergence of computational intelligence at the neuronal scale", "title_normalized": "minimal biophysical rules are sufficient for the emergence of computational intelligence at the neuronal scale", "doi": "10.64898/2026.03.01.708921", "preprint_doi": NaN, "pmid": NaN, "arxiv_id": NaN, "abstract": "Abstract\n                How intelligence emerges from the brain’s complex microscopic physical system is a central question for neuroscience and artificial intelligence. Constrained by the genomic bottleneck that precludes synapse-by-synapse specification, we propose and validate a microscopic structure-function ‘concise-constraint sufficiency’ hypothesis. We develop the Neuro-Informed Generative Connectome (NIGC) framework, and show that connectomes generated under a concise set of biophysical constraints (geometric embedding, node propensity modulation, a global energy budget and maximum-entropy selection) closely match the structural statistics of a measured mouse V1 microcircuit (similarities, 0.997). In parallel, using the generated connectome as the fixed reservoir of an echo state network (ESN), training only a linear readout achieves 90% accuracy on an auditory multi-classification task. Moreover, multidimensional biologically consistent functional phenotypes, such as hierarchical transmission delays and low-dimensional spatiotemporal trajectories, are obtained without fitting functional matrices or time courses. Further, by combining single-constraint ablations, pathological perturbations and cross-modal validation, we clarify how specific structural constraints map onto functional consequences. Together, these results delineate sufficient conditions for computational intelligence emergence at the microscopic scale, and provide an auditable benchmark for first-principles understanding of brain construction.", "authors": "Guanyu Wang; Liang Qi; Kunyang Li; Chenyu Tang; Xuhang Chen; L. Occhipinti; A. Nathan; Ningli Wang; Yu Pan; Peter Smielewski; Ying Wang; Yingyan Mao; Xiaoyu Guo; Shuo Gao", "year": 2026.0, "venue": "bioRxiv", "date": "2026-03-25", "url": NaN, "sources": "['semantic_scholar']", "n_sources": 1, "all_dois": "['10.64898/2026.03.01.708921']", "duplicate_count": 1, "abstract_source": "crossref", "abstract_enriched_from": NaN, "abstract_old_len": NaN, "update_batch": "2026-03-01_to_2026-04-14", "_pilot_row_id": 264, "round-A_scope_reviewer_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "no", "text_bio_bridge_present": "no", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "none", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "not_assessed", "boundary_case": "clear_exclude", "decision_rationale": "The abstract presents a biophysical generative connectome model and echo state network for classification, with no natural-language text component or text-bio bridge."}, "round-A_scope_reviewer_paper_type": "primary_model_paper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "no", "round-A_scope_reviewer_text_bio_bridge_present": "no", "round-A_scope_reviewer_primary_exclusion_code": "none", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "none", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "none", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "clear_exclude", "round-A_scope_reviewer_decision_rationale": "The abstract presents a biophysical generative connectome model and echo state network for classification, with no natural-language text component or text-bio bridge.", "round-A_architecture_reviewer_output": {"paper_type": "primary_model_paper", "generative_model_present": "yes", "foundation_model_evidence": "no", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "connectomes generated under a concise set of biophysical constraints", "boundary_case": "text_component_boundary", "decision_rationale": "The abstract describes a generative framework for creating connectomes under biophysical constraints, showing clear generative evidence, but lacks any text generation or foundation-model pretraining evidence."}, "round-A_architecture_reviewer_paper_type": "primary_model_paper", "round-A_architecture_reviewer_generative_model_present": "yes", "round-A_architecture_reviewer_foundation_model_evidence": "no", "round-A_architecture_reviewer_primary_exclusion_code": "none", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "connectomes generated under a concise set of biophysical constraints", "round-A_architecture_reviewer_boundary_case": "text_component_boundary", "round-A_architecture_reviewer_decision_rationale": "The abstract describes a generative framework for creating connectomes under biophysical constraints, showing clear generative evidence, but lacks any text generation or foundation-model pretraining evidence.", "pilot_roundA_scope_gate": "EXCLUDE", "pilot_roundA_architecture_gate": "PASS", "pilot_needs_adjudication": false}
./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/nemotron3_super_120b_fp8_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11581/guideline_pilot_raw_completed.jsonl:258:{"cluster_id": 3731, "title": "Abstract B065: Stage-aware CRISPR design for brain metastasis interception: Multi-modal validation of BBB extravasation and CNS colonization targets", "title_normalized": "abstract b065 stageaware crispr design for brain metastasis interception multimodal validation of bbb extravasation and cns colonization targets", "doi": "10.1158/1538-7445.brain26-b065", "preprint_doi": NaN, "pmid": NaN, "arxiv_id": NaN, "abstract": "Brain metastases occur in 20-40% of patients with breast, lung, and melanoma cancers and represent a leading cause of cancer mortality. Current CRISPR design tools prioritize on-target efficiency alone, ignoring stage-specific vulnerabilities along metastatic cascades. We present Interception, a stage-aware CRISPR design framework that can be applied to brain colonization by integrating multi-modal genomic signals and foundation models to target BBB extravasation and CNS microenvironment adaptation.\n \n \n \n We implemented a modular pipeline that (i) computes Functionality (Evo2 variant predictions), Essentiality (DepMap scores), Chromatin accessibility (framework for CNS-specific enhancers), and Regulatory impact; (ii) selects mission-specific targets using weighted Target-Lock scoring; (iii) generates PAM-aware guide candidates; (iv) scores efficacy via Evo2 delta predictions; (v) quantifies genome-wide safety via minimap2/BLAST with exponential decay mapping. Candidates ranked by composite Assassin score: 0.40×efficacy + 0.30×safety + 0.30×mission fit. To demonstrate applicability to brain metastasis, we identified candidate genes for BBB extravasation (VEGF-C, MMP9) and CNS adaptation (L1CAM, STAT3, CTGF) based on published brain metastasis literature.\n \n \n \n We validated the Target-Lock scoring framework using 38 metastasis-associated genes across 8 cascade steps (304 data points). Per-step AUROC was 0.976 ± 0.035, AUPRC 0.948 ± 0.064, Precision@3 = 1.000 (1000-bootstrap CIs). All 8 steps showed significant enrichment (Fisher's exact p < 0.05, 6/8 with p < 0.001), with large effect sizes (Cohen's d > 2.0). Guide RNA designs (n=20) achieved mean efficacy 0.548 ± 0.119, safety 0.771 ± 0.210, Assassin score 0.517 ± 0.114. Structural validation of 15 guide:DNA complexes via AlphaFold 3 achieved 100% pass rate (pLDDT 65.6 ± 1.8, iPTM 0.36 ± 0.01; acceptance: pLDDT ≥50, iPTM ≥0.30). When applied to brain metastasis candidate genes, the framework prioritizes targets implicated in BBB permeability (VEGF-C), neuronal adhesion (L1CAM), and astrocyte-mediated survival (STAT3) based on Target-Lock scoring.\n \n \n \n Interception delivers a reproducible, mission-aware CRISPR design framework validated on metastatic cascade genes (AUROC 0.976, 100% structural pass rate) and applicable to brain metastasis target selection. The framework integrates multi-modal signals, genome-wide safety validation, and structural confirmation. Application to brain colonization identifies candidate targets for BBB extravasation and CNS microenvironment adaptation. Future work includes experimental validation in brain-tropic cell lines (MDA-MB-231-BR, PC9-BrM3), integration of brain-specific DepMap essentiality, and in vivo intracranial injection models to measure metastatic burden reduction.\n \n \n \n Fahad Kiani, Sabreen Abeed Allah. Stage-aware CRISPR design for brain metastasis interception: Multi-modal validation of BBB extravasation and CNS colonization targets [abstract]. In: Proceedings of the AACR Special Conference in Cancer Research: Brain Cancer; 2026 Mar 23-25; Philadelphia, PA. Philadelphia (PA): AACR; Cancer Res 2026;86(6_Suppl):Abstract nr B065.", "authors": "Fahad Kiani; Sabreen Abeed Allah", "year": 2026.0, "venue": "Cancer Research", "date": "2026-03-23", "url": NaN, "sources": "['semantic_scholar']", "n_sources": 1, "all_dois": "['10.1158/1538-7445.brain26-b065']", "duplicate_count": 1, "abstract_source": NaN, "abstract_enriched_from": NaN, "abstract_old_len": NaN, "update_batch": "2026-03-01_to_2026-04-14", "_pilot_row_id": 266, "round-A_scope_reviewer_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "no", "text_bio_bridge_present": "no", "primary_exclusion_code": "EC2_no_text_component", "uncertainty_reason": "none", "evidence_for_text_component": "none", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "not_assessed", "boundary_case": "clear_exclude", "decision_rationale": "The abstract describes a CRISPR design framework that integrates genomic signals and foundation models but does not mention any natural-language text component or text-bio generation, indicating lack of a substantive text component and text-bio bridge."}, "round-A_scope_reviewer_paper_type": "primary_model_paper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "no", "round-A_scope_reviewer_text_bio_bridge_present": "no", "round-A_scope_reviewer_primary_exclusion_code": "EC2_no_text_component", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "none", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "none", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "clear_exclude", "round-A_scope_reviewer_decision_rationale": "The abstract describes a CRISPR design framework that integrates genomic signals and foundation models but does not mention any natural-language text component or text-bio generation, indicating lack of a substantive text component and text-bio bridge.", "round-A_architecture_reviewer_output": {"paper_type": "primary_model_paper", "generative_model_present": "yes", "foundation_model_evidence": "unclear", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "generates PAM-aware guide candidates", "boundary_case": "biological_token_only_boundary", "decision_rationale": "The abstract describes a stage-aware CRISPR design framework that generates PAM-aware guide candidates (generative evidence) and integrates foundation models, though it does not show the framework itself is a foundation model."}, "round-A_architecture_reviewer_paper_type": "primary_model_paper", "round-A_architecture_reviewer_generative_model_present": "yes", "round-A_architecture_reviewer_foundation_model_evidence": "unclear", "round-A_architecture_reviewer_primary_exclusion_code": "none", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "generates PAM-aware guide candidates", "round-A_architecture_reviewer_boundary_case": "biological_token_only_boundary", "round-A_architecture_reviewer_decision_rationale": "The abstract describes a stage-aware CRISPR design framework that generates PAM-aware guide candidates (generative evidence) and integrates foundation models, though it does not show the framework itself is a foundation model.", "pilot_roundA_scope_gate": "EXCLUDE", "pilot_roundA_architecture_gate": "PASS", "pilot_needs_adjudication": false}
./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/nemotron3_super_120b_fp8_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11581/guideline_pilot_raw_completed.jsonl:263:{"cluster_id": 3698, "title": "MINT: Molecularly Informed Training with Spatial Transcriptomics Supervision for Pathology Foundation Models", "title_normalized": "mint molecularly informed training with spatial transcriptomics supervision for pathology foundation models", "doi": NaN, "preprint_doi": NaN, "pmid": NaN, "arxiv_id": "2603.07895", "abstract": "Pathology foundation models learn morphological representations through self-supervised pretraining on large-scale whole-slide images, yet they do not explicitly capture the underlying molecular state of the tissue. Spatial transcriptomics technologies bridge this gap by measuring gene expression in situ, offering a natural cross-modal supervisory signal. We propose MINT (Molecularly Informed Training), a fine-tuning framework that incorporates spatial transcriptomics supervision into pretrained pathology Vision Transformers. MINT appends a learnable ST token to the ViT input to encode transcriptomic information separately from the morphological CLS token, preventing catastrophic forgetting through DINO self-distillation and explicit feature anchoring to the frozen pretrained encoder. Gene expression regression at both spot-level (Visium) and patch-level (Xenium) resolutions provides complementary supervision across spatial scales. Trained on 577 publicly available HEST samples, MINT achieves the best overall performance on both HEST-Bench for gene expression prediction (mean Pearson r = 0.440) and EVA for general pathology tasks (0.803), demonstrating that spatial transcriptomics supervision complements morphology-centric self-supervised pretraining.", "authors": "M. Lee; Jonghyun Kim; Juseung Yun; Sunwoo Yu; Jongseong Jang", "year": 2026.0, "venue": NaN, "date": "2026-03-09", "url": NaN, "sources": "['semantic_s