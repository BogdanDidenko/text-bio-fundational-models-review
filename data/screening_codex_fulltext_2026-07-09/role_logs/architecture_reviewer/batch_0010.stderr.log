./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/nemotron3_super_120b_fp8_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11581/guideline_pilot_raw_completed.jsonl:310:{"cluster_id": 3749, "title": "Neurobiological architecture of first-episode, drug-naive late-life depression: Insights from multimodal MRI, transcriptomics, and neurotransmitter mapping.", "title_normalized": "neurobiological architecture of firstepisode drugnaive latelife depression insights from multimodal mri transcriptomics and neurotransmitter mapping", "doi": "10.1016/j.jad.2026.121532", "preprint_doi": NaN, "pmid": 41780696.0, "arxiv_id": NaN, "abstract": "PURPOSE\nTo elucidate the neurobiological architecture of late-life depression (LLD) by integrating macroscopic multimodal MRI with microscopic transcriptomic and neurochemical mapping.\n\n\nMETHODS\nWe analyzed 39 first-episode, drug-naive LLD patients and 41 matched healthy controls (HC) using structural MRI, diffusion kurtosis imaging, and resting-state fMRI. Data were processed to extract gray matter volume (GMV), white matter diffusion metrics (FA, MD, AD, RD), and functional indices (fALFF, DC), with group differences evaluated under rigorous multiple-comparison corrections. To elucidate molecular underpinnings, partial least squares (PLS) regression was applied to link neuroimaging t-maps with Allen Human Brain Atlas gene expression profiles. Spatial correlations between neuroimaging statistical maps and PET-derived neurotransmitter receptor density maps were further examined to identify neurochemical substrates.\n\n\nRESULTS\nLLD patients exhibited localized gray matter volume (GMV) reductions in the right fusiform gyrus and limbic structures, widespread microstructural white matter degradation across fronto-limbic tracts, and increased functional amplitude and network centrality centered on the medial prefrontal cortex (mPFC). Transcriptomic decoding linked these macroscopic anomalies to gene sets enriched for mitochondrial metabolism, calcium signaling, and synaptic organization. Furthermore, spatial correlation analyses uniquely revealed that structural atrophy was predominantly associated with the glutamatergic system, whereas functional and network alterations aligned most robustly with the opioid system.\n\n\nCONCLUSIONS\nOur findings support a multi-scale neurobiological model of LLD, wherein distinct molecular deficits in bioenergetics, glutamatergic excitotoxicity, and opioid neurotransmission underlie macroscopic structural and functional network failures. This integrative framework identifies specific neurochemical systems as prime mechanistic substrates and potential therapeutic targets for the cognitive-emotional dysregulation characteristic of LLD.", "authors": "Heng Shao; Xiaohui Yu; Yan Zhang; Yingjie Yang; Jiaojian Wang; Chen Luo; Jie Zhang", "year": 2026.0, "venue": "Journal of Affective Disorders", "date": "2026-03-02", "url": NaN, "sources": "['semantic_scholar']", "n_sources": 1, "all_dois": "['10.1016/j.jad.2026.121532']", "duplicate_count": 1, "abstract_source": NaN, "abstract_enriched_from": NaN, "abstract_old_len": NaN, "update_batch": "2026-03-01_to_2026-04-14", "_pilot_row_id": 284, "round-A_scope_reviewer_output": {"paper_type": "unclear", "bio_modality_present": "yes", "text_component_present": "no", "text_bio_bridge_present": "no", "primary_exclusion_code": "EC2_no_text_component", "uncertainty_reason": "none", "evidence_for_text_component": "none", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "not_assessed", "boundary_case": "thin_abstract_boundary", "decision_rationale": "The abstract reports an empirical MRI/transcriptomics study without any text or language component or generative modeling, indicating no substantive text-bio bridge and not a primary model paper."}, "round-A_scope_reviewer_paper_type": "unclear", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "no", "round-A_scope_reviewer_text_bio_bridge_present": "no", "round-A_scope_reviewer_primary_exclusion_code": "EC2_no_text_component", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "none", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "none", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "thin_abstract_boundary", "round-A_scope_reviewer_decision_rationale": "The abstract reports an empirical MRI/transcriptomics study without any text or language component or generative modeling, indicating no substantive text-bio bridge and not a primary model paper.", "round-A_architecture_reviewer_output": {"paper_type": "unclear", "generative_model_present": "no", "foundation_model_evidence": "no", "primary_exclusion_code": "EC3_not_generative", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "none", "boundary_case": "clear_exclude", "decision_rationale": "The abstract details a multimodal MRI, transcriptomics, and neurotransmitter mapping study with no description of a generative architecture or foundation-model pretraining."}, "round-A_architecture_reviewer_paper_type": "unclear", "round-A_architecture_reviewer_generative_model_present": "no", "round-A_architecture_reviewer_foundation_model_evidence": "no", "round-A_architecture_reviewer_primary_exclusion_code": "EC3_not_generative", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "none", "round-A_architecture_reviewer_boundary_case": "clear_exclude", "round-A_architecture_reviewer_decision_rationale": "The abstract details a multimodal MRI, transcriptomics, and neurotransmitter mapping study with no description of a generative architecture or foundation-model pretraining.", "pilot_roundA_scope_gate": "UNCERTAIN", "pilot_roundA_architecture_gate": "UNCERTAIN", "pilot_needs_adjudication": true, "round-B_adjudicator_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "no", "text_bio_bridge_present": "no", "generative_model_present": "no", "foundation_model_evidence": "no", "primary_exclusion_code": "EC2_no_text_component", "uncertainty_reason": "none", "evidence_for_text_component": "none", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "none", "boundary_case": "text_component_boundary", "decision_rationale": "The abstract focuses on MRI, transcriptomics, and neurotransmitter mapping without any natural language text or generative mechanism, so it lacks a text component and text-bio bridge."}, "round-B_adjudicator_paper_type": "primary_model_paper", "round-B_adjudicator_bio_modality_present": "yes", "round-B_adjudicator_text_component_present": "no", "round-B_adjudicator_text_bio_bridge_present": "no", "round-B_adjudicator_generative_model_present": "no", "round-B_adjudicator_foundation_model_evidence": "no", "round-B_adjudicator_primary_exclusion_code": "EC2_no_text_component", "round-B_adjudicator_uncertainty_reason": "none", "round-B_adjudicator_evidence_for_text_component": "none", "round-B_adjudicator_evidence_for_text_bio_bridge": "none", "round-B_adjudicator_evidence_for_generative_model": "none", "round-B_adjudicator_boundary_case": "text_component_boundary", "round-B_adjudicator_decision_rationale": "The abstract focuses on MRI, transcriptomics, and neurotransmitter mapping without any natural language text or generative mechanism, so it lacks a text component and text-bio bridge."}
./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/nemotron3_super_120b_fp8_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11581/guideline_pilot_raw_completed.jsonl:325:{"cluster_id": 3803, "title": "evoCancerGPT: Generating Zero-Shot Single-Cell and Single-Sample Cancer Progression Through Transfer Learning", "title_normalized": "evocancergpt generating zeroshot singlecell and singlesample cancer progression through transfer learning", "doi": NaN, "preprint_doi": NaN, "pmid": NaN, "arxiv_id": NaN, "abstract": "Abstract\n                Cancer evolution is driven by complex changes in gene expression as cells transition and change states during tumorigenesis. Single-cell RNA sequencing has provided snapshot insights into how the transcriptomics of tumors evolve, but whether the existing knowledge can be used to reliably learn and generate the patterns behind the evolution of cancers remains unknown. Here, we introduce evoCancerGPT, a generative pre-trained transformer decoder-only single-cell foundation model designed to forecast future gene expression profiles in cancer evolution by leveraging previous cell states at the level of single patients. This model integrates the continuous gene expression data of each cell to create a comprehensive representation of a cell token. Training sentences are constructed for each cancer type, each patient and each cell type separately, ordered via inferred pseudotime algorithms, using 2.76 million cell tokens, each with 12,639 genes, spanning 7 cancer types. By learning from long-range dependencies between cells arranged in pseudotime from a large corpus of data, evoCancerGPT captures key transitions in cancer evolution, achieving high concordance to ground truth trajectories and outperforming linear and scGPT baselines in held-out test samples in low-context scenarios. Our work suggests evoCancerGPT’s potential utility in characterizing tumor progression at a single-cell and single-patient level and ultimately contributing to more personalized cancer care.", "authors": "['X Wang', 'R Tan', 'S Cristea']", "year": 2026.0, "venue": "bioRxiv", "date": NaN, "url": "https://www.biorxiv.org/content/10.64898/2026.02.12.705621.abstract", "sources": "['google_scholar']", "n_sources": 1, "all_dois": "[]", "duplicate_count": 1, "abstract_source": NaN, "abstract_enriched_from": "crossref_title", "abstract_old_len": 182.0, "update_batch": "2026-03-01_to_2026-04-14", "_pilot_row_id": 337, "round-A_scope_reviewer_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "no", "text_bio_bridge_present": "no", "primary_exclusion_code": "EC2_no_text_component", "uncertainty_reason": "none", "evidence_for_text_component": "none", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "not_assessed", "boundary_case": "text_component_boundary", "decision_rationale": "The abstract describes evoCancerGPT as a generative transformer over cell tokens with no natural-language text component, thus lacking a substantive text/bio bridge."}, "round-A_scope_reviewer_paper_type": "primary_model_paper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "no", "round-A_scope_reviewer_text_bio_bridge_present": "no", "round-A_scope_reviewer_primary_exclusion_code": "EC2_no_text_component", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "none", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "none", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "text_component_boundary", "round-A_scope_reviewer_decision_rationale": "The abstract describes evoCancerGPT as a generative transformer over cell tokens with no natural-language text component, thus lacking a substantive text/bio bridge.", "round-A_architecture_reviewer_output": {"paper_type": "primary_model_paper", "generative_model_present": "yes", "foundation_model_evidence": "yes", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "generative pre-trained transformer decoder-only", "boundary_case": "clear_include", "decision_rationale": "The abstract presents evoCancerGPT as a generative pre‑trained transformer decoder‑only foundation model trained on 2.76 million cell tokens across seven cancer types, indicating a decoder‑based generative architecture and broad pretraining."}, "round-A_architecture_reviewer_paper_type": "primary_model_paper", "round-A_architecture_reviewer_generative_model_present": "yes", "round-A_architecture_reviewer_foundation_model_evidence": "yes", "round-A_architecture_reviewer_primary_exclusion_code": "none", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "generative pre-trained transformer decoder-only", "round-A_architecture_reviewer_boundary_case": "clear_include", "round-A_architecture_reviewer_decision_rationale": "The abstract presents evoCancerGPT as a generative pre‑trained transformer decoder‑only foundation model trained on 2.76 million cell tokens across seven cancer types, indicating a decoder‑based generative architecture and broad pretraining.", "pilot_roundA_scope_gate": "EXCLUDE", "pilot_roundA_architecture_gate": "PASS", "pilot_needs_adjudication": false}
./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/nemotron3_super_120b_fp8_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11581/guideline_pilot_raw_completed.jsonl:350:{"cluster_id": 3832, "title": "EssTFNet: Integration of Adaptive Time–Frequency and DNA Language Models for Interpretable Human Essential Gene Prediction", "title_normalized": "esstfnet integration of adaptive timefrequency and dna language models for interpretable human essential gene prediction", "doi": NaN, "preprint_doi": NaN, "pmid": NaN, "arxiv_id": NaN, "abstract": "Abstract\n                \n                  Essential genes are defined as those that are indispensable for an organism’s survival. The loss of function of these genes results in cell death or an inability to complete the normal life cycle. Research on essential genes is pivotal in elucidating the origin and evolution of life, as well as in identifying potential therapeutic targets. Therefore, accurately predicting essential genes is of great scientific importance and has many applications in basic research and the biomedical field. In this study, we propose EssTFNet, a novel and interpretable deep learning framework that combines adaptive time–frequency analysis with a DNA language model to achieve accurate prediction of human essential genes while enabling mechanistic biological interpretation. Specifically, EssTFNet leverages the architecture of ATFNet, which innovatively maps DNA and protein sequences into equivalent time-series signals to extract periodic and non-stationary features, thereby enhancing the model’s capacity to capture complex sequence patterns. Through effective feature selection and architectural optimization, EssTFNet strikes a favorable balance among prediction accuracy, model interpretability, and cross-tissues generalization capability, significantly outperforming current mainstream sequence-based deep learning methods with an AUC of 0.8336 and an AUPR of 0.8212. Additionally, the DeepLIFT attribution method was employed to identify functional motifs closely associated with gene essentiality, offering valuable insights for experimental validation. For the convenience of researchers, we have developed an easy-to-use web server and made it along with the source code in a GitHub repository:\n                  https://github.com/QIANJINYDX/EssTFNet\n                  . Overall, this study presents a potentially useful methodological framework for human essential genes prediction, which could provide valuable insights for future research and applications in this field.", "authors": "['DX Ye', 'SS Yuan', 'W Su', 'HQ Zhang', 'R Li', 'YC Qi']", "year": 2026.0, "venue": "bioRxiv", "date": NaN, "url": "https://www.biorxiv.org/content/10.64898/2025.12.31.697261.abstract", "sources": "['google_scholar']", "n_sources": 1, "all_dois": "[]", "duplicate_count": 1, "abstract_source": NaN, "abstract_enriched_from": "crossref_title", "abstract_old_len": 178.0, "update_batch": "2026-03-01_to_2026-04-14", "_pilot_row_id": 366, "round-A_scope_reviewer_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "no", "text_bio_bridge_present": "no", "primary_exclusion_code": "EC2_no_text_component", "uncertainty_reason": "none", "evidence_for_text_component": "none", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "not_assessed", "boundary_case": "text_component_boundary", "decision_rationale": "The abstract presents a DNA language model for gene sequences but does not describe any natural‑language text component or explicit text‑bio alignment, indicating lack of a substantive text component."}, "round-A_scope_reviewer_paper_type": "primary_model_paper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "no", "round-A_scope_reviewer_text_bio_bridge_present": "no", "round-A_scope_reviewer_primary_exclusion_code": "EC2_no_text_componen