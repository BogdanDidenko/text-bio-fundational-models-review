y_case": "clear_exclude", "decision_rationale": "The paper describes MINT as a fine-tuning framework that adds a learnable spatial transcriptomics token to a pretrained pathology Vision Transformer and trains via gene expression regression; no decoder, autoregressive, or other generative mechanism is mentioned."}, "round-A_architecture_reviewer_paper_type": "application_wrapper", "round-A_architecture_reviewer_generative_model_present": "no", "round-A_architecture_reviewer_foundation_model_evidence": "yes", "round-A_architecture_reviewer_primary_exclusion_code": "application_wrapper", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "none", "round-A_architecture_reviewer_boundary_case": "clear_exclude", "round-A_architecture_reviewer_decision_rationale": "The paper describes MINT as a fine-tuning framework that adds a learnable spatial transcriptomics token to a pretrained pathology Vision Transformer and trains via gene expression regression; no decoder, autoregressive, or other generative mechanism is mentioned.", "pilot_roundA_scope_gate": "EXCLUDE", "pilot_roundA_architecture_gate": "EXCLUDE", "pilot_needs_adjudication": true, "round-B_adjudicator_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "no", "text_bio_bridge_present": "no", "generative_model_present": "no", "foundation_model_evidence": "yes", "primary_exclusion_code": "EC2_no_text_component", "uncertainty_reason": "none", "evidence_for_text_component": "Gene expression regression at both spot-level (Visium) and patch-level (Xenium) resolutions provides complementary supervision across spatial scales.", "evidence_for_text_bio_bridge": "MINT appends a learnable ST token to the ViT input to encode transcriptomic information separately from the morphological CLS token", "evidence_for_generative_model": "Gene expression regression at both spot-level (Visium) and patch-level (Xenium) resolutions provides complementary supervision across spatial scales.", "boundary_case": "text_component_boundary", "decision_rationale": "The abstract describes a vision transformer fine-tuned with spatial transcriptomics tokens for gene expression regression, with no natural language text or generative mechanism, thus lacking a text component and text-bio bridge."}, "round-B_adjudicator_paper_type": "primary_model_paper", "round-B_adjudicator_bio_modality_present": "yes", "round-B_adjudicator_text_component_present": "no", "round-B_adjudicator_text_bio_bridge_present": "no", "round-B_adjudicator_generative_model_present": "no", "round-B_adjudicator_foundation_model_evidence": "yes", "round-B_adjudicator_primary_exclusion_code": "EC2_no_text_component", "round-B_adjudicator_uncertainty_reason": "none", "round-B_adjudicator_evidence_for_text_component": "Gene expression regression at both spot-level (Visium) and patch-level (Xenium) resolutions provides complementary supervision across spatial scales.", "round-B_adjudicator_evidence_for_text_bio_bridge": "MINT appends a learnable ST token to the ViT input to encode transcriptomic information separately from the morphological CLS token", "round-B_adjudicator_evidence_for_generative_model": "Gene expression regression at both spot-level (Visium) and patch-level (Xenium) resolutions provides complementary supervision across spatial scales.", "round-B_adjudicator_boundary_case": "text_component_boundary", "round-B_adjudicator_decision_rationale": "The abstract describes a vision transformer fine-tuned with spatial transcriptomics tokens for gene expression regression, with no natural language text or generative mechanism, thus lacking a text component and text-bio bridge."}
./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/nemotron3_super_120b_fp8_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11581/guideline_pilot_raw_completed.jsonl:266:{"cluster_id": 3702, "title": "Poisoning the Genome: Targeted Backdoor Attacks on DNA Foundation Models", "title_normalized": "poisoning the genome targeted backdoor attacks on dna foundation models", "doi": NaN, "preprint_doi": NaN, "pmid": NaN, "arxiv_id": "2603.27465v1", "abstract": "Genomic foundation models trained on DNA sequences have demonstrated remarkable capabilities across diverse biological tasks, from variant effect prediction to genome design. These models are typically trained on massive, publicly sourced genomic datasets comprising trillions of nucleotide tokens, which renders them intrinsically susceptible to errors, artifacts, and adversarial issues embedded in the training data. Unlike natural language, DNA sequences lack the semantic transparency that might allow model makers to filter out corrupted entries, making genomic training corpora particularly susceptible to undetected manipulation. While training data poisoning has been established as a credible threat to large language models, its implications for genomic foundation models remain unexplored. Here, we present the first systematic investigation of training data poisoning in genomic language models. We demonstrate two complementary attack vectors. First, we show that adversarially crafted sequences can selectively degrade generative behavior on targeted genomic contexts, with backdoor activation following a sigmoidal dose-response relationship and full implantation achieved at 1 percent cumulative poison exposure. Second, targeted label corruption of downstream training data can selectively compromise clinically relevant variant classification, demonstrated using BRCA1 variant effect prediction. Our results reveal that genomic foundation models are vulnerable to targeted data poisoning attacks, underscoring the need for data provenance tracking, integrity verification, and adversarial robustness evaluation in the genomic foundation model development pipeline.", "authors": "Charalampos Koilakos; I. Mouratidis; Ilias Georgakopoulos-Soares", "year": 2026.0, "venue": NaN, "date": "2026-03-29", "url": NaN, "sources": "['arxiv', 'semantic_scholar']", "n_sources": 2, "all_dois": "[]", "duplicate_count": 2, "abstract_source": NaN, "abstract_enriched_from": NaN, "abstract_old_len": NaN, "update_batch": "2026-03-01_to_2026-04-14", "_pilot_row_id": 237, "round-A_scope_reviewer_output": {"paper_type": "unclear", "bio_modality_present": "yes", "text_component_present": "no", "text_bio_bridge_present": "no", "primary_exclusion_code": "none", "uncertainty_reason": "paper_type_unclear", "evidence_for_text_component": "none", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "not_assessed", "boundary_case": "thin_abstract_boundary", "decision_rationale": "The abstract examines poisoning attacks on DNA foundation models but does not introduce a new model or natural-language text component, leaving paper_type unclear."}, "round-A_scope_reviewer_paper_type": "unclear", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "no", "round-A_scope_reviewer_text_bio_bridge_present": "no", "round-A_scope_reviewer_primary_exclusion_code": "none", "round-A_scope_reviewer_uncertainty_reason": "paper_type_unclear", "round-A_scope_reviewer_evidence_for_text_component": "none", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "none", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "thin_abstract_boundary", "round-A_scope_reviewer_decision_rationale": "The abstract examines poisoning attacks on DNA foundation models but does not introduce a new model or natural-language text component, leaving paper_type unclear.", "round-A_architecture_reviewer_output": {"paper_type": "unclear", "generative_model_present": "unclear", "foundation_model_evidence": "yes", "primary_exclusion_code": "none", "uncertainty_reason": "generative_status_unclear", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "generative behavior", "boundary_case": "biological_token_only_boundary", "decision_rationale": "The abstract notes that genomic foundation models exhibit generative behavior but does not describe an explicit generative mechanism (e.g., decoder, autoregressive). It does provide foundation‑model evidence via pretraining on massive DNA token corpora."}, "round-A_architecture_reviewer_paper_type": "unclear", "round-A_architecture_reviewer_generative_model_present": "unclear", "round-A_architecture_reviewer_foundation_model_evidence": "yes", "round-A_architecture_reviewer_primary_exclusion_code": "none", "round-A_architecture_reviewer_uncertainty_reason": "generative_status_unclear", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "generative behavior", "round-A_architecture_reviewer_boundary_case": "biological_token_only_boundary", "round-A_architecture_reviewer_decision_rationale": "The abstract notes that genomic foundation models exhibit generative behavior but does not describe an explicit generative mechanism (e.g., decoder, autoregressive). It does provide foundation‑model evidence via pretraining on massive DNA token corpora.", "pilot_roundA_scope_gate": "UNCERTAIN", "pilot_roundA_architecture_gate": "UNCERTAIN", "pilot_needs_adjudication": true, "round-B_adjudicator_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "no", "text_bio_bridge_present": "no", "generative_model_present": "yes", "foundation_model_evidence": "yes", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "abstract mentions only DNA sequences, no natural language text", "evidence_for_text_bio_bridge": "no mention of natural language text or text-bio alignment in abstract", "evidence_for_generative_model": "degrade generative behavior on targeted genomic contexts", "boundary_case": "clear_include", "decision_rationale": "The abstract describes DNA sequence foundation models with explicit generative behavior and no natural language text component, supporting inclusion as a primary model paper."}, "round-B_adjudicator_paper_type": "primary_model_paper", "round-B_adjudicator_bio_modality_present": "yes", "round-B_adjudicator_text_component_present": "no", "round-B_adjudicator_text_bio_bridge_present": "no", "round-B_adjudicator_generative_model_present": "yes", "round-B_adjudicator_foundation_model_evidence": "yes", "round-B_adjudicator_primary_exclusion_code": "none", "round-B_adjudicator_uncertainty_reason": "none", "round-B_adjudicator_evidence_for_text_component": "abstract mentions only DNA sequences, no natural language text", "round-B_adjudicator_evidence_for_text_bio_bridge": "no mention of natural language text or text-bio alignment in abstract", "round-B_adjudicator_evidence_for_generative_model": "degrade generative behavior on targeted genomic contexts", "round-B_adjudicator_boundary_case": "clear_include", "round-B_adjudicator_decision_rationale": "The abstract describes DNA sequence foundation models with explicit generative behavior and no natural language text component, supporting inclusion as a primary model paper."}
./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/nemotron3_super_120b_fp8_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11581/guideline_pilot_raw_completed.jsonl:269:{"cluster_id": 3705, "title": "Cross-Modal Training Using Xenium Spatial Transcriptomics Enables DINO-DETR Based Detection of Vascular Niches in H&E Whole-Slide Images", "title_normalized": "crossmodal training using xenium spatial transcriptomics enables dinodetr based detection of vascular niches in he wholeslide images", "doi": "10.64898/2026.03.17.712266", "preprint_doi": NaN, "pmid": NaN, "arxiv_id": NaN, "abstract": "Abstract\n                \n                  Background\n                  Tumor vasculature is a key driver of glioma progression, yet routine quantification depends on subjective histopathologic assessment or resource-intensive ancillary immunohistochemistry. A scalable, objective method for vascular phenotyping from routine histology remains an unmet need.\n                \n                \n                  Methods\n                  We leveraged 10x Genomics Xenium spatial transcriptomics data from a glioblastoma specimen to generate molecularly resolved annotations of GBM-associated endothelial cells and pericytes across 809,041 cells. These annotations were transferred to matched H&amp;E-stained sections to train a DINO-DETR-based object detection model using a binary classification scheme (vascular vs. other). The model was validated on four independent Xenium patient slides and applied to a retrospective cohort of 119 diffuse gliomas spanning WHO grades 2-4 (oligodendroglioma, astrocytoma, and glioblastoma) with linked survival data.\n                \n                \n                  Results\n                  Binary vascular cell detection achieved a precision of 0.78, a recall of 0.63, and an F1 score of 0.70, with an overall accuracy of 98.6%. Orthogonal spatial validation confirmed that predicted vascular cells were preferentially localized within annotated blood vessel regions. In subtype-stratified survival analysis, high AI-derived vascular cell proportion was significantly associated with worse overall survival in astrocytoma patients (log-rank p &lt; 0.019).\n                \n                \n                  Conclusion\n                  Cross-modal AI training using spatial transcriptomics enables scalable, molecularly informed vascular quantification directly from routine H&amp;E slides. Within the astrocytoma subtype, where tumor grade is most heterogeneous and vascular phenotype most variable, objective vascular quantification provides independent prognostic information demonstrating the potential of spatially supervised deep learning to extract clinically meaningful microenvironmental signals from universally available histologic material.", "authors": "S. Pranali; Ramya Alugam; Shashank Gupta; N. Shah; M. Uppin", "year": 2026.0, "venue": "bioRxiv", "date": "2026-03-19", "url": NaN, "sources": "['semantic_scholar']", "n_sources": 1, "all_dois": "['10.64898/2026.03.17.712266']", "duplicate_count": 1, "abstract_source": "crossref", "abstract_enriched_from": NaN, "abstract_old_len": NaN, "update_batch": "2026-03-01_to_2026-04-14", "_pilot_row_id": 240, "round-A_scope_reviewer_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "no", "text_bio_bridge_present": "no", "primary_exclusion_code": "EC2_no_text_component", "uncertainty_reason": "none", "evidence_for_text_component": "none", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "not_assessed", "boundary_case": "clear_exclude", "decision_rationale": "The abstract describes using spatial transcriptomics to train a DINO-DETR object detection model with no mention of text or language components or generative text-bio bridging."}, "round-A_scope_reviewer_paper_type": "primary_model_paper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "no", "round-A_scope_reviewer_text_bio_bridge_present": "no", "round-A_scope_reviewer_primary_exclusion_code": "EC2_no_text_component", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "none", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "none", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "clear_exclude", "round-A_scope_reviewer_decision_rationale": "The abstract describes using spatial transcriptomics to train a DINO-DETR object detection model with no mention of text or language components or generative text-bio bridging.", "round-A_architecture_reviewer_output": {"paper_type": "application_wrapper", "generative_model_present": "no", "foundation_model_evidence": "unclear", "primary_exclusion_code": "application_wrapper", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "none", "boundary_case": "wrapper_boundary", "decision_rationale": "The abstract describes using an existing DINO-DETR detection model for binary vascular cell classification; no generative mechanism (decoder, autoregressive, diffusion) is mentioned, and no evidence of foundation-model pretraining or broad applicability is provided."}, "round-A_architecture_reviewer_paper_type": "application_wrapper", "round-A_architecture_reviewer_generative_model_present": "no", "round-A_architecture_reviewer_foundation_model_evidence": "unclear", "round-A_architecture_reviewer_primary_exclusion_code": "application_wrapper", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "none", "round-A_architecture_reviewer_