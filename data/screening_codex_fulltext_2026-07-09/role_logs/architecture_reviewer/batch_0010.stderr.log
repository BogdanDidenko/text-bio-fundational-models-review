none", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "generative pre-trained transformer", "boundary_case": "clear_include", "decision_rationale": "The abstract states scGPT is a generative pre-trained transformer trained on over 33 million cells, indicating a generative architecture with foundation-model pretraining."}, "round-A_architecture_reviewer_paper_type": "primary_model_paper", "round-A_architecture_reviewer_generative_model_present": "yes", "round-A_architecture_reviewer_foundation_model_evidence": "yes", "round-A_architecture_reviewer_primary_exclusion_code": "none", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "generative pre-trained transformer", "round-A_architecture_reviewer_boundary_case": "clear_include", "round-A_architecture_reviewer_decision_rationale": "The abstract states scGPT is a generative pre-trained transformer trained on over 33 million cells, indicating a generative architecture with foundation-model pretraining.", "pilot_roundA_scope_gate": "EXCLUDE", "pilot_roundA_architecture_gate": "PASS", "pilot_needs_adjudication": false}
