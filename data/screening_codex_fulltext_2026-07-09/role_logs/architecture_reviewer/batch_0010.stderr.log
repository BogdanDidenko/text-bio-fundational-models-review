ces": 1, "all_dois": "[]", "duplicate_count": 2, "abstract_source": "s2_title", "abstract_enriched_from": NaN, "abstract_old_len": NaN, "update_batch": NaN, "_pilot_row_id": 90, "round-A_scope_reviewer_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "unclear", "text_bio_bridge_present": "unclear", "primary_exclusion_code": "none", "uncertainty_reason": "mixed_signals", "evidence_for_text_component": "none", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "not_assessed", "boundary_case": "thin_abstract_boundary", "decision_rationale": "Abstract describes scGPT as a generative pretrained transformer on single-cell gene expression data, with no mention of natural-language text input/output or explicit text-bio alignment."}, "round-A_scope_reviewer_paper_type": "primary_model_paper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "unclear", "round-A_scope_reviewer_text_bio_bridge_present": "unclear", "round-A_scope_reviewer_primary_exclusion_code": "none", "round-A_scope_reviewer_uncertainty_reason": "mixed_signals", "round-A_scope_reviewer_evidence_for_text_component": "none", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "none", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "thin_abstract_boundary", "round-A_scope_reviewer_decision_rationale": "Abstract describes scGPT as a generative pretrained transformer on single-cell gene expression data, with no mention of natural-language text input/output or explicit text-bio alignment.", "round-A_architecture_reviewer_output": {"paper_type": "primary_model_paper", "generative_model_present": "yes", "foundation_model_evidence": "yes", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "generative pre-trained transformer", "boundary_case": "clear_include", "decision_rationale": "The abstract states scGPT is a generative pre-trained transformer built from large-scale single-cell data, indicating a generative architecture and foundation-model pretraining."}, "round-A_architecture_reviewer_paper_type": "primary_model_paper", "round-A_architecture_reviewer_generative_model_present": "yes", "round-A_architecture_reviewer_foundation_model_evidence": "yes", "round-A_architecture_reviewer_primary_exclusion_code": "none", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "generative pre-trained transformer", "round-A_architecture_reviewer_boundary_case": "clear_include", "round-A_architecture_reviewer_decision_rationale": "The abstract states scGPT is a generative pre-trained transformer built from large-scale single-cell data, indicating a generative architecture and foundation-model pretraining.", "pilot_roundA_scope_gate": "UNCERTAIN", "pilot_roundA_architecture_gate": "PASS", "pilot_needs_adjudication": true, "round-B_adjudicator_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "no", "text_bio_bridge_present": "no", "generative_model_present": "yes", "foundation_model_evidence": "yes", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "none", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "generative pre-trained transformer", "boundary_case": "biological_token_only_boundary", "decision_rationale": "The abstract presents scGPT as a generative pretrained transformer on single-cell omics data, with no natural language text input or output, so text component and text-bio bridge are absent."}, "round-B_adjudicator_paper_type": "primary_model_paper", "round-B_adjudicator_bio_modality_present": "yes", "round-B_adjudicator_text_component_present": "no", "round-B_adjudicator_text_bio_bridge_present": "no", "round-B_adjudicator_generative_model_present": "yes", "round-B_adjudicator_foundation_model_evidence": "yes", "round-B_adjudicator_primary_exclusion_code": "none", "round-B_adjudicator_uncertainty_reason": "none", "round-B_adjudicator_evidence_for_text_component": "none", "round-B_adjudicator_evidence_for_text_bio_bridge": "none", "round-B_adjudicator_evidence_for_generative_model": "generative pre-trained transformer", "round-B_adjudicator_boundary_case": "biological_token_only_boundary", "round-B_adjudicator_decision_rationale": "The abstract presents scGPT as a generative pretrained transformer on single-cell omics data, with no natural language text input or output, so text component and text-bio bridge are absent."}
./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/nemotron3_super_120b_fp8_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11581/guideline_pilot_raw_completed.jsonl:132:{"cluster_id": 3598, "title": "Hybrid Vision Transformer–CNN Framework for Alzheimer’s Disease Cell Type Classification: A Comparative Study with Vision–Language Models", "title_normalized": "hybrid vision transformercnn framework for alzheimers disease cell type classification a comparative study with visionlanguage models", "doi": "10.3390/jimaging12030098", "preprint_doi": NaN, "pmid": NaN, "arxiv_id": NaN, "abstract": "Accurate identification of Alzheimer’s disease (AD)-related cellular characteristics from microscopy images is essential for understanding neurodegenerative mechanisms at the cellular level. While most computational approaches focus on macroscopic neuroimaging modalities, cell type classification from microscopy remains relatively underexplored. In this study, we propose a hybrid vision transformer–convolutional neural network (ViT–CNN) framework that integrates DeiT-Small and EfficientNet-B7 to classify three AD-related cell types—astrocytes, cortical neurons, and SH-SY5Y neuroblastoma cells—from phase-contrast microscopy images. We perform a comparative evaluation against conventional CNN architectures (DenseNet, ResNet, InceptionNet, and MobileNet) and prompt-based multimodal vision–language models (GPT-5, GPT-4o, and Gemini 2.5-Flash) using zero-shot, few-shot, and chain-of-thought prompting. Experiments conducted with stratified fivefold cross-validation show that the proposed hybrid model achieves a test accuracy of 61.03% and a macro F1 score of 61.85, outperforming standalone CNN baselines and prompt-only LLM approaches under data-limited conditions. These results suggest that combining convolutional inductive biases with transformer-based global context modeling can improve generalization for cellular microscopy classification. While constrained by dataset size and scope, this work serves as a proof of concept and highlights promising directions for future research in domain-specific pretraining, multimodal data integration, and explainable AI for AD-related cellular analysis.", "authors": "Hasan M.E.", "year": 2026.0, "venue": "Journal of Imaging", "date": "2026-03-01", "url": NaN, "sources": "['scopus']", "n_sources": 1, "all_dois": "['10.3390/jimaging12030098']", "duplicate_count": 1, "abstract_source": "crossref", "abstract_enriched_from": NaN, "abstract_old_len": NaN, "update_batch": "2026-03-01_to_2026-04-14", "_pilot_row_id": 140, "round-A_scope_reviewer_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "no", "text_bio_bridge_present": "no", "primary_exclusion_code": "EC2_no_text_component", "uncertainty_reason": "none", "evidence_for_text_component": "none", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "not_assessed", "boundary_case": "text_component_boundary", "decision_rationale": "The proposed hybrid ViT-CNN model processes only microscopy images and contains no text/language component; comparison with vision–language models is external, not integrated."}, "round-A_scope_reviewer_paper_type": "primary_model_paper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "no", "round-A_scope_reviewer_text_bio_bridge_present": "no", "round-A_scope_reviewer_primary_exclusion_code": "EC2_no_text_component", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "none", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "none", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "text_component_boundary", "round-A_scope_reviewer_decision_rationale": "The proposed hybrid ViT-CNN model processes only microscopy images and contains no text/language component; comparison with vision–language models is external, not integrated.", "round-A_architecture_reviewer_output": {"paper_type": "primary_model_paper", "generative_model_present": "no", "foundation_model_evidence": "unclear", "primary_exclusion_code": "EC3_not_generative", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "none", "boundary_case": "clear_exclude", "decision_rationale": "The abstract proposes a hybrid ViT-CNN framework for classifying Alzheimer's disease cell types, describing only a predictive classification task with no decoder, autoregressive, diffusion, or other generative mechanism."}, "round-A_architecture_reviewer_paper_type": "primary_model_paper", "round-A_architecture_reviewer_generative_model_present": "no", "round-A_architecture_reviewer_foundation_model_evidence": "unclear", "round-A_architecture_reviewer_primary_exclusion_code": "EC3_not_generative", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "none", "round-A_architecture_reviewer_boundary_case": "clear_exclude", "round-A_architecture_reviewer_decision_rationale": "The abstract proposes a hybrid ViT-CNN framework for classifying Alzheimer's disease cell types, describing only a predictive classification task with no decoder, autoregressive, diffusion, or other generative mechanism.", "pilot_roundA_scope_gate": "EXCLUDE", "pilot_roundA_architecture_gate": "EXCLUDE", "pilot_needs_adjudication": false}
./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/nemotron3_super_120b_fp8_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11581/guideline_pilot_raw_completed.jsonl:134:{"cluster_id": 3605, "title": "Yixin Yangshen Granules Target HIF−1 Signaling to Modulate the Neuroimmune Microenvironment in Alzheimer’s Disease: Insights from Integrative Multi-Omics and Deep Learning", "title_normalized": "yixin yangshen granules target hif1 signaling to modulate the neuroimmune microenvironment in alzheimers disease insights from integrative multiomics and deep learning", "doi": "10.3390/ph19030502", "preprint_doi": NaN, "pmid": NaN, "arxiv_id": NaN, "abstract": "Background/Objectives: Alzheimer’s disease (AD) involves amyloid and tau pathology with neuroimmune dysregulation, and Yixin Yangshen Granules (YXYS) shows neuroprotective promise, though mechanisms remain unclear. This study aimed to elucidate the multi-target mechanisms of YXYS in AD. Methods: The study began by analyzing a public human AD hippocampal snRNA-seq dataset to identify cell-type-specific pathological pathways and profiled YXYS constituents by UPLC-QTOF-MS. In vitro, YXYS cytoprotection against mitochondrial dysfunction and oxidative stress was tested in Aβ25–35-challenged HT22 cells; in vivo efficacy was assessed in Aβ1–42-induced mice via behavioral and histopathological analyses. Integrated transcriptomic and proteomic profiling of brain tissue, with ELISA, qRT-PCR, and Western blot validation, confirmed pathway targets. Using the intersection of transcriptomic and proteomic targets as biological input, the DTIAM deep learning framework was employed to prioritize active YXYS constituents. Finally, molecular docking and 100-ns dynamics simulations demonstrated direct binding of Ganosporelactone A to HIF−1α. Results: AD snRNA-seq analysis highlighted HIF−1 and AGE-RAGE signaling as prominent pathways in the AD hippocampus, particularly enriched in brain microvascular endothelial cells, implicating neurovascular hypoxic and inflammatory stress. In Aβ-induced mice, YXYS improved cognition, reduced Aβ pathology, suppressed neuroinflammation, and promoted neuronal survival, consistent with in vitro evidence of restored mitochondrial function. Multi-omics confirmed convergence on HIF−1 and AGE-RAGE pathways, with YXYS rebalancing the neuroimmune microenvironment by reducing pro-inflammatory M0 macrophages. Screening against these consensus signaling hubs, deep learning analysis prioritized Ganosporelactone A as the top-ranked modulator, and molecular further demonstrated the stable binding of Ganosporelactone A to HIF−1α, linking YXYS to mitigation of hypoxic stress. Conclusions: Guided by multi-omics and deep learning, our findings suggest that YXYS may alleviate AD-related phenotypes through multi-target modulation of the HIF−1 and AGE-RAGE pathways, with associated improvements in neuro-immune homeostasis and reductions in oxidative stress, neuroinflammation, and hypoxia.", "authors": "Wang Z.", "year": 2026.0, "venue": "Pharmaceuticals", "date": "2026-03-01", "url": NaN, "sources": "['scopus']", "n_sources": 1, "all_dois": "['10.3390/ph19030502']", "duplicate_count": 1, "abstract_source": "crossref", "abstract_enriched_from": NaN, "abstract_old_len": NaN, "update_batch": "2026-03-01_to_2026-04-14", "_pilot_row_id": 144, "round-A_scope_reviewer_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "no", "text_bio_bridge_present": "no", "primary_exclusion_code": "EC2_no_text_component", "uncertainty_reason": "none", "evidence_for_text_component": "none", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "not_assessed", "boundary_case": "text_component_boundary", "decision_rationale": "The abstract describes a deep learning framework applied to multi-omics data with no mention of natural language text or text-bio bridging."}, "round-A_scope_reviewer_paper_type": "primary_model_paper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "no", "round-A_scope_reviewer_text_bio_bridge_present": "no", "round-A_scope_reviewer_primary_exclusion_code": "EC2_no_text_component", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "none", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "none", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "text_component_boundary", "round-A_scope_reviewer_decision_rationale": "The abstract describes a deep learning framework applied to multi-omics data with no mention of natural language text or text-bio bridging.", "round-A_architecture_reviewer_output": {"paper_type": "primary_model_paper", "generative_model_present": "no", "foundation_model_evidence": "no", "primary_exclusion_code": "EC3_not_generative", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "none", "boundary_case": "clear_exclude", "decision_rationale": "The abstract describes a deep learning framework for prioritizing constituents, with no mention of decoder, autoregressive, diffusion, or other generative mechanisms. Therefore, the model is not generative and lacks foundation-model evidence."}, "round-A_architecture_reviewer_paper_type": "primary_model_paper", "round-A_architecture_reviewer_generative_model_present": "no", "round-A_architecture_reviewer_foundation_model_evidence": "no", "round-A_architecture_reviewer_primary_exclusion_code": "EC3_not_generative", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "none", "round-A_architecture_reviewer_boundary_case": "clear_exclude", "round-A_architecture_reviewer_decision_rationale": "The abstract describes a deep learning framework for prioritizing constituents, with no mention of decoder, autoregressive, diffusion, or other generative mechanisms. Therefore, the model is not generative and lacks foundation-model evidence.", "pilot_roundA_scope_gate": "EXCLUDE", "pilot_roundA_architecture_gate": "EXCLUDE", "pilot_needs_adjudication": false}
./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/nemotron3_super_120b_fp8_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11581/guideline_pilot_raw_completed.jsonl:137:{"cluster_id": 3609, "title": "Multimodal image analysis of cross-tissue cotton GBLTP gene expression Patterns", "title_normalized": "multimodal image analysis of crosstissue cotton gbltp gene expression patterns", "doi": "10.1117/12.3106782", "preprint_doi": NaN, "pmid": NaN, "arxiv_id": NaN, "abstract": "With the wide application of computer technology in gene chip technology, multimodal image analysis of gene expression patterns has become increasingly important. To address the issue that the current image fusion methods for cross-tissue cotton GbLTP gene expression patterns are difficult to generate image details well, a multimodal image fusion method combining the Swin Transformer model and the dual-discriminator conditional generative adversarial network is proposed in this study. Performance comparisons between the proposed method and alternative approaches reveal superior visual fidelity metrics: mean visual fidelity of 4.36 and mean squared error of 0.141. Additionally, the proposed method achieves higher mutual information 15.21, information entropy 7.36, spatial frequency 80.16, structural similarity 46.89 dB, edge intensity 80.16 dB, and peak signal-to-noise ratio 80.16 dB compared to competitors. 22.89, 98.76%, 80.16, and 46.89 dB, respectively. Comparative analysis across these metrics consistently demonstrates superiority over the comparison methods. These results confirm that the proposed multimodal image fusion method delivers robust performance across multiple dimensions, providing a theoretical foundation for research in multimodal image analysis of gene expression patterns.", "authors": "Liu Chao", "year": 2026.0, "venue": "International Conference on Computer Vision, Pattern Recognition and Detection", "date": "2026-03-05", "url": NaN, "sources