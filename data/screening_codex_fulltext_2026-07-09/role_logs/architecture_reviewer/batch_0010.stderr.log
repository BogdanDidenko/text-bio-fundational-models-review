./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/nemotron3_super_120b_fp8_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11581/guideline_pilot_raw_completed.jsonl:533:{"cluster_id": 3984, "title": "Spatial multiomics profiling reveals ZFP36-mediated immunometabolic reprogramming in bladder cancer", "title_normalized": "spatial multiomics profiling reveals zfp36mediated immunometabolic reprogramming in bladder cancer", "doi": NaN, "preprint_doi": NaN, "pmid": NaN, "arxiv_id": NaN, "abstract": "Bladder cancer remains a significant therapeutic challenge due to its marked heterogeneity and capacity for immune evasion. Here, we employ spatial metabolomics and spatial transcriptomics to systematically characterize and visualize the metabolic and transcriptional landscapes of bladder cancer. Our findings identify distinct metabolic and transcriptional profiles across different tumor regions, highlighting heterogeneity and immune-associated metabolic reprogramming in BLCA. Further investigation identifies zinc finger protein 36 (ZFP36) as a potential immunotherapeutic target. Utilizing\n                    Zfp36\n                    whole-body knockout and T cell–specific\n                    Zfp36\n                    conditional knockout mice, we validated that\n                    Zfp36\n                    knockout decreases the activation threshold for T cells and increases T cell infiltration in tumors. Moreover, we found that elevated ZFP36 expression is dramatically linked to worse patient outcomes. Mechanistically, ZFP36 facilitates mRNA degradation of key immune regulators, including\n                    C1QBP\n                    , thereby inhibiting T cell activation and cytotoxicity. Notably, combining\n                    Zfp36\n                    knockout with anti-PD-1 therapy produced synergistic antitumor effects, suggesting that ZFP36 inhibition could be a promising therapeutic strategy. This integrated multiomics approach collectively uncovers immune-metabolic regulatory pathways in BLCA and points to critical molecular targets for immunotherapy.", "authors": "['F Ye', 'X Han', 'W Li', 'L Huang', 'Z Chen', 'Y Lu']", "year": 2026.0, "venue": "Proceedings of the …", "date": NaN, "url": "https://www.pnas.org/doi/abs/10.1073/pnas.2505125123", "sources": "['google_scholar']", "n_sources": 1, "all_dois": "[]", "duplicate_count": 1, "abstract_source": NaN, "abstract_enriched_from": "crossref_title", "abstract_old_len": 179.0, "update_batch": "2026-03-01_to_2026-04-14", "_pilot_row_id": 518, "round-A_scope_reviewer_output": {"paper_type": "unclear", "bio_modality_present": "yes", "text_component_present": "no", "text_bio_bridge_present": "no", "primary_exclusion_code": "none", "uncertainty_reason": "paper_type_unclear", "evidence_for_text_component": "none", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "not_assessed", "boundary_case": "thin_abstract_boundary", "decision_rationale": "The abstract reports spatial metabolomics and transcriptomics experiments with no text or language component or generative model, so it does not constitute a text-bio foundational model."}, "round-A_scope_reviewer_paper_type": "unclear", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "no", "round-A_scope_reviewer_text_bio_bridge_present": "no", "round-A_scope_reviewer_primary_exclusion_code": "none", "round-A_scope_reviewer_uncertainty_reason": "paper_type_unclear", "round-A_scope_reviewer_evidence_for_text_component": "none", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "none", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "thin_abstract_boundary", "round-A_scope_reviewer_decision_rationale": "The abstract reports spatial metabolomics and transcriptomics experiments with no text or language component or generative model, so it does not constitute a text-bio foundational model.", "round-A_architecture_reviewer_output": {"paper_type": "unclear", "generative_model_present": "no", "foundation_model_evidence": "no", "primary_exclusion_code": "EC3_not_generative", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "none", "boundary_case": "clear_exclude", "decision_rationale": "The abstract describes an experimental spatial multiomics study of bladder cancer with no mention of generative architecture or foundation-model pretraining."}, "round-A_architecture_reviewer_paper_type": "unclear", "round-A_architecture_reviewer_generative_model_present": "no", "round-A_architecture_reviewer_foundation_model_evidence": "no", "round-A_architecture_reviewer_primary_exclusion_code": "EC3_not_generative", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "none", "round-A_architecture_reviewer_boundary_case": "clear_exclude", "round-A_architecture_reviewer_decision_rationale": "The abstract describes an experimental spatial multiomics study of bladder cancer with no mention of generative architecture or foundation-model pretraining.", "pilot_roundA_scope_gate": "UNCERTAIN", "pilot_roundA_architecture_gate": "UNCERTAIN", "pilot_needs_adjudication": true, "round-B_adjudicator_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "no", "text_bio_bridge_present": "no", "generative_model_present": "no", "foundation_model_evidence": "no", "primary_exclusion_code": "EC2_no_text_component", "uncertainty_reason": "none", "evidence_for_text_component": "none", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "none", "boundary_case": "text_component_boundary", "decision_rationale": "The abstract describes spatial metabolomics and transcriptomics experiments with no mention of natural-language text, prompts, or generative mechanisms, indicating a missing text component and no generative text-bio model."}, "round-B_adjudicator_paper_type": "primary_model_paper", "round-B_adjudicator_bio_modality_present": "yes", "round-B_adjudicator_text_component_present": "no", "round-B_adjudicator_text_bio_bridge_present": "no", "round-B_adjudicator_generative_model_present": "no", "round-B_adjudicator_foundation_model_evidence": "no", "round-B_adjudicator_primary_exclusion_code": "EC2_no_text_component", "round-B_adjudicator_uncertainty_reason": "none", "round-B_adjudicator_evidence_for_text_component": "none", "round-B_adjudicator_evidence_for_text_bio_bridge": "none", "round-B_adjudicator_evidence_for_generative_model": "none", "round-B_adjudicator_boundary_case": "text_component_boundary", "round-B_adjudicator_decision_rationale": "The abstract describes spatial metabolomics and transcriptomics experiments with no mention of natural-language text, prompts, or generative mechanisms, indicating a missing text component and no generative text-bio model."}
./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/nemotron3_super_120b_fp8_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11581/guideline_pilot_raw_completed.csv:146:3519,scgpt: Towards building a foundation model for single-cell multi-omics using generative ai. bioRxiv,scgpt towards building a foundation model for singlecell multiomics using generative ai biorxiv,,,,,"Generative pre-trained models have achieved remarkable success in various domains such as natural language processing and computer vision. Specifically, the combination of large-scale diverse datasets and pre-trained transformers has emerged as a promising approach for developing foundation models. Drawing parallels between linguistic constructs and cellular biology — where texts comprise words, similarly, cells are defined by genes — our study probes the applicability of foundation models to advance cellular biology and genetics research. Utilizing the burgeoning single-cell sequencing data, we have pioneered the construction of a foundation model for single-cell biology, scGPT, which is based on generative pre-trained transformer across a repository of over 33 million cells. Our findings illustrate that scGPT, a generative pre-trained transformer, effectively distills critical biological insights concerning genes and cells. Through the further adaptation of transfer learning, scGPT can be optimized to achieve superior performance across diverse downstream applications. This includes tasks such as cell-type annotation, multi-batch integration, multi-omic integration, genetic perturbation prediction, and gene network inference. The scGPT codebase is publicly available at https://github.com/bowang-lab/scGPT.","['H Cui', 'C Wang', 'H Maan', 'K Pang', 'F Luo', 'B Wang']",,,,,['google_scholar'],1,[],1,s2_title,,,,76,"{""paper_type"": ""primary_model_paper"", ""bio_modality_present"": ""yes"", ""text_component_present"": ""no"", ""text_bio_bridge_present"": ""no"", ""primary_exclusion_code"": ""EC2_no_text_component"", ""uncertainty_reason"": ""none"", ""evidence_for_text_component"": ""none"", ""evidence_for_text_bio_bridge"": ""none"", ""evidence_for_generative_model"": ""not_assessed"", ""boundary_case"": ""text_component_boundary"", ""decision_rationale"": ""The abstract describes scGPT as a generative pre-trained transformer trained on single-cell sequencing data, with no mention of natural language text input, output, or conditioning. Hence the model lacks a substantive text component and text-bio bridge.""}",primary_model_paper,yes,no,no,EC2_no_text_component,none,none,none,not_assessed,text_component_boundary,"The abstract describes scGPT as a generative pre-trained transformer trained on single-cell sequencing data, with no mention of natural language text input, output, or conditioning. Hence the model lacks a substantive text component and text-bio bridge.","{""paper_type"": ""primary_model_paper"", ""generative_model_present"": ""yes"", ""foundation_model_evidence"": ""yes"", ""primary_exclusion_code"": ""none"", ""uncertainty_reason"": ""none"", ""evidence_for_text_component"": ""not_assessed"", ""evidence_for_text_bio_bridge"": ""not_assessed"", ""evidence_for_generative_model"": ""generative pre-trained transformer"", ""boundary_case"": ""clear_include"", ""decision_rationale"": ""The abstract states scGPT is a generative pre-trained transformer trained on over 33 million cells, indicating a generative architecture with foundation-model pretraining.""}",primary_model_paper,yes,yes,none,none,not_assessed,not_assessed,generative pre-trained transformer,clear_include,"The abstract states scGPT is a generative pre-trained transformer trained on over 33 million cells, indicating a generative architecture with foundation-model pretraining.",EXCLUDE,PASS,False,,,,,,,,,,,,,,
