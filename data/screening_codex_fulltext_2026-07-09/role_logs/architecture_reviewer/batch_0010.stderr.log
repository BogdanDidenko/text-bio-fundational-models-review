./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/nemotron3_super_120b_fp8_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11581/guideline_pilot_raw_completed.jsonl:205:{"cluster_id": 3680, "title": "ncProFormer: A CNN-enhanced Transformer for ncRNA Coding-Potential Prediction.", "title_normalized": "ncproformer a cnnenhanced transformer for ncrna codingpotential prediction", "doi": "10.1021/acs.jcim.6c00056", "preprint_doi": NaN, "pmid": 41830618.0, "arxiv_id": NaN, "abstract": "Recent studies have revealed that some noncoding RNAs (ncRNAs) bear translational potential, and their encoded micropeptides have essential functions in multiple biological processes. However, accurate identification of coding-capable ncRNAs remains challenging due to weak translation signals, low conservation, and heterogeneous data distributions. Herein, we propose ncProFormer, a deep learning framework tailored for ncRNA coding-potential prediction. ncProFormer integrates the nucleic-acid language model GENA-LM to obtain contextual sequence embeddings, adopts an all-token representation strategy, and employs a convolutional neural network (CNN)-enhanced transformer encoder to jointly capture local nucleotide patterns and long-range dependencies. ncProFormer consistently outperformed the existing methods across the in-house human data set, the external validation data set, the public CPPred benchmark data set. More importantly, this study presents the first cross-species evaluation in ncRNA coding-potential prediction. Without retraining, ncProFormer maintained its strong predictive performance on mouse and rat data sets, showing that the learned biological representations are transferable and it is robust under the distributional shift and cross-species conditions. Collectively, these findings establish ncProFormer as an effective and generalizable framework for uncovering the coding potential of ncRNAs, thus offering a promising computational tool for characterizing ncRNA functions across diverse transcriptomic contexts.", "authors": "Mengyue Tong; Yuanting Chen; Long Chen; Jing Xu; Yingjie Yang; Guixia Liu; Weihua Li; Yun Tang", "year": 2026.0, "venue": "Journal of Chemical Information and Modeling", "date": "2026-03-14", "url": NaN, "sources": "['semantic_scholar']", "n_sources": 1, "all_dois": "['10.1021/acs.jcim.6c00056']", "duplicate_count": 1, "abstract_source": NaN, "abstract_enriched_from": NaN, "abstract_old_len": NaN, "update_batch": "2026-03-01_to_2026-04-14", "_pilot_row_id": 215, "round-A_scope_reviewer_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "no", "text_bio_bridge_present": "no", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "none", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "not_assessed", "boundary_case": "none", "decision_rationale": "The abstract describes a nucleic‑acid language model for sequence embeddings and a CNN‑enhanced transformer for coding‑potential prediction, with no natural‑language text component or text‑bio bridge."}, "round-A_scope_reviewer_paper_type": "primary_model_paper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "no", "round-A_scope_reviewer_text_bio_bridge_present": "no", "round-A_scope_reviewer_primary_exclusion_code": "none", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "none", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "none", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "none", "round-A_scope_reviewer_decision_rationale": "The abstract describes a nucleic‑acid language model for sequence embeddings and a CNN‑enhanced transformer for coding‑potential prediction, with no natural‑language text component or text‑bio bridge.", "round-A_architecture_reviewer_output": {"paper_type": "primary_model_paper", "generative_model_present": "no", "foundation_model_evidence": "yes", "primary_exclusion_code": "EC3_not_generative", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "none", "boundary_case": "clear_exclude", "decision_rationale": "The abstract describes an encoder-only CNN-enhanced Transformer for ncRNA coding-potential prediction, with no decoder or generative mechanism. Although it uses pretrained GENA-LM embeddings and shows transferable representations, it lacks a generative architecture."}, "round-A_architecture_reviewer_paper_type": "primary_model_paper", "round-A_architecture_reviewer_generative_model_present": "no", "round-A_architecture_reviewer_foundation_model_evidence": "yes", "round-A_architecture_reviewer_primary_exclusion_code": "EC3_not_generative", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "none", "round-A_architecture_reviewer_boundary_case": "clear_exclude", "round-A_architecture_reviewer_decision_rationale": "The abstract describes an encoder-only CNN-enhanced Transformer for ncRNA coding-potential prediction, with no decoder or generative mechanism. Although it uses pretrained GENA-LM embeddings and shows transferable representations, it lacks a generative architecture.", "pilot_roundA_scope_gate": "EXCLUDE", "pilot_roundA_architecture_gate": "EXCLUDE", "pilot_needs_adjudication": false}
./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/nemotron3_super_120b_fp8_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11581/guideline_pilot_raw_completed.jsonl:216:{"cluster_id": 3653, "title": "Decoupling Lineage and Intrinsic Information in Single-Cell Lineage Tracing Data with Deep Disentangled Representation Learning", "title_normalized": "decoupling lineage and intrinsic information in singlecell lineage tracing data with deep disentangled representation learning", "doi": "10.64898/2026.03.10.710716", "preprint_doi": NaN, "pmid": NaN, "arxiv_id": NaN, "abstract": "Abstract\n                Single-cell RNA sequencing combined with lineage tracing technologies provides rich opportunities to study development and tumor evolution, yet existing computational methods struggle to disentangle intrinsic transcriptional states from lineage-driven effects. We introduce DeepTracing, a deep generative framework that integrates disentangled representation learning with lineage-aware Gaussian processes to explicitly separate intrinsic cellular variation from lineage constraints. The model constructs a layered latent space and enforces independence via Total Correlation regularization, producing intrinsic, lineage, and unified embeddings. Across extensive benchmarks, DeepTracing consistently outperforms existing approaches. In TedSim simulations, it achieves superior clustering of cell states and effectively recovers phylogenetic structure, surpassing original expression and scVI. Applied to mouse tumor lineage-tracing data, DeepTracing attains higher ARI/NMI for tumor-type classification than scVI and PORCELAN, accurately separating primary and metastatic tumors and recovering known trajectories such as early lymph-node divergence and liver-to-kidney cross-seeding. In larger datasets, it maintains strong performance while preserving both transcriptomic continuity and lineage fidelity. DeepTracing also reconstructs continuous developmental trajectories in mouse ventral midbrain, isolating temporal effects from intrinsic differentiation. These results establish DeepTracing as a scalable and interpretable framework for analyzing multimodal single-cell data in tumor progression.\n                \n                  Code availability\n                  \n                    The source code is publicly available at\n                    https://github.com/Yuhong-Wen/DeepTracing\n                    .", "authors": "Yuhong Wen; Jiankang Xiong; Fuzhou Gong; Liang Ma; Lin Wan", "year": 2026.0, "venue": "bioRxiv", "date": "2026-03-11", "url": NaN, "sources": "['semantic_scholar']", "n_sources": 1, "all_dois": "['10.64898/2026.03.10.710716']", "duplicate_count": 1, "abstract_source": "crossref", "abstract_enriched_from": NaN, "abstract_old_len": NaN, "update_batch": "2026-03-01_to_2026-04-14", "_pilot_row_id": 190, "round-A_scope_reviewer_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "no", "text_bio_bridge_present": "no", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "none", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "not_assessed", "boundary_case": "clear_exclude", "decision_rationale": "The abstract presents a deep generative model for single-cell RNA-seq and lineage tracing without any natural-language text component or text-bio alignment."}, "round-A_scope_reviewer_paper_type": "primary_model_paper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "no", "round-A_scope_reviewer_text_bio_bridge_present": "no", "round-A_scope_reviewer_primary_exclusion_code": "none", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "none", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "none", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-