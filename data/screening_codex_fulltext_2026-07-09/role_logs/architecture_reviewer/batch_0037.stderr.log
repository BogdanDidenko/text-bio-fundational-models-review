r,unclear,none,generative_status_unclear,not_assessed,not_assessed,leverages pre-trained semantic understanding to generate high-dimensional spatial-aware representations,generative_boundary,"The abstract describes converting graphs to text and using pretrained LLMs to generate representations, but does not specify an explicit decoder, autoregressive, or other generative mechanism.",EXCLUDE,UNCERTAIN,True,"{""paper_type"": ""application_wrapper"", ""bio_modality_present"": ""yes"", ""text_component_present"": ""yes"", ""text_bio_bridge_present"": ""no"", ""generative_model_present"": ""unclear"", ""foundation_model_evidence"": ""yes"", ""primary_exclusion_code"": ""application_wrapper"", ""uncertainty_reason"": ""generative_status_unclear"", ""evidence_for_text_component"": ""transforms intricate spatial graph structures into structured textual representations suitable for large language models (LLMs)"", ""evidence_for_text_bio_bridge"": ""none"", ""evidence_for_generative_model"": ""none"", ""boundary_case"": ""thin_abstract_boundary"", ""decision_rationale"": ""The abstract describes converting spatial graphs into textual descriptions and using frozen LLM embeddings for downstream representation, indicating an application wrapper use of LLMs without explicit text-conditioned generative mechanism.""}",application_wrapper,yes,yes,no,unclear,yes,application_wrapper,generative_status_unclear,transforms intricate spatial graph structures into structured textual representations suitable for large language models (LLMs),none,none,thin_abstract_boundary,"The abstract describes converting spatial graphs into textual descriptions and using frozen LLM embeddings for downstream representation, indicating an application wrapper use of LLMs without explicit text-conditioned generative mechanism.",EXCLUDE|UNCERTAIN,application_wrapper,yes,yes,no,unclear,yes,application_wrapper,generative_status_unclear,transforms intricate spatial graph structures into structured textual representations suitable for large language models (LLMs),none,none,thin_abstract_boundary,"The abstract describes converting spatial graphs into textual descriptions and using frozen LLM embeddings for downstream representation, indicating an application wrapper use of LLMs without explicit text-conditioned generative mechanism.",EXCLUDE,application_wrapper,,EXCLUDE,application_wrapper,generative_status_unclear,False
./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/gpt_oss_120b_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11550/guideline_pilot_raw_completed.jsonl:62:{"cluster_id": 62, "title": "TissueNarrator: Generative Modeling of Spatial Transcriptomics with Large Language Models.", "title_normalized": "tissuenarrator generative modeling of spatial transcriptomics with large language models", "doi": "10.1101/2025.11.24.690325", "preprint_doi": NaN, "pmid": 41394628.0, "arxiv_id": NaN, "abstract": "The intricate spatial organization and molecular communication among cells are fundamental to multicellular systems. Spatial transcriptomics (ST) enables gene expression profiling while preserving spatial context, providing rich data for studying cellular interactions and tissue dynamics. However, most existing computational approaches focus on embedding-based tasks and provide limited generative capacity for simulating cell behavior  in situ . Moreover, accurately interpreting spatial interactions requires extensive biological knowledge, which current models do not incorporate. Here, we introduce T  issue N  arrator , a framework that reformulates spatial omics analysis as a language modeling problem. By representing tissue sections as spatial sentences – rank-based gene lists augmented with spatial coordinates and metadata – T  issue N  arrator leverages pretrained large language models (LLMs) to learn spatially conditioned gene expression patterns. The model generates realistic, context-aware cellular profiles, predicts intercellular interactions, and performs  in silico perturbation analyses. Across multiple ST technologies (MERFISH, Perturb-FISH, and CosMx SMI), T  issue N  arrator achieves superior quantitative performance and recovers biologically meaning-ful ligand–receptor and signaling pathways. Furthermore, a conversational inference mode enables natural-language querying of tissue organization. By integrating pretrained biological knowledge with spatial context, T  issue N  arrator establishes a new, scalable generative paradigm for modeling, simulating, and reasoning about tissue systems.", "authors": "Liu Sizhe; Tang Junjie; Ma Jian; Liang Shaoheng", "year": 2025.0, "venue": "bioRxiv : the preprint server for biology", "date": NaN, "url": NaN, "sources": "['biorxiv_medrxiv', 'google_scholar', 'pubmed', 'semantic_scholar']", "n_sources": 4, "all_dois": "['10.1101/2025.11.24.690325']", "duplicate_count": 4, "abstract_source": NaN, "abstract_enriched_from": NaN, "abstract_old_len": NaN, "update_batch": NaN, "_pilot_row_id": 62, "round-A_scope_reviewer_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "yes", "text_bio_bridge_present": "yes", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "conversational inference mode enables natural-language querying of tissue organization", "evidence_for_text_bio_bridge": "reformulates spatial omics analysis as a language modeling problem", "evidence_for_generative_model": "not_assessed", "boundary_case": "none", "decision_rationale": "The abstract presents TissueNarrator as a new framework that treats spatial transcriptomics as language, uses pretrained LLMs, and provides natural-language querying, satisfying primary model, biological modality, text component, and text‑bio bridge criteria."}, "round-A_scope_reviewer_paper_type": "primary_model_paper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "yes", "round-A_scope_reviewer_text_bio_bridge_present": "yes", "round-A_scope_reviewer_primary_exclusion_code": "none", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "conversational inference mode enables natural-language querying of tissue organization", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "reformulates spatial omics analysis as a language modeling problem", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "none", "round-A_scope_reviewer_decision_rationale": "The abstract presents TissueNarrator as a new framework that treats spatial transcriptomics as language, uses pretrained LLMs, and provides natural-language querying, satisfying primary model, biological modality, text component, and text‑bio bridge criteria.", "round-A_architecture_reviewer_output": {"paper_type": "primary_model_paper", "generative_model_present": "yes", "foundation_model_evidence": "yes", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "model generates realistic, context-aware cellular profiles", "boundary_case": "clear_include", "decision_rationale": "The abstract presents TissueNarrator, a new framework that leverages pretrained LLMs to generate realistic cellular profiles and simulate tissue dynamics, indicating a generative architecture with foundation-model pretraining."}, "round-A_architecture_reviewer_paper_type": "primary_model_paper", "round-A_architecture_reviewer_generative_model_present": "yes", "round-A_architecture_reviewer_foundation_model_evidence": "yes", "round-A_architecture_reviewer_primary_exclusion_code": "none", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "model generates realistic, context-aware cellular profiles", "round-A_architecture_reviewer_boundary_case": "clear_include", "round-A_architecture_reviewer_decision_rationale": "The abstract presents TissueNarrator, a new framework that leverages pretrained LLMs to generate realistic cellular profiles and simulate tissue dynamics, indicating a generative architecture with foundation-model pretraining.", "pilot_roundA_scope_gate": "PASS", "pilot_roundA_architecture_gate": "PASS", "pilot_needs_adjudication": false}
./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/gpt_oss_120b_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11550/guideline_pilot_raw_completed.jsonl:164:{"cluster_id": 143, "title": "Interpretable Transfer Learning for Cancer Drug Resistance: Candidate Target Identification.", "title_normalized": "interpretable transfer learning for cancer drug resistance candidate target identification", "doi": "10.3390/cimb47090753", "preprint_doi": NaN, "pmid": 41020875.0, "arxiv_id": NaN, "abstract": "Tumor drug resistance exhibits substantial heterogeneity across cancer types, reflecting distinct molecular mechanisms in each malignancy. To characterize this complexity, we developed a pan-cancer transfer learning framework that integrates bulk RNA-seq data with a residual variational autoencoder (Res VAE) backbone. Five models were trained on the Genomics of Drug Sensitivity in Cancer (GDSC) dataset, which includes drug response profiles for 72 chemotherapeutic agents. Among them, three models are specially designed by incorporating variational autoencoders and large pretrained models (LLMs): the LLM large VAE (VAE_LL), the LLM small VAE (VAE_LS), and the LLM distillation VAE (VAE_LD). Random Forest (RF) and eXtreme Gradient Boosting (XGB) were included as ensemble learning baselines. After internal cross-validation, the top four models (VAE_LL, VAE_LD, XGB, and RF) were applied to five representative TCGA cohorts comprising 1,836 patients. For each cancer type, resistance to nine clinically relevant first-line drugs was modeled, resulting in 180 drug–cancer prediction tasks. Among all models, VAE_LD achieved the best overall performance, with a mean AUC of 0.81 and an F1 score of 0.92 on the GDSC benchmark, and maintained strong predictive power in the clinical validation phase. Interpretation analyses identified tumor-specific resistance biomarkers with clinical significance. In lung adenocarcinoma, elevated expression of TFF1 was repeatedly associated with resistance to Gefitinib and correlated with poor patient prognosis, indicating its potential as a therapeutic target. In glioblastoma, OPALIN, LTF, IL2RA, and SLC17A7 were implicated in Temozolomide resistance through pathways related to epithelial differentiation and angiogenesis. In conclusion, the VAE_LD model offers a high-performing and interpretable approach for predicting drug resistance across multiple tumor types. It supports the identification of clinically actionable biomarkers and provides a robust framework for precision oncology applications.", "authors": "Zhang Wenjie; Wu Xisong; Chen Liang; Wan Xinyue", "year": 2025.0, "venue": "Current issues in molecular biology", "date": NaN, "url": NaN, "sources": "['pubmed', 'scopus', 'semantic_scholar']", "n_sources": 3, "all_dois": "['10.3390/cimb47090753']", "duplicate_count": 3, "abstract_source": NaN, "abstract_enriched_from": NaN, "abstract_old_len": NaN, "update_batch": NaN, "_pilot_row_id": 143, "round-A_scope_reviewer_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "unclear", "text_bio_bridge_present": "unclear", "primary_exclusion_code": "none", "uncertainty_reason": "text_component_unclear", "evidence_for_text_component": "large pretrained models (LLMs)", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "not_assessed", "boundary_case": "none", "decision_rationale": "The work presents new VAE models (primary model) using bulk RNA‑seq data (bio modality), but the abstract only mentions incorporating LLMs without specifying natural‑language text input or output, leaving the text component and text‑bio bridge unclear."}, "round-A_scope_reviewer_paper_type": "primary_model_paper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "unclear", "round-A_scope_reviewer_text_bio_bridge_present": "unclear", "round-A_scope_reviewer_primary_exclusion_code": "none", "round-A_scope_reviewer_uncertainty_reason": "text_component_unclear", "round-A_scope_reviewer_evidence_for_text_component": "large pretrained models (LLMs)", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "none", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "none", "round-A_scope_reviewer_decision_rationale": "The work presents new VAE models (primary model) using bulk RNA‑seq data (bio modality), but the abstract only mentions incorporating LLMs without specifying natural‑language text input or output, leaving the text component and text‑bio bridge unclear.", "round-A_architecture_reviewer_output": {"paper_type": "primary_model_paper", "generative_model_present": "yes", "foundation_model_evidence": "yes", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "variational autoencoder (Res VAE) backbone", "boundary_case": "none", "decision_rationale": "The abstract introduces VAE-based models (a generative architecture) and explicitly incorporates large pretrained LLMs, fitting the criteria for a primary generative text‑bio foundational model."}, "round-A_architecture_reviewer_paper_type": "primary_model_paper", "round-A_architecture_reviewer_generative_model_present": "yes", "round-A_architecture_reviewer_foundation_model_evidence": "yes", "round-A_architecture_reviewer_primary_exclusion_code": "none", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "variational autoencoder (Res VAE) backbone", "round-A_architecture_reviewer_boundary_case": "none", "round-A_architecture_reviewer_decision_rationale": "The abstract introduces VAE-based models (a generative architecture) and explicitly incorporates large pretrained LLMs, fitting the criteria for a primary generative text‑bio foundational model.", "pilot_roundA_scope_gate": "UNCERTAIN", "pilot_roundA_architecture_gate": "PASS", "pilot_needs_adjudication": true, "round-B_adjudicator_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "no", "text_bio_bridge_present": "no", "generative_model_present": "yes", "foundation_model_evidence": "yes", "primary_exclusion_code": "EC2_no_text_component", "uncertainty_reason": "none", "evidence_for_text_component": "none", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "variational autoencoder (Res VAE) backbone", "boundary_case": "clear_exclude", "decision_rationale": "The abstract presents a VAE‑based model for drug‑resistance prediction using RNA‑seq data and mentions large pretrained LLMs, but it contains no natural‑language text input, output, or alignment, so there is no text‑bio bridge; therefore the paper is excluded under EC2_no_text_component."}, "round-B_adjudicator_paper_type": "primary_model_paper", "round-B_adjudicator_bio_modality_present": "yes", "round-B_adjudicator_text_component_present": "no", "round-B_adjudicator_text_bio_bridge_present": "no", "round-B_adjudicator_generative_model_present": "yes", "round-B_adjudicator_foundation_model_evidence": "yes", "round-B_adjudicator_primary_exclusion_code": "EC2_no_text_component", "round-B_adjudicator_uncertainty_reason": "none", "round-B_adjudicator_evidence_for_text_component": "none", "round-B_adjudicator_evidence_for_text_bio_bridge": "none", "round-B_adjudicator_evidence_for_generative_model": "variational autoencoder (Res VAE) backbone", "round-B_adjudicator_boundary_case": "clear_exclude", "round-B_adjudicator_decision_rationale": "The abstract presents a VAE‑based model for drug‑resistance prediction using RNA‑seq data and mentions large pretrained LLMs, but it