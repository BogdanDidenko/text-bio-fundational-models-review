./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/gpt_oss_120b_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11550/guideline_pilot_raw_completed.jsonl:694:{"cluster_id": 719, "title": "Improving polygenic prediction from whole-genome sequencing data by leveraging predicted epigenomic features", "title_normalized": "improving polygenic prediction from wholegenome sequencing data by leveraging predicted epigenomic features", "doi": "10.1073/pnas.2419202122", "preprint_doi": NaN, "pmid": NaN, "arxiv_id": NaN, "abstract": "Significance Epi-PRS improves polygenic risk scoring by integrating genomic large language models (LLMs) to impute epigenomic signals as intermediaries between genotype and phenotype. This approach enables a more comprehensive assessment of personal variant impacts by incorporating nonlinear models, rare variants, and regulatory mechanisms. By leveraging the power of genomic LLM trained on massive amount of reference epigenomics data, Epi-PRS has demonstrated superior performance over existing PRS methods in predicting genetic risk for breast cancer and diabetes in UK Biobank data. These results highlight the potential of Epi-PRS to improve disease risk modeling and advance the field of precision medicine.", "authors": "Zeng W.", "year": 2025.0, "venue": "Proceedings of the National Academy of Sciences of the United States of America", "date": "2025-06-17", "url": NaN, "sources": "['scopus']", "n_sources": 1, "all_dois": "['10.1073/pnas.2419202122']", "duplicate_count": 1, "abstract_source": "s2_doi", "abstract_enriched_from": NaN, "abstract_old_len": NaN, "update_batch": NaN, "_pilot_row_id": 697, "round-A_scope_reviewer_output": {"paper_type": "application_wrapper", "bio_modality_present": "yes", "text_component_present": "no", "text_bio_bridge_present": "no", "primary_exclusion_code": "application_wrapper", "uncertainty_reason": "none", "evidence_for_text_component": "none", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "not_assessed", "boundary_case": "none", "decision_rationale": "The abstract presents a polygenic risk scoring method that leverages a genomic LLM to impute epigenomic signals, with no mention of natural‑language text or a text‑bio mapping; thus it functions as an application wrapper rather than a primary text‑bio generative model."}, "round-A_scope_reviewer_paper_type": "application_wrapper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "no", "round-A_scope_reviewer_text_bio_bridge_present": "no", "round-A_scope_reviewer_primary_exclusion_code": "application_wrapper", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "none", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "none", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "none", "round-A_scope_reviewer_decision_rationale": "The abstract presents a polygenic risk scoring method that leverages a genomic LLM to impute epigenomic signals, with no mention of natural‑language text or a text‑bio mapping; thus it functions as an application wrapper rather than a primary text‑bio generative model.", "round-A_architecture_reviewer_output": {"paper_type": "application_wrapper", "generative_model_present": "no", "foundation_model_evidence": "yes", "primary_exclusion_code": "application_wrapper", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "none", "boundary_case": "wrapper_boundary", "decision_rationale": "The abstract describes Epi-PRS that uses a pretrained genomic LLM to impute epigenomic signals for polygenic risk scoring, without presenting a new generative architecture; thus it is an application wrapper rather than a primary generative model."}, "round-A_architecture_reviewer_paper_type": "application_wrapper", "round-A_architecture_reviewer_generative_model_present": "no", "round-A_architecture_reviewer_foundation_model_evidence": "yes", "round-A_architecture_reviewer_primary_exclusion_code": "application_wrapper", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "none", "round-A_architecture_reviewer_boundary_case": "wrapper_boundary", "round-A_architecture_reviewer_decision_rationale": "The abstract describes Epi-PRS that uses a pretrained genomic LLM to impute epigenomic signals for polygenic risk scoring, without presenting a new generative architecture; thus it is an application wrapper rather than a primary generative model.", "pilot_roundA_scope_gate": "EXCLUDE", "pilot_roundA_architecture_gate": "EXCLUDE", "pilot_needs_adjudication": false}
./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/gpt_oss_120b_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11550/guideline_pilot_raw_completed.jsonl:900:{"cluster_id": 952, "title": "A BERT-GNN Approach for Metastatic Breast Cancer Prediction Using Histopathology Reports", "title_normalized": "a bertgnn approach for metastatic breast cancer prediction using histopathology reports", "doi": "10.3390/diagnostics14131365", "preprint_doi": NaN, "pmid": NaN, "arxiv_id": NaN, "abstract": "Metastatic breast cancer (MBC) continues to be a leading cause of cancer-related deaths among women. This work introduces an innovative non-invasive breast cancer classification model designed to improve the identification of cancer metastases. While this study marks the initial exploration into predicting MBC, additional investigations are essential to validate the occurrence of MBC. Our approach combines the strengths of large language models (LLMs), specifically the bidirectional encoder representations from transformers (BERT) model, with the powerful capabilities of graph neural networks (GNNs) to predict MBC patients based on their histopathology reports. This paper introduces a BERT-GNN approach for metastatic breast cancer prediction (BG-MBC) that integrates graph information derived from the BERT model. In this model, nodes are constructed from patient medical records, while BERT embeddings are employed to vectorise representations of the words in histopathology reports, thereby capturing semantic information crucial for classification by employing three distinct approaches (namely univariate selection, extra trees classifier for feature importance, and Shapley values to identify the features that have the most significant impact). Identifying the most crucial 30 features out of 676 generated as embeddings during model training, our model further enhances its predictive capabilities. The BG-MBC model achieves outstanding accuracy, with a detection rate of 0.98 and an area under curve (AUC) of 0.98, in identifying MBC patients. This remarkable performance is credited to the model’s utilisation of attention scores generated by the LLM from histopathology reports, effectively capturing pertinent features for classification.", "authors": "Basaad  A.", "year": 2024.0, "venue": "Diagnostics", "date": "2024-07-01", "url": NaN, "sources": "['scopus']", "n_sources": 1, "all_dois": "['10.3390/diagnostics14131365']", "duplicate_count": 1, "abstract_source": "s2_doi", "abstract_enriched_from": NaN, "abstract_old_len": NaN, "update_batch": NaN, "_pilot_row_id": 880, "round-A_scope_reviewer_output": {"paper_type": "application_wrapper", "bio_modality_present": "no", "text_component_present": "yes", "text_bio_bridge_present": "yes", "primary_exclusion_code": "application_wrapper", "uncertainty_reason": "none", "evidence_for_text_component": "BERT embeddings are employed to vectorise representations of the words in histopathology reports", "evidence_for_text_bio_bridge": "predict MBC patients based on their histopathology reports", "evidence_for_generative_model": "not_assessed", "boundary_case": "none", "decision_rationale": "The work introduces a BERT‑GNN classifier that uses BERT embeddings of histopathology report text as features for a downstream graph neural network, i.e., it wraps an existing LLM rather than presenting a novel generative text‑bio foundational model."}, "round-A_scope_reviewer_paper_type": "application_wrapper", "round-A_scope_reviewer_bio_modality_present": "no", "round-A_scope_reviewer_text_component_present": "yes", "round-A_scope_reviewer_text_bio_bridge_present": "yes", "round-A_scope_reviewer_primary_exclusion_code": "application_wrapper", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "BERT embeddings are employed to vectorise representations of the words in histopathology reports", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "predict MBC patients based on their histopathology reports", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "none", "round-A_scope_reviewer_decision_rationale": "The work introduces a BERT‑GNN classifier that uses BERT embeddings of histopathology report text as features for a downstream graph neural network, i.e., it wraps an existing LLM rather than presenting a novel generative text‑bio foundational model.", "round-A_architecture_reviewer_output": {"paper_type": "primary_model_paper", "generative_model_present": "no", "foundation_model_evidence": "yes", "primary_exclusion_code": "EC3_not_generative", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "none", "boundary_case": "clear_exclude", "decision_rationale": "The abstract proposes a BERT‑GNN classification model for metastatic breast cancer prediction and does not mention any generative mechanism (e.g., decoder, autoregressive generation). It uses BERT embeddings, indicating use of a pretrained LLM, but the work is purely predictive."}, "round-A_architecture_reviewer_paper_type": "primary_model_paper", "round-A_architecture_reviewer_generative_model_present": "no", "round-A_architecture_reviewer_foundation_model_evidence": "yes", "round-A_architecture_reviewer_primary_exclusion_code": "EC3_not_generative", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "none", "round-A_architecture_reviewer_boundary_case": "clear_exclude", "round-A_architecture_reviewer_decision_rationale": "The abstract proposes a BERT‑GNN classification model for metastatic breast cancer prediction and does not mention any generative mechanism (e.g., decoder, autoregressive generation). It uses BERT embeddings, indicating use of a pretrained LLM, but the work is purely predictive.", "pilot_roundA_scope_gate": "EXCLUDE", "pilot_roundA_architecture_gate": "EXCLUDE", "pilot_needs_adjudication": true, "round-B_adjudicator_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "yes", "text_bio_bridge_present": "yes", "generative_model_present": "no", "foundation_model_evidence": "yes", "primary_exclusion_code": "EC3_not_generative", "uncertainty_reason": "none", "evidence_for_text_component": "BERT embeddings are employed to vectorise representations of the words in histopathology reports", "evidence_for_text_bio_bridge": "nodes are constructed from patient medical records, while BERT embeddings ... capture semantic information ... for classification", "evidence_for_generative_model": "none", "boundary_case": "clear_exclude", "decision_rationale": "The abstract describes a BERT‑GNN classification model using text embeddings and patient record graphs, with no indication of generative capabilities; therefore it is excluded under EC3_not_generative."}, "round-B_adjudicator_paper_type": "primary_model_paper", "round-B_adjudicator_bio_modality_present": "yes", "round-B_adjudicator_text_component_present": "yes", "round-B_adjudicator_text_bio_bridge_present": "yes", "round-B_adjudicator_generative_model_present": "no", "round-B_adjudicator_foundation_model_evidence": "yes", "round-B_adjudicator_primary_exclusion_code": "EC3_not_generative", "round-B_adjudicator_uncertainty_reason": "none", "round-B_adjudicator_evidence_for_text_component": "BERT embeddings are employed to vectorise representations of the words in histopathology reports", "round-B_adjudicator_evidence_for_text_bio_bridge": "nodes are constructed from patient medical records, while BERT embeddings ... capture semantic information ... for classification", "round-B_adjudicator_evidence_for_generative_model": "none", "round-B_adjudicator_boundary_case": "clear_exclude", "round-B_adjudicator_decision_rationale": "The abstract describes a BERT‑GNN classification model using text embeddings and patient record graphs, with no indication of generative capabilities; therefore it is excluded under EC3_not_generative."}
./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/gpt_oss_120b_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11550/guideline_pilot_raw_completed.jsonl:1122:{"cluster_id": 1236, "title": "Language may be all omics needs: Harmonizing multimodal data for omics understanding with CellHermes", "title_normalized": "language may be all omics needs harmonizing multimodal data for omics understanding with cellhermes", "doi": "10.1101/2025.11.07.687322", "preprint_doi": NaN, "pmid": NaN, "arxiv_id": NaN, "abstract": "Decoding cellular systems requires integrating diverse omics data, yet most models are trained from scratch on a single modality, restricting generalization. Here we present CellHermes, a biological language model that leverages pretrained large language models (LLMs) to integrate multimodal forms of omics data, such as transcriptomic profile and PPI network, through natural language for better omics understanding. By reformulating these datasets into question-answer pairs, CellHermes emulates multiple self-supervised learning paradigms within a single, universal, language-based framework with LORA fine-tuning on existing natural language-LLM, achieving comparable or even better performance compared to current single-cell foundation models. Within this framework, CellHermes functions as an encoder, a predictor and an explainer for supporting a range of downstream tasks. For encoder, CellHermes encodes biological entities with embeddings that enable accurate network discovery and cross-dataset generalization; For predictor, CellHermes unifies heterogeneous downstream tasks by translating them into natural language question-answers pairs, allowing a single model to perform multi-task prediction by instruction fine-tuning; For explainer, CellHermes explains molecular mechanisms by combining attention analysis with text-based reasoning, leveraging the interpretability and reasoning capabilities of LLMs. We evaluated the ability of CellHermes as an  encoder on representing genes and cells using 5 gene-level downstream tasks and 5 diverse single-cell datasets across different tissues compared with other single cell foundation models. We also evaluated CellHermes as a  predictor on BioUniBench, a new benchmark of 10 tasks across 7 databases for LLMs, including perturbation response, cell fitness estimation, gene-disease association, and cell type identification. All benchmarks suggest CellHermes can unify multiple biological tasks within one model without compromising performance. By applying CellHermes as an  explainer for a melanoma patients dataset, it can uncover potential key genes on tumor-reactive T cells. Together, CellHermes establishes natural language as a unifying medium for omics, offering a foundation that, in the future, potentially enables a more integrated and interpretable research loop of biological representation, prediction, and interpretability.", "authors": "Yicheng Gao; Weixu Wang; Yuheng Zhao; Kejing Dong; Caihua Shan; Weizhong Zheng; Till Richter; Zekai Li; Siming Chen; Fabian J. Theis; Qi Liu", "year": 2025.0, "venue": "bioRxiv", "date": "2025-11-28", "url": NaN, "sources": "['biorxiv_medrxiv', 'google_scholar', 'semantic_scholar']", "n_sources": 3, "all_dois": "['10.1101/2025.11.07.687322']", "duplicate_count": 3, "abstract_source": NaN, "abstract_enriched_from": NaN, "abstract_old_len": NaN, "update_batch": NaN, "_pilot_row_id": 1125, "round-A_scope_reviewer_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "yes", "text_bio_bridge_present": "yes", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "reformulating these datasets into question‑answer pairs", "evidence_for_text_bio_bridge": "translating them into natural language question‑answers pairs", "evidence_for_generative_model": "not_assessed", "boundary_case": "none", "decision_rationale": "The abstract presents CellHermes as a new model that uses pretrained LLMs and natural‑language QA reformulation to integrate omics data, indicating a substantive text component and a clear text‑bio bridge."}, "round-A_scope_reviewer_paper_type": "primary_model_paper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "yes", "round-A_scope_reviewer_text_bio_bridge_present": "yes", "round-A_scope_reviewer_primary_exclusion_code": "none", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "reformulating these datasets into question‑answer pairs", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "translating them into natural language question‑answers pairs", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "none", "round-A_scope_reviewer_decision_rationale": "The abstract presents CellHermes as a new model that uses pretrained LLMs and natural‑language QA reformulation to integrate omics data, indicating a substantive text component and a clear text‑bio bridge.", "round-A_architecture_reviewer_output": {"paper_type": "primary_model_paper", "generative_model_present": "no", "foundation_model_evidence": "yes", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "none", "boundary_case": "none", "decision_rationale": "The abstract presents CellHermes as a new model built on pretrained LLMs for encoding, prediction, and explanation, without mentioning any decoder or generative mechanism; it clearly leverages a pretrained LLM, providing foundation‑model evidence."}, "round-A_architecture_reviewer_paper_type": "primary_model_paper", "round-A_architecture_reviewer_generative_model_present": "no", "round-A_architecture_reviewer_foundation_model_evidence": "yes", "round-A_architecture_reviewer_primary_exclusion_code": "none", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "none", "round-A_architecture_reviewer_boundary_case": "none", "round-A_architecture_reviewer_decision_rationale": "The abstract presents CellHermes as a new model built on pretrained LLMs for encoding, prediction, and explanation, without mentioning any decoder or generative mechanism; it clearly leverages a pretrained LLM, providing foundation‑model evidence.", "pilot_roundA_scope_gate": "PASS", "pilot_roundA_architecture_gate": "EXCLUDE", "pilot_needs_adjudication": false}
./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/gpt_oss_120b_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11550/guideline_pilot_raw_completed.jsonl:1281:{"cluster_id": 1403, "title": "Leveraging genomic large language models to enhance causal genotype-brain-clinical pathways in Alzheimer's disease", "title_normalized": "leveraging genomic large language models to enhance causal genotypebrainclinical pathways in alzheimers disease", "doi": "10.1101/2024.10.03.24314824", "preprint_doi": NaN, "pmid": NaN, "arxiv_id": NaN, "abstract": "Abstract\n                Genome-wide association studies (GWAS) have identified numerous Alzheimer’s disease (AD)- associated variants. However, how these variants contribute to the etiology of AD remains largely elusive. Recent advances in genomic large language models (LLMs) offer new opportunities to interpret the genetic variation observed in personal genome. In this study, we propose epiBrainLLM, a novel computational framework that leverages genomic LLM to enhance our understanding of the causal pathways from genotypes to brain measures to AD-related clinical phenotypes. epiBrainLLM will first convert the personal DNA sequence into a diverse set of genomic and epigenomic features using a pretrained genomic LLM and then use these features to further predict phenotypes. Across various experimental settings, epiBrainLLM significantly improves causal analysis compared to traditional genotype association approach. We conclude that epiBrainLLM provides a novel perspective for understanding the regulatory mechanisms underlying the AD disease etiology, potentially offering insights into complex disease mechanisms beyond AD.", "authors": "Q. Liu; W. Zeng; H. Zhu; L. Li; W. Wong", "year": 2024.0, "venue": "medRxiv", "date": "2024-10-04", "url": NaN, "sources": "['semantic_scholar']", "n_sources": 1, "all_dois": "['10.1101/2024.10.03.24314824']", "duplicate_count": 1, "abstract_source": "crossref", "ab