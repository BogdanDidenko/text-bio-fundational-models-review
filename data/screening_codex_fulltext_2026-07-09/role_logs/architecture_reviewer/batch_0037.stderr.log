./data/screening_codex_full_2026-07-06/role_logs/adjudicator/batch_0059.stderr.log:735:./data/screening_codex_full_2026-07-06/role_logs/architecture_reviewer/batch_0314.stderr.log:801:./data/screening_codex_full_2026-07-06/role_logs/scope_reviewer/batch_0141.stdout.log:1:{"results":[{"record_id":"rec_001121","paper_type":"benchmark_resource","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","primary_exclusion_code":"benchmark_resource","uncertainty_reason":"none","decision_rationale":"The abstract centers on creating the MSK-CHORD dataset and infrastructure, not introducing a new candidate foundation model. NLP is used to annotate free-text clinical reports for a resource buildout.","evidence_snippet":"\"Systematic generation of a clinicogenomic harmonized oncologic real-world dataset (MSK-CHORD)\"; \"NLP could automatically annotate\"; \"create a Clinicogenomic, Harmonized Oncologic Real-world Dataset\""},{"record_id":"rec_001122","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"This is a self-supervised model on neuronal population recordings with transcriptomic labels used downstream. The abstract does not describe a substantive text/language component in the candidate model.","evidence_snippet":"\"self-supervised learning based method\"; \"population recordings\"; \"molecular (transcriptomic) labels for downstream supervised tasks\""},{"record_id":"rec_001123","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","primary_exclusion_code":"none","uncertainty_reason":"none","decision_rationale":"The abstract presents a gene-based language model and a Transformer trained to produce genome representations. It explicitly frames gene content as language and uses that bridge for model learning.","evidence_snippet":"\"gene-based language model\"; \"Transformer model\"; \"generates whole-genome vector representations\""},{"record_id":"rec_001124","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","primary_exclusion_code":"none","uncertainty_reason":"none","decision_rationale":"This is a multimodal foundation model using pathology images, clinical reports, and genomics. The clinical reports provide a clear text component within the model itself.","evidence_snippet":"\"integrates pathology images, clinical reports, and genomics data\"; \"multimodal foundation model\""},{"record_id":"rec_001125","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"The model operates on cancer multi-omics data for survival analysis and does not describe a text or language component. The bridge is between Transformer/VAE modules and omics, not text-bio.","evidence_snippet":"\"robust cancer multi-omics survival analysis\"; \"predict patients’ survival risk using cancer multi-omics data\""},{"record_id":"rec_001126","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","primary_exclusion_code":"none","uncertainty_reason":"none","decision_rationale":"CellHermes explicitly reformulates omics data into question-answer pairs and uses pretrained LLMs. The abstract supports a substantive text-bio bridge as part of the model.","evidence_snippet":"\"integrate multimodal forms of omics data ... through natural language\"; \"question-answer pairs\"; \"pretrained large language models\""},{"record_id":"rec_001127","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"The abstract describes a deep learning framework over drug response, genetics, expression, and CRISPR screens. It does not present a substantive text or language component.","evidence_snippet":"\"learns molecular mechanisms of drug sensitivity and resistance\"; \"integrating genetics, gene expression, and CRISPR screens\""},{"record_id":"rec_001128","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","primary_exclusion_code":"none","uncertainty_reason":"none","decision_rationale":"This is a gene expression language model trained self-supervised on single-cell RNA profiles. The language-model framing and gene-context learning support a text-style modeling component tied to biology.","evidence_snippet":"\"single-cell gene expression language model\"; \"trained across a diversity of cell types\"; \"learn context dependencies between genes\""}]}
./data/screening_codex_full_2026-07-06/role_logs/adjudicator/batch_0061.prompt.txt:52:[{"record_id":"rec_001279","title":"A multimodal cross-attention pathotranscriptome integration for enhanced survival prediction of oral squamous cell carcinoma","abstract":"Abstract\n                \n                  Oral squamous cell carcinoma (OSCC) accounts for a major part of cancer mortality, with survival outcomes highly dependent on early diagnosis. While many approaches have been proposed for OSCC survival prediction, they often rely on unimodal data, which may be suboptimal. In this study, we introduced a unified cross-attention-based deep learning framework that integrates whole-slide histopathology images (WSIs) and transcriptomic data from OSCC patients for survival prediction. The framework employed an autoencoder for transcriptomic feature extraction and a state-of-the-art pathology foundation model—evaluated across five alternatives—to derive WSI embeddings. These embeddings were subsequently integrated using cross-attention and concatenation within a Cox proportional hazards model. The multimodal approach outperformed nearly all unimodal counterparts, achieving a maximum concordance index of 0.780±0.059 with cross-attention and 0.766±0.050 with concatenation. The results indicate that pathotranscriptomic integration could improve survival prediction for OSCC patients. The implementation is available on GitHub at:\n                  https://github.com/kountaydwivedi/multimodal fusion.git\n                  .\n                \n                \n                  This work has been submitted to the IEEE for possible publication. Copyright may be transferred without notice, after which this version may no longer be accessible\n                  .","doi":"10.1101/2025.10.31.25339218","year":"2025","venue":"medRxiv","sources":["semantic_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_001279","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"Primary multimodal survival prediction model using histopathology images and transcriptomic data. The abstract does not describe a text/language model or text-bio bridge.","evidence_snippet":"\"integrates whole-slide histopathology images (WSIs) and transcriptomic data\"; \"cross-attention-based deep learning framework\""},"architecture_reviewer":{"record_id":"rec_001279","paper_type":"application_wrapper","generative_model_present":"no","foundation_model_evidence":"no","primary_exclusion_code":"application_wrapper","uncertainty_reason":"none","decision_rationale":"This is a survival-prediction integration framework that uses a pathology foundation model to generate WSI embeddings. The candidate model itself is a downstream wrapper, not a generative foundation model.","evidence_snippet":"“a state-of-the-art pathology foundation model … to derive WSI embeddings” and “integrated using cross-attention”"},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"EC2_no_text_component","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","generative_model_present":"no","foundation_model_evidence":"no"}}},{"record_id":"rec_001282","title":"Potential of deep representative learning features to interpret the sequence information in proteomics","abstract":"In molecular biology and proteomics, accurately predicting functions of proteins is a very critical step. However, it sinks a lot of time and resources to detect the protein functions through biological experiments. Therefore, it is necessary to develop an accurate and reliable computational method for this prediction purpose. Since a growing number of deep learning and natural language processing (NLP) models have been developed recently, they hold potential to assist in protein function problems. Therefore, Wang et al. applied them to extract the hidden features of protein sequences and improve the performance of protein function prediction. As a case study, they used their approach to develop a web-server namely prPred-DRLF to predict plant resistance proteins, which play important roles in the detection of pathogen invasion. Cross-validation and independent test results indicate that prPred-DRLF outperformed current state-of-the-art prediction methods on the same datasets. The excellent performance then shows that deep representative learning (using deep learning and NLP) is an accurate and reliable method for protein function prediction. This article is protected by copyright. All rights reserved.","doi":"10.1002/pmic.202100232","year":"2021","venue":"Proteomics","sources":["semantic_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_001282","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"unclear","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"The abstract is a commentary on prior work, not a primary model paper. It discusses deep learning and NLP models for protein sequence interpretation rather than presenting a new candidate model.","evidence_snippet":"“Potential of deep representative learning features”; “Wang et al. applied them” and “deep learning and natural language processing (NLP) models”"},"architecture_reviewer":{"record_id":"rec_001282","paper_type":"review_editorial","generative_model_present":"no","foundation_model_evidence":"no","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"The abstract is a commentary/review of prior work on protein function prediction rather than a new model description. It does not describe a generative architecture or foundation-model-style pretraining in the candidate work.","evidence_snippet":"“Potential of deep representative learning features...” and “Wang et al. applied them”"},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"review_editorial","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"unclear","generative_model_present":"no","foundation_model_evidence":"no"}}},{"record_id":"rec_001285","title":"Leveraging genomic large language models to enhance causal genotype-brain-clinical pathways in Alzheimer's disease","abstract":"Abstract\n                Genome-wide association studies (GWAS) have identified numerous Alzheimer’s disease (AD)- associated variants. However, how these variants contribute to the etiology of AD remains largely elusive. Recent advances in genomic large language models (LLMs) offer new opportunities to interpret the genetic variation observed in personal genome. In this study, we propose epiBrainLLM, a novel computational framework that leverages genomic LLM to enhance our understanding of the causal pathways from genotypes to brain measures to AD-related clinical phenotypes. epiBrainLLM will first convert the personal DNA sequence into a diverse set of genomic and epigenomic features using a pretrained genomic LLM and then use these features to further predict phenotypes. Across various experimental settings, epiBrainLLM significantly improves causal analysis compared to traditional genotype association approach. We conclude that epiBrainLLM provides a novel perspective for understanding the regulatory mechanisms underlying the AD disease etiology, potentially offering insights into complex disease mechanisms beyond AD.","doi":"10.1101/2024.10.03.24314824","year":"2024","venue":"medRxiv","sources":["semantic_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_001285","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","primary_exclusion_code":"none","uncertainty_reason":"none","decision_rationale":"The abstract describes a genomic large language model used to convert DNA sequence into features for downstream phenotype prediction. That supports both a text-like sequence component and a substantive text-bio bridge.","evidence_snippet":"“leverages genomic LLM” and “convert the personal DNA sequence into a diverse set of genomic and epigenomic features”"},"architecture_reviewer":{"record_id":"rec_001285","paper_type":"application_wrapper","generative_model_present":"no","foundation_model_evidence":"yes","primary_exclusion_code":"application_wrapper","uncertainty_reason":"none","decision_rationale":"The framework uses a pretrained genomic LLM to extract features and then predicts phenotypes, which makes it an application wrapper rather than a newly described generative model. The abstract does provide foundation-model evidence via the pretrained genomic LLM and transferred features.","evidence_snippet":"“using a pretrained genomic LLM” and “convert the personal DNA sequence into a diverse set of genomic and epigenomic features”"},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"application_wrapper","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","generative_model_present":"no","foundation_model_evidence":"yes"}}},{"record_id":"rec_001295","title":"Abstract A031: Unsupervised graph-based visualization of variational autoencoder latent spaces reveals hidden multiple myeloma subtypes","abstract":"Latent space representations learned through variational autoencoders (VAEs) offer a powerful, unsupervised means of capturing nonlinear structure in high-dimensional oncology data. The latent embedding spaces often encode information that differs from traditional bioinformatics methods such as t-SNE or UMAP. However, a persistent challenge remains: how to meaningfully visualize and interpret these latent variables. Common dimensionality reduction techniques like UMAP and t-SNE, while effective, can obscure graph-theoretic relationships that may underlie important biological patterns. We present a novel approach for intuitive latent space interpretation using NetFlow, a method that visualizes the organizational structure of samples as a graph derived from their latent embeddings. NetFlow constructs a topological representation based on the metric structure of the latent space, drawing on concepts from network analysis, optimal mass transport, topological data analysis, and lineage tracing. The result is an interpretable graph in which nodes represent individual subjects and edges reflect local and global similarity among the samples. We applied this method to multiple myeloma (MM), a hematologic malignancy marked by malignant plasma cell proliferation and inevitable relapse. To uncover hidden disease subtypes, we trained a VAE on multimodal data from 659 patients in the MMRF CoMMpass dataset (IA19), integrating transcriptomic, genomic, and clinical features. Direct clustering of latent space vectors failed to yield subgroups with significant differences in progression-free survival (PFS). In contrast, NetFlow generated a latent space graph that, when clustered using Louvain community detection, identified three distinct subtypes: one high-risk and two low-risk groups. The high-risk group exhibited a median PFS of 1.5 years shorter than the low-risk groups (p<0.001) and was enriched for known poor prognostic markers including gain 1q21 (59%), MAF translocations (17%), and t(4;14) (66%). Although the two low-risk groups had similar PFS outcomes, they differed in their molecular profiles, suggesting they may benefit from different therapeutic strategies. These preliminary results demonstrate that variational autoencoders and NetFlow graph analysis can reveal latent substructures missed by traditional clustering, thereby advancing latent space explainability and enabling improved subtype discovery in MM. Our framework offers a generalizable pipeline for interpreting deep generative models in cancer genomics.\n \n \n \n Anish K. Simhal, Rena Elkin, Ross S. Firestone, Jung Hun Oh, Joseph O. Deasy. Unsupervised graph-based visualization of variational autoencoder latent spaces reveals hidden multiple myeloma subtypes [abstract]. In: Proceedings of the AACR Special Conference in Cancer Research: Artificial Intelligence and Machine Learning; 2025 Jul 10-12; Montreal, QC, Canada. Philadelphia (PA): AACR; Clin Cancer Res 2025;31(13_Suppl):Abstract nr A031.","doi":"10.1158/1557-3265.aimachine-a031","year":"2025","venue":"Clinical Cancer Research","sources":["semantic_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_001295","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"This is a VAE-based analysis and visualization method for multimodal oncology data. The abstract does not describe a text/language component or text-bio bridge.","evidence_snippet":"\"trained a VAE on multimodal data ... transcriptomic, genomic, and clinical features\""},"architecture_reviewer":{"record_id":"rec_001295","paper_type":"application_wrapper","generative_model_present":"yes","foundation_model_evidence":"no","primary_exclusion_code":"application_wrapper","uncertainty_reason":"none","decision_rationale":"The work applies a variational autoencoder and then adds NetFlow for graph-based visualization of latent spaces. That is a wrapper/interpretation pipeline around an existing generative model, not evidence of a foundation model.","evidence_snippet":"\"variational autoencoders (VAEs)\"; \"visualize and interpret\"; \"framework for interpreting deep generative models\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"EC2_no_text_component","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","generative_model_present":"yes","foundation_model_evidence":"no"}}},{"record_id":"rec_001297","title":"The Role of Artificial Intelligence in Treatment and Diagnosis in Healthcare","abstract":"Technology, specifically artificial intelligence (AI) is gradually but progressively creeping into the health sector and it’s perhaps the one that has been revolutionised most in diagnosis and treatment. This review brings out discussions on the practices of AI technologies in medical, the pros and the cons. First of all, an endeavour is made to elucidate the meaning of the term AI and its utilization in the field of healthcare. The specific AI techniques are described comprehensively focusing on the machine learning, deep learning, and natural language processing methods to be used in the project The role of multiple types of data in AI includes the EHR, medical images, and genomics data. Self-diagnosis: AI is improving the diagnosis approaches in the radiology and pathology fields and predicting the early-stage disease with better results in most of the cases, and enhancing the identification of genetic diseases. As for treatment, the enhancement of the use of AI has had an impact on issues such as; Prescribing and recommending drugs according to the characteristics of the patients, smart drug administration and management, robotic surgeries and simulations. Discussions are made using concrete and successful implementation of AI in cancer, cardiovascular, neurological and infectious diseases for the purpose of elucidating particular results. This also has to do with the ethical and legal problems like who has the liability to determine in the instance of complicated problems, patients’ information discretion, data privacy, and other legalities. In this article, we briefly mention the prosaic matters of AI, which deals with the engineering aspects of establishing AI such as the aspect of data and the ways and means of checking them and the interdisciplinary character of it. Concerning future developments, additional technologies like AI and connected devices in the field of health care, interdisciplinary at national and international level as well as data sharing is emphasized. Thus. AI has a very great perspective in healthcare, particularly in diagnostics and treatment of diseases due to the probability of increasing the level of accuracy, efficacy, and personalization. Despite these, they are tangible objectives with major challenges and require cooperation between nations with proper handling of Artificial Intelligence to practice clinical medication.","doi":"10.55544/jrasb.3.4.2","year":"2024","venue":"Journal for Research in Applied Sciences and Biotechnology","sources":["semantic_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_001297","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"unclear","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"The abstract explicitly says this is a review of AI in healthcare. It mentions NLP and multiple data types, but the paper itself is not a primary model paper.","evidence_snippet":"“This review brings out discussions on the practices of AI technologies in medical” and mentions “natural language processing methods” with EHR, medical images, and genomics."},"architecture_reviewer":{"record_id":"rec_001297","paper_type":"review_editorial","generative_model_present":"no","foundation_model_evidence":"no","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"This is a review of AI in healthcare, not a primary model paper. It discusses ML/DL/NLP applications but does not describe a generative foundation model.","evidence_snippet":"\"This review brings out discussions on the practices of AI technologies in medical\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"review_editorial","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"unclear","generative_model_present":"no","foundation_model_evidence":"no"}}},{"record_id":"rec_001299","title":"Reimagining Cancer Care With Generative Artificial Intelligence: The Promise of Large Language Models.","abstract":"The emergence of state-of-the-art large language models (LLMs), which hold the ability to generalize to diverse natural language processing tasks, has led to new opportunities in health care. Oncology is especially well-suited to leverage these resources as the journeys of patients with cancer inherently yield extensive, longitudinal data sets comprising clinical narratives, pathology and radiology reports, and genomic sequencing reports. This review begins with an overview of the fundamental concepts behind LLMs, including the definitions, architecture, training paradigm, and performance optimization through prompt engineering and retrieval-augmented generation. We also take a moment to explore the newly emerging paradigm of LLMs in a multiagentic framework. We then synthesize current research on how LLMs may benefit stakeholders within the practice of oncology, including patients, oncologists, researchers, and learners. Finally, we address the limitations and risks of LLMs, including hallucinations, inherent biases, patient privacy, and clinician deskilling. While research thus far shows significant potential for LLMs to transform cancer care, necessary future directions include studies emphasizing patient stakeholder perspectives on LLM incorporation in clinical workflows, the development of relevant clinical benchmarks for LLM evaluation, a greater focus on real-world prospective testing, and deeper exploration of LLM reasoning capabilities.","doi":"10.1200/CCI-25-00134","year":"2025","venue":"JCO Clinical Cancer Informatics","sources":["semantic_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_001299","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"unclear","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"The abstract states that this article is a review of LLMs in cancer care. It discusses applications and limitations rather than introducing a new model.","evidence_snippet":"“This review begins with an overview of the fundamental concepts behind LLMs” and “we then synthesize current research on how LLMs may benefit stakeholders.”"},"architecture_reviewer":{"record_id":"rec_001299","paper_type":"review_editorial","generative_model_present":"yes","foundation_model_evidence":"yes","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"This is a review of large language models in oncology, including their architecture and training paradigm. The abstract describes generative LLMs with broad task generalization.","evidence_snippet":"\"large language models (LLMs), which hold the ability to generalize to diverse natural language processing tasks\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"review_editorial","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"unclear","generative_model_present":"yes","foundation_model_evidence":"yes"}}}]
./data/screening_codex_full_2026-07-06/role_logs/adjudicator/batch_0062.stdout.log:1:{"results":[{"record_id":"rec_001301","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","generative_model_present":"no","foundation_model_evidence":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"This is a multimodal molecular profiling study using methylation arrays and single-nucleus RNA/ATAC sequencing, but it does not describe any text or language-model component. It is outside scope for generative text-bio foundation models.","evidence_snippet":"\"We profiled 109 pediatric adrenocortical tumors using Illumina methylation arrays\" and \"single-nucleus RNA sequencing and ... ATAC sequencing\""},{"record_id":"rec_001302","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","generative_model_present":"yes","foundation_model_evidence":"yes","primary_exclusion_code":"none","uncertainty_reason":"none","decision_rationale":"The abstract describes a newly developed Epi-PRS method that uses a pretrained genomic LLM to transform genotypes into epigenomic signals. That supports a primary model with a substantive bio-text bridge, not just a wrapper.","evidence_snippet":"\"we developed Epi-PRS\" and \"A pretrained LLM is employed to transform genotypes into epigenomic signals\""},{"record_id":"rec_001311","paper_type":"primary_model_paper","bio_modality_present":"no","text_component_present":"yes","text_bio_bridge_present":"no","generative_model_present":"no","foundation_model_evidence":"no","primary_exclusion_code":"EC1_no_bio_modality","uncertainty_reason":"none","decision_rationale":"The abstract presents language-model-style embedding of EHR codes, but the data are clinical codes rather than a biological modality in scope. It is therefore excluded for lack of bio modality.","evidence_snippet":"\"use patient diagnosis and procedure codes as vocabularies and treat each patient as a sentence\""},{"record_id":"rec_001312","paper_type":"application_wrapper","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"no","generative_model_present":"no","foundation_model_evidence":"no","primary_exclusion_code":"application_wrapper","uncertainty_reason":"none","decision_rationale":"This paper studies reconstruction attacks on pretrained and fine-tuned LLM embeddings for genomic sequences, which is an analysis of existing models rather than a new foundation model. The abstract does not support a substantive text-bio bridge.","evidence_snippet":"\"Comparing Reconstruction Attacks on Pretrained Versus Full Fine-tuned Large Language Model Embeddings\""},{"record_id":"rec_001313","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","generative_model_present":"unclear","foundation_model_evidence":"yes","primary_exclusion_code":"none","uncertainty_reason":"generative_status_unclear","decision_rationale":"The abstract explicitly proposes PlantBiMoE as a bidirectional foundation model for plant genomes and reports benchmarked performance across many tasks. However, it does not clearly state a generative decoding or autoregressive objective.","evidence_snippet":"\"PlantBiMoE: A Bidirectional Foundation Model with Sparsemoe for Plant Genomes\" and \"best performance on 20 out of 31 datasets\""},{"record_id":"rec_001315","paper_type":"application_wrapper","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"no","generative_model_present":"no","foundation_model_evidence":"no","primary_exclusion_code":"application_wrapper","uncertainty_reason":"none","decision_rationale":"This is an applied clinical-trial prediction study using deep learning, transformers, and NLP on notes, protocols, and structured patient data. It does not describe a new generative text-bio foundation model.","evidence_snippet":"\"deep learning and predictive modelling\" and \"natural language processing techniques are utilized\""}]}
./data/screening_codex_full_2026-07-06/role_logs/architecture_reviewer/batch_0263.response.txt:1:{"results":[{"record_id":"rec_002097","paper_type":"review_editorial","generative_model_present":"no","foundation_model_evidence":"no","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"This is a review of AI-driven predictive analytics, not a new generative model. The abstract discusses predictive systems and their challenges, with no foundation-model evidence.","evidence_snippet":"\"This review compiles healthcare's AI-driven predictive analytics advancements\" and discusses \"predictive systems\"."},{"record_id":"rec_002098","paper_type":"primary_model_paper","generative_model_present":"no","foundation_model_evidence":"no","primary_exclusion_code":"EC3_not_generative","uncertainty_reason":"none","decision_rationale":"The work develops a multimodal deep learning model to predict prognosis and survival outcomes. The abstract describes predictive classification/regression, not a generative architecture or foundation model.","evidence_snippet":"\"developed to process WSI data\" and \"used to combine these learned features to predict long-term OS outcomes\"."},{"record_id":"rec_002099","paper_type":"review_editorial","generative_model_present":"no","foundation_model_evidence":"no","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"This is a review of multimodal integration techniques for Alzheimer’s diagnosis. It summarizes methods rather than presenting a generative model or foundation-model evidence.","evidence_snippet":"\"This paper reviews the latest advancements in multimodal integration techniques\"."},{"record_id":"rec_002100","paper_type":"primary_model_paper","generative_model_present":"no","foundation_model_evidence":"no","primary_exclusion_code":"EC3_not_generative","uncertainty_reason":"none","decision_rationale":"The abstract describes a multimodal classification model for early Alzheimer’s detection. It is an attention-based predictive system, not a clearly generative model.","evidence_snippet":"\"A deep learning-based classification model\" and \"used in the network to allow the model to highlight the relevant biomarkers\"."},{"record_id":"rec_002101","paper_type":"primary_model_paper","generative_model_present":"no","foundation_model_evidence":"no","primary_exclusion_code":"EC3_not_generative","uncertainty_reason":"none","decision_rationale":"This is an ensemble deep learning predictor for m6A site identification. The abstract focuses on sequence classification, with no generative mechanism or foundation-model characteristics.","evidence_snippet":"\"an ensemble deep learning predictor (EDLm6APred) was finally constructed for m6A site prediction\"."},{"record_id":"rec_002102","paper_type":"primary_model_paper","generative_model_present":"yes","foundation_model_evidence":"yes","primary_exclusion_code":"none","uncertainty_reason":"none","decision_rationale":"The abstract explicitly says CellTok processes inputs \"autoregressively\" and supports \"generation,\" which is generative evidence. It also uses pretrained LLM knowledge for unified multimodal analysis, which supports foundation-model-like characteristics.","evidence_snippet":"\"process biological and textual inputs autoregressively\" and \"leveraging pretrained knowledge within LLMs\"."},{"record_id":"rec_002103","paper_type":"review_editorial","generative_model_present":"no","foundation_model_evidence":"no","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"This is a review of NLP approaches in genomics, transcriptomics, and proteomics. It surveys methods and architectures rather than introducing a generative model.","evidence_snippet":"\"This review explores the application of NLP methods to biological sequence data\"."},{"record_id":"rec_002104","paper_type":"primary_model_paper","generative_model_present":"no","foundation_model_evidence":"yes","primary_exclusion_code":"EC3_not_generative","uncertainty_reason":"none","decision_rationale":"The abstract presents gene expression prediction with a pretrained large language model and prompt-based in-context learning. However, it remains a predictive system, not a clearly generative architecture.","evidence_snippet":"\"leveraging a pretrained large language model\" and \"enabling in-context learning\" for \"gene expression prediction\"."}]}
./data/screening_codex_full_2026-07-06/role_logs/adjudicator/batch_0110.stderr.log:66:[{"record_id":"rec_002225","title":"GREmLN: A Cellular Graph Structure Aware Transcriptomics Foundation Model","abstract":"A bstract The ever-increasing availability of large-scale single-cell profiles presents an opportunity to develop foundation models to capture cell properties and behavior. However, standard language models such as transformers benefits from sequentially structured data with well defined absolute or relative positional relationships, while single cell RNA data have orderless gene features. Molecular-interaction graphs, such as gene regulatory networks (GRN) or protein-protein interaction (PPI) networks, offer graph structure-based models that effectively encode both non-local gene token dependencies, as well as potential causal relationships. We introduce GREmLN ( G ene R egulatory Em bedding-based L arge N eural model), a foundation model that leverages graph signal processing to embed gene token graph structure directly within its attention mechanism, producing biologically informed single cell specific gene embeddings. Our model faithfully captures transcriptomics landscapes and achieves superior performance relative to state-of- the-art baselines on cell type annotation, graph structure understanding, and finetuned reverse perturbation prediction tasks. It offers a unified and interpretable framework for learning high-capacity foundational representations that capture complex, long-range regulatory dependencies from high-dimensional single-cell transcriptomic data. Moreover, the incorporation of graph-structured inductive biases enables more parameter-efficient architectures and accelerates training convergence.","doi":"10.1101/2025.07.03.663009","year":"2025","venue":"bioRxiv","sources":["biorxiv_medrxiv","semantic_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_002225","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"Single-cell transcriptomics is the biological core, but the abstract describes gene tokens and graph-aware attention rather than a substantive text/language component. No text-bio bridge is evident.","evidence_snippet":"\"a foundation model\" for \"single cell RNA data\" with \"gene token graph structure\" embedded in attention"},"architecture_reviewer":{"record_id":"rec_002225","paper_type":"primary_model_paper","generative_model_present":"unclear","foundation_model_evidence":"yes","primary_exclusion_code":"EC3_not_generative","uncertainty_reason":"generative_status_unclear","decision_rationale":"The abstract describes a foundation model for single-cell transcriptomics with learned embeddings and downstream prediction tasks, but it does not clearly state a generative architecture. It does provide foundation-model-like language about large-scale pretraining and transferable representations.","evidence_snippet":"\"introduce GREmLN ... a foundation model\"; \"learn high-capacity foundational representations\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"EC2_no_text_component","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","generative_model_present":"unclear","foundation_model_evidence":"yes"}}},{"record_id":"rec_002228","title":"Adding layers of information to scRNA-seq data using pre-trained language models","abstract":"Abstract\n                Pre-trained language models promise to enrich analyses of single-cell data with additional layers of information leveraging large text corpora. Yet, it is still unclear how to achieve optimal alignment with the primary quantitative single-cell data. To address this, we construct text-based training datasets from both scRNA-seq data and biomedical literature targeted to the experimental setting at hand. We then jointly train language models on both information sources to learn a common, literature-enriched representation. Our examples on functionality, disease associations, and temporal trajectories show the potential of knowledge-augmented embeddings as a generalizable and interpretable strategy for enriching single-cell analysis pipelines.","doi":"10.1101/2025.08.23.671699","year":"2025","venue":"bioRxiv","sources":["google_scholar","semantic_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_002228","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","primary_exclusion_code":"none","uncertainty_reason":"none","decision_rationale":"The abstract describes jointly training language models on scRNA-seq-derived text datasets and biomedical literature. That supports both a text component and a substantive bio-text bridge.","evidence_snippet":"\"jointly train language models on both information sources\" and \"common, literature-enriched representation\""},"architecture_reviewer":{"record_id":"rec_002228","paper_type":"primary_model_paper","generative_model_present":"unclear","foundation_model_evidence":"yes","primary_exclusion_code":"EC3_not_generative","uncertainty_reason":"generative_status_unclear","decision_rationale":"The abstract says it uses pre-trained language models and jointly trains them on scRNA-seq data and biomedical literature. That suggests broad pretraining and transferable representations, but it does not clearly specify a generative mechanism.","evidence_snippet":"\"Pre-trained language models\"; \"jointly train language models on both information sources\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"EC3_not_generative","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","generative_model_present":"unclear","foundation_model_evidence":"yes"}}},{"record_id":"rec_002230","title":"Automated machine learning with interpretation: A systematic review of methodologies and applications in healthcare","abstract":"Machine learning (ML) has achieved substantial success in performing healthcare tasks in which the configuration of every part of the ML pipeline relies heavily on technical knowledge. To help professionals with borderline expertise to better use ML techniques, Automated ML (AutoML) has emerged as a prospective solution. However, most models generated by AutoML are black boxes that are challenging to comprehend and deploy in healthcare settings. We conducted a systematic review to examine AutoML with interpretation systems for healthcare. We searched four databases (MEDLINE, EMBASE, Web of Science, and Scopus) complemented with seven prestigious ML conferences (AAAI, ACL, ICLR, ICML, IJCAI, KDD, and NeurIPS) that reported AutoML with interpretation for healthcare before September 1, 2023. We included 118 articles related to AutoML with interpretation in healthcare. First, we illustrated AutoML techniques used in the included publications, including automated data preparation, automated feature engineering, and automated model development, accompanied by a real‐world case study to demonstrate the advantages of AutoML over classic ML. Then, we summarized interpretation methods: feature interaction and importance, data dimensionality reduction, intrinsically interpretable models, and knowledge distillation and rule extraction. Finally, we detailed how AutoML with interpretation has been used for six major data types: image, free text, tabular data, signal, genomic sequences, and multi‐modality. To some extent, AutoML with interpretation provides effortless development and improves users' trust in ML in healthcare settings. In future studies, researchers should explore automated data preparation, seamless integration of automation and interpretation, compatibility with multi‐modality, and utilization of foundation models.","doi":"10.1002/med4.75","year":"2024","venue":"Medicine Advances","sources":["semantic_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_002230","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"unclear","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"The abstract explicitly says this is a systematic review of AutoML with interpretation in healthcare. It synthesizes prior work rather than presenting a primary model.","evidence_snippet":"\"We conducted a systematic review\" of AutoML with interpretation systems for healthcare"},"architecture_reviewer":{"record_id":"rec_002230","paper_type":"review_editorial","generative_model_present":"no","foundation_model_evidence":"no","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"The abstract states it is a systematic review of AutoML with interpretation in healthcare. It is not a primary model paper and does not describe a generative foundation model.","evidence_snippet":"\"We conducted a systematic review\"; \"included 118 articles\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"review_editorial","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"unclear","generative_model_present":"no","foundation_model_evidence":"no"}}},{"record_id":"rec_002231","title":"Advances in Human Genome Resolution: The Role of Pan-Genomic Strategies and Fine-Tuning Pre-trained Genomic Models","abstract":"The groundbreaking theory of DNA double helix structure has greatly promoted the development of molecular genetics, shaping and refining the genetic central dogma, thus enabling researchers to explore genotype-phenotype regulation at different levels. In particular, with the continued advancement of third-generation sequencing technology, an increasing number of highly accurate human genomes have been assembled, such as T2T-CHM13 and HG002. These high-quality genome sequences not only provide a more comprehensive human reference sequence, but also enable functional genomics studies within a unified coordinate system. To better explore and resolve the complex genetic information encompassed within human genome sequences, scientists have proposed novel research strategies, involving graphical pan-genome and pre-trained genomic models. The graphical pan-genomes provide population- level high-quality references, revealing the genomic diversity within populations and exploring the sequence complexity of specific regions, such as the KIR immune region. Concurrently, related studies of pre-trained models within the human genome offer new perspectives for interpreting sequence functions and delving into the hidden genetic codes, potentially leading to complete DNA decoding. Overall, graphical pan-genome and pre-trained genomic models represent two crucial strategies in genomics research, which will provide more new insights and make greater breakthroughs in the human genome. Together, these approaches have deepened our understanding of the human genome, fostered the development of bioinformatics ecosystems, and will contribute to the establishment and improvement of the entire field. Therefore, this review focuses on DNA sequencing, human genome assembly, high-quality pan-genome and pre-trained genomic large language models (LLMs), highlighting and summarizing the latest achievements and progress in human genome research, discussing existing challenges and providing future perspectives.","doi":"10.18103/mra.v12i7.5571","year":"2024","venue":"Medical Research Archives","sources":["semantic_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_002231","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"unclear","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"The abstract says the paper is a review of human genome assembly, pan-genomes, and pre-trained genomic models. This is not a primary candidate model paper.","evidence_snippet":"\"Therefore, this review focuses on ... pre-trained genomic large language models\""},"architecture_reviewer":{"record_id":"rec_002231","paper_type":"review_editorial","generative_model_present":"no","foundation_model_evidence":"no","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"This is a review of pan-genomic strategies and pre-trained genomic models. It summarizes the area rather than reporting a new generative model.","evidence_snippet":"\"This review focuses on ... pre-trained genomic large language models\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"review_editorial","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"unclear","generative_model_present":"no","foundation_model_evidence":"no"}}},{"record_id":"rec_002237","title":"Abstract 1267: Dual approach using unbiased proteomics and multiplexed immunofluorescence for the detection of markers predictive for immunotherapy in melanoma patients","abstract":"Background: Remarkable clinical success with immune checkpoint inhibitor (ICI) therapy has been achieved in recent years for the treatment of melanoma. However, despite the clinical advances of ICI therapy no durable responses are observed in 40-60% of melanoma patients, and current biomarkers such as tumor mutational burden (TMB) and PD-L1 expression do not clearly distinguish responders. Therefore, a growing focus of immuno-oncology (IO) research is focused on identifying novel biomarkers that are predictive for the response of treatment with ICIs. Due to the complexity of the interactions between cancer cells and the immune system, the identification of predictive biomarkers for patient response requires a combination of tools and efforts. Therefore, we have designed a multi-modality approach for the protein analysis of tumor tissue samples from late-stage melanoma patients treated with ICIs, consisting of an unbiased deep proteomic analysis followed by a multiplexed immunofluorescence (mIF) spatial tissue analysis.\n Methods: Formalin-fixed paraffin-embedded (FFPE) tumor samples were firstly used for unbiased quantification of proteins using data-independent acquisition (DIA) LC-MS technology and Biognosys’ Spectronaut software. Baseline patient samples were classified as responders (n = 9) or non-responders (n = 15) based on the response at 3 months post ICI-treatment. Additionally, patient’s tumor mutational burden (TMB) was analyzed using whole exome sequencing (WES). Subsequently, the same patient samples will be analyzed by MultiOmyx™, a proprietary, immunofluorescence (IF) multiplexing assay that enables visualization and characterization of up to 60 biomarkers on a single FFPE section. A custom panel will be generated to verify key markers identified by proteomics analysis in a spatial context and after multiplexing images will be analyzed by applying the proprietary deep-learning based cell classification platform NeoLYTX.\n Results: Analysis of the 24 FFPE samples from metastatic melanoma patients treated with ICI therapy stratified into responders and non-responders lead to the identification of 103 proteins that are significantly up- or down-regulated between the groups. Work is now ongoing to follow-up these findings by an mIF tissue analysis which will provide further details on the spatial relationship in the tumor microenvironment of these markers and pathways.\n Conclusions: In this study we demonstrate the power of a dual proteomic and mIF profiling for a comprehensive characterization of melanoma patients and the discovery and detection of markers predictive for response to ICI-therapy.\n Citation Format: Anna Juncker-Jensen, Nigel Beaton, Kristina Beeler, Tobias Treiber, Mitchell Levesque, Julia M. Gomez, Harry Nunns, Xin-Xing Tan, Jakob Vowinckel. Dual approach using unbiased proteomics and multiplexed immunofluorescence for the detection of markers predictive for immunotherapy in melanoma patients [abstract]. In: Proceedings of the American Association for Cancer Research Annual Meeting 2022; 2022 Apr 8-13. Philadelphia (PA): AACR; Cancer Res 2022;82(12_Suppl):Abstract nr 1267.","doi":"10.1158/1538-7445.am2022-1267","year":"2022","venue":"Cancer Research","sources":["semantic_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_002237","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"This is a proteomics and multiplexed immunofluorescence biomarker study for melanoma response prediction. It does not describe a text or language component in the candidate method.","evidence_snippet":"“unbiased proteomics and multiplexed immunofluorescence” and “deep-learning based cell classification platform”"},"architecture_reviewer":{"record_id":"rec_002237","paper_type":"application_wrapper","generative_model_present":"no","foundation_model_evidence":"no","primary_exclusion_code":"application_wrapper","uncertainty_reason":"none","decision_rationale":"This is a biomarker/proteomics study that uses a proprietary deep-learning cell classification platform for analysis. No generative model is described.","evidence_snippet":"\"proprietary, deep-learning based cell classification platform NeoLYTX\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"EC2_no_text_component","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","generative_model_present":"no","foundation_model_evidence":"no"}}},{"record_id":"rec_002240","title":"ATLAS: Population-Level Disease Locus Discovery via Differential Attention in Genomic Language Models","abstract":"Identifying disease-associated genetic variants remains a key challenge in genomics, especially in small cohorts or for rare and complex mutation types where genome-wide association studies (GWAS) often fall short. We introduce ATLAS, a population-level framework that leverages attention signals from pretrained genomic language models (gLMs) to detect disease-associated genes and loci directly from raw sequences—without requiring explicit variant calls or supervised training. ATLAS first performs gene-level differential attention analysis to prioritize candidate genes, followed by base-level analysis to localize disease-associated regions at single-haplotype resolution. We validate ATLAS on synthetic and\n                  β\n                  -thalassemia datasets, demonstrating robust performance across diverse allele frequencies (down to 10%), cohort sizes (below 200 individuals per group), and genomic scales. Compared to GWAS, ATLAS achieves higher recall of known loci and captures haplotype-specific signals missed by traditional methods. Cross-model benchmarking further shows that precise localization depends on both model size and pretraining on diverse human genomes. In summary, ATLAS offers a scalable, sequence-native alternative to traditional statistical genetics.","doi":"10.64898/2026.02.09.704696","year":"2026","venue":"bioRxiv","sources":["semantic_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_002240","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_substantive_text_bio_bridge","uncertainty_reason":"none","decision_rationale":"The abstract describes a genomic language model framework for disease locus discovery from raw sequences. It is biological language modeling, but no substantive text-bio bridge is described.","evidence_snippet":"“leverages attention signals from pretrained genomic language models” and “without requiring explicit variant calls”"},"architecture_reviewer":{"record_id":"rec_002240","paper_type":"application_wrapper","generative_model_present":"no","foundation_model_evidence":"yes","primary_exclusion_code":"application_wrapper","uncertainty_reason":"none","decision_rationale":"ATLAS uses attention signals from pretrained genomic language models for locus discovery rather than proposing a new generative model. The abstract gives clear evidence of pretrained foundation-model use, but as a downstream framework.","evidence_snippet":"\"leverages attention signals from pretrained genomic language models\"; \"pretraining on diverse human genomes\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"EC2_no_substantive_text_bio_bridge","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"no","generative_model_present":"no","foundation_model_evidence":"yes"}}}]
./data/screening_codex_full_2026-07-06/role_logs/adjudicator/batch_0110.stderr.log:1522:./data/screening_codex_full_2026-07-06/role_logs/scope_reviewer/batch_0346.stderr.log:4139:./data/screening_codex_full_2026-07-06/role_logs/scope_reviewer/batch_0293.response.txt:1:{"results":[{"record_id":"rec_002337","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"unclear","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"The abstract says this is a comprehensive overview and explicitly states, 'This review synthesizes current research.' It discusses NLP and omics in drug discovery, but as a review rather than a primary model paper.","evidence_snippet":"\"This review synthesizes current research\" and \"including natural language processing techniques\""},{"record_id":"rec_002338","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","primary_exclusion_code":"none","uncertainty_reason":"none","decision_rationale":"The work integrates 'language- and transformer-based models' with MS-genome datasets to identify microbial producers. This is a substantive text-bio model bridge rather than a review or wrapper.","evidence_snippet":"\"integrating language- and transformer-based models to cross-validate mass spectrometry (MS)-genome datasets\""},{"record_id":"rec_002339","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","primary_exclusion_code":"none","uncertainty_reason":"none","decision_rationale":"The abstract presents a new genomic language-model framework and trains PhyloGPN on whole-genome alignments. The language-modeling component is central to the biological task.","evidence_snippet":"\"introduce a novel framework for training gLMs\" and \"train PhyloGPN\""},{"record_id":"rec_002340","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"This is a radiogenomics model that predicts gene expression from MRI images. The abstract contains no substantive text or language component.","evidence_snippet":"\"predicts the expression contents of genetic factors ... using MRI images\""},{"record_id":"rec_002341","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"GenoCGC is a CNN/Graphormer model for genomic sequence classification. The mention of genomic large language models is only for comparison, not part of the candidate model.","evidence_snippet":"\"hybrid model combining Convolutional Neural Network (CNN) and a Graph-based Transformer\" and \"compared GenoCGC ... with genomic large language models\""},{"record_id":"rec_002342","paper_type":"application_wrapper","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"no","primary_exclusion_code":"application_wrapper","uncertainty_reason":"none","decision_rationale":"EP2vec uses embeddings learned using an unsupervised NLP method and then trains a classifier for EPI prediction. That is a downstream wrapper around NLP-derived features.","evidence_snippet":"\"sequence embedding features ... learned ... using an unsupervised deep learning method in natural language processing\""},{"record_id":"rec_002343","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"The abstract proposes a modified VAE for integrating omics modalities and predicting drug response. It is purely biological/modal data, with no text component.","evidence_snippet":"\"apply similar approaches to correct large omics measurements across various cancer datasets\""},{"record_id":"rec_002344","paper_type":"review_editorial","bio_modality_present":"no","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"This is a conference 'Preface' describing proceedings and tracks, not an original model paper. It does not present a biological modality or text-bio model.","evidence_snippet":"\"Preface\" and \"the conference ... proceedings ... tracks\""}]}
./data/screening_codex_full_2026-07-06/role_logs/adjudicator/batch_0110.stderr.log:1536:./data/screening_codex_full_2026-07-06/role_logs/scope_reviewer/batch_0346.stderr.log:4212:./data/screening_codex_full_2026-07-06/role_logs/scope_reviewer/batch_0239.response.txt:1:{"results":[{"record_id":"rec_001905","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"Primary model for dynamic gene regulatory network inference in cell differentiation. The abstract describes gene expression, transcription factors, and regulatory networks, but no substantive text/language component.","evidence_snippet":"\"infers dynamic GRN\" and \"between transcription factor (TF) expression and target gene activation\""},{"record_id":"rec_001906","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"This is explicitly a review of AI applications in the DNA sequencing pipeline. It mentions language models translating natural language experimental goals into primer sets.","evidence_snippet":"\"This review examines how AI has changed the DNA sequencing pipeline\" and \"big language models to translate natural language experimental goals\""},{"record_id":"rec_001907","paper_type":"application_wrapper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"application_wrapper","uncertainty_reason":"none","decision_rationale":"A federated learning detection framework built from vision models over CT, MRI, histology, genomic, and clinical inputs. The abstract does not describe a substantive text or language model component.","evidence_snippet":"\"automated detection ... from multimodal inputs, including CT, MRI, histology, genomic, and clinical records\""},{"record_id":"rec_001908","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"The abstract states this is a comprehensive review of contrastive learning in medical AI. It spans biomedical modalities and NLP, but remains a review rather than a candidate model paper.","evidence_snippet":"\"This paper presents a comprehensive review\" and \"medical imaging, electronic health records, physiological signal analysis, and genomics\""},{"record_id":"rec_001909","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"This is a primary deep-learning model for multi-omics survival prediction. The modality is biological data only, with no text/language component described.","evidence_snippet":"\"integrate multi-omics data (e.g., gene expression, DNA methylation, miRNA expression, and copy number variations)\""},{"record_id":"rec_001910","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_substantive_text_bio_bridge","uncertainty_reason":"none","decision_rationale":"The work uses genomic large language models and inverse folding to design RNA sequences. However, the abstract supports bio-sequence modeling rather than a substantive text-bio bridge.","evidence_snippet":"\"integrates genomic large language models (LLMs) with inverse folding models\" and \"generate RNA sequences\""},{"record_id":"rec_001911","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"This is a primary multimodal topic model for single-cell multiomics. The abstract concerns transcriptomic, epigenomic, and proteomic data, with no text/language component.","evidence_snippet":"\"single-cell multiomics assays simultaneously measure transcriptomic, epigenomic, and proteomic modalities\""},{"record_id":"rec_001912","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"This is a primary bioimage synthesis method for multiplex immunofluorescence and H&E data. The transformer and masked language modeling are used over visual tokens, not a substantive text component.","evidence_snippet":"\"channel-wise bioimage synthesis\" and \"a bidirectional transformer infers missing markers through masked language modeling\""}]}
