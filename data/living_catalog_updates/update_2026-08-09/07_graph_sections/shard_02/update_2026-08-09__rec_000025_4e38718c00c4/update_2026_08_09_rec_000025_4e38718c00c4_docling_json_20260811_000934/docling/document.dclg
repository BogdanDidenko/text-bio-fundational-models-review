  <heading>scDifformer: diffusion-based post-training for virtual cell modeling across large-scale single-cell data</heading>
Zhan Xiao
  <superscript>1, 4</superscript>
,
Wuke Wang
  <superscript>2, 4</superscript>
,
Xin Long
  <superscript>3, 4, 4, ✉</superscript>
,
Wenbo Zhang
  <superscript>5</superscript>
,
Weiqiang Zhang
  <superscript>6</superscript>
,
Duoyuan Chen
  <superscript>7</superscript>
,
Sujie Xu
  <superscript>8</superscript>
,
Qian Yu
  <superscript>9</superscript>
,
Xinpeng Zhang
  <superscript>10</superscript>
,
Shichen Huang
  <superscript>11</superscript>
,
Ning Zhang
  <superscript>12</superscript>
,
Yanbin Yin
  <superscript>13</superscript>
,
Xingxu Huang
  <superscript>14, 15</superscript>
,
Jieping Ye
  <superscript>16</superscript>
