./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/gpt_oss_120b_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11561/guideline_pilot_raw_completed.jsonl:754:{"cluster_id": 3851, "title": "Cell type annotation using large language models (LLMs) and CytoAnalyst", "title_normalized": "cell type annotation using large language models llms and cytoanalyst", "doi": NaN, "preprint_doi": NaN, "pmid": NaN, "arxiv_id": NaN, "abstract": "Abstract\n                  \n                    Motivation\n                    Cell annotation is fundamental for single-cell data interpretation. Accurate annotation allows us to identify cell types, understand their functions, trace developmental trajectories, and pinpoint alterations associated with a condition of interest. However, this complex process demands extensive manual curation, domain expertise, and proficiency across diverse bioinformatics tools. These challenges impede reproducibility and consistency.\n                  \n                  \n                    Results\n                    We have developed a new approach for semi-automatic cell type annotation, powered by large language models (LLMs). Given the input single-cell data, we first perform dimension reduction, clustering, and differential analysis to identify distinct cell groups and their respective markers. Next, we utilize Meta’s Llama and structured prompting to infer potential cell types. This approach greatly reduces manual labor from researchers while maintaining biological accuracy through enforced ontology, tissue context, and marker gene signatures. Our solution is freely accessible through our web-based platform named CytoAnalyst, hosted on a high-performance infrastructure with optimized networking and storage capabilities. CytoAnalyst also offers capabilities for quality control, embedding analysis, clustering, differential analysis, gene set analysis, cell enrichment, cell type annotation, and pseudo-time trajectory inference.\n                  \n                  \n                    Availability and implementation\n                    CytoAnalyst is freely available at https://cytoanalyst.tinnguyen-lab.com/. The CytoAnalyst handbook, including step-by-step tutorials and example case studies, is available at https://cytoanalyst.tinnguyen-lab.com/docs/.", "authors": "['K Nguyen', 'D Tran', 'P Nguyen', 'S Ro', 'P Bya']", "year": 2026.0, "venue": "Bioinformatics …", "date": NaN, "url": "https://academic.oup.com/bioinformaticsadvances/advance-article-abstract/doi/10.1093/bioadv/vbag001/8442891", "sources": "['google_scholar']", "n_sources": 1, "all_dois": "[]", "duplicate_count": 1, "abstract_source": NaN, "abstract_enriched_from": "crossref_title", "abstract_old_len": 189.0, "update_batch": "2026-03-01_to_2026-04-14", "_pilot_row_id": 758, "round-A_scope_reviewer_output": {"paper_type": "application_wrapper", "bio_modality_present": "yes", "text_component_present": "yes", "text_bio_bridge_present": "yes", "primary_exclusion_code": "application_wrapper", "uncertainty_reason": "none", "evidence_for_text_component": "utilize Meta’s Llama and structured prompting", "evidence_for_text_bio_bridge": "infer potential cell types ... using LLM", "evidence_for_generative_model": "not_assessed", "boundary_case": "none", "decision_rationale": "The work introduces a semi‑automatic annotation method that applies an existing LLM (Meta’s Llama) via prompting to map single‑cell markers to cell‑type text, so it is an application wrapper rather than a novel primary model."}, "round-A_scope_reviewer_paper_type": "application_wrapper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "yes", "round-A_scope_reviewer_text_bio_bridge_present": "yes", "round-A_scope_reviewer_primary_exclusion_code": "application_wrapper", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "utilize Meta’s Llama and structured prompting", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "infer potential cell types ... using LLM", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "none", "round-A_scope_reviewer_decision_rationale": "The work introduces a semi‑automatic annotation method that applies an existing LLM (Meta’s Llama) via prompting to map single‑cell markers to cell‑type text, so it is an application wrapper rather than a novel primary model.", "round-A_architecture_reviewer_output": {"paper_type": "application_wrapper", "generative_model_present": "yes", "foundation_model_evidence": "yes", "primary_exclusion_code": "application_wrapper", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "utilize Meta’s Llama and structured prompting to infer potential cell types", "boundary_case": "wrapper_boundary", "decision_rationale": "The paper presents a web platform (CytoAnalyst) that leverages an existing LLM (Meta’s Llama) via prompting for cell type annotation, making it an application wrapper rather than a novel generative model."}, "round-A_architecture_reviewer_paper_type": "application_wrapper", "round-A_architecture_reviewer_generative_model_present": "yes", "round-A_architecture_reviewer_foundation_model_evidence": "yes", "round-A_architecture_reviewer_primary_exclusion_code": "application_wrapper", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "utilize Meta’s Llama and structured prompting to infer potential cell types", "round-A_architecture_reviewer_boundary_case": "wrapper_boundary", "round-A_architecture_reviewer_decision_rationale": "The paper presents a web platform (CytoAnalyst) that leverages an existing LLM (Meta’s Llama) via prompting for cell type annotation, making it an application wrapper rather than a novel generative model.", "pilot_roundA_scope_gate": "EXCLUDE", "pilot_roundA_architecture_gate": "EXCLUDE", "pilot_needs_adjudication": false}
./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/gpt_oss_120b_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11561/guideline_pilot_raw_completed.jsonl:755:{"cluster_id": 3850, "title": "Foundation Models Meet Medical Image Interpretation", "title_normalized": "foundation models meet medical image interpretation", "doi": NaN, "preprint_doi": NaN, "pmid": NaN, "arxiv_id": NaN, "abstract": "Facing challenges such as limited annotated data and insufficient model generalization in medical deep learning, foundation models (FMs) are reshaping the paradigm of medical image interpretation through large-scale pretraining and efficient fine-tuning. Unlike traditional models focused on single modality and task, FMs enable multi-modal representation and task-agnostic transfer, adapting to various downstream applications without extensive annotation or retraining. This paper systematically reviews the research progress on medical FMs, focusing on medical tasks, datasets, and evaluation metrics. It covers key interpretation tasks such as classification, segmentation, generation, and prognosis prediction. At the data level, it integrates multi-source data including 2-dimensional (2D)/3D medical imaging, vision-language data, electronic health records (EHRs), physiological signals, and bioinformatics data, and summarizes the evaluation metrics for each task. On this basis, the paper categorizes and analyzes mainstream medical FMs, including pretrained models, vision FMs, vision-language FMs, and extended multi-modal FMs, providing a systematic comparison of their performance and characteristics. Furthermore, we innovatively proposes the IPIU medical FM platform, which integrates large-scale medical data, universal vision models, medical vision-language models, and medical large language models, and verifies its effectiveness in typical clinical tasks. In addition, this work is the first to systematically analyze the key challenges and emerging trends of medical FMs across 12 critical dimensions, including data, modeling, security, and computational resources, filling the gaps in the existing reviews in systematic sorting and forward-looking analysis. Our aim is to provide theoretical support and practical reference for the sustainable development of medical FMs. Related resources and literature lists will be open sourced on\n                    https://github.com/JYAOii/Foundation-Models-meet-Medical-Image-Interpretation\n                    .", "authors": "['L Jiao', 'J Hao', 'R Li', 'L Li', 'X Liu', 'F Liu', 'W Ma', 'P Chen']", "year": 2026.0, "venue": "Research", "date": NaN, "url": "https://spj.science.org/doi/abs/10.34133/research.1024", "sources": "['google_scholar']", "n_sources": 1, "all_dois": "[]", "duplicate_count": 1, "abstract_source": NaN, "abstract_enriched_from": "crossref_title", "abstract_old_len": 182.0, "update_batch": "2026-03-01_to_2026-04-14", "_pilot_row_id": 757, "round-A_scope_reviewer_output": {"paper_type": "review_editorial", "bio_modality_present": "yes", "text_component_present": "yes", "text_bio_bridge_present": "unclear", "primary_exclusion_code": "review_editorial", "uncertainty_reason": "text_bio_bridge_unclear", "evidence_for_text_component": "vision-language data", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "not_assessed", "boundary_case": "none", "decision_rationale": "The abstract describes a systematic review of medical foundation models, making it a review/editorial rather than a primary model paper; therefore it is excluded as a review."}, "round-A_scope_reviewer_paper_type": "review_editorial", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "yes", "round-A_scope_reviewer_text_bio_bridge_present": "unclear", "round-A_scope_reviewer_primary_exclusion_code": "review_editorial", "round-A_scope_reviewer_uncertainty_reason": "text_bio_bridge_unclear", "round-A_scope_reviewer_evidence_f