./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/gpt_oss_120b_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11561/guideline_pilot_raw_completed.jsonl:830:{"cluster_id": 3928, "title": "Combining BulkFormer and TabPFN to predict post-transplant function from kidney biopsies during machine perfusion or cold storage", "title_normalized": "combining bulkformer and tabpfn to predict posttransplant function from kidney biopsies during machine perfusion or cold storage", "doi": NaN, "preprint_doi": NaN, "pmid": NaN, "arxiv_id": NaN, "abstract": "Abstract\n                Generating predictions from transcriptomic data poses a unique challenge due to the high number of genes, and often small sample size. BulkFormer and TabPFN have emerged as leading transformer-based foundation models for bulk transcriptomic and tabular data respectively. We explore an artificial intelligence pipeline using BulkFormer-TabPFN v2.5 which generates zero-shot predictions from raw RNA-Seq count data without retraining. This was tested on three cohorts of biopsies taken from donated human kidneys. BulkFormer-TabPFN was able to predict delayed kidney function using RNA-Seq counts from kidneys undergoing ex-situ normothermic machine perfusion (NMP; c-statistic=0.82, 95% CI=0.67–0.97). Predictive discrimination was optimised under the following conditions: BulkFormer-TabPFN versus TabPFN alone, maximum absolute aggregation of BulkFormer gene-level embeddings, biopsies taken during ex-situ NMP versus cold storage. BulkFormer-TabPFN predictions were modified by cytokine filter treatment during ex-situ NMP, suggesting they could be a dynamic surrogate endpoint for novel therapeutics, which is intrinsically linked to post-transplant outcome. This demonstrates for the first time synergistic benefits of these foundation models, to generate zero-shot predictions without model retraining. The provided code provides a blueprint to replicate generating predictions from RNA-Seq count data, which could be applied in a wide range of biomedical contexts within and beyond organ transplantation.", "authors": "['SJ Tingle', 'G Kourounis', 'S Kazerouni', 'HVM Spiers']", "year": 2026.0, "venue": NaN, "date": NaN, "url": "https://www.researchsquare.com/article/rs-9242336/latest", "sources": "['google_scholar']", "n_sources": 1, "all_dois": "[]", "duplicate_count": 1, "abstract_source": NaN, "abstract_enriched_from": "crossref_title", "abstract_old_len": 182.0, "update_batch": "2026-03-01_to_2026-04-14", "_pilot_row_id": 835, "round-A_scope_reviewer_output": {"paper_type": "application_wrapper", "bio_modality_present": "yes", "text_component_present": "no", "text_bio_bridge_present": "no", "primary_exclusion_code": "application_wrapper", "uncertainty_reason": "none", "evidence_for_text_component": "none", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "not_assessed", "boundary_case": "none", "decision_rationale": "Combines BulkFormer and TabPFN to generate zero‑shot predictions from RNA‑Seq counts; no natural‑language text or prompt described, so it is an application wrapper rather than a primary multimodal text‑bio model."}, "round-A_scope_reviewer_paper_type": "application_wrapper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "no", "round-A_scope_reviewer_text_bio_bridge_present": "no", "round-A_scope_reviewer_primary_exclusion_code": "application_wrapper", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "none", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "none", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "none", "round-A_scope_reviewer_decision_rationale": "Combines BulkFormer and TabPFN to generate zero‑shot predictions from RNA‑Seq counts; no natural‑language text or prompt described, so it is an application wrapper r