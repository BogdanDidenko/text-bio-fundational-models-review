./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/gpt_oss_120b_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11561/guideline_pilot_raw_completed.jsonl:779:{"cluster_id": 3879, "title": "FishMamba-1: A Linear-Complexity Foundation Model for Deciphering Polyploid Cyprinid Genomes", "title_normalized": "fishmamba1 a linearcomplexity foundation model for deciphering polyploid cyprinid genomes", "doi": NaN, "preprint_doi": NaN, "pmid": NaN, "arxiv_id": NaN, "abstract": "Abstract\n                \n                  The Cypriniformes order, comprising essential aquaculture species like carps and minnows, presents unique genomic challenges due to complex whole-genome duplication (WGD) events and extensive repetitive elements. Conventional annotation tools and Transformer-based foundation models often struggle to capture long-range dependencies in these expanded genomes due to quadratic computational complexity. Here, we introduce FishMamba-1, the first genomic foundation model tailored for the aquatic clade, built upon the selective state-space model (SSM) architecture. By leveraging Mamba-2’s linear scaling efficiency, FishMamba-1 processes context windows of 32,768 base pairs (32k)—significantly surpassing the 4–6k limit of standard DNA Transformers—enabling the modeling of distal regulatory patterns on a single GPU. We curated Cypri-24, a comprehensive dataset comprising 28.8 Gb of high-quality genome assemblies from 24 representative species, to pre-train FishMamba-1 on 15 billion tokens. Subsequent fine-tuning for genome segmentation (FishSegmenter) demonstrates the model’s capability to annotate gene structures at single-nucleotide resolution with remarkable precision. Evaluation on a held-out test set reveals that FishMamba-1 achieves a precision of 64.6% in exon identification, effectively distinguishing coding regions from the vast non-coding background without relying on RNA-seq evidence. Furthermore, interpretability analysis confirms that the model captures biological syntax such as splice acceptor motifs. FishMamba-1 provides a scalable, open-source framework for decoding the complex genomes of non-model organisms, providing a scalable computational resource to support downstream applications in molecular breeding and ecological monitoring. The complete source code, pre-trained model weights, and datasets are freely available at\n                  https://github.com/lu1000001/FishMamba\n                  . Additionally, the FishMamba Hub, a web-based inference platform, is accessible at\n                  https://huggingface.co/spaces/lu1000001/FishMamba-Hub\n                  to facilitate real-time genomic segmentation for the aquatic research community.\n                \n                \n                  Graphic Abstract", "authors": "['S Lu', 'C Fang', 'C Wang', 'Y Qian', 'W Fang', 'T Li', 'H Zeng']", "year": 2026.0, "venue": "bioRxiv", "date": NaN, "url": "https://www.biorxiv.org/content/10.64898/2026.03.09.710409.abstract", "sources": "['google_scholar']", "n_sources": 1, "all_dois": "[]", "duplicate_count": 1, "abstract_source": NaN, "abstract_enriched_from": "crossref_title", "abstract_old_len": 181.0, "update_batch": "2026-03-01_to_2026-04-14", "_pilot_row_id": 786, "round-A_scope_reviewer_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "no", "text_bio_bridge_present": "no", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "none", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "not_assessed", "boundary_case": "none", "decision_rationale": "The abstract presents a new DNA foundation model (FishMamba-1) for genomic segmentation, with no mention of natural-language text, captions, or documents; therefore there is no substantive text component or text‑bio bridge."}, "round-A_scope_reviewer_paper_type": "primary_model_paper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "no", "round-A_scope_reviewer_text_bio_bridge_present": "no", "round-A_scope_reviewer_primary_exclusion_code": "none", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "none", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "none", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "none", "round-A_scope_reviewer_decision_rationale": "The abstract presents a new DNA foundation model (FishMamba-1) for genomic segmentation, with no mention of natural-language text, captions, or documents; therefore there is no substantive text component or text‑bio bridge.", "round-A_architecture_reviewer_output": {"paper_type": "primary_model_paper", "generative_model_present": "no", "foundation_model_evidence": "yes", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "none", "boundary_case": "none", "decision_rationale": "The abstract introduces FishMamba-1 as a foundation model pretrained on 15 billion tokens, but its downstream use is genome segmentation (exon identification), with no mention of a generative decoder or generation task."}, "round-A_architecture_reviewer_paper_type": "primary_model_paper", "round-A_architecture_reviewer_generative_model_present": "no", "round-A_architecture_reviewer_foundation_model_evidence": "yes", "round-A_architecture_reviewer_primary_exclusion_code": "none", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "none", "round-A_architecture_reviewer_boundary_case": "none", "round-A_architecture_reviewer_decision_rationale": "The abstract introduces FishMamba-1 as a foundation model pretrained on 15 billion tokens, but its downstream use is genome segmentation (exon identification), with no mention of a generative decoder or generation task.", "pilot_roundA_scope_gate": "EXCLUDE", "pilot_roundA_architecture_gate": "EXCLUDE", "pilot_needs_adjudication": false}
./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/gpt_oss_120b_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11561/guideline_pilot_raw_completed.jsonl:780:{"cluster_id": 3880, "title": "stMCP: Spatial Transcriptomics with a Model Context Protocol Server", "title_normalized": "stmcp spatial transcriptomics with a model context protocol server", "doi": NaN, "preprint_doi": NaN, "pmid": NaN, "arxiv_id": NaN, "abstract": "Abstract\n                Spatial transcriptomics enables high-resolution mapping of gene expression in intact tissues but remains challenging due to complex computational workflows that limit accessibility and reproducibility. Here, we present a Model Context Protocol (MCP) framework enabling natural language-driven spatial transcriptomics analysis. By executing analytical tools locally, this architecture eliminates the need to upload massive datasets to large language models, bypassing high token costs and mitigating data privacy and training risks. The MCP orchestrator interprets intent, dynamically routes requests, maintains session state, and verifies input integrity to ensure reproducible execution. Benchmarking across biological discovery, orchestration accuracy, token usage, and execution time demonstrates robust performance. This architecture establishes a scalable template for AI-native research by standardizing the interface between models and local analytical engines. Rather than replacing bioinformaticians, this framework empowers biologists to independently and comprehensively explore their data, accelerating hypothesis testing, and unlocking broader biological discoveries.", "authors": "['JJ Smith', 'X Wang', 'M McPheeters', 'MA Widjaja-Adhi']", "year": 2026.0, "venue": "bioRxiv", "date": NaN, "url": "https://www.biorxiv.org/content/10.64898/2026.03.11.710153.abstract", "sources": "['google_scholar']", "n_sources": 1, "all_dois": "[]", "duplicate_count": 1, "abstract_source": NaN, "abstract_enriched_