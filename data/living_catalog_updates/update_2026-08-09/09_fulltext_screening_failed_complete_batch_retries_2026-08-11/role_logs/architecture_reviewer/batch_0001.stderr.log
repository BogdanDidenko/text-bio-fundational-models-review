./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/gpt_oss_120b_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11561/guideline_pilot_raw_completed.jsonl:814:{"cluster_id": 3913, "title": "ChromBERT-tools: A versatile toolkit for context-specific embedding of transcription regulators across different cell types", "title_normalized": "chromberttools a versatile toolkit for contextspecific embedding of transcription regulators across different cell types", "doi": NaN, "preprint_doi": NaN, "pmid": NaN, "arxiv_id": NaN, "abstract": "Abstract\n                \n                  Motivation\n                  Representations that capture the genome-wide context of transcription regulators are critical for establishing a shared backbone for flexible transcription modeling and in silico regulatory analysis. Yet, current embeddings predominantly rely on limited modalities, such as gene co-expression or static protein features, offering an incomplete perspective that ignores context-dependent transcription regulator activities across the genome. The lack of transcription regulation-informed embeddings, paired with the absence of a user-friendly and lightweight toolkit for their generation, adaption to different cell types and interpretation, impedes the capture of the regulatory logic that underpin cellular states and functions.\n                \n                \n                  Results\n                  To address this need, we present ChromBERT-tools, a lightweight toolkit designed to operationalize regulation-informed embeddings derived from a foundation model pre-trained on the comprehensive landscapes of human and mouse transcription regulators. ChromBERT-tools provides user-friendly command-line interfaces (CLIs) and Python APIs to achieve two primary goals: (i) generating cell-type-agnostic embeddings that capture the semantic representations of individual regulators and their combinatorial interactions, serving as biological priors of transcription regulator modality to enhance transcription regulation modeling and rule interpretation; and (ii) generating cell-type-specific embeddings via fine-tuned model variants, which support in silico inference of regulatory roles of transcription regulators in cell types with scarce experimental data. The toolkit streamlines end-to-end workflows for embedding generation, adaption to different cell types and interpretation towards biological inferences such as regulator-regulator interaction across the genome and key regulators determining cell identity or cell state transition.\n                \n                \n                  Availability and implementation\n                  \n                    ChromBERT-tools is freely available at\n                    https://github.com/TongjiZhanglab/ChromBERT-tools\n                    , with documentation at\n                    https://chrombert-tools.readthedocs.io/en/latest/\n                    .", "authors": "['Q Chen', 'Z Yu', 'Y Zhang']", "year": 2026.0, "venue": "bioRxiv", "date": NaN, "url": "https://www.biorxiv.org/content/10.64898/2026.02.04.703739.abstract", "sources": "['google_scholar']", "n_sources": 1, "all_dois": "[]", "duplicate_count": 1, "abstract_source": NaN, "abstract_enriched_from": "crossref_title", "abstract_old_len": 185.0, "update_batch": "2026-03-01_to_2026-04-14", "_pilot_row_id": 820, "round-A_scope_reviewer_output": {"paper_type": "application_wrapper", "bio_modality_present": "yes", "text_component_present": "no", "text_bio_bridge_present": "no", "primary_exclusion_code": "application_wrapper", "uncertainty_reason": "none", "evidence_for_text_component": "none", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "not_assessed", "boundary_case": "none", "decision_rationale": "The abstract describes a toolkit that generates embeddings from a pre‑trained foundation model for transcription regulators, without introducing a new model and without mentioning natural‑language text, prompts, or captions; thus it is an application wrapper with no substantive text component or text‑bio bridge."}, "round-A_scope_reviewer_paper_type": "application_wrapper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "no", "round-A_scope_reviewer_text_bio_bridge_present": "no", "round-A_scope_reviewer_primary_exclusion_code": "application_wrapper", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "none", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "none", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "none", "round-A_scope_reviewer_decision_rationale": "The abstract describes a toolkit that generates embeddings from a pre‑trained foundation model for transcription regulators, without introducing a new model and without mentioning natural‑language text, prompts, or captions; thus it is an application wrapper with no substantive text component or text‑bio bridge.", "round-A_architecture_reviewer_output": {"paper_type": "application_wrapper", "generative_model_present": "no", "foundation_model_evidence": "yes", "primary_exclusion_code": "application_wrapper", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "none", "boundary_case": "wrapper_boundary", "decision_rationale": "The abstract presents ChromBERT-tools, a toolkit that generates embeddings from a pre‑trained foundation model, without describing a generative architecture; thus it is an application wrapper rather than a primary generative model."}, "round-A_architecture_reviewer_paper_type": "application_wrapper", "round-A_architecture_reviewer_generative_model_present": "no", "round-A_architecture_reviewer_foundation_model_evidence": "yes", "round-A_architecture_reviewer_primary_exclusion_