./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/gpt_oss_120b_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11561/guideline_pilot_raw_completed.jsonl:750:{"cluster_id": 3847, "title": "CellTypeAI: Automated cell identification for scRNA-seq using local generative-AI", "title_normalized": "celltypeai automated cell identification for scrnaseq using local generativeai", "doi": NaN, "preprint_doi": NaN, "pmid": NaN, "arxiv_id": NaN, "abstract": "Abstract\n                Single-cell RNA sequencing (scRNA-seq) cell annotation techniques rely on the matching of known defining marker genes to a given cell population. However, these methods may lack robustness to dynamic fluctuations in cell marker expression between patients, samples and pathologies. The advent of easy-to-implement predictive technologies, like generative-AI (gen-AI), has facilitated the introduction of computational workflows that improve otherwise inaccurate context-dependent cell type annotation. Here, we introduce CellTypeAI, a streamlined, scalable program developed for tissue context-dependent cell annotation of scRNA-seq datasets using modern gen-AI models, enhanced by retrieval augmented generation methods. Our implementation builds upon local gen-AI hosting technologies and directly integrates into scRNA-seq analysis pipelines. We show that CellTypeAI provides improved annotation accuracy compared to current conventional annotation methods and nascent cloud-based gen-AI approaches. As CellTypeAI leverages locally-run AI models, it can be applied to sensitive datasets, unlike approaches utilising online gen-AI tools such as ChatGPT, DeepSeek, or Claude. CellTypeAI presents a novel solution for tissue-specific cell type identification, overcoming traditional marker-based limitations via locally-deployed generative-AI models.\n                \n                  Contact\n                  \n                    john.grainger-2@manchester.ac.uk\n                    ;\n                    magnus.rattray@manchester.ac.uk", "authors": "['RH Daw', 'HR Deijnen', 'M Rattray', 'JR Grainger']", "year": 2026.0, "venue": "bioRxiv", "date": NaN, "url": "https://www.biorxiv.org/content/10.64898/2026.03.03.709253.abstract", "sources": "['google_scholar']", "n_sources": 1, "all_dois": "[]", "duplicate_count": 1, "abstract_source": NaN, "abstract_enriched_from": "crossref_title", "abstract_old_len": 177.0, "update_batch": "2026-03-01_to_2026-04-14", "_pilot_row_id": 754, "round-A_scope_reviewer_output": {"paper_type": "application_wrapper", "bio_modality_present": "yes", "text_component_present": "unclear", "text_bio_bridge_present": "unclear", "primary_exclusion_code": "application_wrapper", "uncertainty_reason": "mixed_signals", "evidence_for_text_component": "none", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "not_assessed", "boundary_case": "none", "decision_rationale": "CellTypeAI is presented as a pipeline that leverages existing local generative‑AI models for scRNA‑seq cell annotation, without introducing a new generative model, so it fits the application‑wrapper category; the abstract does not clearly describe a natural‑language text component or a substantive text‑bio bridge."}, "round-A_scope_reviewer_paper_type": "application_wrapper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "unclear", "round-A_scope_reviewer_text_bio_bridge_present": "unclear", "round-A_scope_reviewer_primary_exclusion_code": "application_wrapper", "round-A_scope_reviewer_uncertainty_reason": "mixed_signals", "round-A_scope_reviewer_evidence_for_text_component": "none", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "none", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "none", "round-A_scope_reviewer_decision_rationale": "CellTypeAI is presented as a pipeline that leverages existing local generative‑AI models for scRNA‑seq cell annotation, without introducing a new generative model, so it fits the application‑wrapper category; the abstract does not clearly describe a natural‑language text component or a substantive text‑bio bridge.", "round-A_architecture_reviewer_output": {"paper_type": "application_wrapper", "generative_model_present": "no", "foundation_model_evidence": "no", "primary_exclusion_code": "application_wrapper", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "using modern gen-AI models, enhanced by retrieval augmented generation methods", "boundary_case": "wrapper_boundary", "decision_rationale": "CellTypeAI integrates existing local generative AI models for cell annotation without proposing a new generative architecture, making it an application wrapper rather than a primary generative foundational model."}, "round-A_architecture_reviewer_paper_type": "application_wrapper", "round-A_architecture_reviewer_generative_model_present": "no", "round-A_architecture_reviewer_foundation_model_evidence": "no", "round-A_architecture_reviewer_primary_exclusion_code": "application_wrapper", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "using modern gen-AI models, enhanced by retrieval augmented generation methods", "round-A_architecture_reviewer_boundary_case": "wrapper_boundary", "round-A_architecture_reviewer_decision_rationale": "CellTypeAI integrates existing local generative AI models for cell annotation without proposing a new generative architecture, making it an application wrapper rather than a primary generative foundational model.", "pilot_roundA_scope_gate": "EXCLUDE", "pilot_roundA_architecture_gate": "EXCLUDE", "pilot_needs_adjudication": false}
