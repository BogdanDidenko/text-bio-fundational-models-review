./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/gpt_oss_120b_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11561/guideline_pilot_raw_completed.jsonl:741:{"cluster_id": 3837, "title": "Zero-shot biological reasoning with open-weights large language models reproduces CRISPR screen based prediction of synthetic lethal interactions", "title_normalized": "zeroshot biological reasoning with openweights large language models reproduces crispr screen based prediction of synthetic lethal interactions", "doi": NaN, "preprint_doi": NaN, "pmid": NaN, "arxiv_id": NaN, "abstract": "ABSTRACT\n                Identifying clinically relevant synthetic lethal interactions has great potential for uncovering novel therapeutic vulnerabilities in cancer. Current approaches rely on machine learning models that estimate probabilities of synthetic lethal interactions, without supplying explicit knowledge of the underlying biology and lack the human-readable interpretation leading to the prediction. Large Language Models (LLMs) represent a new class of tools capable of reasoning and leveraging extensive biological knowledge acquired from relevant literature during their pretraining. Here, we tested multiple open-weight LLMs for their ability to predict known and novel synthetic lethal interactions. We found that most of the tested models were better at reconstructing the results of three known genome-wide CRISPR knockout screens than random chance, while observed that their performance was related to the parameter-size of the model, and on average benefited little from additional pathway and genetic information apart from what they already possess when estimating the likelihood of a synthetic lethal relationship. After selecting the best-performing and most computationally efficient model for our use case (Qwen2.5-32B-Instruct, 0.715 AUROC), we performed an in silico screen of 398,277 gene pairs from 893 clinically relevant genes. Our goal was to highlight the potential of open-weights LLMs as scalable, context-aware prioritization tools for synthetic lethal interactions, and to lay the groundwork for predicting higher-order genetic interactions.", "authors": "['A Prosz', 'Z Sztupinszki', 'M Diossy', 'B Zimon', 'I Csabai']", "year": 2026.0, "venue": "bioRxiv", "date": NaN, "url": "https://www.biorxiv.org/content/10.64898/2026.01.28.702211.abstract", "sources": "['google_scholar']", "n_sources": 1, "all_dois": "[]", "duplicate_count": 1, "abstract_source": NaN, "abstract_enriched_from": "crossref_title", "abstract_old_len": 183.0, "update_batch": "2026-03-01_to_2026-04-14", "_pilot_row_id": 744, "round-A_scope_reviewer_output": {"paper_type": "application_wrapper", "bio_modality_present": "yes", "text_component_present": "yes", "text_bio_bridge_present": "yes", "primary_exclusion_code": "application_wrapper", "uncertainty_reason": "none", "evidence_for_text_component": "Large Language Models (LLMs) ... leveraging extensive biological knowledge acquired from relevant literature", "evidence_for_text_bio_bridge": "predict known and novel synthetic lethal interactions using open-weight LLMs", "evidence_for_generative_model": "not_assessed", "boundary_case": "none", "decision_rationale": "The study applies existing open‑weight LLMs to predict synthetic lethal interactions without introducing a new model, so it is an application wrapper; the abstract shows both a biological modality and a substantive text‑bio bridge."}, "round-A_scope_reviewer_paper_type": "application_wrapper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "yes", "round-A_scope_reviewer_text_bio_bridge_present": "yes", "round-A_scope_reviewer_primary_exclusion_code": "application_wrapper", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "Large Language Models (LLMs) ... leveraging extensive biological knowledge acquired from relevant lite