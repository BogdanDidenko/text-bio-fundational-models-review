./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/gpt_oss_120b_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11561/guideline_pilot_raw_completed.jsonl:796:{"cluster_id": 3896, "title": "Foundation Model for Biological Temporal Data Dynamics with Experimental Validation", "title_normalized": "foundation model for biological temporal data dynamics with experimental validation", "doi": NaN, "preprint_doi": NaN, "pmid": NaN, "arxiv_id": NaN, "abstract": "Abstract\n                High-dimensional biological and physiology-adjacent time series are often noisy, partially observed, and heterogeneous across subjects, space, and time, making it difficult to learn continuous-time models that are both stable to integrate and useful for intervention analysis. We propose a reusable latent-dynamics backbone that couples a mask-aware variational autoencoder with a latent neural ordinary differential equation, and returns the learned dynamics to observation space through decoded rollouts or decoder pushforward. In this work, we use the term foundation model in a dynamical sense: a shared transferable backbone for temporal modeling across datasets and downstream tasks. We evaluate the framework on three datasets: 64-channel electroencephalography motor movement and imagery, the AirQualityUCI multi-variate environmental time series with meteorological and calendar controls, and a registered Drosophila blastoderm gene-expression atlas. Across electroencephalography and air quality, the same backbone improves open-loop forecasting relative to classical baselines and supports controlled counterfactual rollouts. In electroencephalography, it also enables data-efficient subject adaptation. In air quality, it supports interpretable in silico intervention screening over exogenous drivers. In the Drosophila atlas, the black-box backbone supervises a sparse editable Hill-type mechanistic student model, yielding candidate regulatory structure, equation-level perturbation hypotheses, and an interpretable artificial-intelligence workflow for mechanistic analysis. These results show that a shared latent-dynamics backbone can unify forecasting, adaptation, counterfactual analysis, interpretable AI, and mechanistic distillation across heterogeneous biological time-series settings.", "authors": "['X Duan', 'V Periwal']", "year": 2026.0, "venue": NaN, "date": NaN, "url": "https://www.researchsquare.com/article/rs-9018407/latest", "sources": "['google_scholar']", "n_sources": 1, "all_dois": "[]", "duplicate_count": 1, "abstract_source": NaN, "abstract_enriched_from": "crossref_title", "abstract_old_len": 186.0, "update_batch": "2026-03-01_to_2026-04-14", "_pilot_row_id": 803, "round-A_scope_reviewer_output": {"paper_type": "primary_model_paper", "bio_modality_present": "yes", "text_component_present": "no", "text_bio_bridge_present": "no", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "none", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "not_assessed", "boundary_case": "none", "decision_rationale": "The abstract describes a new latent-dynamics backbone applied to biological time‑series (EEG, air quality, Drosophila gene expression) with no mention of natural‑language text or prompts, so the text component and bridge are absent while the work is a primary model contribution."}, "round-A_scope_reviewer_paper_type": "primary_model_paper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "no", "round-A_scope_reviewer_text_bio_bridge_present": "no", "round-A_scope_reviewer_primary_exclusion_code": "none", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "none", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "none", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "none", "round-A_scope_reviewer_decision_rationale": "The abstract describes a new latent-dynamics backbone applied to biological time‑series (EEG, air quality, Drosophila gene expression) with no mention of natural‑language text or prompts, so the text component and bridge are absent while the work is a primary model contribution.", "round-A_architecture_reviewer_output": {"paper_type": "primary_model_paper", "generative_model_present": "yes", "foundation_model_evidence": "yes", "primary_exclusion_code": "none", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "mask-aware variational autoencoder with decoded rollouts", "boundary_case": "none", "decision_rationale": "The abstract proposes a mask-aware VAE coupled with a latent neural ODE that produces decoded rollouts, and explicitly frames the backbone as a shared, transferable foundation model for diverse biological temporal datasets."}, "round-A_architecture_reviewer_paper_type": "primary_model_paper", "round-A_architecture_reviewer_generative_model_present": "yes", "round-A_architecture_reviewer_foundation_model_evidence": "yes", "round-A_architecture_reviewer_primary_exclusion_code": "none", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "mask-aware variational autoencoder with decoded rollouts", "round-A_architecture_reviewer_boundary_case": "none", "round-A_architecture_reviewer_decision_rationale": "The abstract proposes a mask-aware VAE coupled with a latent neural ODE that produces decoded rollouts, and explicitly frames the backbone as a shared, transferable foundation model for diverse biological temporal datasets.", "pilot_roundA_scope_gate": "EXCLUDE", "pilot_roundA_architecture_