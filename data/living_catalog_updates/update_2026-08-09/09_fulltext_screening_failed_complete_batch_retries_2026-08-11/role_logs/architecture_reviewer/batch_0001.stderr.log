./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/gpt_oss_120b_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11561/guideline_pilot_raw_completed.jsonl:761:{"cluster_id": 3859, "title": "scCluBench: Comprehensive Benchmarking of Clustering Algorithms for Single-Cell RNA Sequencing", "title_normalized": "scclubench comprehensive benchmarking of clustering algorithms for singlecell rna sequencing", "doi": NaN, "preprint_doi": NaN, "pmid": NaN, "arxiv_id": NaN, "abstract": "Cell clustering is crucial for uncovering cellular heterogeneity in single-cell RNA sequencing (scRNA-seq) data by identifying cell types and marker genes. Despite its importance, existing benchmarks for scRNA-seq clustering remain fragmented, lacking standardized protocols and often omitting recent advances in artificial intelligence.To fill these gaps, we present scCluBench, a comprehensive benchmark of clustering algorithms for scRNA-seq data. scCluBench provides 36 scRNA-seq datasets collected from diverse public sources, covering multiple tissues, which are uniformly processed to ensure consistency for systematic evaluation and downstream analyses. To assess performance, we collect and reproduce a range of scRNA-seq clustering methods, including traditional, deep learning-based, graph-based, and biological foundation models. We comprehensively evaluate each method both quantitatively and qualitatively, using core performance metrics and visualization analyses. Furthermore, we construct representative downstream biological tasks, such as marker gene identification and cell type annotation, to further assess the practical utility. scCluBench then investigates the performance differences and applicability boundaries of various clustering models across diverse analytical tasks, systematically assessing their robustness and scalability in real-world scenarios. Overall, scCluBench offers a standardized and user-friendly benchmark for scRNA-seq clustering, with standardized datasets, unified evaluation protocols, and transparent analyses, facilitating informed method selection and providing valuable insights into model generalizability and application scope.", "authors": "['P Xu', 'Z Wang', 'Z Wang', 'P Li', 'J Wang', 'R Zhang']", "year": 2026.0, "venue": "Proceedings of the …", "date": NaN, "url": "https://ojs.aaai.org/index.php/AAAI/article/view/37110", "sources": "['google_scholar']", "n_sources": 1, "all_dois": "[]", "duplicate_count": 1, "abstract_source": NaN, "abstract_enriched_from": "crossref_title", "abstract_old_len": 182.0, "update_batch": "2026-03-01_to_2026-04-14", "_pilot_row_id": 766, "round-A_scope_reviewer_output": {"paper_type": "benchmark_resource", "bio_modality_present": "yes", "text_component_present": "no", "text_bio_bridge_present": "no", "primary_exclusion_code": "benchmark_resource", "uncertainty_reason": "none", "evidence_for_text_component": "none", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "not_assessed", "boundary_case": "none", "decision_rationale": "The abstract describes a comprehensive benchmark of clustering algorithms for scRNA‑seq data, with no mention of natural‑language text or a text‑bio generative component."}, "round-A_scope_reviewer_paper_type": "benchmark_resource", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "no", "round-A_scope_reviewer_text_bio_bridge_present": "no", "round-A_scope_reviewer_primary_exclusion_code": "benchmark_resource", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "none", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "none", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "none", "round-A_scope_reviewer_decision_rationale": "The abstract describes a comprehensive benchmark of clustering algorithms for scRNA‑seq data, with no mention of natur