./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/gpt_oss_120b_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11561/guideline_pilot_raw_completed.jsonl:902:{"cluster_id": 3984, "title": "Spatial multiomics profiling reveals ZFP36-mediated immunometabolic reprogramming in bladder cancer", "title_normalized": "spatial multiomics profiling reveals zfp36mediated immunometabolic reprogramming in bladder cancer", "doi": NaN, "preprint_doi": NaN, "pmid": NaN, "arxiv_id": NaN, "abstract": "Bladder cancer remains a significant therapeutic challenge due to its marked heterogeneity and capacity for immune evasion. Here, we employ spatial metabolomics and spatial transcriptomics to systematically characterize and visualize the metabolic and transcriptional landscapes of bladder cancer. Our findings identify distinct metabolic and transcriptional profiles across different tumor regions, highlighting heterogeneity and immune-associated metabolic reprogramming in BLCA. Further investigation identifies zinc finger protein 36 (ZFP36) as a potential immunotherapeutic target. Utilizing\n                    Zfp36\n                    whole-body knockout and T cell–specific\n                    Zfp36\n                    conditional knockout mice, we validated that\n                    Zfp36\n                    knockout decreases the activation threshold for T cells and increases T cell infiltration in tumors. Moreover, we found that elevated ZFP36 expression is dramatically linked to worse patient outcomes. Mechanistically, ZFP36 facilitates mRNA degradation of key immune regulators, including\n                    C1QBP\n                    , thereby inhibiting T cell activation and cytotoxicity. Notably, combining\n                    Zfp36\n                    knockout with anti-PD-1 therapy produced synergistic antitumor effects, suggesting that ZFP36 inhibition could be a promising therapeutic strategy. This integrated multiomics approach collectively uncovers immune-metabolic regulatory pathways in BLCA and points to critical molecular targets for immunotherapy.", "authors": "['F Ye', 'X Han', 'W Li', 'L Huang', 'Z Chen', 'Y Lu']", "year": 2026.0, "venue": "Proceedings of the …", "date": NaN, "url": "https://www.pnas.org/doi/abs/10.1073/pnas.2505125123", "sources": "['google_scholar']", "n_sources": 1, "all_dois": "[]", "duplicate_count": 1, "abstract_source": NaN, "abstract_enriched_from": "crossref_title", "abstract_old_len": 179.0, "update_batch": "2026-03-01_to_2026-04-14", "_pilot_row_id": 891, "round-A_scope_reviewer_output": {"paper_type": "unclear", "bio_modality_present": "yes", "text_component_present": "no", "text_bio_bridge_present": "no", "primary_exclusion_code": "EC2_no_text_component", "uncertainty_reason": "paper_type_unclear", "evidence_for_text_component": "none", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "not_assessed", "boundary_case": "clear_exclude", "decision_rationale": "The abstract describes spatial metabolomics and transcriptomics but provides no natural‑language text component or generative model, so it lacks a substantive text‑bio bridge."}, "round-A_scope_reviewer_paper_type": "unclear", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "no", "round-A_scope_reviewer_text_bio_bridge_present": "no", "round-A_scope_reviewer_primary_exclusion_code": "EC2_no_text_component", "round-A_scope_reviewer_uncertainty_reason": "paper_type_unclear", "round-A_scope_reviewer_evidence_for_text_component": "none", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "none", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "clear_exclude", "round-A_scope_reviewer_decision_rationale": "The abstract describes spatial metabolomics and transcriptomics but provides no natural‑language text component or generative model, so it lacks a substantive text‑