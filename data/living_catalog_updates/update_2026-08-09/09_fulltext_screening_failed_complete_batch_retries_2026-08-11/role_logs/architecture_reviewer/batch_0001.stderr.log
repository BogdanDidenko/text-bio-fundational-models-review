./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/gpt_oss_120b_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11561/guideline_pilot_raw_completed.jsonl:768:{"cluster_id": 3867, "title": "Quantifying the fidelity of in vitro human cell culture systems using a biomedical foundation model", "title_normalized": "quantifying the fidelity of in vitro human cell culture systems using a biomedical foundation model", "doi": NaN, "preprint_doi": NaN, "pmid": NaN, "arxiv_id": NaN, "abstract": "Primary cell culture is fast becoming a dominant method for discovery work regarding human disease. Currently, there are no methods to quantitatively benchmark these systems. Here, we apply a uniform in vitro culture system of human intestinal epithelial cells (IECs) to achieve this goal. We previously established methods for long-term two-dimensional (2D) cultivation of mouse IECs using an air–liquid interface (ALI) technique. Here, we further refined these methods for long-term 2D cultivation of human IECs, with histological and molecular features of differentiated intestinal epithelia. Leveraging the power and scalability of a biomedical foundation model (BMFM) trained on single-cell RNA sequencing data (BMFM-RNA), we performed classification tasks to identify cell types across sample sources and to quantitatively benchmark our in vitro differentiated cells against cells collected from patient biopsies. We observed a striking concordance between our in vitro differentiated cells and the corresponding cell types in vivo for multiple differentiated secretory cell types. This approach using BMFM-RNA holds promise to expand our understanding of the regulatory mechanisms, including gene–gene regulation underlying homeostasis and regeneration, as well as the functions of rare and poorly understood lineages within the human intestinal epithelia. Moreover, these methods may be applicable to other organs, model systems, and experimental modalities. We propose that the framework used here can be deployed as a standard benchmarking methodology, ultimately improving the fidelity of primary human culture systems.", "authors": "['S Fujii', 'ST Espenschied', 'V Anand']", "year": 2026.0, "venue": "Proceedings of the …", "date": NaN, "url": "https://www.pnas.org/doi/abs/10.1073/pnas.2520482123", "sources": "['google_scholar']", "n_sources": 1, "all_dois": "[]", "duplicate_count": 1, "abstract_source": NaN, "abstract_enriched_from": "crossref_title", "abstract_old_len": 175.0, "update_batch": "2026-03-01_to_2026-04-14", "_pilot_row_id": 774, "round-A_scope_reviewer_output": {"paper_type": "application_wrapper", "bio_modality_present": "yes", "text_component_present": "no", "text_bio_bridge_present": "no", "primary_exclusion_code": "application_wrapper", "uncertainty_reason": "none", "evidence_for_text_component": "none", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "not_assessed", "boundary_case": "none", "decision_rationale": "The study applies an existing biomedical foundation model trained on single‑cell RNA‑seq data to classify cell types; it does not introduce a new model, nor describe natural‑language text or a text‑bio mapping."}, "round-A_scope_reviewer_paper_type": "application_wrapper", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "no", "round-A_scope_reviewer_text_bio_bridge_present": "no", "round-A_scope_reviewer_primary_exclusion_code": "application_wrapper", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "none", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "none", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "none", "round-A_scope_reviewer_decision_rationale": "The study applies an existing biomedical foundation model trained on single‑cell RNA‑seq data to classify cell types; it does not intro