ry_case": "wrapper_boundary", "decision_rationale": "The abstract describes MCPmed, a protocol and infrastructure for making bioinformatics web services machine‑actionable for LLMs, without proposing a generative architecture."}, "round-A_architecture_reviewer_paper_type": "application_wrapper", "round-A_architecture_reviewer_generative_model_present": "no", "round-A_architecture_reviewer_foundation_model_evidence": "no", "round-A_architecture_reviewer_primary_exclusion_code": "application_wrapper", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "none", "round-A_architecture_reviewer_boundary_case": "wrapper_boundary", "round-A_architecture_reviewer_decision_rationale": "The abstract describes MCPmed, a protocol and infrastructure for making bioinformatics web services machine‑actionable for LLMs, without proposing a generative architecture.", "pilot_roundA_scope_gate": "EXCLUDE", "pilot_roundA_architecture_gate": "EXCLUDE", "pilot_needs_adjudication": true, "round-B_adjudicator_output": {"paper_type": "benchmark_resource", "bio_modality_present": "yes", "text_component_present": "no", "text_bio_bridge_present": "no", "generative_model_present": "no", "foundation_model_evidence": "no", "primary_exclusion_code": "benchmark_resource", "uncertainty_reason": "none", "evidence_for_text_component": "none", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "none", "boundary_case": "clear_exclude", "decision_rationale": "The abstract describes a protocol and infrastructure for making bioinformatics web services machine‑actionable for LLMs, without presenting a new generative model, text component, or multimodal bridge. It is therefore a resource, not a primary model paper."}, "round-B_adjudicator_paper_type": "benchmark_resource", "round-B_adjudicator_bio_modality_present": "yes", "round-B_adjudicator_text_component_present": "no", "round-B_adjudicator_text_bio_bridge_present": "no", "round-B_adjudicator_generative_model_present": "no", "round-B_adjudicator_foundation_model_evidence": "no", "round-B_adjudicator_primary_exclusion_code": "benchmark_resource", "round-B_adjudicator_uncertainty_reason": "none", "round-B_adjudicator_evidence_for_text_component": "none", "round-B_adjudicator_evidence_for_text_bio_bridge": "none", "round-B_adjudicator_evidence_for_generative_model": "none", "round-B_adjudicator_boundary_case": "clear_exclude", "round-B_adjudicator_decision_rationale": "The abstract describes a protocol and infrastructure for making bioinformatics web services machine‑actionable for LLMs, without presenting a new generative model, text component, or multimodal bridge. It is therefore a resource, not a primary model paper."}
./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/gpt_oss_120b_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11561/guideline_pilot_raw_completed.jsonl:898:{"cluster_id": 3997, "title": "AI-Driven Innovations for Quality Control and Standardization: Future Strategies in Adipose-Derived Stem Cell Manufacturing", "title_normalized": "aidriven innovations for quality control and standardization future strategies in adiposederived stem cell manufacturing", "doi": NaN, "preprint_doi": NaN, "pmid": NaN, "arxiv_id": NaN, "abstract": "Artificial intelligence (AI), including machine learning (ML) and deep learning (DL), is increasingly transforming the study, manufacturing, and clinical translation of adipose-derived stem/stromal cells (ADSCs). ADSC-based therapies face persistent challenges related to donor variability, heterogeneous cell populations, limited standardization of culture protocols, and the need for robust quality control (QC) and potency assessment under Good Manufacturing Practice (GMP) conditions. This review discusses how AI-driven approaches can support the ADSC pipeline from donor and tissue pre-screening, through isolation and expansion, to differentiation and batch release decisions. We highlight major methodological advances in computer vision and label-free imaging for monitoring morphology, confluency, proliferation, senescence, and contamination, as well as AI-assisted optimization strategies for culture parameters and differentiation protocols. In addition, we examine the growing role of multi-omics integration (transcriptomics, proteomics, metabolomics, and secretomics) combined with ML to predict functional potency, stratify donors, and identify biomarkers associated with therapeutic efficacy. Finally, we address current limitations, including data scarcity, inter-laboratory variability, model interpretability, and regulatory requirements, and outline future perspectives such as closed-loop bioprocess control, foundation models, and federated learning frameworks. Overall, AI offers a powerful toolkit to improve the reproducibility, safety, and scalability of ADSC manufacturing and to accelerate the development of standardized, data-driven regenerative medicine products.", "authors": "['R Foti', 'G Storti', 'M Palmesano', 'A Calicchia']", "year": 2026.0, "venue": "International Journal of …", "date": NaN, "url": "https://www.mdpi.com/1422-0067/27/5/2388", "sources": "['google_scholar']", "n_sources": 1, "all_dois": "[]", "duplicate_count": 1, "abstract_source": NaN, "abstract_enriched_from": "crossref_title", "abstract_old_len": 187.0, "update_batch": "2026-03-01_to_2026-04-14", "_pilot_row_id": 904, "round-A_scope_reviewer_output": {"paper_type": "review_editorial", "bio_modality_present": "yes", "text_component_present": "no", "text_bio_bridge_present": "no", "primary_exclusion_code": "review_editorial", "uncertainty_reason": "none", "evidence_for_text_component": "none", "evidence_for_text_bio_bridge": "none", "evidence_for_generative_model": "not_assessed", "boundary_case": "none", "decision_rationale": "The abstract explicitly states it is a review of AI methods for ADSC manufacturing and does not mention any natural-language text component or text‑bio mapping."}, "round-A_scope_reviewer_paper_type": "review_editorial", "round-A_scope_reviewer_bio_modality_present": "yes", "round-A_scope_reviewer_text_component_present": "no", "round-A_scope_reviewer_text_bio_bridge_present": "no", "round-A_scope_reviewer_primary_exclusion_code": "review_editorial", "round-A_scope_reviewer_uncertainty_reason": "none", "round-A_scope_reviewer_evidence_for_text_component": "none", "round-A_scope_reviewer_evidence_for_text_bio_bridge": "none", "round-A_scope_reviewer_evidence_for_generative_model": "not_assessed", "round-A_scope_reviewer_boundary_case": "none", "round-A_scope_reviewer_decision_rationale": "The abstract explicitly states it is a review of AI methods for ADSC manufacturing and does not mention any natural-language text component or text‑bio mapping.", "round-A_architecture_reviewer_output": {"paper_type": "review_editorial", "generative_model_present": "no", "foundation_model_evidence": "no", "primary_exclusion_code": "review_editorial", "uncertainty_reason": "none", "evidence_for_text_component": "not_assessed", "evidence_for_text_bio_bridge": "not_assessed", "evidence_for_generative_model": "none", "boundary_case": "clear_exclude", "decision_rationale": "The abstract describes a review of AI/ML methods for ADSC manufacturing and does not mention any generative architecture such as decoder, autoregressive, diffusion, or VAE/GAN. It therefore lacks generative model content and is a review article."}, "round-A_architecture_reviewer_paper_type": "review_editorial", "round-A_architecture_reviewer_generative_model_present": "no", "round-A_architecture_reviewer_foundation_model_evidence": "no", "round-A_architecture_reviewer_primary_exclusion_code": "review_editorial", "round-A_architecture_reviewer_uncertainty_reason": "none", "round-A_architecture_reviewer_evidence_for_text_component": "not_assessed", "round-A_architecture_reviewer_evidence_for_text_bio_bridge": "not_assessed", "round-A_architecture_reviewer_evidence_for_generative_model": "none", "round-A_architecture_reviewer_boundary_case": "clear_exclude", "round-A_architecture_reviewer_decision_rationale": "The abstract describes a review of AI/ML methods for ADSC manufacturing and does not mention any generative architecture such as decoder, autoregressive, diffusion, or VAE/GAN. It therefore lacks generative model content and is a review article.", "pilot_roundA_scope_gate": "EXCLUDE", "pilot_roundA_architecture_gate": "EXCLUDE", "pilot_needs_adjudication": false}
./analysis/screening_run_artifacts_after_prompt_update_20260511/full_runs/gpt_oss_120b_review_pipeline_all4027_current_watchdog_20260511T1116Z/job_11561/guideline_pilot_raw_completed.jsonl:899:{"cluster_id": 3982, "title": "Meiotic prophase I disruption as a strategy for nonhormonal male contraception using small-molecule inhibitor JQ1", "title_normalized": "meiotic prophase i disruption as a strategy for nonhormonal male contraception using smallmolecule inhibitor jq1", "doi": NaN, "preprint_doi": NaN, "pmid": NaN, "arxiv_id": NaN, "abstract": "ABSTRACT\n                Long-acting non-hormonal male contraceptives are urgently needed but developing strategies that are both effective and reversible presents significant challenges. Here, we investigated the potential of meiotic prophase I blockade as a promising and potentially reversible approach to male contraception. To do this, we utilized (+)-JQ1, a small-molecule inhibitor of the testis-specific protein, BRDT. Daily injections of (+)-JQ1 for three weeks resulted in disrupted spermatogenesis resulting in loss of spermatozoa and an inability to sire pups. While spermatogenic cells repopulated the testis within six weeks post drug cessation, full fertility restoration required a longer recovery period. We attribute this delay in full recovery to persistent issues with the pachytene transcriptional program, which is crucial for meiotic progression and spermatid development. These findings underscore the potential of pharmacological approaches to disrupt meiotic prophase I as a targeted, reversible male contraceptive strategy, providing new insights into developing effective non-hormonal contraceptive approaches.", "authors": "['S Tanis', 'LE Simon', 'AK Alexander', 'TS Horan']", "year": 2026.0, "venue": "Proceedings of the …", "date": NaN, "url": "https://www.pnas.org/doi/abs/10.1073/pnas.2517498123", "sources": "['google_scholar']", "n_sources": 1, "all_dois": "[]", "duplicate_count": 1, "abstract_source": NaN, "a