    e-mail: peng.lei@scu.edu.cn; xueyu@hust.edu.cn; Jiada@scu.edu.cn
  </footnote>
  <text>
    <href uri="https://doi.org/10.1038/s41551-026-01769-6"/>
    <location value="339"/>
