    <location value="108"/>
    XunZi, an AI biologist, reveals disease-modifying targets
  </heading>
  <text>
    <location value="34"/>
    <location value="136"/>
    <location value="123"/>
    <location value="141"/>
    Received: 11 January 2026
  </text>
  <text>
    <location value="34"/>
    <location value="149"/>
    <location value="110"/>
    <location value="154"/>
    Accepted: 8 July 2026
  </text>
  <text>
    <location value="34"/>
    <location value="162"/>
    <location value="117"/>
    <location value="167"/>
    Published online: xx xx xxxx
  </text>
  <picture>
    <location value="34"/>
