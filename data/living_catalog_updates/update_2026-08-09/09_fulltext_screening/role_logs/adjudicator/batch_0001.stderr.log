{"results":[{"record_id":"update_2026-08-09__rec_000138","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","generative_model_present":"yes","foundation_model_evidence":"yes","primary_exclusion_code":"none","uncertainty_reason":"none","decision_rationale":"OCellus is presented as a new multimodal language-model framework with a shared backbone, natural-language interface, and generated explanations. The evidence supports a primary model paper rather than a wrapper.","evidence_snippet":"multi-task language model; Planner-Router-Verifier natural-language interface; generates natural-language explanations of its own outputs"},{"record_id":"update_2026-08-09__rec_000231","paper_type":"application_wrapper","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"no","generative_model_present":"no","foundation_model_evidence":"yes","primary_exclusion_code":"application_wrapper","uncertainty_reason":"mixed_signals","decision_rationale":"The visible record is a literature-derived network/ODE pipeline using PubTator3 publications plus an LLM, but it does not show a central generative text-bio model. Wrapper-style use is the safest reading.","evidence_snippet":"gene regulatory relationships were obtained from the pre-annotated PubTator3 table; integrated with a large language model (LLM)"},{"record_id":"update_2026-08-09__rec_000082","paper_type":"application_wrapper","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"no","generative_model_present":"no","foundation_model_evidence":"yes","primary_exclusion_code":"application_wrapper","uncertainty_reason":"none","decision_rationale":"Unify combines scRNA-seq with language-model embeddings as auxiliary features for transfer learning and perturbation prediction. That is wrapper-style feature fusion rather than a generative text-bio model.","evidence_snippet":"combining RNA expression with embeddings from protein language models and general-purpose language models; prediction of perturbation responses across species"},{"record_id":"update_2026-08-09__rec_000106","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","generative_model_present":"unclear","foundation_model_evidence":"yes","primary_exclusion_code":"none","uncertainty_reason":"generative_status_unclear","decision_rationale":"scMIR is a vision-language foundation model with paired microscopy images and structured textual captions plus text-guided alignment. The generative mechanism is not explicit enough to resolve beyond unclear.","evidence_snippet":"paired single-cell images and structured textual captions; text-guided cross-modal alignment; self-supervised image reconstruction"},{"record_id":"update_2026-08-09__rec_000131","paper_type":"application_wrapper","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"no","generative_model_present":"yes","foundation_model_evidence":"yes","primary_exclusion_code":"application_wrapper","uncertainty_reason":"none","decision_rationale":"CellDuality fine-tunes an existing LLM with SFT and self-supervised RLVR over textual biological prompts and outputs. That fits an application wrapper rather than a new foundation model.","evidence_snippet":"all inputs to the LLM are constructed as textual prompts; output is a textual response y, generated autoregressively according to the policy"}]}
