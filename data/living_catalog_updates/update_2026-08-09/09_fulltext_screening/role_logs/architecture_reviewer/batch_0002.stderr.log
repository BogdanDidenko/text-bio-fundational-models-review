./data/screening_codex_fulltext_docling_graph_direct_clean_both_targets_2026-07-10/role_logs/adjudicator/batch_0042.stderr.log:105:[{"record_id":"full_2026-07-06__rec_002339","candidate_id":"full_2026-07-06__rec_002339","source_record_id":"rec_002339","source_corpus":"include","title":"A Phylogenetic Approach to Genomic Language Modeling","abstract":"","doi":"10.48550/arXiv.2503.03773","year":"","venue":"","sources":[],"selected_full_text_sections":"[data_source, input_representation: 3.1 Training Data]\nWe compiled a dataset D where the i -th item consists of a possibly padded length-481 substring x ( i ) of the human reference genome GRCh38, centered at the i -th position of the genome, a list y ( i ) of nucleotides from different species that are aligned to the i -th position, and a phylogenetic tree T ( i ) whose leaves correspond to the elements of y ( i ) . For each position i , we obtained y ( i ) from a whole-genome alignment of 447 placental mammalian genomes that was generated by the Zoonomia Consortium by combining an existing alignment of 241 genomes [44] with an additional set of primate genomes [20]. Since we require at most one nucleotide from a species for each position in the reference genome, we removed sequences from duplicated species in each alignment block, keeping the sequences that had the smallest edit distance to the consensus sequence of the block and breaking ties by choosing the first sequence to appear in the file.\n\nTo obtain T ( i ) , we first downloaded a species-level tree that includes each species in our whole-genome alignment and has been previously used to derive constraint scores from the Zoonomia Consortium's alignment [35]. We then set T ( i ) to be the minimum spanning tree containing the nodes corresponding to the species that have alignments to this position.\n\n<!-- image -->\n\n|\n\nFig. 1. Illustration of PhyloGPN's modeling framework. The input data consist of 481 bp windows from the human reference genome GRCh38 and the alignment columns are obtained from a whole-genome alignment of 447 mammalian species to GRCh38.","first_pass_outputs":{"scope_reviewer":{"record_id":"full_2026-07-06__rec_002339","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"This is a primary model paper on genomic language modeling using human reference genome windows and aligned mammalian nucleotides. The provided evidence shows biological sequence input only; no natural-language text component or text-bio bridge is described.","evidence_snippet":"\"input data consist of 481 bp windows from the human reference genome GRCh38\" and \"a phylogenetic tree T(i)\"; no natural-language text is described here"},"architecture_reviewer":{"record_id":"full_2026-07-06__rec_002339","paper_type":"primary_model_paper","generative_model_present":"unclear","foundation_model_evidence":"yes","primary_exclusion_code":"none","uncertainty_reason":"generative_status_unclear","decision_rationale":"The record describes a genomic language modeling framework trained on human genome windows plus multi-species alignments, which supports broad pretraining. It does not explicitly state an autoregressive/decoder/generative mechanism in the provided sections.","evidence_snippet":"\"A Phylogenetic Approach to Genomic Language Modeling\"; \"Fig. 1. Illustration of PhyloGPN's modeling framework\"; \"alignment of 447 placental mammalian genomes\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"EC2_no_text_component","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","generative_model_present":"unclear","foundation_model_evidence":"yes"}}}]
