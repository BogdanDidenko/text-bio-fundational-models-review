./data/screening_codex_fulltext_2026-07-09/role_logs/adjudicator/batch_0011.response.txt:1:{"results":[{"record_id":"full_2026-07-06__rec_001289","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","generative_model_present":"unclear","foundation_model_evidence":"yes","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"generative_status_unclear","decision_rationale":"The provided sections describe scGPT as a foundation model trained on human cell data with downstream biological tasks, but they do not show any natural-language text component or text-bio alignment. Generative status is not explicitly demonstrated beyond the title claim \"using Generative AI\" and the pretraining/evaluation description.","evidence_snippet":"\"pre-trained the scGPT model on smaller scales of the normal human cells\"; \"cell embeddings computed from the pre-trained scGPT\"; tasks of \"cell type annotation, reference mapping, and perturbation response prediction\"; title: \"Using Generative AI\"; none; none"}]}
