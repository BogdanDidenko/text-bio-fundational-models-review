./data/screening_codex_fulltext_docling_graph_direct_clean_both_targets_2026-07-10/role_logs/scope_reviewer/batch_0200.response.txt:1:{"results":[{"record_id":"full_2026-07-06__rec_001830","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"yes","primary_exclusion_code":"none","uncertainty_reason":"none","decision_rationale":"The record presents a new model, OpticalDNA, for genomic modeling and evaluation, not a review, benchmark, or wrapper. It explicitly combines DNA rendering with an OCR-capable vision-language model and prompt-conditioned genomic objectives.","evidence_snippet":"“OpticalDNA renders DNA into structured visual layouts and trains an OCR-capable vision-language model with a visual DNA encoder and a document decoder”; “prompt-conditioned objectives over core genomic primitives”."}]}
