./data/screening_codex_fulltext_2026-07-09/role_logs/scope_reviewer/batch_0078.prompt.txt:87:[{"record_id":"full_2026-07-06__rec_002400","candidate_id":"full_2026-07-06__rec_002400","source_record_id":"rec_002400","source_corpus":"include","title":"Synthetic Histopathological Images Generation with Artificial Intelligence to Accelerate Research and Improve Clinical Outcomes in Hematology","abstract":"","doi":"10.1182/blood-2023-187521","year":"","venue":"","sources":[],"full_text_context":"[document_opening: Docling opening text]\nBlood 142 (2023) 902-905\n## The 65th ASH Annual Meeting Abstracts\n### ORAL ABSTRACTS\n## 803.EMERGING TOOLS, TECHNIQUES AND ARTIFICIAL INTELLIGENCE IN HEMATOLOGY\n#### Synthetic Histopathological Images Generation with Artificial Intelligence to Accelerate Research and Improve Clinical Outcomes in Hematology\n,\nGianluca Asti, MSc 1 , Saverio D'Amico, MSc 1 , Nico Curti, PhD 2,3 , Gianluca Carlini, PhD 2,3 , Elisabetta Sauta, PhD 1 , Nicolas Riccardo Derus, PhD 4 , Daniele Dall'Olio, PhD 4 , Claudia Sala, PhD 4 , Lorenzo Dall'Olio, PhD 3,2 , Luca Lanino, MD 5 Giulia Maggioni, MD 1 , Alessia Campagna, MD 1 , Marta Ubezio, MD 1 , Antonio Russo, MD 1 , Gabriele Todisco, MD 1 , Cristina Astrid Tentori, MD 1 , Pierandrea Morandini, MEng 1 , Marilena Bicchieri, PhD 1 , Maria Chiara Grondelli, BSc 1 , Matteo Zampini, PhD 1 , Victor Savevski, MEng 1 , Armando Santoro, MD 6,7 , Shahram Kordasti, MDPhD 8 , Valeria Santini, MD 9 , Anne Sophie Kubasch, MD 10 , Uwe Platzbecker, MD 11 , Maria Diez-Campelo, MD PhD 12 , Pierre Fenaux, MD PhD 13 , Lin-Pierre Zhao, MD 13 , Amer M. [truncated]","section_evidence":[{"section_type":"document_opening","heading":"Docling opening text","heading_level":0,"line_start":1,"line_end":0,"text":"Blood 142 (2023) 902-905\n## The 65th ASH Annual Meeting Abstracts\n### ORAL ABSTRACTS\n## 803.EMERGING TOOLS, TECHNIQUES AND ARTIFICIAL INTELLIGENCE IN HEMATOLOGY\n#### Synthetic Histopathological Images Generation with Artificial Intelligence to Accelerate Research and Improve Clinical Outcomes in Hematology\n,\nGianluca Asti, MSc 1 , Saverio D'Amico, MSc 1 , Nico Curti, PhD 2,3 , Gianluca Carlini, PhD 2,3 , Elisabetta Sauta, PhD 1 , Nicolas Riccardo Derus, PhD 4 , Daniele Dall'Olio, PhD 4 , Claudia Sala, PhD 4 , Lorenzo Dall'Olio, PhD 3,2 , Luca Lanino, MD 5 Giulia Maggioni, MD 1 , Alessia Campagna, MD 1 , Marta Ubezio, MD 1 , Antonio Russo, MD 1 , Gabriele Todisco, MD 1 , Cristina Astrid Tentori, MD 1 , Pierandrea Morandini, MEng 1 , Marilena Bicchieri, PhD 1 , Maria Chiara Grondelli, BSc 1 , Matteo Zampini, PhD 1 , Victor Savevski, MEng 1 , Armando Santoro, MD 6,7 , Shahram Kordasti, MDPhD 8 , Valeria Santini, MD 9 , Anne Sophie Kubasch, MD 10 , Uwe Platzbecker, MD 11 , Maria Diez-Campelo, MD PhD 12 , Pierre Fenaux, MD PhD 13 , Lin-Pierre Zhao, MD 13 , Amer M. [truncated]","original_chars":1087}],"docling_markdown":"data/docling_include_no_vlm_2026-07-09/markdown/full_2026_07_06_rec_002400.md"}]
