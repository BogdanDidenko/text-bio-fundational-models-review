[{"record_id":"rec_000245","title":"A six-tiered framework for evaluating AI models from repeatability to replaceability","abstract":"Artificial intelligence (AI) is rapidly transforming biotechnology and medicine. But evaluating its safety, effectiveness, and generalizability is increasingly challenging, especially for complex generative models. Traditional evaluation metrics often fall short in high-stakes applications where reliability and adaptability are critical. We propose a six-tiered framework to guide AI evaluation across the dimensions of repeatability, reproducibility, robustness, rigidity, reusability, and replaceability. These tiers reflect increasing expectations, from basic consistency to deployment. Each is defined clearly, with actionable testing methodologies informed by literature. Designed for flexibility, the framework applies to both traditional and generative AI. Through case studies in diagnostics and medical large language models (LLM), we demonstrate its utility in fostering trustworthy, accountable, and effective AI for biomedicine, biotechnology, and beyond.","doi":"10.1016/j.tibtech.2025.07.015","year":"2026","venue":"","sources":["google_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_000245","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"unclear","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"This proposes an evaluation framework and case studies, which makes it a review/editorial-style methods paper rather than a primary model paper. No new bio-text model is presented.","evidence_snippet":"“We propose a six-tiered framework” and “case studies in diagnostics and medical large language models”"},"architecture_reviewer":{"record_id":"rec_000245","paper_type":"review_editorial","generative_model_present":"unclear","foundation_model_evidence":"unclear","primary_exclusion_code":"review_editorial","uncertainty_reason":"generative_status_unclear","decision_rationale":"This is an evaluation framework for AI models, not a model paper. The abstract mentions generative models only as an application area, with no candidate generative architecture described.","evidence_snippet":"\"propose a six-tiered framework\" and \"applies to both traditional and generative AI\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"review_editorial","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"unclear","generative_model_present":"unclear","foundation_model_evidence":"unclear"}}},{"record_id":"rec_000247","title":"Toward the Programmable Cell: Future Directions in Biological Artificial Intelligence","abstract":"Over the past five years, artificial intelligence has moved from a peripheral analysis tool in the life sciences to a central engine of discovery. Foundation models trained on protein sequences, genomic DNA, and single-cell transcriptomes now predict molecular structure with experimental accuracy, generate functional proteins that do not exist in nature, and encode substantial amounts of organized biological knowledge in their internal representations. This review surveys the current landscape of biological AI and uses it as a vantage point from which to chart the field's most consequential future directions. After situating the major model families across the protein, genomic, and cellular modalities, we organize the road ahead around six themes: (i) the integration of modalities and scales toward an \"AI virtual cell\"; (ii) the shift from prediction to generative design and programmable biology; (iii) mechanistic interpretability as a route from predictive black boxes to scientific instruments; (iv) agentic AI and autonomous experimentation; (v) benchmarking, generalization, and the still unsettled question of what these models actually learn; and (vi) the data, evaluation, reproducibility, and governance challenges that condition all of the above. A recurring theme is that the next decade of progress will depend less on raw scale than on trust: on our ability to verify, interpret, and experimentally ground what biological AI systems claim to know. We argue that interpretability and rigorous evaluation are not adjuncts to the field but prerequisites for its translation into reliable biological and clinical practice.","doi":"10.2139/ssrn.7008859","year":"2026","venue":"","sources":["google_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_000247","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"unclear","primary_exclusion_code":"review_editorial","uncertainty_reason":"none","decision_rationale":"This is a survey of biological AI future directions, not a primary model paper. The abstract says it “surveys the current landscape” and organizes themes across modalities.","evidence_snippet":"“This review surveys the current landscape of biological AI”"},"architecture_reviewer":{"record_id":"rec_000247","paper_type":"review_editorial","generative_model_present":"unclear","foundation_model_evidence":"unclear","primary_exclusion_code":"review_editorial","uncertainty_reason":"mixed_signals","decision_rationale":"This is a forward-looking review of biological AI and foundation models, not a new model. It discusses generative design and model families, but only at a survey level.","evidence_snippet":"\"This review surveys the current landscape of biological AI\" and discusses \"the shift from prediction to generative design\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"review_editorial","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"review_editorial","bio_modality_present":"yes","text_component_present":"yes","text_bio_bridge_present":"unclear","generative_model_present":"unclear","foundation_model_evidence":"unclear"}}},{"record_id":"rec_000248","title":"OCOO-T: A Simple and Scalable Virtual Cell Model for Transcriptional Perturbation Response Prediction","abstract":"Predicting single-cell transcriptional responses to genetic, chemical and cytokine perturbations is a fundamental challenge in computational biology and AI Virtual Cell (AIVC) modeling, with direct implications for drug discovery and the elucidation of gene regulatory networks. Existing approaches often rely on auxiliary cell-state encoders, hierarchical variational autoencoders, dedicated Transformer encoder-decoder modules, or gene-interaction priors to compress high-dimensional expression profiles into latent representations. While effective, these designs increase architectural complexity and may limit scalability and generalizability. This paper introduces OCOO-T 1, a minimalist flow-matching-based AIVC model for transcriptional perturbation response prediction. OCOO-T utilizes a vanilla Transformer stack that operates directly on continuous gene expression profiles and formulates perturbation response prediction as a continuous-time denoising process. Perturbation embeddings, dosage information, and cell-line/cell-type specificity are integrated through adaptive layer normalization and in-context tokens. Comprehensive evaluations on Tahoe100M, Replogle, and PBMC benchmarks demonstrate that OCOO-T achieves state-of-the-art performance across diverse perturbations and cell types while effectively scaling to long transcriptional profiles through patching and depatching of cellular contexts. By leveraging the simplicity of Transformer-based denoising for single-cell omics, OCOO-T provides an effective and scalable framework for in-silico cellular simulation.","doi":"10.64898/2026.06.08.731000","year":"2026","venue":"","sources":["google_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_000248","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"OCOO-T is presented as a new model for transcriptional perturbation response prediction. The abstract describes gene expression and perturbation embeddings but no substantive text component.","evidence_snippet":"“introduces OCOO-T… for transcriptional perturbation response prediction” and “operates directly on continuous gene expression profiles”"},"architecture_reviewer":{"record_id":"rec_000248","paper_type":"primary_model_paper","generative_model_present":"yes","foundation_model_evidence":"unclear","primary_exclusion_code":"none","uncertainty_reason":"foundation_model_evidence_unclear","decision_rationale":"OCOO-T is described as a flow-matching-based model and continuous-time denoising process, which is generative. The abstract shows broad applicability across perturbations and cell types, but not explicit foundation-model pretraining.","evidence_snippet":"\"flow-matching-based\" model and \"continuous-time denoising process\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"EC2_no_text_component","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","generative_model_present":"yes","foundation_model_evidence":"unclear"}}},{"record_id":"rec_000250","title":"Unbalanced Perturbation Dynamics For Cell Fate Design","abstract":"Abstract Large-scale single-cell perturbation sequencing provides an unprecedented opportunity to construct virtual cells for the in silico simulation of cellular responses and the inverse design of optimal interventions. However, most perturbation-response models treat cellular responses primarily as mass-preserving shifts in transcriptomic state, whereas single-cell perturbation measurements are inherently unbalanced: the recovered endpoint population is shaped by technical sampling as well as biological perturbation-induced proliferation, apoptosis and selection. Here we introduce U-Pert, an unbalanced generative framework that learns condition- and context-dependent perturbation dynamics from unpaired single-cell snapshots. U-Pert jointly models transcriptomic state transitions and cell-number dynamics, enabling scalable and robust forward prediction of unseen perturbations and contexts, as well as inverse design to screen for desired genetic or pharmacological interventions that achieve user-defined transcriptomic or population-level outcomes. Across controlled simulations, genetic perturbation benchmarks, sciPlex3 drug responses and PBMC cytokine perturbations, U-Pert predicts unseen responses, captures both molecular and abundance changes, and performs inverse design for target gene-expression programs and cell-type compositions. These results show that cell abundance is an integral component of the perturbation phenotype, providing a mass-aware framework for virtual-cell modeling and perturbation cell fate design.","doi":"10.64898/2026.06.30.735555","year":"2026","venue":"","sources":["google_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_000250","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"This introduces U-Pert as an \"unbalanced generative framework\" for single-cell perturbation dynamics, so it is a primary model paper with biological data. The abstract does not describe any text/language component or text-bio bridge.","evidence_snippet":"\"single-cell perturbation sequencing\"; \"unbalanced generative framework\""},"architecture_reviewer":{"record_id":"rec_000250","paper_type":"primary_model_paper","generative_model_present":"yes","foundation_model_evidence":"unclear","primary_exclusion_code":"none","uncertainty_reason":"foundation_model_evidence_unclear","decision_rationale":"U-Pert is explicitly called an unbalanced generative framework and supports forward prediction/inverse design. The abstract does not clearly state broad pretraining or foundation-model scale beyond large perturbation datasets.","evidence_snippet":"\"an unbalanced generative framework that learns condition- and context-dependent perturbation dynamics\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"EC2_no_text_component","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","generative_model_present":"yes","foundation_model_evidence":"unclear"}}},{"record_id":"rec_000251","title":"Benchmarking virtual cell models for in-the-wild perturbation response","abstract":"… methods leveraging pretrained embeddings like scGPT [26], … the ability of a model to predict gene expression for cell line or … and test sets using single-cell foundation model (scFM) …","doi":"","year":"2026","venue":"","sources":["google_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_000251","paper_type":"benchmark_resource","bio_modality_present":"yes","text_component_present":"unclear","text_bio_bridge_present":"unclear","primary_exclusion_code":"benchmark_resource","uncertainty_reason":"text_component_unclear","decision_rationale":"The title and abstract describe \"benchmarking virtual cell models\" and evaluating pretrained embeddings, which makes this a benchmark resource rather than a new candidate model. The excerpt does not clearly establish a substantive text component or text-bio bridge.","evidence_snippet":"\"Benchmarking virtual cell models\"; \"pretrained embeddings like scGPT\""},"architecture_reviewer":{"record_id":"rec_000251","paper_type":"benchmark_resource","generative_model_present":"no","foundation_model_evidence":"no","primary_exclusion_code":"benchmark_resource","uncertainty_reason":"none","decision_rationale":"This is a benchmarking study of virtual cell models, not a new generative model. The abstract focuses on evaluating pretrained embeddings and scFM-based models.","evidence_snippet":"\"Benchmarking virtual cell models for in-the-wild perturbation response\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"benchmark_resource","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"benchmark_resource","bio_modality_present":"yes","text_component_present":"unclear","text_bio_bridge_present":"unclear","generative_model_present":"no","foundation_model_evidence":"no"}}},{"record_id":"rec_000252","title":"Modeling microenvironment trajectories on spatial transcriptomics with nicheflow","abstract":"… by providing single-cell resolution mapping of gene expression … profiles and spatial coordinates, we assign cell type labels to … Nicheformer: a foundation model for single-cell and …","doi":"10.52202/085713-3453","year":"2026","venue":"","sources":["google_scholar"],"first_pass_outputs":{"scope_reviewer":{"record_id":"rec_000252","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","primary_exclusion_code":"EC2_no_text_component","uncertainty_reason":"none","decision_rationale":"The abstract presents \"nicheflow\" for modeling trajectories on spatial transcriptomics, so this is a primary biological model paper. It is about transcriptomic/spatial data only, with no clear text component or text-bio bridge.","evidence_snippet":"\"Modeling microenvironment trajectories on spatial transcriptomics with nicheflow\""},"architecture_reviewer":{"record_id":"rec_000252","paper_type":"primary_model_paper","generative_model_present":"no","foundation_model_evidence":"unclear","primary_exclusion_code":"EC3_not_generative","uncertainty_reason":"foundation_model_evidence_unclear","decision_rationale":"The abstract fragment describes spatial transcriptomics mapping and cell-type labeling, but no explicit generative mechanism. Nicheformer is only mentioned as a referenced foundation model, not evidence that Nicheflow itself is one.","evidence_snippet":"\"assign cell type labels ... Nicheformer: a foundation model for single-cell and ...\""},"python_gate":{"provisional_decision":"ADJUDICATE","provisional_code":"EC2_no_text_component","adjudication_reason":"criterion_unclear_or_reviewer_conflict","paper_type":"primary_model_paper","bio_modality_present":"yes","text_component_present":"no","text_bio_bridge_present":"no","generative_model_present":"no","foundation_model_evidence":"unclear"}}}]

