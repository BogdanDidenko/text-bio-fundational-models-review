./data/living_catalog/taxonomy_rerun_preflight_2026-08-12/taxonomy/runs/discovery/shard_02/records/july_update_2026-07-06__rec_000050_23824e963093/july_update_2026_07_06_rec_000050_23824e963093_docling_json_20260812_141419/docling/chunks.json:6927:    "text": "C Main-Results Tables\nC.1 Results for Figure 2\n SFT1 = 0.282. Protein, SFT2 = 0.330. Protein, SFT4 = 0.357. Protein, SFT8 = 0.368. Protein, SFT16 = 0.333. Protein, SFT32 = 0.315. Protein, Model = Qwen3-1.7B. Protein, Split = OOD. Protein, Base = 0.095. Protein, SFT1 = 0.220. Protein, SFT2 = 0.254. Protein, SFT4 = 0.278. Protein, SFT8 = 0.261. Protein, SFT16 = 0.245. Protein, SFT32 = 0.233. Protein, Model = Qwen3-4B. Protein, Split = ID. Protein, Base = 0.126. Protein, SFT1 = 0.303. Protein, SFT2 = 0.349. Protein, SFT4 = 0.368. Protein, SFT8 = 0.382. Protein, SFT16 = 0.367. Protein, SFT32 = 0.332. Protein, Model = Qwen3-4B. Protein, Split = OOD. Protein, Base = 0.108. Protein, SFT1 = 0.322. Protein, SFT2 = 0.364. Protein, SFT4 = 0.340. Protein, SFT8 = 0.342. Protein, SFT16 = 0.305. Protein, SFT32 = 0.291",
