_or_context\", \"paired_alignment_supervision\", \"training_target\", \"generated_output\", \"no_text_on_this_route\", \"unclear\"], \"title\": \"Text Role\", \"type\": \"string\"}, \"input_status\": {\"enum\": [\"actual_model_input\", \"paired_alignment_input\", \"training_only_target\", \"generated_output\", \"baseline_only\", \"ablation_only\", \"unclear\"], \"title\": \"Input Status\", \"type\": \"string\"}, \"evidence_quote\": {\"description\": \"One short contiguous verbatim quote supporting this route. Never concatenate separate sentences or summarize.\", \"title\": \"Evidence Quote\", \"type\": \"string\"}, \"section_heading\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}], \"default\": null, \"title\": \"Section Heading\"}, \"supporting_figure_or_table\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}], \"default\": null, \"title\": \"Supporting Figure Or Table\"}, \"evidence_status\": {\"enum\": [\"explicit_text\", \"text_plus_figure\", \"figure_only\", \"inferred\"], \"title\": \"Evidence Status\", \"type\": \"string\"}, \"uncertainty\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}], \"default\": null, \"title\": \"Uncertainty\"}}, \"required\": [\"route_label\", \"model_name\", \"lifecycle_phase\", \"task_or_configuration_verbatim\", \"source_object_verbatim\", \"source_object_normalized\", \"source_modality_normalized\", \"model_visible_form_verbatim\", \"carrier_family\", \"carrier_subtype\", \"insertion_or_fusion_verbatim\", \"fusion_topology\", \"text_role\", \"input_status\", \"evidence_quote\", \"evidence_status\"], \"title\": \"TaxonomyCodedRoute\", \"type\": \"object\"}}}\n=== END SCHEMA ===\n\n"}, "prompt_sha256": "2fbf699fea6b7e7207e04d54208e91a2acc8170d1844ab597fea734413146741", "schema_json": "{\"type\": \"object\", \"properties\": {\"items\": {\"type\": \"array\", \"items\": {\"description\": \"Taxonomy-v1 coding for all candidate input routes in one paper.\", \"properties\": {\"taxonomy_version\": {\"con