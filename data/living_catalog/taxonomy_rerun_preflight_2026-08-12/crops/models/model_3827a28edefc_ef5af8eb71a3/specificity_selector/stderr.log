RIM50, TRIM63, TRIM69, TRIM71, TRIM9, TRIP12, UBA1, UBA3, UBA5, UBA52, UBA6, UBA7, UBAC1, UBB, UBC, UBE2A, UBE2B, UBE2C, UBE2D1, UBE2D2, UBE2D3, UBE2D4, UBE2E1, UBE2E2, UBE2E3, UBE2F, UBE2G1, UBE2G2, UBE2H, UBE2J1, UBE2J2, UBE2K, UBE2L3, UBE2L6, UBE2M, UBE2N, UBE2O, UBE2Q1, UBE2Q2, UBE2R2, UBE2S, UBE2U, UBE2V1, UBE2V2, UBE2W, UBE2Z, UBE3A, UBE3B, UBE3C, UBE3D, UBE4A, UBOX5, UBR1, UBR2, UBR4, UFL1, UNKL, VAMP3, VAMP8, VHL, WSB1, WWP1, ZBTB16, ZNRF1, ZNRF2\n\nFigure 21: The 381 genes in the 'Reactome Class I MHC-Mediated Antigen Processing Presentation' gene set, used to score virtual screen outputs.\n", "prompt_sha256": "b9bdafadf6082882aebbe3d2265d6f659a86d4ae64bd8e5ab2ddfa33199ba01b", "schema_json": "{\"$defs\": {\"DenseCandidateDisposition\": {\"additionalProperties\": false, \"description\": \"Explicit coverage-audit disposition for one dense Graph candidate.\", \"properties\": {\"candidate_ref\": {\"title\": \"Candidate Ref\", \"type\": \"string\"}, \"decision\": {\"enum\": [\"supports_accepted_route\", \"accepted_as_dense_only_route\", \"exclude_duplicate\", \"exclude_training_only_target\", \"exclude_generated_output\", \"exclude_baseline_or_ablation\", \"exclude_not_a_source_to_model_route\", \"exclude_figure_only\", \"exclude_ungrounded_or_taxonomy_invalid\", \"unresolved\"], \"title\": \"Decision\", \"type\": \"string\"}, \"linked_route_labels\": {\"items\": {\"type\": \"string\"}, \"title\": \"Linked Route Labels\", \"type\": \"array\"}, \"reason\": {\"title\": \"Reason\", \"type\": \"string\"}, \"uncertainty\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}], \"title\": \"Uncertainty\"}}, \"required\": [\"candidate_ref\", \"decision\", \"linked_route_labels\", \"reason\", \"uncertainty\"], \"title\": \"DenseCandidateDisposition\", \"type\": \"object\"}, \"ExcludedRouteCandidate\": {\"additionalProperties\": false, \"description\": \"A fixed discovery candidate explicitly excluded from accepted input routes.\", \"properties\": {\"candidate_ref\": {\"title\": \"Candidate Ref\", \"type\": \"string\"}, \"decision\": {\"enum\": [\"exclude_training_only_target\", \"exclude_generated_output\", \"exclude_baseline_only\", \"exclude_ablation_only\", \"exclude_not_a_source_to_model_route\", \"exclude_duplicate_candidate\", \"uncertain\"], \"title\": \"Decision\", \"type\": \"string\"}, \"reason\": {\"title\": \"Reason\", \"type\": \"string\"}, \"evidence_quote\": {\"title\": \"Evidence Quote\", \"type\": \"string\"}, \"uncertainty\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}], \"title\": \"Uncertainty\"}}, \"required\": [\"candidate_ref\", \"decision\", \"reason\", \"evidence_quote\", \"uncertainty\"], \"title\": \"ExcludedRouteCandidate\", \"type\": \"object\"}, \"FinalAdjudicatedInputRoute\": {\"additionalProperties\": false, \"description\": \"Final route grounded in discovery and/or dense Graph evidence.\", \"properties\": {\"route_label\": {\"title\": \"Route Label\", \"type\": \"string\"}, \"model_name\": {\"title\": \"Model Name\", \"type\": \"string\"}, \"lifecycle_phase\": {\"enum\": [\"pretraining\", \"fine_tuning\", \"inference\", \"evaluation\", \"unclear\"], \"title\": \"Lifecycle Phase\", \"type\": \"string\"}, \"task_or_configuration_verbatim\": {\"title\": \"Task Or Configuration Verbatim\", \"type\": \"string\"}, \"source_object_verbatim\": {\"title\": \"Source Object Verbatim\", \"type\": \"string\"}, \"source_object_normalized\": {\"title\": \"Source Object Normalized\", \"type\": \"string\"}, \"source_modality_normalized\": {\"title\": \"Source Modality Normalized\", \"type\": \"string\"}, \"transformation_chain_verbatim\": {\"items\": {\"type\": \"string\"}, \"title\": \"Transformation Chain Verbatim\", \"type\": \"array\"}, \"transformation_chain_normalized\": {\"items\": {\"type\": \"string\"}, \"title\": \"Transformation Chain Normalized\", \"type\": \"array\"}, \"model_visible_form_verbatim\": {\"title\": \"Model Visible Form Verbatim\", \"type\": \"string\"}, \"carrier_family\": {\"description\": \"Frozen v1 model-visible carrier. text_native_token_stream covers ordinary language tokens, structured prompts, and deterministic biological text serializations; discrete_biological_symbol_stream covers native biological tokens, aligned structural tracks, and learned VQ/RVQ/codebook IDs; dense_continuous_carrier covers projected, virtual-token, connector-mediated, or pooled embeddings; visual_raster_carrier covers pixels, slides, patches, and visual case contexts; geometric_or_diffusion_state_carrier covers noisy states, coordinates/backbones/shapes, and structural constraints. Classify the first model-facing carrier before routine embedding lookup or encoder processing. Do not relabel tokenizer tokens, biological symbols, or pixels as dense merely because the model subsequently embeds or encodes them.\", \"enum\": [\"text_native_token_stream\", \"discrete_biological_symbol_stream\", \"dense_continuous_carrier\", \"visual_raster_carrier\", \"geometric_or_diffusion_state_carrier\", \"other_evidence_grounded\"], \"title\": \"Carrier Family\", \"type\": \"string\"}, \"carrier_subtype\": {\"description\": \"Subtype must belong to carrier_family exactly as defined in the frozen taxonomy_codebook.md. Learned quantized IDs must not be coded as native biological tokens or continuous embeddings. Deterministically serialized cell/gene/profile text belongs to the text-native serialization subtype.\", \"enum\": [\"plain_language_prompt_or_question\", \"structured_biological_prompt_or_task_scaffold\", \"serialized_biological_context_or_ordered_profile\", \"native_biological_token_stream\", \"multi_track_structural_symbol_stream\", \"learned_quantized_id_or_codebook_token\", \"direct_projected_embedding\", \"virtual_token_prefix\", \"connector_mediated_embedding\", \"pooled_or_aggregated_embedding\", \"raw_slide_or_patch_input\", \"patch_context_or_case_level_visual_reasoning\", \"noisy_diffusion_state\", \"coordinate_backbone_or_shape_conditioning\", \"symbolic_structural_constraint\", \"other_evidence_grounded\"], \"title\": \"Carrier Subtype\", \"type\": \"string\"}, \"insertion_or_fusion_verbatim\": {\"title\": \"Insertion Or Fusion Verbatim\", \"type\": \"string\"}, \"fusion_topology\": {\"enum\": [\"tokenizer_sequence\", \"concatenation\", \"prefix\", \"placeholder_replacement\", \"interleaving\", \"cross_attention\", \"query_bottleneck\", \"shared_latent_alignment\", \"encoder_decoder\", \"side_or_generative_conditioning\", \"retrieval_or_tool_context\", \"other_explicit\", \"unclear\"], \"title\": \"Fusion Topology\", \"type\": \"string\"}, \"text_role\": {\"enum\": [\"biological_payload\", \"semantic_annotation\", \"instruction_or_query\", \"modality_or_task_selector\", \"metadata_or_context\", \"paired_alignment_supervision\", \"training_target\", \"generated_output\", \"no_text_on_this_route\", \"unclear\"], \"title\": \"Text Role\", \"type\": \"string\"}, \"input_status\": {\"enum\": [\"actual_model_input\", \"paired_alignment_input\", \"training_only_target\", \"generated_output\", \"baseline_only\", \"ablation_only\", \"unclear\"], \"title\": \"Input Status\", \"type\": \"string\"}, \"evidence_quote\": {\"description\": \"One short contiguous verbatim quote supporting this route. Never concatenate separate sentences or summarize.\", \"title\": \"Evidence Quote\", \"type\": \"string\"}, \"section_heading\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}], \"title\": \"Section Heading\"}, \"supporting_figure_or_table\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}], \"title\": \"Supporting Figure Or Table\"}, \"evidence_status\": {\"enum\": [\"explicit_text\", \"text_plus_figure\", \"figure_only\", \"inferred\"], \"title\": \"Evidence Status\", \"type\": \"string\"}, \"uncertainty\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}], \"title\": \"Uncertainty\"}, \"source_candidate_refs\": {\"description\": \"Discovery route_ref values supporting this route. A combined discovery candidate may support several split source-to-model routes; duplicated discovery candidates may be merged into one final route.\", \"items\": {\"type\": \"string\"}, \"title\": \"Source Candidate Refs\", \"type\": \"array\"}, \"dense_candidate_refs\": {\"description\": \"Dense coverage candidate refs supporting this route. At least one source candidate ref or dense candidate ref must support every final route.\", \"items\": {\"type\": \"string\"}, \"title\": \"Dense Candidate Refs\", \"type\": \"array\"}}, \"required\": [\"route_label\", \"model_name\", \"lifecycle_phase\", \"task_or_configuration_verbatim\", \"source_object_verbatim\", \"source_object_normalized\", \"source_modality_normalized\", \"transformation_chain_verbatim\", \"transformation_chain_normalized\", \"model_visible_form_verbatim\", \"carrier_family\", \"carrier_subtype\", \"insertion_or_fusion_verbatim\", \"fusion_topology\", \"text_role\", \"input_status\", \"evidence_quote\", \"section_heading\", \"supporting_figure_or_table\", \"evidence_status\", \"uncertainty\", \"source_candidate_refs\", \"dense_candidate_refs\"], \"title\": \"FinalAdjudicatedInputRoute\", \"type\": \"object\"}}, \"additionalProperties\": false, \"description\": \"Blinded final reconciliation with complete candidate accounting.\", \"properties\": {\"taxonomy_version\": {\"const\": \"input-representation-taxonomy-v1.2-adjudicated\", \"title\": \"Taxonomy Version\", \"type\": \"string\"}, \"title\": {\"title\": \"Title\", \"type\": \"string\"}, \"doi\": {\"anyOf\": [{\"type\": \"string\"}, {\"type\": \"null\"}], \"title\": \"Doi\"}, \"input_routes\": {\"items\": {\"$ref\": \"#/$defs/FinalAdjudicatedInputRoute\"}, \"title\": \"Input Routes\", \"type\": \"array\"}, \"excluded_candidates\": {\"items\": {\"$ref\": \"#/$defs/ExcludedRouteCandidate\"}, \"title\": \"Excluded Candidates\", \"type\": \"array\"}, \"dense_candidate_dispositions\": {\"items\": {\"$ref\": \"#/$defs/DenseCandidateDisposition\"}, \"title\": \"Dense Candidate Dispositions\", \"type\": \"array\"}}, \"required\": [\"taxonomy_version\", \"title\", \"doi\", \"input_routes\", \"excluded_candidates\", \"dense_candidate_dispositions\"], \"title\": \"FinalAdjudicatedTaxonomyDocument\", \"type\": \"object\"}"}
