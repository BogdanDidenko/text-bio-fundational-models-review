fine-tuning\", \"task_or_configuration_verbatim\": \"x, t\", \"source_object_verbatim\": \"single-cell gene expression profile x\", \"transformation_chain_verbatim\": [\"RVQ encoder\", \"RVQ tokenizer\"], \"model_visible_form_verbatim\": \"RVQ discrete codes\", \"insertion_or_fusion_verbatim\": \"embedded through the same token embedding table used for text tokens\", \"text_role_verbatim\": \"task instruction t\", \"input_status_verbatim\": \"actual model input\", \"evidence_quote\": \"gene expression data passes through\", \"section_heading\": \"3.2 Residual Quantization for LLM-Native Cell Tokens\", \"supporting_figure_or_table\": \"Figure 2\", \"uncertainty\": null, \"grounding\": {\"pages\": [8, 9], \"doc_item_refs\": [\"#/texts/145\", \"#/texts/146\", \"#/texts/147\", \"#/texts/148\", \"#/texts/149\", \"#/texts/151\", \"#/texts/152\"], \"provenance_match\": \"verbatim\"}}, {\"route_ref\": \"june_update_2026-06-10__rec_000121::route_003\", \"record_id\": \"june_update_2026-06-10__rec_000121\", \"paper_title\": \"RVQ-Alpha: Bridging Single-Cell Transcriptomics and Large Language Models via Discrete Tokenization and Verifiable Reinforcement Learning\", \"grounding_valid\": true, \"picture_only_provenance\": false, \"id\": \"InputRouteDiscovery_0b6cb114afb4437a\", \"route_label\": \"Population RVQ stream\", \"model_name\": \"Qwen3-4B-Thinking-2507\", \"lifecycle_phase_verbatim\": \"reinforcement learning\", \"task_or_configuration_verbatim\": \"P, t\", \"source_object_verbatim\": \"cell population P\", \"transformation_chain_verbatim\": [\"RVQ tokenizer\", \"per-cell and population-level delimiters\"], \"model_visible_form_verbatim\": \"RVQ discrete codes with per-cell and population-level delimiters\", \"insertion_or_fusion_verbatim\": \"fused at the shared embedding layer\", \"text_role_verbatim\": \"task instruction t\", \"input_status_verbatim\": \"actual model input\", \"evidence_quote\": \"per-cell and population-level delimiters separate cells\", \"section_h