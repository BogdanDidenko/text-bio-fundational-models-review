./data/input_representation_atlas_crop_crossvalidation_2026-07-12/post_role_scope_adjudication_manifest.json:5892:        "caption": "Figure 4 . Interactive exploration of user-provided scRNA-seq data with CellWhisperer",
./data/input_representation_atlas_crop_crossvalidation_2026-07-12/post_role_scope_adjudication_manifest.json:6060:        "supporting_figure_or_table": "Figure 4",
