ntentTypes.ArticleTab, '02118581-202603000-00013');\r\n    };\r\n\r\n    window.addEventListener(\""load\"", () => {\r\n        HighlightSearchTerms();\r\n    });\r\n\r\n document.addEventListener('DOMContentLoaded', function() {\r\n    function dispatchCustomEvent(eventName, linkUrl) {\r\n        document.dispatchEvent(new CustomEvent(eventName, {\r\n            detail: {\r\n                link_url: linkUrl\r\n            }\r\n        }));\r\n    }\r\n\r\n    var anchors = {\r\n        'omni:articleviewer:buy': document.getElementById('ctl00_ctl29_g_1e6b2693_88ba_4081_8911_eecbf8ee1aa9_ctl00_hypPurchase'),\r\n        'omni:articleviewer:subscribe': document.getElementById('ctl00_ctl29_g_1e6b2693_88ba_4081_8911_eecbf8ee1aa9_ctl00_hypSubscribe'),\r\n        'omni:articleviewer:permission': document.getElementById('ctl00_ctl29_g_1e6b2693_88ba_4081_8911_eecbf8ee1aa9_ctl00_hypliPatentOrCaregiver'),\r\n        'omni:articleviewer:society': document.getElementById('ctl00_ctl29_g_1e6b2693_88ba_4081_8911_eecbf8ee1aa9_ctl00_hypSociety')\r\n    };\r\n\r\n    Object.keys(anchors).forEach(function(eventName) {\r\n        var anchor = anchors[eventName];\r\n        if (anchor) {\r\n            anchor.addEventListener('click', function(event) {\r\n                dispatchCustomEvent(eventName, anchor.href);\r\n            });\r\n        }\r\n    });\r\n});\r\n\r\n</script>\r\n<script>\r\n    function closeArticleViewerModalDialog() {\r\n        $('#articleViewerDialog').hide();\r\n\r\n        return false;\r\n    }\r\n</script>\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n<div class=\""ejp-article-wrapper\"">\r\n    <div id=\""ctl00_ctl29_g_1e6b2693_88ba_4081_8911_eecbf8ee1aa9_ctl00_ucArticleTools_container\"" data-article-config=\""{&quot;title&quot;:&quot;ReadAloud: A pipeline for single-cell chromatin accessibility data analysis&quot;,&quot;doi&quot;:&quot;10.1097/BS9.0000000000000259&quot;}\"" data-read-along=\""false\"" data-ppt-event-detail=\""{&quot;eventName&quot;:&quot;PPTDownload&qu