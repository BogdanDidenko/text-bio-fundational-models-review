{
  "$defs": {
    "TaxonomyCodedRoute": {
      "description": "One route coded against taxonomy v1 while retaining lossless evidence.",
      "properties": {
        "route_label": {
          "title": "Route Label",
          "type": "string"
        },
        "model_name": {
          "title": "Model Name",
          "type": "string"
        },
        "lifecycle_phase": {
          "enum": [
            "pretraining",
            "fine_tuning",
            "inference",
            "evaluation",
            "unclear"
          ],
          "title": "Lifecycle Phase",
          "type": "string"
        },
        "task_or_configuration_verbatim": {
          "title": "Task Or Configuration Verbatim",
          "type": "string"
        },
        "source_object_verbatim": {
          "title": "Source Object Verbatim",
          "type": "string"
        },
        "source_object_normalized": {
          "title": "Source Object Normalized",
          "type": "string"
        },
        "source_modality_normalized": {
          "title": "Source Modality Normalized",
          "type": "string"
        },
        "transformation_chain_verbatim": {
          "items": {
            "type": "string"
          },
          "title": "Transformation Chain Verbatim",
          "type": "array"
        },
        "transformation_chain_normalized": {
          "items": {
            "type": "string"
          },
          "title": "Transformation Chain Normalized",
          "type": "array"
        },
        "model_visible_form_verbatim": {
          "title": "Model Visible Form Verbatim",
          "type": "string"
        },
        "carrier_family": {
          "description": "Frozen v1 model-visible carrier. text_native_token_stream covers ordinary language tokens, structured prompts, and deterministic biological text serializations; discrete_biological_symbol_stream covers native biological tokens, aligned structural tracks, and learned VQ/RVQ/codebook IDs; dense_continuous_carrier covers projected, virtual-token, connector-mediated, or pooled embeddings; visual_raster_carrier covers pixels, slides, patches, and visual case contexts; geometric_or_diffusion_state_carrier covers noisy states, coordinates/backbones/shapes, and structural constraints. Classify the first model-facing carrier before routine embedding lookup or encoder processing. Do not relabel tokenizer tokens, biological symbols, or pixels as dense merely because the model subsequently embeds or encodes them.",
          "enum": [
            "text_native_token_stream",
            "discrete_biological_symbol_stream",
            "dense_continuous_carrier",
            "visual_raster_carrier",
            "geometric_or_diffusion_state_carrier",
            "other_evidence_grounded"
          ],
          "title": "Carrier Family",
          "type": "string"
        },
        "carrier_subtype": {
          "description": "Subtype must belong to carrier_family exactly as defined in the frozen taxonomy_codebook.md. Learned quantized IDs must not be coded as native biological tokens or continuous embeddings. Deterministically serialized cell/gene/profile text belongs to the text-native serialization subtype.",
          "enum": [
            "plain_language_prompt_or_question",
            "structured_biological_prompt_or_task_scaffold",
            "serialized_biological_context_or_ordered_profile",
            "native_biological_token_stream",
            "multi_track_structural_symbol_stream",
            "learned_quantized_id_or_codebook_token",
            "direct_projected_embedding",
            "virtual_token_prefix",
            "connector_mediated_embedding",
            "pooled_or_aggregated_embedding",
            "raw_slide_or_patch_input",
            "patch_context_or_case_level_visual_reasoning",
            "noisy_diffusion_state",
            "coordinate_backbone_or_shape_conditioning",
            "symbolic_structural_constraint",
            "other_evidence_grounded"
          ],
          "title": "Carrier Subtype",
          "type": "string"
        },
        "insertion_or_fusion_verbatim": {
          "title": "Insertion Or Fusion Verbatim",
          "type": "string"
        },
        "fusion_topology": {
          "enum": [
            "tokenizer_sequence",
            "concatenation",
            "prefix",
            "placeholder_replacement",
            "interleaving",
            "cross_attention",
            "query_bottleneck",
            "shared_latent_alignment",
            "encoder_decoder",
            "side_or_generative_conditioning",
            "retrieval_or_tool_context",
            "other_explicit",
            "unclear"
          ],
          "title": "Fusion Topology",
          "type": "string"
        },
        "text_role": {
          "enum": [
            "biological_payload",
            "semantic_annotation",
            "instruction_or_query",
            "modality_or_task_selector",
            "metadata_or_context",
            "paired_alignment_supervision",
            "training_target",
            "generated_output",
            "no_text_on_this_route",
            "unclear"
          ],
          "title": "Text Role",
          "type": "string"
        },
        "input_status": {
          "enum": [
            "actual_model_input",
            "paired_alignment_input",
            "training_only_target",
            "generated_output",
            "baseline_only",
            "ablation_only",
            "unclear"
          ],
          "title": "Input Status",
          "type": "string"
        },
        "evidence_quote": {
          "description": "One short contiguous verbatim quote supporting this route. Never concatenate separate sentences or summarize.",
          "title": "Evidence Quote",
          "type": "string"
        },
        "section_heading": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section Heading"
        },
        "supporting_figure_or_table": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supporting Figure Or Table"
        },
        "evidence_status": {
          "enum": [
            "explicit_text",
            "text_plus_figure",
            "figure_only",
            "inferred"
          ],
          "title": "Evidence Status",
          "type": "string"
        },
        "uncertainty": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uncertainty"
        }
      },
      "required": [
        "route_label",
        "model_name",
        "lifecycle_phase",
        "task_or_configuration_verbatim",
        "source_object_verbatim",
        "source_object_normalized",
        "source_modality_normalized",
        "model_visible_form_verbatim",
        "carrier_family",
        "carrier_subtype",
        "insertion_or_fusion_verbatim",
        "fusion_topology",
        "text_role",
        "input_status",
        "evidence_quote",
        "evidence_status"
      ],
      "title": "TaxonomyCodedRoute",
      "type": "object"
    }
  },
  "description": "Taxonomy-v1 coding for all candidate input routes in one paper.",
  "properties": {
    "taxonomy_version": {
      "const": "input-representation-taxonomy-v1",
      "default": "input-representation-taxonomy-v1",
      "title": "Taxonomy Version",
      "type": "string"
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "doi": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Doi"
    },
    "input_routes": {
      "description": "All distinct routes, including explicitly identified non-input candidates. Every route starts at one source object and one lifecycle phase. Never use a single hybrid or fused-summary route when several source-to-model pathways exist; record the shared configuration on each participating route.",
      "edge_label": "HAS_CODED_INPUT_ROUTE",
      "items": {
        "$ref": "#/$defs/TaxonomyCodedRoute"
      },
      "title": "Input Routes",
      "type": "array"
    }
  },
  "required": [
    "title"
  ],
  "title": "TaxonomyCodedDocument",
  "type": "object"
}
